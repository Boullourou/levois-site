---
import { site } from '../config/site';
import Analytics from '../components/Analytics.astro';
import '../styles/public-base.css';
import '../styles/levois.css';
import '../styles/editorial.css';
import '../styles/plan-vivant.css';
import '../styles/v7.css';
import '../styles/v7-production.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPublishedEditorialArticles } from '../lib/editorial/catalog';
import { createResourceCatalog, getResourceRegistry } from '../lib/editorial/shared-catalog';

interface Props { 
  homeV7?: boolean; 
  title: string; 
  description?: string; 
  image?: string; 
  imageAlt?: string;
  article?: { headline: string; author: { name: string; role: string }; category: string; createdAt?: string; updatedAt?: string; topicId?: string; revision?: number };
  noindex?: boolean; 
  headerTransparent?: boolean; 
  homeV2?: boolean; 
  designContract?: string 
}

const {
  title,
  description = site.description,
  image = '/assets/levois-partage.jpg',
  imageAlt = 'LEVOIS · Conseil immobilier avec Mouaad Boullourou à Lèves et Chartres',
  article,
  noindex = false,
  homeV7 = false
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = Astro.url.pathname.endsWith('/') ? site.url + Astro.url.pathname : site.url + Astro.url.pathname + '/';

const normalizedTitle = title.replace(/\bLEVOIS\.FR\b/gi, 'LEVOIS');
const pageTitle = normalizedTitle === 'Accueil'
  ? 'LEVOIS · Conseil Immobilier & Vente à Lèves et Chartres'
  : (normalizedTitle.includes('LEVOIS') ? normalizedTitle : `${normalizedTitle} · LEVOIS`);
const shareImage = new URL(image, site.url).href;
const allArticleIdentities = getResourceRegistry(createResourceCatalog(getPublishedEditorialArticles()));
const contextPaths = ['/situer-ma-vente', '/ma-recherche', '/vendre-et-acheter', '/lecture', '/contact', '/reprendre', '/votre-rue'];
const articleRegistry = contextPaths.includes(path) ? allArticleIdentities : article ? allArticleIdentities.filter((entry) => path === `/ressources/${entry.slug}`) : [];

const schemaOrg = {
  '@context': 'https://schema.org',
  '@graph': [
    ...(article ? [{
      '@type': 'Article',
      '@id': `${canonicalUrl}#article`,
      headline: article.headline,
      description,
      mainEntityOfPage: canonicalUrl,
      url: canonicalUrl,
      image: shareImage,
      articleSection: article.category,
      inLanguage: 'fr-FR',
      author: { '@type': 'Person', name: article.author.name, jobTitle: article.author.role, ...(article.author.name === 'Mouaad Boullourou' ? { '@id': 'https://levois.fr/#mouaad' } : {}) },
      publisher: { '@id': 'https://levois.fr/#agent' },
      ...(article.createdAt ? { dateCreated: article.createdAt } : {}),
      ...(article.updatedAt ? { dateModified: article.updatedAt } : {}),
    }] : []),
    {
      '@type': 'RealEstateAgent',
      '@id': 'https://levois.fr/#agent',
      name: 'LEVOIS',
      url: 'https://levois.fr/',
      logo: 'https://levois.fr/favicon.svg',
      image: 'https://levois.fr/assets/levois-partage.jpg',
      telephone: '+33781380121',
      email: 'mouaad@levois.fr',
      priceRange: '$$',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '25 rue de la Butte Celtique',
        addressLocality: 'Lèves',
        postalCode: '28300',
        addressRegion: 'Eure-et-Loir',
        addressCountry: 'FR'
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: 48.4697,
        longitude: 1.4816
      },
      areaServed: [
        { '@type': 'City', name: 'Lèves', sameAs: 'https://fr.wikipedia.org/wiki/L%C3%A8ves' },
        { '@type': 'City', name: 'Chartres', sameAs: 'https://fr.wikipedia.org/wiki/Chartres' },
        { '@type': 'City', name: 'Mainvilliers' },
        { '@type': 'City', name: 'Lucé' },
        { '@type': 'City', name: 'Champhol' },
        { '@type': 'City', name: 'Le Coudray' },
        { '@type': 'City', name: 'Luisant' }
      ],
      parentOrganization: {
        '@type': 'Organization',
        name: 'SAFTI',
        url: 'https://www.safti.fr',
        sameAs: 'https://www.safti.fr/cms/mentions-legales'
      },
      founder: {
        '@type': 'Person',
        '@id': 'https://levois.fr/#mouaad',
        name: 'Mouaad Boullourou',
        jobTitle: 'Conseiller immobilier indépendant SAFTI',
        telephone: '+33781380121',
        email: 'mouaad@levois.fr',
        image: 'https://levois.fr/v7/asset-07.webp',
        sameAs: [
          'https://www.safti.fr/votre-conseiller-safti/mouaad-boullourou',
          'https://www.pappers.fr/entreprise/boullourou-mouaad-824194419'
        ],
        identifier: 'RSAC Chartres 824 194 419'
      }
    },
    {
      '@type': 'WebSite',
      '@id': 'https://levois.fr/#website',
      url: 'https://levois.fr/',
      name: 'LEVOIS',
      description: 'Conseil immobilier indépendant et observatoire DVF des ventes réelles à Lèves et Chartres Métropole.',
      publisher: { '@id': 'https://levois.fr/#agent' },
      inLanguage: 'fr-FR'
    }
  ]
};
---
<!doctype html>
<html lang="fr">
<head>
  <script is:inline>document.documentElement.classList.add("js");</script>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="color-scheme" content="light"/>
  {(noindex || ['/composants', '/404', '/situer-ma-vente/resultat', '/lecture', '/reprendre'].includes(path)) && <meta name="robots" content="noindex,nofollow"/>}
  <title>{pageTitle}</title>
  <meta name="theme-color" content="#F7F6F2"/>
  <meta name="description" content={description}/>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link rel="canonical" href={canonicalUrl}/>
  <meta property="og:url" content={canonicalUrl}/>
  <meta property="og:title" content={pageTitle}/>
  <meta property="og:description" content={description}/>
  <meta property="og:image" content={shareImage}/>
  <meta property="og:image:alt" content={imageAlt}/>
  <meta property="og:site_name" content="LEVOIS"/>
  <meta property="og:locale" content="fr_FR"/>
  <meta property="og:type" content={article ? 'article' : 'website'}/>
  {article && <meta property="article:author" content={article.author.name}/>}
  {article && <meta property="article:section" content={article.category}/>}
  {article?.updatedAt && <meta property="article:modified_time" content={article.updatedAt}/>}
  {article?.topicId && <meta name="levois:topic-id" content={article.topicId}/>}
  {article?.revision !== undefined && <meta name="levois:revision" content={String(article.revision)}/>}
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={pageTitle}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={shareImage}/>
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrg).replace(/</g, '\\u003c')}/>
</head>
<body class:list={['levois-v7', homeV7 ? 'v7-homepage' : 'reperes-shell plan-vivant v7-inner', { 'rp-territoire': path === '/votre-rue' }]}>
  <a class="lv-skip" href="#contenu">Aller au contenu</a>
  <Header transparent={homeV7}/>
  <main id="contenu" tabindex="-1"><slot/></main>
  <Footer flush={homeV7}/>
  <Analytics/>
  {articleRegistry.length > 0 && <script id="levois-article-context" type="application/json" set:html={JSON.stringify(articleRegistry).replace(/</g, '\\u003c')}/>}
  <script>
    import '../scripts/public-forms';
    import '../scripts/experience-entry';
    import '../scripts/editorial-context';
  </script>
</body>
</html>
