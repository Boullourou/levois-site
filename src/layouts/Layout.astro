---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MontageHeader from '../components/territory-c/MontageHeader.astro';
import MontageFooter from '../components/territory-c/MontageFooter.astro';
import Analytics from '../components/Analytics.astro';
import { site } from '../config/site';
import '../styles/global.css';
import '../styles/montage.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Header intégré sur fond papier (Hero) ou solide dès l'arrivée. */
  headerTransparent?: boolean;
  /** Exclut la page de l'indexation (pages internes). */
  noindex?: boolean;
  /** Active le monde visuel LEVOIS V2, désormais commun à toutes les pages publiques. */
  homeV2?: boolean;
  /** Contrat de direction rendu dans le HTML pour rester auditable après build. */
  designContract?: string;
  /** Active le démonstrateur isolé du territoire C « Montage habité ». */
  territoryC?: boolean;
}

const {
  title,
  description = site.description,
  image = '/images/hero-chartres-evidence-1536.webp',
  headerTransparent = false,
  noindex = false,
  homeV2 = true,
  designContract,
  territoryC = false,
} = Astro.props;

const fullTitle = title === 'Accueil' ? `LEVOIS · ${site.baseline}` : `${title} · LEVOIS`;
const canonical = site.url + Astro.url.pathname;
const ogImage = image.startsWith('http') ? image : site.url + image;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <script is:inline>document.documentElement.classList.add('js');</script>

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="LEVOIS" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${site.url}/#website`,
          url: site.url,
          name: site.name,
          description: site.description,
          inLanguage: 'fr-FR',
          publisher: { '@id': `${site.url}/#mouaad-boullourou` },
        },
        {
          '@type': 'Person',
          '@id': `${site.url}/#mouaad-boullourou`,
          name: site.mouaad.nom,
          url: `${site.url}/mouaad`,
          jobTitle: 'Conseiller immobilier SAFTI',
          description: 'Mouaad Boullourou, conseiller immobilier SAFTI à Lèves et alentours.',
          sameAs: ['https://www.safti.fr/votre-conseiller-safti/mouaad-boullourou'],
        },
      ],
    })} />
  </head>

  <body class:list={['min-h-screen flex flex-col', { 'home-shell': homeV2 && !territoryC, 'montage-shell': territoryC }]}>
    {designContract && <Fragment set:html={`<!--\n${designContract}\n-->`} />}
    <a href="#contenu" class:list={[territoryC ? 'mh-skip' : 'sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-argile focus:text-papier-vif focus:px-4 focus:py-2 focus:rounded-full font-sans']}>
      Aller au contenu
    </a>

    {territoryC ? <MontageHeader /> : <Header transparent={headerTransparent} homeV2={homeV2} />}
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    {territoryC ? <MontageFooter /> : <Footer homeV2={homeV2} flush={title === 'Accueil'} />}
    <Analytics />

    <script>
      // Révélation à l'entrée dans le viewport — famille A (narration).
      // Avec prefers-reduced-motion, le CSS affiche tout directement.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
      );
      document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));

      // Filet de sécurité : quoi qu'il arrive, tout est visible après 2,5 s.
      setTimeout(() => {
        document.querySelectorAll('.fade-up:not(.is-visible)').forEach((el) => el.classList.add('is-visible'));
      }, 2500);

      // Parallaxe très légère (max 24px), désactivée si mouvement réduit.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const parallaxEls = document.querySelectorAll<HTMLElement>('.parallax');
      if (parallaxEls.length && !reduced && window.innerWidth > 768) {
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            const y = Math.min(window.scrollY * 0.08, 24);
            parallaxEls.forEach((el) => (el.style.transform = `translateY(${y}px)`));
            ticking = false;
          });
        }, { passive: true });
      }
    </script>
  </body>
</html>
