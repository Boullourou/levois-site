---
import { site } from '../config/site';
import Analytics from '../components/Analytics.astro';
import '../styles/public-base.css';
import '../styles/levois.css';
import '../styles/editorial.css';
import '../styles/plan-vivant.css';
import '../styles/v7.css';
import '../styles/v7-production.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { homeV7?:boolean; title:string; description?:string; image?:string; noindex?:boolean; headerTransparent?:boolean; homeV2?:boolean; designContract?:string }
const {title,description=site.description,image='/assets/levois-partage.jpg',noindex=false,homeV7=false}=Astro.props;
const path=Astro.url.pathname.replace(/\/$/,'')||'/';
const links=[{href:'/ma-recherche',label:'Acheter'},{href:'/situer-ma-vente',label:'Vendre'},{href:'/vendre-et-acheter',label:'Vendre et acheter'},{href:'/votre-rue',label:'Repères locaux'}];
---
<!doctype html>
<html lang="fr"><head>
<script is:inline>document.documentElement.classList.add("js");</script>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="color-scheme" content="light"/>
{(noindex||['/composants','/404','/situer-ma-vente/resultat','/lecture','/reprendre'].includes(path))&&<meta name="robots" content="noindex,nofollow"/>}
<title>{title==='Accueil'?'LEVOIS · Des décisions immobilières plus claires':title+' · LEVOIS'}</title>
<meta name="theme-color" content="#102635"/><meta name="description" content={description}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="canonical" href={site.url+Astro.url.pathname}/>
<link rel="preload" href="/v7/asset-02.woff" as="font" type="font/woff" crossorigin/><link rel="preload" href="/v7/asset-01.woff" as="font" type="font/woff" crossorigin/>
<meta property="og:title" content={title+' · LEVOIS'}/><meta property="og:description" content={description}/><meta property="og:image" content={site.url+image}/><meta property="og:locale" content="fr_FR"/><meta property="og:type" content="website"/>
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'RealEstateAgent',name:'LEVOIS',url:site.url,email:site.email,telephone:site.phone,founder:{'@type':'Person',name:site.mouaad.nom},areaServed:site.communes.map(name=>({'@type':'City',name}))})}/>
</head><body class:list={['levois-v7',homeV7?'v7-homepage':'reperes-shell plan-vivant v7-inner',{'rp-territoire':path==='/votre-rue'}]}>
<a class="lv-skip" href="#contenu">Aller au contenu</a>
<Header transparent={homeV7}/>
<main id="contenu" tabindex="-1"><slot/></main>
<Footer flush={homeV7}/>
<Analytics/>
<script>
import '../scripts/public-forms';
import '../scripts/experience-entry';
</script>
</body></html>
