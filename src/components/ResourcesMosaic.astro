---
/**
 * Ressources — mosaïque éditoriale (tailles variables selon l'importance).
 * Réponse courte immédiatement visible, bénéfice concret, durée réelle.
 * Interaction de survol sobre ; aucune animation nécessaire pour comprendre.
 */
import { resources } from '../data/resources';
import { resourceContents } from '../data/resourceContent';

const shortFor = (id: string) => resourceContents.find((c) => c.id === id)?.reponseCourte ?? '';
// Tailles de la mosaïque (indices) : la 1re en vedette, une seconde mise en avant.
const featured = new Set([0]);
const wide = new Set([3]);
---

<section class="py-section md:py-section-md" aria-labelledby="ressources-titre">
  <div class="max-w-page mx-auto px-edge md:px-edge-md">
    <div class="max-w-xl mb-10 fade-up">
      <p class="eyebrow mb-4">Ressources gratuites</p>
      <h2 id="ressources-titre" class="text-display text-encre">Comprendre avant d’ajuster.</h2>
      <p class="font-sans text-body-lg text-brun mt-4">
        Six ressources construites autour des questions réelles des propriétaires.
        Sans inscription, sans contrepartie.
      </p>
    </div>

    <div class="mosaic">
      {resources.map((r, i) => (
        <a
          href={`/ressources/${r.slug}`}
          class={`res-card ${featured.has(i) ? 'res-featured' : ''} ${wide.has(i) ? 'res-wide' : ''} fade-up`}
        >
          <div class="res-top">
            <p class="res-question">{r.question}</p>
            <h3 class="res-titre">{r.titre}</h3>
            {featured.has(i) && <p class="res-short">{shortFor(r.id)}</p>}
            {!featured.has(i) && <p class="res-benefice">{r.benefice}</p>}
          </div>
          <div class="res-foot">
            <span class="res-duree">{r.duree}</span>
            <span class="res-cta">{r.cta}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .mosaic { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 640px) { .mosaic { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .mosaic { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } }

  .res-card {
    display: flex; flex-direction: column; justify-content: space-between;
    background: #FFFFFF; border: 1px solid #C9CEC8; border-radius: 0;
    padding: 1.5rem; min-height: 220px;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .res-card:hover { border-color: #243CFF; background: #F2F5EF; transform: translateY(-2px); }

  /* Vedette : occupe 2 colonnes et 2 rangées sur desktop, fond teinté */
  @media (min-width: 1024px) {
    .res-featured { grid-column: span 2; grid-row: span 2; background: #F2F5EF; border-color: #C9CEC8; }
    .res-wide { grid-column: span 2; }
  }
  .res-featured .res-titre { font-size: clamp(1.6rem, 3vw, 2.2rem); }

  .res-question { font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.92rem; color: #243CFF; margin-bottom: 0.6rem; }
  .res-titre { font-family: 'Public Sans', system-ui, sans-serif; font-weight: 700; font-size: 1.35rem; line-height: 1.15; color: #111522; margin-bottom: 0.6rem; }
  .res-short { font-family: 'Public Sans', system-ui, sans-serif; font-size: 1.02rem; line-height: 1.6; color: #202635; max-width: 46ch; }
  .res-benefice { font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.96rem; line-height: 1.55; color: #58615B; }
  .res-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 1.5rem; }
  .res-duree { font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.85rem; color: #58615B; }
  .res-cta { font-family: 'Public Sans', system-ui, sans-serif; font-weight: 600; font-size: 0.95rem; color: #243CFF; display: inline-flex; align-items: center; gap: 0.4rem; }

  @media (prefers-reduced-motion: reduce) { .res-card { transition: none; } .res-card:hover { transform: none; } }
</style>
