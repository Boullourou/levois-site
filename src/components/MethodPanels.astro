---
/**
 * Le Système des Écarts — cinq panneaux éditoriaux distincts.
 *
 * Volontairement différent du sélecteur de situations : ici, pile verticale
 * de grands panneaux pleine largeur, mise en page alternée (image gauche /
 * droite / bande), et progression chromatique papier → sable → argile →
 * cuivre → encre. Un bandeau d'index montre d'emblée les cinq noms.
 * Aucun contenu n'est masqué derrière une animation ; le sens ne dépend
 * pas du mouvement.
 */
import ResponsiveImage from './ResponsiveImage.astro';

const etapes = [
  {
    n: '01', nom: 'Comprendre', slot: 'methode-comprendre', layout: 'image-droite',
    bg: '#F2F5EF', ink: '#111522', sub: '#58615B', accent: '#243CFF', dot: '#C9CEC8',
    resume: 'Distinguer ce qui est observé de ce qui est supposé.',
    texte: 'Un fait : « l’annonce reçoit des vues mais pas de contacts ». Une supposition : « le prix est trop élevé ». La méthode commence par séparer les deux — parce que toutes les mauvaises décisions naissent de leur confusion.',
  },
  {
    n: '02', nom: 'Aligner', slot: 'methode-aligner', layout: 'image-gauche',
    bg: '#FFFFFF', ink: '#111522', sub: '#58615B', accent: '#243CFF', dot: '#C9CEC8',
    resume: 'Faire coïncider le projet, le calendrier et les contraintes réelles.',
    texte: 'Une vente sert un projet de vie. Quand le projet est flou ou que le calendrier a changé, aucun réglage d’annonce ne compense. L’alignement précède le positionnement.',
  },
  {
    n: '03', nom: 'Positionner', slot: 'methode-positionner', layout: 'image-bande',
    bg: '#C9CEC8', ink: '#111522', sub: '#202635', accent: '#243CFF', dot: '#58615B',
    resume: 'Présenter le bien face aux alternatives que l’acheteur compare.',
    texte: 'Les acheteurs voient votre annonce entre cinq et huit autres, au même budget, au même moment. C’est cette comparaison réelle qui définit la position — jamais une moyenne abstraite.',
  },
  {
    n: '04', nom: 'Piloter', slot: 'methode-piloter', layout: 'image-gauche-portrait',
    bg: '#243CFF', ink: '#F2F5EF', sub: 'rgba(242,245,239,0.82)', accent: '#D7FF42', dot: '#202635',
    resume: 'Modifier un levier à la fois et lire les réactions.',
    texte: 'Changer le prix, les photos et le texte en même temps, c’est renoncer à comprendre. Le pilotage, c’est la discipline du levier unique : un changement, une période d’observation, une lecture.',
  },
  {
    n: '05', nom: 'Apprendre', slot: 'methode-apprendre', layout: 'image-droite-portrait',
    bg: '#111522', ink: '#F2F5EF', sub: 'rgba(242,245,239,0.75)', accent: '#D7FF42', dot: '#58615B',
    resume: 'Utiliser les signaux pour décider sans précipitation.',
    texte: 'Chaque période d’observation produit un enseignement — même le silence. La décision suivante se construit sur ces acquis, pas sur l’inquiétude du moment ni sur l’avis le plus fort de l’entourage.',
  },
];
---

<section id="methode" class="py-section md:py-section-md" aria-labelledby="methode-titre">
  <div class="max-w-page mx-auto px-edge md:px-edge-md">
    <div class="md:flex items-end justify-between gap-10 mb-8 fade-up">
      <div class="max-w-xl">
        <p class="eyebrow mb-4">La méthode</p>
        <h2 id="methode-titre" class="text-display text-encre">Le Système des Écarts</h2>
        <p class="font-sans text-body-lg text-brun mt-4">
          Cinq temps pour passer de l’impression au signal, puis du signal à la décision.
          Une progression — pas une recette automatique.
        </p>
      </div>
      <a href="/methode" class="btn-secondaire mt-6 md:mt-0 shrink-0">Page complète de la méthode</a>
    </div>

  </div>

  <!-- Les cinq panneaux -->
  <div class="max-w-page mx-auto px-edge md:px-edge-md mt-10 md:mt-14 space-y-4 md:space-y-5">
    {etapes.map((e) => (
      <article
        id={`etape-${e.n}`}
        class={`method-panel ${e.layout}`}
        style={`--bg:${e.bg};--ink:${e.ink};--sub:${e.sub};--accent:${e.accent};`}
      >
        <div class="method-media">
          <ResponsiveImage slot={e.slot} ratio="none" sizes="(min-width:768px) 44vw, 100vw" class="method-img" />
        </div>
        <div class="method-copy">
          <p class="method-n">{e.n} — Temps {e.n.replace('0', '')}</p>
          <h3 class="method-nom">{e.nom}</h3>
          <p class="method-resume">{e.resume}</p>
          <p class="method-texte">{e.texte}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  /* Panneaux */
  .method-panel {
    background: var(--bg); color: var(--ink);
    border-radius: 0; overflow: hidden;
    display: grid; grid-template-columns: 1fr;
  }
  .method-media { position: relative; min-height: 240px; }
  :global(.method-img) { width: 100%; height: 100%; min-height: 240px; }
  :global(.method-media .ri) { height: 100%; }
  .method-copy { padding: 2rem 1.5rem 2.25rem; display: flex; flex-direction: column; justify-content: center; }
  .method-n { font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.78rem; letter-spacing: 0.14em; color: var(--accent); font-weight: 600; margin-bottom: 0.9rem; text-transform: uppercase; }
  .method-nom { font-family: 'Public Sans', system-ui, sans-serif; font-weight: 700; font-size: clamp(1.9rem, 4vw, 2.8rem); line-height: 1.05; color: var(--ink); margin-bottom: 0.9rem; }
  .method-resume { font-family: 'Public Sans', system-ui, sans-serif; font-style: normal; font-weight: 600; font-size: 1.15rem; line-height: 1.4; color: var(--ink); opacity: 0.92; margin-bottom: 1rem; }
  .method-texte { font-family: 'Public Sans', system-ui, sans-serif; font-size: 1.02rem; line-height: 1.6; color: var(--sub); max-width: 42ch; }

  @media (min-width: 768px) {
    .method-panel { grid-template-columns: 44% 56%; align-items: stretch; min-height: 400px; }
    .method-copy { padding: 3rem 3.25rem; }
    .method-media { min-height: 400px; }
    :global(.method-img) { min-height: 400px; }

    .image-gauche .method-media, .image-gauche-portrait .method-media { order: 0; }
    .image-gauche .method-copy, .image-gauche-portrait .method-copy { order: 1; }
    .image-droite .method-media, .image-droite-portrait .method-media { order: 1; }
    .image-droite .method-copy, .image-droite-portrait .method-copy { order: 0; }

    /* Bande fine (Positionner) : image en haut pleine largeur, texte dessous */
    .image-bande { grid-template-columns: 1fr; }
    .image-bande .method-media { min-height: 260px; }
    .image-bande :global(.method-img) { min-height: 260px; }
    .image-bande .method-copy { padding-top: 2rem; }

    /* Portraits (Piloter/Apprendre) : colonne image plus étroite pour ne pas sur-zoomer */
    .image-gauche-portrait { grid-template-columns: 34% 66%; }
    .image-droite-portrait { grid-template-columns: 66% 34%; }
  }
</style>
