---
/**
 * Prototype inactif conservé par le snapshot du 17 août 2026.
 *
 * Ce composant n'est importé par aucune page. Ne pas l'activer sans une revue
 * produit et design explicite face au WorldGateway actuellement utilisé.
 */
import ResponsiveImage from '../ResponsiveImage.astro';

const routes = [
  {
    journey: 'buyer',
    href: '/ma-recherche',
    label: 'Je veux acheter',
    action: 'Clarifier avant de visiter',
    className: 'route-buyer',
  },
  {
    journey: 'seller_future',
    href: '/situer-ma-vente',
    label: 'Je possède un bien',
    action: 'Anticiper avant d’avoir à décider',
    className: 'route-future',
  },
  {
    journey: 'listing_live',
    href: '/audit-annonce',
    label: 'Mon annonce est en ligne',
    action: 'Comprendre les signaux de ma vente',
    className: 'route-live',
  },
];
---

<section class="decision-hero" id="situations" aria-labelledby="decision-title">
  <div class="decision-copy">
    <h1 id="decision-title">Une recherche immobilière se clarifie avant la visite.</h1>
    <p>
      Secteur, budget, surface, priorités&nbsp;: le site vous donne une première
      lecture utile avant tout contact. Les parcours vendeurs restent disponibles
      si votre situation est de l’autre côté du marché.
    </p>
    <a class="territory-link" href="#repere-local">Lèves · Chartres · bassin chartrain</a>
  </div>

  <figure class="decision-media">
    <ResponsiveImage
      slot="hero-chartres-evidence"
      ratio="none"
      sizes="(min-width: 900px) 48vw, 100vw"
      class="decision-photo"
      priority={true}
    />
    <figcaption>
      <span>Une lecture locale avant toute proposition.</span>
      <details>
        <summary>Crédit photo</summary>
        <small>
          <a href="https://commons.wikimedia.org/wiki/File:Chartres_Notre-Dame_DJI_0377.jpg" rel="license noopener noreferrer">Ludvig14 · Wikimedia Commons</a>
          · <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.fr" rel="license noopener noreferrer">CC BY-SA 4.0</a>
        </small>
      </details>
    </figcaption>
  </figure>

  <div class="decision-question">
    <p>Quel parcours voulez-vous ouvrir&nbsp;?</p>
    <span>Première lecture gratuite. Aucune coordonnée demandée au départ.</span>
  </div>

  <nav class="decision-routes" aria-label="Choisir ma situation">
    {routes.map((route) => (
      <a class:list={['decision-route', route.className]} href={route.href} data-journey={route.journey}>
        <span>
          <strong>{route.label}</strong>
          <small>{route.action}</small>
        </span>
        <i aria-hidden="true"></i>
      </a>
    ))}
  </nav>
</section>

<style>
  .decision-hero {
    --paper: #f2f5ef;
    --ink: #111522;
    --blue: #243cff;
    --lime: #d7ff42;
    min-height: calc(100svh - 78px);
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(420px, .92fr);
    grid-template-rows: minmax(430px, 1fr) auto auto;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Public Sans', system-ui, sans-serif;
  }

  .decision-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(58px, 7vw, 110px) clamp(28px, 6vw, 88px);
  }
  .decision-copy h1 {
    max-width: 780px;
    margin: 0;
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(56px, 6.2vw, 96px);
    font-weight: 400;
    line-height: .91;
    letter-spacing: -.035em;
    text-wrap: balance;
  }
  .decision-copy > p {
    max-width: 640px;
    margin: 34px 0 0;
    font-size: clamp(18px, 1.55vw, 22px);
    line-height: 1.55;
  }
  .territory-link {
    width: max-content;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    margin-top: 24px;
    color: #58615b;
    font-size: 12px;
    text-underline-offset: 5px;
  }
  .territory-link:hover { color: var(--blue); }

  .decision-media {
    position: relative;
    min-width: 0;
    min-height: 430px;
    margin: 0;
    overflow: hidden;
    background: var(--ink);
  }
  :global(.decision-photo) { width: 100%; height: 100%; }
  :global(.decision-photo img) {
    filter: saturate(.76) contrast(1.05);
    transition: filter .5s cubic-bezier(.16, 1, .3, 1), transform .7s cubic-bezier(.16, 1, .3, 1);
  }
  .decision-media:hover :global(.decision-photo img) { filter: grayscale(1) contrast(1.08); transform: scale(1.015); }
  .decision-media figcaption {
    position: absolute;
    inset: auto 0 0;
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 12px 20px;
    background: rgba(17, 21, 34, .9);
    color: var(--paper);
    font-size: 12px;
    line-height: 1.4;
  }
  .decision-media details { position: relative; text-align: right; }
  .decision-media summary { cursor: pointer; text-decoration: underline; text-underline-offset: 4px; }
  .decision-media details small {
    position: absolute;
    right: 0;
    bottom: calc(100% + 12px);
    width: min(340px, 80vw);
    padding: 12px;
    background: var(--ink);
    color: var(--paper);
    text-align: left;
  }

  .decision-question {
    grid-column: 1 / -1;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    padding: 26px clamp(28px, 6vw, 88px) 20px;
    border-top: 1px solid var(--ink);
  }
  .decision-question p { margin: 0; font-size: clamp(28px, 2.7vw, 42px); font-weight: 800; letter-spacing: -.025em; }
  .decision-question span { max-width: 360px; color: #58615b; font-size: 12px; line-height: 1.45; text-align: right; }

  .decision-routes { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .decision-route {
    min-height: 116px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    padding: 22px clamp(22px, 3vw, 44px);
    border-top: 1px solid var(--ink);
    border-right: 1px solid var(--ink);
    text-decoration: none;
    transition: background-color .2s ease-out, color .2s ease-out;
  }
  .decision-route:last-child { border-right: 0; }
  .decision-route span { display: grid; gap: 7px; }
  .decision-route strong { font-size: clamp(18px, 1.7vw, 22px); line-height: 1.1; }
  .decision-route small { font-size: 12px; line-height: 1.35; }
  .decision-route i { position: relative; width: 34px; height: 14px; flex: 0 0 34px; animation: decision-cue 3s cubic-bezier(.16,1,.3,1) infinite; }
  .decision-route i::before { content: ''; position: absolute; inset: 6px 2px auto 0; height: 2px; background: currentColor; }
  .decision-route i::after { content: ''; position: absolute; right: 1px; top: 2px; width: 9px; height: 9px; border-top: 2px solid currentColor; border-right: 2px solid currentColor; transform: rotate(45deg); }
  .route-buyer { background: var(--ink); color: var(--lime); }
  .route-buyer:hover { background: var(--lime); color: var(--ink); }
  .route-future { background: var(--paper); color: var(--ink); }
  .route-future:hover { background: var(--lime); }
  .route-live { background: var(--blue); color: var(--paper); }
  .route-live:hover { background: var(--ink); color: var(--lime); }
  .decision-route:focus-visible { outline: 3px solid var(--lime); outline-offset: -7px; }

  @keyframes decision-cue {
    0%, 72%, 100% { transform: translateX(0); }
    80% { transform: translateX(7px); }
    88% { transform: translateX(2px); }
    94% { transform: translateX(7px); }
  }

  @media (max-width: 980px) {
    .decision-hero { min-height: auto; grid-template-columns: 1fr; grid-template-rows: auto; }
    .decision-copy { min-height: 520px; order: 1; }
    .decision-question { order: 2; }
    .decision-routes { order: 3; }
    .decision-media { order: 4; }
    .decision-media { min-height: 520px; }
    .decision-question, .decision-routes { grid-column: auto; }
  }
  @media (max-width: 720px) {
    .decision-copy { min-height: auto; padding: 48px 20px 40px; }
    .decision-copy h1 { font-size: clamp(56px, 15vw, 76px); }
    .decision-copy > p { margin-top: 28px; font-size: 18px; }
    .decision-media { min-height: 400px; }
    .decision-question { align-items: start; flex-direction: column; padding: 34px 20px 22px; }
    .decision-question span { text-align: left; }
    .decision-routes { grid-template-columns: 1fr; }
    .decision-route { min-height: 98px; border-right: 0; padding: 20px; }
    .decision-route strong { font-size: 22px; }
    .decision-media figcaption { align-items: flex-start; flex-direction: column; gap: 7px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.decision-photo img), .decision-route, .decision-route i { animation: none; transition: none; transform: none; }
  }
</style>
