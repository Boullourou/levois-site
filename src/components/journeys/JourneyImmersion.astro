---
interface Props {
  world: 'anticipate' | 'selling' | 'buying';
  title: string;
  text: string;
  action: string;
  target: string;
}
const { world, title, text, action, target } = Astro.props;
---

<section class:list={['journey-immersion', `journey-immersion--${world}`]} aria-labelledby={`journey-${world}`}>
  <div class="journey-visual" aria-hidden="true">
    {world === 'anticipate' && (
      <div class="future-line">
        <span class="future-horizon"></span>
        <i></i><i></i><i></i>
        <b>aujourd’hui</b><b>si la vie change</b><b>prêt à décider</b>
      </div>
    )}
    {world === 'selling' && (
      <div class="signal-field">
        <span class="signal-scan"></span>
        <i style="--h:34%"></i><i style="--h:72%"></i><i style="--h:48%"></i><i style="--h:86%"></i><i style="--h:57%"></i>
        <b>vues</b><b>contacts</b><b>visites</b>
      </div>
    )}
    {world === 'buying' && (
      <div class="choice-map">
        <span class="choice-route"></span>
        <i class="choice-node choice-node--a"></i>
        <i class="choice-node choice-node--b"></i>
        <i class="choice-node choice-node--c"></i>
        <b>budget</b><b>priorités</b><b>bon choix</b>
      </div>
    )}
  </div>
  <div class="journey-copy">
    <h1 id={`journey-${world}`}>{title}</h1>
    <p>{text}</p>
    <a href={target}>{action}<i aria-hidden="true"></i></a>
  </div>
</section>

<style>
  .journey-immersion { --world:#2a6ff5; --accent:#d7ff42; position:relative; min-height:calc(100svh - var(--site-header-h)); display:flex; align-items:flex-end; overflow:hidden; isolation:isolate; padding:clamp(90px,14vh,170px) clamp(22px,7vw,110px) clamp(70px,10vh,120px); color:white; background:#102d5c; }
  .journey-immersion--selling { --world:#243cff; --accent:#d7ff42; background:#071329; }
  .journey-immersion--buying { --world:#f56a5a; --accent:#fff6e8; background:#6f2524; }
  .journey-immersion::before { content:''; position:absolute; z-index:-2; width:min(78vw,1100px); aspect-ratio:1; right:-14vw; top:-26vw; border-radius:48% 52% 42% 58%; background:var(--world); animation:journey-morph 11s ease-in-out infinite; }
  .journey-immersion::after { content:''; position:absolute; z-index:-1; inset:0; background:linear-gradient(90deg,rgba(3,10,25,.78) 0%,rgba(3,10,25,.18) 64%,transparent); }
  .journey-copy { position:relative; z-index:2; max-width:1080px; animation:journey-enter .9s cubic-bezier(.16,1,.3,1) both; }
  .journey-copy h1 { max-width:980px; margin:0; font-family:'Bricolage Grotesque','Public Sans',sans-serif; font-size:clamp(64px,9vw,144px); font-weight:740; line-height:.94; letter-spacing:-.04em; text-wrap:balance; }
  .journey-copy p { max-width:690px; margin:clamp(26px,4vh,44px) 0 0; font-size:clamp(18px,1.7vw,24px); line-height:1.5; }
  .journey-copy a { display:inline-flex; align-items:center; gap:18px; margin-top:34px; padding:16px 22px; border-radius:999px; background:var(--accent); color:#0b1730; font-weight:850; text-decoration:none; transition:transform .25s ease; }
  .journey-copy a:hover { transform:translateY(-4px); }
  .journey-copy i { position:relative; width:31px; height:12px; }
  .journey-copy i::before { content:''; position:absolute; left:0; top:5px; width:29px; height:2px; background:currentColor; }
  .journey-copy i::after { content:''; position:absolute; right:0; top:1px; width:9px; height:9px; border:solid currentColor; border-width:2px 2px 0 0; transform:rotate(45deg); }
  .journey-visual { position:absolute; z-index:1; inset:0; pointer-events:none; }
  .future-line { position:absolute; width:min(54vw,760px); height:270px; right:4vw; top:20vh; }
  .future-horizon { position:absolute; left:0; right:0; top:116px; height:3px; background:white; transform:rotate(-7deg); transform-origin:center; }
  .future-line i { position:absolute; z-index:2; width:18px; height:18px; border-radius:50%; background:var(--accent); box-shadow:0 0 0 10px rgba(215,255,66,.16); animation:journey-breathe 3s ease-in-out infinite; }
  .future-line i:nth-of-type(1){left:2%;top:142px}.future-line i:nth-of-type(2){left:49%;top:91px;animation-delay:.5s}.future-line i:nth-of-type(3){right:1%;top:37px;animation-delay:1s}
  .future-line b { position:absolute; top:190px; color:rgba(255,255,255,.72); font-size:12px; font-weight:700; }
  .future-line b:nth-of-type(1){left:0}.future-line b:nth-of-type(2){left:42%}.future-line b:nth-of-type(3){right:0}
  .signal-field { position:absolute; width:min(46vw,650px); height:440px; right:6vw; top:12vh; display:flex; align-items:flex-end; gap:clamp(14px,2vw,32px); padding:46px; border:1px solid rgba(255,255,255,.35); background:repeating-linear-gradient(to bottom,transparent 0 87px,rgba(255,255,255,.13) 88px); }
  .signal-field i { flex:1; height:var(--h); min-width:22px; background:var(--accent); transform-origin:bottom; animation:signal-rise 2.8s cubic-bezier(.16,1,.3,1) infinite alternate; }
  .signal-field i:nth-of-type(2){animation-delay:.25s}.signal-field i:nth-of-type(3){animation-delay:.5s}.signal-field i:nth-of-type(4){animation-delay:.75s}.signal-field i:nth-of-type(5){animation-delay:1s}
  .signal-scan { position:absolute; left:0; right:0; top:18%; height:2px; background:white; box-shadow:0 0 18px white; animation:signal-scan 4s ease-in-out infinite; }
  .signal-field b { position:absolute; bottom:15px; color:rgba(255,255,255,.7); font-size:11px; text-transform:uppercase; letter-spacing:.08em; }
  .signal-field b:nth-of-type(1){left:7%}.signal-field b:nth-of-type(2){left:43%}.signal-field b:nth-of-type(3){right:7%}
  .choice-map { position:absolute; width:min(52vw,720px); height:500px; right:2vw; top:10vh; border:1px dashed rgba(255,255,255,.52); border-radius:50%; animation:journey-spin 24s linear infinite; }
  .choice-route { position:absolute; left:8%; right:8%; top:49%; height:3px; background:white; transform:rotate(-15deg); }
  .choice-node { position:absolute; width:22px; height:22px; border-radius:50%; background:var(--accent); box-shadow:0 0 0 11px rgba(255,246,232,.16); }
  .choice-node--a{left:9%;top:61%}.choice-node--b{left:48%;top:42%}.choice-node--c{right:8%;top:22%}
  .choice-map b { position:absolute; color:white; font-size:13px; font-weight:780; }
  .choice-map b:nth-of-type(1){left:3%;top:72%}.choice-map b:nth-of-type(2){left:42%;top:52%}.choice-map b:nth-of-type(3){right:2%;top:13%}
  @keyframes journey-enter { from{opacity:0;transform:translateY(42px);filter:blur(10px)} to{opacity:1;transform:none;filter:none} }
  @keyframes journey-morph { 50%{border-radius:57% 43% 56% 44%;transform:rotate(3deg) scale(1.04)} }
  @keyframes journey-spin { to{transform:rotate(360deg)} }
  @keyframes journey-breathe { 50%{transform:scale(1.4)} }
  @keyframes signal-rise { from{transform:scaleY(.55)} to{transform:scaleY(1)} }
  @keyframes signal-scan { 50%{top:82%} }
  @media(max-width:720px){.journey-immersion{min-height:760px;padding:110px 20px 76px}.journey-immersion::before{width:130vw;right:-62vw;top:-10vw}.journey-copy h1{font-size:clamp(58px,17vw,88px);line-height:.97}.future-line{width:86vw;right:-20vw;top:17vh;opacity:.62}.signal-field{width:76vw;height:330px;right:-28vw;top:15vh;opacity:.64;padding:32px}.choice-map{width:92vw;height:92vw;right:-45vw;top:12vh;opacity:.68}}
  @media(prefers-reduced-motion:reduce){.journey-immersion::before,.future-line i,.signal-field i,.signal-scan,.choice-map,.journey-copy{animation:none}}
</style>
