---
/**
 * Les visages de LEVOIS — Mouaad puis Léa, deux fonctions distinctes.
 *
 * Mouaad : grande scène documentaire, ses deux images en léger décalage de
 * profondeur, texte sur son rôle d'interprète local et humain.
 * Léa : composition plus éditoriale et lumineuse (traitement graphique — pas
 * de photo dans le pack), orientée transmission et pédagogie.
 * Le personnage de la rue de Lèves n'apparaît jamais ici.
 */
import ResponsiveImage from './ResponsiveImage.astro';
import { site } from '../config/site';
---

<section class="py-section md:py-section-md" aria-labelledby="team-titre">
  <div class="max-w-page mx-auto px-edge md:px-edge-md">
    <h2 id="team-titre" class="sr-only">Les personnes derrière LEVOIS</h2>

    <!-- Mouaad — grande scène documentaire -->
    <div class="grid md:grid-cols-12 gap-8 md:gap-12 items-center mb-20 md:mb-28">
      <div class="md:col-span-6 order-1 fade-up">
        <div class="mouaad-stack">
          <div class="mouaad-main">
            <ResponsiveImage slot="mouaad-terrain" ratio="4/5" sizes="(min-width:768px) 42vw, 90vw" class="w-full h-full" />
          </div>
          <div class="mouaad-inset">
            <ResponsiveImage slot="mouaad-rdv" ratio="1/1" sizes="(min-width:768px) 20vw, 40vw" class="w-full h-full" rounded={false} />
          </div>
        </div>
      </div>
      <div class="md:col-span-6 order-2 fade-up">
        <p class="eyebrow mb-4">La continuité humaine</p>
        <h3 class="text-h2 text-encre mb-2">{site.mouaad.nom}</h3>
        <p class="font-sans text-brun mb-6">{site.mouaad.titre}</p>
        <div class="space-y-4 font-sans text-body-lg text-encre/85 leading-relaxed">
          <p>
            Mouaad est l’interprète local de LEVOIS : celui qui lit le marché du bassin chartrain
            au quotidien, applique la méthode sur votre bien précis, et traduit les signaux en
            décisions concrètes.
          </p>
          <p>
            Sa manière de travailler tient en quatre verbes — écouter, reformuler, comprendre,
            puis seulement décider. La lecture précède toujours la proposition.
          </p>
        </div>
        <p class="font-sans text-sm text-brun border-l-2 border-argile/60 pl-4 mt-6 mb-7">{site.mouaad.signature}</p>
        <a href="/mouaad" class="btn-secondaire">Faire connaissance</a>
      </div>
    </div>

    <!-- Léa — composition éditoriale lumineuse (graphique) -->
    <div class="lea-scene grid md:grid-cols-12 gap-8 md:gap-12 items-center fade-up">
      <div class="md:col-span-7 order-2 md:order-1">
        <p class="eyebrow mb-4">La voix des contenus</p>
        <h3 class="text-h2 text-encre mb-4">Léa</h3>
        <p class="font-sans text-body-lg text-encre/85 leading-relaxed max-w-lg mb-4">{site.lea.role}</p>
        <p class="font-sans text-[15px] text-brun leading-relaxed max-w-lg mb-7">
          Son rôle est éditorial : elle rend les signaux du marché simples à comprendre.
          Elle ne fixe pas de prix, n’estime pas et n’accompagne pas les ventes — c’est le métier de Mouaad.
        </p>
        <a href="/ressources" class="btn-secondaire">Découvrir les ressources</a>
      </div>
      <div class="md:col-span-5 order-1 md:order-2">
        <div class="lea-card" role="img" aria-label="Léa, la voix des contenus LEVOIS">
          <span class="lea-monogram">L</span>
          <div class="lea-lines" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <p class="lea-caption">Contenus &amp; pédagogie</p>
        </div>
      </div>
    </div>

    <p class="font-sans text-sm text-brun/80 text-center mt-14 fade-up">
      Mouaad exerce comme conseiller immobilier indépendant au sein du réseau SAFTI.
      LEVOIS est sa méthode de lecture, de pédagogie et d’accompagnement.
    </p>
  </div>
</section>

<style>
  .mouaad-stack { position: relative; }
  .mouaad-main { border-radius: 24px; overflow: hidden; box-shadow: 0 30px 60px -34px rgba(33,28,22,0.45); }
  .mouaad-inset {
    position: absolute; right: -0.5rem; bottom: -1.75rem; width: 42%;
    border-radius: 16px; overflow: hidden;
    box-shadow: 0 24px 48px -22px rgba(33,28,22,0.55);
    outline: 5px solid #F7F2EA;
    transition: transform 0.6s cubic-bezier(0.22,1,0.36,1);
  }
  @media (min-width: 768px) { .mouaad-stack:hover .mouaad-inset { transform: translateY(-6px); } }
  @media (max-width: 480px) { .mouaad-inset { width: 46%; bottom: -1.25rem; } }

  .lea-scene { background: linear-gradient(140deg, #FDFBF6 0%, #F5EAD9 100%); border: 1px solid #EDE2CF; border-radius: 28px; padding: 2rem 1.5rem; }
  @media (min-width: 768px) { .lea-scene { padding: 3rem; } }
  .lea-card {
    position: relative; aspect-ratio: 4/5; border-radius: 20px; overflow: hidden;
    background: radial-gradient(120% 90% at 25% 15%, #F3D9AE 0%, #E9C48C 45%, #D8A45E 100%);
    display: flex; flex-direction: column; justify-content: space-between; padding: 1.75rem;
  }
  .lea-monogram { font-family: 'Fraunces', serif; font-weight: 500; font-size: clamp(5rem, 16vw, 9rem); line-height: 0.8; color: rgba(58,40,20,0.82); }
  .lea-lines { display: flex; flex-direction: column; gap: 0.5rem; }
  .lea-lines span { height: 3px; border-radius: 3px; background: rgba(58,40,20,0.28); }
  .lea-lines span:nth-child(1) { width: 70%; }
  .lea-lines span:nth-child(2) { width: 45%; }
  .lea-lines span:nth-child(3) { width: 58%; }
  .lea-caption { font-family: 'Instrument Sans', sans-serif; font-size: 0.85rem; letter-spacing: 0.06em; color: rgba(58,40,20,0.72); }
</style>
