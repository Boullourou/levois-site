---
/**
 * La scène Mouaad — documentation et prise de parole LEVOIS.
 */
import ResponsiveImage from './ResponsiveImage.astro';
import { site } from '../config/site';
---

<section class="py-section md:py-section-md" aria-labelledby="team-titre">
  <div class="max-w-page mx-auto px-edge md:px-edge-md">
    <h2 id="team-titre" class="sr-only">La personne derrière LEVOIS</h2>

    <!-- Mouaad — grande scène documentaire -->
    <div class="grid md:grid-cols-12 gap-8 md:gap-12 items-center">
      <div class="md:col-span-6 order-1 fade-up">
        <div class="mouaad-stack">
          <div class="mouaad-main">
            <ResponsiveImage slot="mouaad-terrain" ratio="4/5" sizes="(min-width:768px) 42vw, 90vw" class="w-full h-full" />
          </div>
          <div class="mouaad-inset">
            <ResponsiveImage slot="mouaad-rdv" ratio="1/1" sizes="(min-width:768px) 20vw, 40vw" class="w-full h-full" rounded={false} />
          </div>
        </div>
      </div>
      <div class="md:col-span-6 order-2 fade-up">
        <p class="eyebrow mb-4">La continuité humaine</p>
        <h3 class="text-h2 text-encre mb-2">{site.mouaad.nom}</h3>
        <p class="font-sans text-brun mb-6">{site.mouaad.titre}</p>
        <div class="space-y-4 font-sans text-body-lg text-encre/85 leading-relaxed">
          <p>
            Mouaad est l'interprète local de LEVOIS : celui qui lit le marché du bassin chartrain
            au quotidien, applique la méthode sur votre bien précis, et traduit les signaux en
            décisions concrètes.
          </p>
          <p>
            Sa manière de travailler tient en quatre verbes — écouter, reformuler, comprendre,
            puis seulement décider. La lecture précède toujours la proposition.
          </p>
        </div>
        <p class="font-sans text-sm text-brun border-l-2 border-argile/60 pl-4 mt-6 mb-7">{site.mouaad.signature}</p>
        <a href="/mouaad" class="btn-secondaire">Faire connaissance</a>
      </div>
    </div>

    <p class="font-sans text-sm text-brun/80 text-center mt-14 fade-up">
      Mouaad exerce comme conseiller immobilier indépendant au sein du réseau SAFTI.
      LEVOIS est sa méthode de lecture, de pédagogie et d'accompagnement.
    </p>
  </div>
</section>

<style>
  .mouaad-stack { position: relative; }
  .mouaad-main { border-radius: 24px; overflow: hidden; box-shadow: 0 30px 60px -34px rgba(33,28,22,0.45); }
  .mouaad-inset {
    position: absolute; right: -0.5rem; bottom: -1.75rem; width: 42%;
    border-radius: 16px; overflow: hidden;
    box-shadow: 0 24px 48px -22px rgba(33,28,22,0.55);
    outline: 5px solid #F7F2EA;
    transition: transform 0.6s cubic-bezier(0.22,1,0.36,1);
  }
  @media (min-width: 768px) { .mouaad-stack:hover .mouaad-inset { transform: translateY(-6px); } }
  @media (max-width: 480px) { .mouaad-inset { width: 46%; bottom: -1.25rem; } }
</style>
