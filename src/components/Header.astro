---
export interface Props {
  transparent?: boolean;
  homeV2?: boolean;
}

const { transparent = false, homeV2 = false } = Astro.props;

const legacyLinks = [
  { href: '/#situations', label: 'Votre situation' },
  { href: '/methode', label: 'La méthode' },
  { href: '/ressources', label: 'Ressources' },
  { href: '/mouaad', label: 'Mouaad' },
];

const homeLinks = [
  { href: '/#marche', label: 'Marché local' },
  { href: '/ma-recherche', label: 'Acheter' },
  { href: '/situer-ma-vente', label: 'Vendre' },
  { href: '/audit-annonce', label: 'Audit annonce' },
  { href: '/methode', label: 'Méthode' },
  { href: '/ressources', label: 'Ressources' },
  { href: '/mouaad', label: 'Mouaad' },
];
---

{homeV2 ? (
  <header class="home-header" data-home-header>
    <a class="home-wordmark" href="/" aria-label="LEVOIS, retour à l’accueil">LEVOIS</a>
    <button
      class="home-menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="home-menu"
      aria-label="Ouvrir le menu"
      data-home-menu-button
    >
      <span>Menu</span><i aria-hidden="true"></i>
    </button>
    <nav class="home-nav" id="home-menu" aria-label="Navigation principale" data-home-menu>
      {homeLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <p class="home-territory">Lèves · Chartres<br /><span>bassin chartrain</span></p>
  </header>
) : (
  <header
    id="site-header"
    class:list={[
      'sticky top-0 z-50 transition-colors duration-300',
      transparent ? 'bg-papier/0' : 'bg-papier/95 backdrop-blur-sm border-b border-beige/60',
    ]}
    data-transparent={transparent ? 'true' : 'false'}
  >
    <div class="max-w-page mx-auto px-edge md:px-edge-md flex items-center justify-between h-16 md:h-[72px]">
      <a href="/" class="font-display text-xl md:text-2xl tracking-[0.14em] text-encre" aria-label="LEVOIS — retour à l’accueil">
        L&thinsp;E&thinsp;V&thinsp;O&thinsp;I&thinsp;S
      </a>

      <nav class="hidden md:flex items-center gap-7" aria-label="Navigation principale">
        {legacyLinks.map((link) => (
          <a href={link.href} class="font-sans text-[15px] text-encre/80 hover:text-argile transition-colors duration-200">
            {link.label}
          </a>
        ))}
        <a href="/situer-ma-vente" class="btn-primaire !py-2.5 !px-5 text-[15px]">Faire le point</a>
      </nav>

      <button
        id="menu-btn"
        class="md:hidden inline-flex items-center justify-center w-11 h-11 -mr-2 text-encre"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Ouvrir le menu"
      >
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path class="menu-open" d="M2 6h18M2 11h18M2 16h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <path class="menu-close hidden" d="M5 5l12 12M17 5L5 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div id="menu-mobile" class="hidden md:hidden bg-papier border-b border-beige">
      <nav class="px-edge py-4 flex flex-col gap-1" aria-label="Navigation mobile">
        {legacyLinks.map((link) => (
          <a href={link.href} class="font-sans text-lg text-encre py-3 border-b border-beige/60 last:border-0">
            {link.label}
          </a>
        ))}
        <a href="/situer-ma-vente" class="btn-primaire mt-3 w-full">Faire le point</a>
      </nav>
    </div>
  </header>
)}

{homeV2 && (
  <style>
    .home-header {
      --home-header-pad: clamp(22px, 5vw, 76px);
      box-sizing: border-box;
      width: 100%;
      position: sticky;
      z-index: 50;
      top: 0;
      min-height: var(--site-header-h);
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 0 var(--home-header-pad);
      border-bottom: 1px solid rgba(17, 21, 34, .18);
      background: rgba(242, 245, 239, .96);
      color: #111522;
      backdrop-filter: blur(12px);
      font-family: 'Public Sans', system-ui, sans-serif;
    }

    .home-wordmark {
      width: max-content;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      font-family: 'Archivo Black', sans-serif;
      font-size: clamp(24px, 2.2vw, 34px);
      letter-spacing: -.035em;
      text-decoration: none;
    }

    .home-nav { display: flex; align-items: center; gap: clamp(16px, 2.2vw, 34px); }
    .home-nav a {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      font-size: 14px;
      font-weight: 500;
      text-decoration-thickness: 1px;
      text-underline-offset: 5px;
    }
    .home-nav a:hover { text-decoration-line: underline; }

    .home-menu-button { display: none; }

    .home-territory {
      justify-self: end;
      margin: 0;
      color: #58615b;
      font-size: 12px;
      line-height: 1.35;
      text-align: right;
    }
    .home-territory span { color: #a84531; }

    @media (max-width: 980px) {
      .home-header {
        min-height: var(--site-header-h);
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 18px;
      }
      .home-wordmark { grid-column: 1; }
      .home-territory { display: none; }
      .home-menu-button {
        grid-column: 2;
        min-width: 82px;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 0 14px;
        border: 1px solid currentColor;
        border-radius: 0;
        background: transparent;
        color: inherit;
        font: 600 13px/1 'Public Sans', system-ui, sans-serif;
        text-transform: uppercase;
        letter-spacing: .04em;
      }
      .home-menu-button i,
      .home-menu-button i::before {
        width: 14px;
        height: 1px;
        display: block;
        background: currentColor;
        content: '';
        transition: transform .2s ease-out;
      }
      .home-menu-button i::before { transform: translateY(5px); }
      .home-menu-button[aria-expanded='true'] i { transform: rotate(45deg); }
      .home-menu-button[aria-expanded='true'] i::before { transform: rotate(90deg); }
      .home-nav {
        position: absolute;
        inset: 100% 0 auto;
        display: none;
        grid-template-columns: repeat(2, 1fr);
        gap: 0;
        padding: 0 var(--home-header-pad) 18px;
        border-bottom: 1px solid rgba(17, 21, 34, .22);
        background: #f2f5ef;
      }
      .home-nav[data-open='true'] { display: grid; }
      .home-nav a {
        min-height: 52px;
        justify-content: flex-start;
        border-bottom: 1px solid rgba(17, 21, 34, .16);
        font-size: 14px;
      }
      .home-nav a:nth-last-child(-n + 2) { border-bottom: 0; }
    }

    @media (max-width: 520px) {
      .home-header { --home-header-pad: 18px; }
      .home-wordmark { font-size: 25px; }
      .home-nav { grid-template-columns: 1fr; }
      .home-nav a:nth-last-child(2) { border-bottom: 1px solid rgba(17, 21, 34, .16); }
    }
  </style>
)}

{homeV2 && (
  <script>
    const homeMenuButton = document.querySelector('[data-home-menu-button]');
    const homeMenu = document.querySelector('[data-home-menu]');

    const closeHomeMenu = () => {
      homeMenuButton?.setAttribute('aria-expanded', 'false');
      homeMenuButton?.setAttribute('aria-label', 'Ouvrir le menu');
      homeMenu?.removeAttribute('data-open');
    };

    homeMenuButton?.addEventListener('click', () => {
      const willOpen = homeMenuButton.getAttribute('aria-expanded') !== 'true';
      homeMenuButton.setAttribute('aria-expanded', String(willOpen));
      homeMenuButton.setAttribute('aria-label', willOpen ? 'Fermer le menu' : 'Ouvrir le menu');
      if (willOpen) homeMenu?.setAttribute('data-open', 'true');
      else homeMenu?.removeAttribute('data-open');
    });

    homeMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeHomeMenu));
    window.addEventListener('resize', () => {
      if (window.innerWidth > 980) closeHomeMenu();
    });
  </script>
)}

{!homeV2 && (
  <script>
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('menu-mobile');
    const header = document.getElementById('site-header');

    btn?.addEventListener('click', () => {
      const open = menu?.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      btn.querySelector('.menu-open')?.classList.toggle('hidden', open);
      btn.querySelector('.menu-close')?.classList.toggle('hidden', !open);
      if (open) header?.classList.add('bg-papier', 'border-b', 'border-beige');
    });

    menu?.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn?.setAttribute('aria-expanded', 'false');
        btn?.querySelector('.menu-open')?.classList.remove('hidden');
        btn?.querySelector('.menu-close')?.classList.add('hidden');
      })
    );

    if (header?.dataset.transparent === 'true') {
      const solidify = () => {
        const solid = window.scrollY > 40;
        header.classList.toggle('bg-papier/95', solid);
        header.classList.toggle('backdrop-blur-sm', solid);
        header.classList.toggle('border-b', solid);
        header.classList.toggle('border-beige/60', solid);
      };
      window.addEventListener('scroll', solidify, { passive: true });
      solidify();
    }
  </script>
)}
