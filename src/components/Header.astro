---
export interface Props {
  transparent?: boolean;
  homeV2?: boolean;
}

const { transparent = false, homeV2 = false } = Astro.props;

const legacyLinks = [
  { href: '/#situations', label: 'Votre situation' },
  { href: '/methode', label: 'La méthode' },
  { href: '/ressources', label: 'Ressources' },
  { href: '/mouaad', label: 'Mouaad' },
];

const homeLinks = [
  { href: '/#methode', label: 'La méthode' },
  { href: '/#marche', label: 'Le marché' },
  { href: '/#mouaad', label: 'Mouaad' },
];
---

{homeV2 ? (
  <header class="home-header" data-home-header>
    <a class="home-wordmark" href="/" aria-label="LEVOIS, retour à l’accueil">LEVOIS</a>
    <nav class="home-nav" aria-label="Navigation principale">
      {homeLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <p class="home-territory">Lèves · Chartres<br /><span>bassin chartrain</span></p>
  </header>
) : (
  <header
    id="site-header"
    class:list={[
      'sticky top-0 z-50 transition-colors duration-300',
      transparent ? 'bg-papier/0' : 'bg-papier/95 backdrop-blur-sm border-b border-beige/60',
    ]}
    data-transparent={transparent ? 'true' : 'false'}
  >
    <div class="max-w-page mx-auto px-edge md:px-edge-md flex items-center justify-between h-16 md:h-[72px]">
      <a href="/" class="font-display text-xl md:text-2xl tracking-[0.14em] text-encre" aria-label="LEVOIS — retour à l’accueil">
        L&thinsp;E&thinsp;V&thinsp;O&thinsp;I&thinsp;S
      </a>

      <nav class="hidden md:flex items-center gap-7" aria-label="Navigation principale">
        {legacyLinks.map((link) => (
          <a href={link.href} class="font-sans text-[15px] text-encre/80 hover:text-argile transition-colors duration-200">
            {link.label}
          </a>
        ))}
        <a href="/situer-ma-vente" class="btn-primaire !py-2.5 !px-5 text-[15px]">Faire le point</a>
      </nav>

      <button
        id="menu-btn"
        class="md:hidden inline-flex items-center justify-center w-11 h-11 -mr-2 text-encre"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Ouvrir le menu"
      >
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path class="menu-open" d="M2 6h18M2 11h18M2 16h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <path class="menu-close hidden" d="M5 5l12 12M17 5L5 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div id="menu-mobile" class="hidden md:hidden bg-papier border-b border-beige">
      <nav class="px-edge py-4 flex flex-col gap-1" aria-label="Navigation mobile">
        {legacyLinks.map((link) => (
          <a href={link.href} class="font-sans text-lg text-encre py-3 border-b border-beige/60 last:border-0">
            {link.label}
          </a>
        ))}
        <a href="/situer-ma-vente" class="btn-primaire mt-3 w-full">Faire le point</a>
      </nav>
    </div>
  </header>
)}

{homeV2 && (
  <style>
    .home-header {
      --home-header-pad: clamp(22px, 5vw, 76px);
      position: sticky;
      z-index: 50;
      top: 0;
      min-height: 78px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 0 var(--home-header-pad);
      border-bottom: 1px solid rgba(17, 21, 34, .18);
      background: rgba(242, 245, 239, .96);
      color: #111522;
      backdrop-filter: blur(12px);
      font-family: 'Public Sans', system-ui, sans-serif;
    }

    .home-wordmark {
      width: max-content;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      font-family: 'Archivo Black', sans-serif;
      font-size: clamp(24px, 2.2vw, 34px);
      letter-spacing: -.035em;
      text-decoration: none;
    }

    .home-nav { display: flex; align-items: center; gap: clamp(22px, 3vw, 42px); }
    .home-nav a {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      font-size: 14px;
      font-weight: 500;
      text-decoration-thickness: 1px;
      text-underline-offset: 5px;
    }
    .home-nav a:hover { text-decoration-line: underline; }

    .home-territory {
      justify-self: end;
      margin: 0;
      color: #58615b;
      font-size: 12px;
      line-height: 1.35;
      text-align: right;
    }
    .home-territory span { color: #a84531; }

    @media (max-width: 980px) {
      .home-header {
        min-height: 104px;
        grid-template-columns: 1fr auto;
        grid-template-rows: 58px 46px;
        align-content: stretch;
      }
      .home-wordmark { grid-column: 1; grid-row: 1; }
      .home-territory { grid-column: 2; grid-row: 1; }
      .home-nav {
        grid-column: 1 / -1;
        grid-row: 2;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        margin: 0 calc(var(--home-header-pad) * -1);
        border-top: 1px solid rgba(17, 21, 34, .18);
      }
      .home-nav a { justify-content: center; font-size: 13px; }
    }
  </style>
)}

{!homeV2 && (
  <script>
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('menu-mobile');
    const header = document.getElementById('site-header');

    btn?.addEventListener('click', () => {
      const open = menu?.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      btn.querySelector('.menu-open')?.classList.toggle('hidden', open);
      btn.querySelector('.menu-close')?.classList.toggle('hidden', !open);
      if (open) header?.classList.add('bg-papier', 'border-b', 'border-beige');
    });

    menu?.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn?.setAttribute('aria-expanded', 'false');
        btn?.querySelector('.menu-open')?.classList.remove('hidden');
        btn?.querySelector('.menu-close')?.classList.add('hidden');
      })
    );

    if (header?.dataset.transparent === 'true') {
      const solidify = () => {
        const solid = window.scrollY > 40;
        header.classList.toggle('bg-papier/95', solid);
        header.classList.toggle('backdrop-blur-sm', solid);
        header.classList.toggle('border-b', solid);
        header.classList.toggle('border-beige/60', solid);
      };
      window.addEventListener('scroll', solidify, { passive: true });
      solidify();
    }
  </script>
)}
