---
export interface Props {
  transparent?: boolean;
  homeV2?: boolean;
}

const links = [
  { href: '/ma-recherche', label: 'Acheter' },
  { href: '/situer-ma-vente', label: 'Vendre' },
  { href: '/votre-rue', label: 'Ventes locales' },
  { href: '/ressources', label: 'Comprendre' },
  { href: '/contact', label: 'Mouaad' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="lv-header" data-lv-header>
  <a class="lv-wordmark" href="/" aria-label="LEVOIS, retour à l’accueil">LEVOIS</a>
  <button
    class="lv-menu"
    type="button"
    aria-expanded="false"
    aria-controls="lv-navigation"
    aria-label="Ouvrir le menu"
    data-lv-menu-button
  >
    <span>Menu</span><i aria-hidden="true"></i>
  </button>
  <nav class="lv-nav" id="lv-navigation" aria-label="Navigation principale" data-lv-navigation>
    {links.map((link) => (
      <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
  <p class="lv-territory">Lèves · Chartres<br />et alentours</p>
</header>

<script>
  const lvMenuButton = document.querySelector<HTMLButtonElement>('[data-lv-menu-button]');
  const lvNavigation = document.querySelector<HTMLElement>('[data-lv-navigation]');

  const closeLvMenu = () => {
    lvMenuButton?.setAttribute('aria-expanded', 'false');
    lvMenuButton?.setAttribute('aria-label', 'Ouvrir le menu');
    lvNavigation?.removeAttribute('data-open');
  };

  lvMenuButton?.addEventListener('click', () => {
    const open = lvMenuButton.getAttribute('aria-expanded') !== 'true';
    lvMenuButton.setAttribute('aria-expanded', String(open));
    lvMenuButton.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    if (open) lvNavigation?.setAttribute('data-open', 'true');
    else lvNavigation?.removeAttribute('data-open');
  });

  lvNavigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeLvMenu));
  window.addEventListener('resize', () => { if (window.innerWidth > 1080) closeLvMenu(); });
</script>
