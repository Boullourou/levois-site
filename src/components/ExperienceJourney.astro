---
import Layout from '../layouts/Layout.astro';
import {getDiagnosticJourney} from '../lib/experience/diagnostics';
import {createContext} from '../lib/experience/context';
import '../styles/diagnostics.css';
interface Props { project:'buyer'|'seller'|'transition'; title:string; description:string }
const {project,title,description}=Astro.props;
const journey=getDiagnosticJourney(project);
const question=journey.getQuestions(createContext(project))[0];
const introductions = {
  seller: {title:'Votre vente avance-t-elle dans la bonne direction ?', text:'Prix incertain, peu de contacts ou visites sans offre : identifiez le point à éclaircir avant de changer de stratégie.'},
  buyer: {title:'Cadrer votre recherche avant de vous engager.', text:'Budget, secteur ou compromis sur le logement : donnez un ordre clair à vos priorités avant la prochaine visite.'},
  transition: {title:'Vendre et acheter : mettez vos deux calendriers d’accord.', text:'Crédit relais, logement provisoire ou dates à coordonner : identifiez la décision à préparer en premier.'},
};
const introduction = introductions[project];
---
<Layout title={title} description={description}>
<div class="lv-journey" data-journey={project}>
<div class="lv-journey-head"><a href="/">Accueil</a><span>5 questions · Votre analyse par e-mail</span></div>
<header class="lv-diagnostic-intro"><h1>{introduction.title}</h1><p>{introduction.text}</p><p class="lv-note">Répondez aux cinq questions, puis indiquez votre prénom et votre e-mail pour recevoir votre synthèse d’arbitrage.</p></header>
<div class="lv-journey-grid">
<div class="lv-question-panel" data-question-panel>
<div class="lv-progress-label"><span>{question.sequenceTitle}</span><span>{question.sequence} sur {journey.sequences.length}</span></div>
<div class="lv-progress" role="progressbar" aria-label="Séquence du projet" aria-valuemin="0" aria-valuemax={journey.sequences.length} aria-valuenow={question.sequence}><i style={'width:'+(question.sequence/journey.sequences.length*100)+'%'}></i></div>
<h2 tabindex="-1" data-question-title>{question.title}</h2>{question.help&&<p class="lv-intro">{question.help}</p>}
<form class="lv-question-form"><div class="lv-choices">{question.choices?.map(o=><label class="lv-choice"><input type={question.type==='multiple'?'checkbox':'radio'} name="answer" value={o.value}/><span>{o.label}{o.detail&&<small>{o.detail}</small>}</span></label>)}</div><div class="lv-question-actions"><button class="lv-button" type="submit">Continuer</button></div></form>
<noscript><p>Ce parcours utilise JavaScript pour relier vos réponses à leurs conséquences. Vous pouvez lire <a href="/methode/">la méthode</a>, utiliser les <a href="/ressources/">ressources en libre accès</a> ou <a href="/contact/">écrire à Mouaad</a>.</p></noscript></div>
<aside class="lv-journey-side" data-journey-side aria-label="Votre progression">
<p class="lv-journey-side-title">Un point clair.<br/>Un prochain pas.</p>
<ol class="lv-sequences">{journey.sequences.map((s,i)=><li aria-current={i===0?'step':undefined}>{s}</li>)}</ol>
<p class="lv-note">Dans votre analyse : le constat, l’angle mort à surveiller et une action utile cette semaine.</p>
</aside>
</div>
<p data-storage-warning class="lv-limit" hidden>La sauvegarde de session est bloquée. Vous pouvez poursuivre et demander votre analyse par e-mail avant de quitter cette page.</p>
</div>
<script>import '../scripts/experience-journey';</script>
</Layout>
