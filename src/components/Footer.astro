---
import { site } from '../config/site';
interface Props { homeV2?: boolean; flush?: boolean }
const { flush = false } = Astro.props;
---
<footer class:list={['v7-footer', { 'v7-footer--flush': flush }]}>
  <div class="v7-footer-inner">
    <div class="v7-footer-top">
        <a class="v7-logo" href="/">LEVOIS</a>
        <p>Conseil immobilier indépendant.<br /><span>Lèves &amp; Chartres Métropole.</span></p>
        <a class="v7-footer-contact" href="/contact/">Écrire à Mouaad <span aria-hidden="true">→</span></a>
    </div>
    <nav class="v7-footer-links" aria-label="Navigation de pied de page">
      <a href="/situer-ma-vente/">Vendre</a>
      <a href="/ma-recherche/">Acheter</a>
      <a href="/vendre-et-acheter/">Vendre & acheter</a>
      <a href="/votre-rue/">Ventes réelles de votre rue (DVF)</a>
      <a href="/estimation-immobiliere-chartres/">Estimation immobilière Chartres</a>
      <a href="/methode/">La méthode</a>
      <a href="/mouaad/">Mouaad</a>
      <a href="/honoraires/">Barème d'honoraires</a>
      <a href="/contact/">Contact</a>
      <a href="/recommander/">Recommander un proche</a>
      <a href="/rejoindre/">Découvrir le métier SAFTI</a>
    </nav>
    <div class="v7-footer-bottom">
      <p>Mouaad Boullourou · Conseiller immobilier indépendant SAFTI (RSAC Chartres n° 824 194 419)<br /><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <nav aria-label="Informations légales et confidentialité">
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/mentions-legales/#credits-photo">Crédits photo</a>
        <a href="/confidentialite/">Confidentialité</a>
        <button type="button" data-analytics-settings>Choix de confidentialité</button>
        <a href="/honoraires/">Barème d'honoraires</a>
      </nav>
    </div>
    <p class="v7-copyright">© {new Date().getFullYear()} LEVOIS · Mouaad Boullourou.</p>
  </div>
</footer>
