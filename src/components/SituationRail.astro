---
/**
 * Sélecteur des cinq situations — grand rail éditorial horizontal.
 *
 * Ce n'est plus une grille de cinq cartes identiques : cinq grands panneaux
 * à progression chromatique (ivoire/sauge → sable/ambre → argile → cuivre →
 * encre/aubergine), manipulables au glisser, à la molette horizontale et au
 * clic. Sur mobile : glissement natif avec scroll-snap, une carte visible et
 * un aperçu de la suivante. Compteur « 1 sur 5 » et boutons précédent/suivant
 * pour l'accessibilité. Chaque panneau est un lien direct vers le diagnostic.
 */
import ResponsiveImage from './ResponsiveImage.astro';
import { situations } from '../data/situations';
import { images } from '../data/images';

const hasPhoto = (slot: string) => Boolean(images[slot]?.slug);

// Progression chromatique + accents propres au sélecteur (distincts de la méthode).
const styleMap: Record<string, { bg: string; accent: string; ink: string; sub: string; dark: boolean }> = {
  preparer:       { bg: '#E9ECE1', accent: '#6E7C5A', ink: '#262A1F', sub: '#5C6350', dark: false },
  publiee:        { bg: '#F2E3C6', accent: '#B27C34', ink: '#3A2E1A', sub: '#6E5A34', dark: false },
  'peu-contacts': { bg: '#EFD9C8', accent: '#A85638', ink: '#38221A', sub: '#7A5442', dark: false },
  visites:        { bg: '#B15E34', accent: '#FBE9D8', ink: '#FDF3EA', sub: 'rgba(253,243,234,0.8)', dark: true },
  longtemps:      { bg: '#362539', accent: '#C79CB8', ink: '#F2E7EE', sub: 'rgba(242,231,238,0.78)', dark: true },
};

const duree = (n: number) => `≈ ${Math.max(2, Math.round((n * 35) / 60))} min`;
---

<section id="situations" class="rail-section scroll-mt-20" aria-labelledby="rail-titre">
  <div class="max-w-page mx-auto px-edge md:px-edge-md">
    <div class="md:flex items-end justify-between gap-8 mb-8 fade-up">
      <div class="max-w-xl">
        <p class="eyebrow mb-4">Le point de départ</p>
        <h2 id="rail-titre" class="text-display text-encre">Où en est votre vente&nbsp;?</h2>
        <p class="font-sans text-body-lg text-brun mt-4">
          Cinq situations, une seule à choisir. Faites glisser, puis ouvrez la vôtre —
          le diagnostic s’adapte à vos réponses. Trois minutes, sans coordonnées.
        </p>
      </div>
      <!-- Contrôles + compteur -->
      <div class="hidden md:flex items-center gap-3 shrink-0" data-rail-controls>
        <span class="font-sans text-sm text-brun mr-1"><span data-rail-current>1</span> sur {situations.length}</span>
        <button type="button" class="rail-arrow" data-rail-prev aria-label="Situation précédente">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M11 4L6 9l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="rail-arrow" data-rail-next aria-label="Situation suivante">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M7 4l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Le rail : déborde volontairement à droite, aligné à gauche sur le contenu -->
  <div class="rail-scroller" data-rail role="group" aria-label="Cinq situations, faites défiler horizontalement">
    <div class="rail-inner">
      {situations.map((s, i) => {
        const st = styleMap[s.id];
        return (
          <a
            href={`/situer-ma-vente?s=${s.id}`}
            class="rail-panel"
            data-rail-item
            data-index={i}
            style={`--bg:${st.bg};--accent:${st.accent};--ink:${st.ink};--sub:${st.sub};`}
            aria-label={`Situation ${s.ordinal} : ${s.titre}`}
          >
            <div class="rail-media">
              {hasPhoto(s.imageSlot) ? (
                <ResponsiveImage slot={s.imageSlot} ratio="4/3" sizes="(min-width:768px) 30vw, 82vw" class="rail-img" />
              ) : (
                <div class={`rail-graphic ${st.dark ? 'is-dark' : ''}`} role="img" aria-label={s.reconnaissance}>
                  <span class="rail-graphic-num">{s.ordinal}</span>
                  <svg class="rail-graphic-motif" viewBox="0 0 120 60" fill="none" aria-hidden="true">
                    <path d="M4 44 H56" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.9"/>
                    <path d="M64 16 H116" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
                    <circle cx="60" cy="30" r="3" fill="currentColor"/>
                  </svg>
                </div>
              )}
            </div>

            <div class="rail-body">
              <p class="rail-ordinal">{s.ordinal}</p>
              <h3 class="rail-panel-titre">{s.titre}</h3>
              <p class="rail-reco">{s.reconnaissance}</p>
              <p class="rail-aide">{s.objectif}</p>
              <div class="rail-foot">
                <span class="rail-duree">{duree(s.questions.length)}</span>
                <span class="rail-cta">
                  Ouvrir
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </div>
            </div>
          </a>
        );
      })}
      <div class="rail-spacer" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .rail-section { padding-top: 3.5rem; padding-bottom: 3.5rem; }
  @media (min-width: 768px) { .rail-section { padding-top: 5rem; padding-bottom: 5.5rem; } }

  .rail-arrow {
    width: 44px; height: 44px; border-radius: 999px;
    border: 1px solid rgba(33,28,22,0.2); color: #211C16;
    display: inline-flex; align-items: center; justify-content: center;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .rail-arrow:hover { border-color: #A85638; color: #A85638; }
  .rail-arrow:disabled { opacity: 0.3; cursor: default; }

  .rail-scroller {
    overflow-x: auto; overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-block: 0.5rem;
    cursor: grab;
  }
  .rail-scroller::-webkit-scrollbar { display: none; }
  .rail-scroller.is-dragging { cursor: grabbing; scroll-snap-type: none; }

  .rail-inner {
    display: flex; gap: 1rem;
    padding-left: max(1.25rem, calc((100vw - 1280px) / 2 + 1.25rem));
    padding-right: 1.25rem;
  }
  @media (min-width: 768px) {
    .rail-inner { gap: 1.25rem; padding-left: max(3rem, calc((100vw - 1280px) / 2 + 3rem)); }
  }
  .rail-spacer { flex: 0 0 1px; }

  .rail-panel {
    scroll-snap-align: start;
    flex: 0 0 82vw;
    max-width: 340px;
    display: flex; flex-direction: column;
    background: var(--bg); color: var(--ink);
    border-radius: 26px; overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.22,1,0.36,1), box-shadow 0.3s;
    min-height: 460px;
  }
  @media (min-width: 768px) {
    .rail-panel { flex-basis: 30vw; max-width: 372px; min-height: 500px; }
    .rail-panel:hover { transform: translateY(-6px); box-shadow: 0 30px 60px -34px rgba(33,28,22,0.5); }
  }

  .rail-media { position: relative; }
  :global(.rail-img) { width: 100%; display: block; }
  .rail-graphic {
    aspect-ratio: 4/3; position: relative;
    display: flex; align-items: center; justify-content: center;
    background:
      radial-gradient(120% 100% at 20% 0%, rgba(255,255,255,0.14), transparent 60%),
      color-mix(in srgb, var(--bg) 78%, #000 12%);
    color: var(--accent);
  }
  .rail-graphic-num {
    font-family: 'Fraunces', serif; font-weight: 500;
    font-size: clamp(3.5rem, 12vw, 5.5rem); line-height: 1;
    color: color-mix(in srgb, var(--accent) 85%, transparent);
  }
  .rail-graphic-motif { position: absolute; bottom: 1.4rem; left: 1.4rem; width: 96px; height: 48px; color: var(--accent); }

  .rail-body { padding: 1.5rem 1.5rem 1.6rem; display: flex; flex-direction: column; flex: 1; }
  .rail-ordinal { font-family: 'Instrument Sans', sans-serif; font-size: 0.8rem; letter-spacing: 0.16em; color: var(--accent); font-weight: 600; margin-bottom: 0.6rem; }
  .rail-panel-titre { font-family: 'Fraunces', serif; font-weight: 500; font-size: 1.4rem; line-height: 1.15; color: var(--ink); margin-bottom: 0.5rem; }
  .rail-reco { font-family: 'Instrument Sans', sans-serif; font-size: 0.98rem; line-height: 1.5; color: var(--ink); opacity: 0.92; margin-bottom: 0.75rem; }
  .rail-aide { font-family: 'Instrument Sans', sans-serif; font-size: 0.9rem; line-height: 1.55; color: var(--sub); flex: 1; }
  .rail-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 1.25rem; }
  .rail-duree { font-family: 'Instrument Sans', sans-serif; font-size: 0.85rem; color: var(--sub); }
  .rail-cta { font-family: 'Instrument Sans', sans-serif; font-weight: 600; font-size: 0.95rem; color: var(--accent); display: inline-flex; align-items: center; gap: 0.4rem; }

  @media (prefers-reduced-motion: reduce) {
    .rail-scroller { scroll-behavior: auto; }
    .rail-panel { transition: none; }
  }
</style>

<script>
  const scroller = document.querySelector<HTMLElement>('[data-rail]');
  if (scroller) {
    const items = Array.from(scroller.querySelectorAll<HTMLElement>('[data-rail-item]'));
    const currentEl = document.querySelector<HTMLElement>('[data-rail-current]');
    const prevBtn = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
    const nextBtn = document.querySelector<HTMLButtonElement>('[data-rail-next]');

    const activeIndex = () => {
      const mid = scroller.scrollLeft + scroller.clientWidth / 2;
      let best = 0, bestD = Infinity;
      items.forEach((it, i) => {
        const c = it.offsetLeft + it.offsetWidth / 2;
        const d = Math.abs(c - mid);
        if (d < bestD) { bestD = d; best = i; }
      });
      return best;
    };
    const syncCounter = () => {
      const i = activeIndex();
      if (currentEl) currentEl.textContent = String(i + 1);
      if (prevBtn) prevBtn.disabled = scroller.scrollLeft <= 2;
      if (nextBtn) nextBtn.disabled = scroller.scrollLeft >= scroller.scrollWidth - scroller.clientWidth - 2;
    };
    const scrollToItem = (i: number) => {
      const t = items[Math.max(0, Math.min(items.length - 1, i))];
      if (t) scroller.scrollTo({ left: t.offsetLeft - items[0].offsetLeft, behavior: 'smooth' });
    };

    prevBtn?.addEventListener('click', () => scrollToItem(activeIndex() - 1));
    nextBtn?.addEventListener('click', () => scrollToItem(activeIndex() + 1));
    scroller.addEventListener('scroll', () => requestAnimationFrame(syncCounter), { passive: true });

    // Molette verticale → défilement horizontal (desktop), sans bloquer la page.
    scroller.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
        const atStart = scroller.scrollLeft <= 0 && e.deltaY < 0;
        const atEnd = scroller.scrollLeft >= scroller.scrollWidth - scroller.clientWidth && e.deltaY > 0;
        if (!atStart && !atEnd) { scroller.scrollLeft += e.deltaY; e.preventDefault(); }
      }
    }, { passive: false });

    // Glisser-déposer à la souris (le clic-lien reste actif si pas de drag).
    let down = false, startX = 0, startLeft = 0, moved = false;
    scroller.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') return;
      down = true; moved = false; startX = e.clientX; startLeft = scroller.scrollLeft;
    });
    scroller.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 6) { moved = true; scroller.classList.add('is-dragging'); }
      scroller.scrollLeft = startLeft - dx;
    });
    const endDrag = () => {
      if (!down) return;
      down = false; scroller.classList.remove('is-dragging');
      if (moved) setTimeout(() => scrollToItem(activeIndex()), 10);
    };
    scroller.addEventListener('pointerup', endDrag);
    scroller.addEventListener('pointerleave', endDrag);
    // Empêche le clic-lien juste après un glissement.
    scroller.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', (e) => { if (moved) e.preventDefault(); })
    );

    syncCounter();
  }
</script>
