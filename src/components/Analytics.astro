---
// Aucun prestataire n'est activé par défaut : la clé doit être configurée explicitement.
const token = import.meta.env.PROD ? (import.meta.env.PUBLIC_POSTHOG_KEY ?? '') : '';
const host = 'https://eu.i.posthog.com';
---

<span hidden data-levois-analytics data-token={token} data-host={host} aria-hidden="true"></span>

<script>
  import '../scripts/analytics';
</script>
