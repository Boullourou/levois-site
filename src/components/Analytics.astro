---
// Cette clé d’ingestion est publique par conception (écriture seule) et peut être embarquée côté navigateur.
const token = import.meta.env.PROD
  ? (import.meta.env.PUBLIC_POSTHOG_KEY ?? 'phc_xSxvsMoZ4TEp6hpEGrWJfqEdSCNroQtpQp5JEQdYqqym')
  : '';
const host = import.meta.env.PUBLIC_POSTHOG_HOST ?? 'https://eu.i.posthog.com';
---

<span hidden data-levois-analytics data-token={token} data-host={host} aria-hidden="true"></span>
<dialog id="analytics-preferences" aria-labelledby="analytics-title">
  <form method="dialog" class="analytics-close"><button type="submit" aria-label="Fermer les choix de confidentialité">Fermer <span aria-hidden="true">×</span></button></form>
  <h2 id="analytics-title">Votre visite. Votre choix.</h2>
  <p>La mesure d’audience aide à comprendre quelles pages sont utiles. Elle est facultative et désactivée tant que vous ne l’acceptez pas. Le site fonctionne avec ou sans elle.</p>
  <p>Les textes saisis, coordonnées, adresses recherchées et réponses aux parcours ne sont pas envoyés à l’outil de mesure.</p>
  <p data-analytics-status role="status"></p>
  <div class="analytics-actions"><button type="button" data-analytics-choice="refused">Refuser</button><button type="button" data-analytics-choice="accepted">Accepter</button></div>
  <a href="/confidentialite#mesure-audience">Comprendre l’utilisation de mes données</a>
</dialog>

<script>
  import '../scripts/analytics';
</script>
