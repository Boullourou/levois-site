---
import { RESOURCE_CATEGORY_LABELS, RESOURCE_SEARCH_THRESHOLD, resourceDate, resourcePageUrl, type ResourceArticle, type ResourceCategory } from '../lib/editorial/shared-catalog';
interface Props {
  entries: ResourceArticle[];
  catalog: ResourceArticle[];
  page: number;
  totalPages: number;
  category?: ResourceCategory;
}
const { entries, catalog, page, totalPages, category } = Astro.props;
const base = category ? `/ressources/categorie/${category}/` : '/ressources/';
const categories = Object.entries(RESOURCE_CATEGORY_LABELS).map(([id, label]) => ({ id, label, count: catalog.filter((entry) => entry.category === id).length })).filter((entry) => entry.count > 0);
const showSearch = catalog.length >= RESOURCE_SEARCH_THRESHOLD;
---
<div class="res-page">
  <div class="w">
    <header class="res-hero">
      <p class="res-ey">Lèves &amp; Chartres Métropole</p>
      <h1>{category ? RESOURCE_CATEGORY_LABELS[category] : 'Comprendre le marché avant de décider.'}</h1>
      <p class="res-sub">Des réponses utiles pour préparer une vente, un achat ou comprendre les ventes locales. Chaque guide distingue les explications, les limites et la prochaine action possible.</p>
    </header>
    <nav class="res-categories" aria-label="Sujets des ressources">
      <a href="/ressources/" aria-current={!category ? 'page' : undefined}>Tous les sujets <span>({catalog.length})</span></a>
      {categories.map((item) => <a href={`/ressources/categorie/${item.id}/`} aria-current={category === item.id ? 'page' : undefined}>{item.label} <span>({item.count})</span></a>)}
    </nav>
    {showSearch && <div class="res-search" data-resource-search hidden>
      <label for="resource-search">Rechercher dans les ressources</label>
      <div class="res-search-row">
        <input id="resource-search" type="search" placeholder="Prix, travaux, visites…" maxlength="120" autocomplete="off" aria-controls="resource-search-results" />
        <button type="button" data-search-clear>Effacer</button>
      </div>
      <p data-search-status role="status" aria-live="polite"></p>
    </div>}
    <div id="resource-search-results" class="res-cards-grid" hidden></div>
    <section class="res-grid-sec" data-resource-default aria-label={category ? `Ressources : ${RESOURCE_CATEGORY_LABELS[category]}` : 'Toutes les ressources'}>
      <div class="res-cards-grid">
        {entries.map((entry) => <article class="res-card">
          <div class="res-card-top">
            <span class="res-category">{RESOURCE_CATEGORY_LABELS[entry.category]}</span>
            {entry.createdAt && <time datetime={entry.createdAt}>Rédigé le {resourceDate(entry.createdAt)}</time>}
          </div>
          <h2 class="res-card-title"><a href={`/ressources/${entry.slug}/`}>{entry.title}</a></h2>
          <p class="res-card-desc">{entry.summary}</p>
          <span class="res-read" aria-hidden="true">Lire le guide →</span>
        </article>)}
      </div>
      {totalPages > 1 && <nav class="res-pagination" aria-label="Pages des ressources">
        {page > 1 && <a rel="prev" href={resourcePageUrl(base, page - 1)}>← Précédente</a>}
        <span>Page {page} sur {totalPages}</span>
        {page < totalPages && <a rel="next" href={resourcePageUrl(base, page + 1)}>Suivante →</a>}
      </nav>}
    </section>
    {showSearch && <noscript><p>Les catégories et les liens de pagination permettent de consulter toutes les ressources sans JavaScript.</p></noscript>}
    <section class="res-tools-sec" aria-labelledby="resources-project">
      <div class="res-tools-box">
        <p class="res-ey">Votre situation</p>
        <h2 id="resources-project">Et pour votre projet, quelle est la prochaine étape ?</h2>
        <p>Cinq questions pour faire le point. Une première réponse à l’écran, puis l’envoi par e-mail si vous le souhaitez.</p>
        <div class="res-tools-btns">
          <a href="/situer-ma-vente/">Je prépare ma vente →</a>
          <a href="/ma-recherche/">Je cherche un logement →</a>
          <a href="/vendre-et-acheter/">Je vends et j’achète →</a>
        </div>
        <a class="res-direct" href="/contact/">Écrire directement à Mouaad →</a>
      </div>
    </section>
  </div>
</div>
<script>
  import { initResourceSearch } from '../lib/editorial/library-search';
  initResourceSearch();
</script>
<style>
  .res-page { background:var(--v7-paper);padding:clamp(64px,8vw,96px) 0 100px;color:var(--v7-ink) }
  .res-hero { max-width:840px;margin-bottom:40px }
  .res-ey { font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--v7-muted);margin-bottom:14px }
  h1 { font-family:'Satoshi',sans-serif;font-size:clamp(34px,4.8vw,56px);font-weight:700;line-height:1.15;letter-spacing:-.03em;margin-bottom:20px }
  .res-sub { font-size:clamp(17px,1.8vw,20px);line-height:1.6;color:var(--v7-muted) }
  .res-categories { display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px }
  .res-categories a { display:inline-flex;gap:6px;align-items:center;min-height:44px;padding:8px 14px;background:#fff;border:1px solid rgba(20,20,20,.12);border-radius:24px;color:var(--v7-ink);font-size:14px;text-decoration:none }
  .res-categories a[aria-current] { background:var(--v7-ink);color:#fff }
  .res-grid-sec { margin-bottom:60px }
  .res-cards-grid { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px }
  .res-cards-grid[hidden],.res-search[hidden] { display:none }
  .res-card { background:#fff;border:1px solid rgba(20,20,20,.05);border-radius:12px;padding:28px 24px;display:flex;flex-direction:column;box-shadow:0 4px 24px -2px rgba(20,20,20,.04);overflow-wrap:anywhere }
  .res-card-top { display:flex;align-items:flex-start;gap:8px;flex-direction:column;margin-bottom:16px }
  .res-category { font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--v7-muted) }
  time { font-size:13px;color:var(--v7-muted) }
  .res-card-title { font-family:'Satoshi',sans-serif;font-size:21px;font-weight:700;line-height:1.3;margin:0 0 14px }
  .res-card-title a { color:var(--v7-ink);text-decoration:none }
  .res-card-title a:hover { text-decoration:underline;text-underline-offset:4px }
  .res-card-desc { font-size:15px;line-height:1.6;color:var(--v7-muted);margin:0 0 24px;flex:1 }
  .res-read { font-size:14px;font-weight:700 }
  .res-pagination { display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:center;margin-top:36px }
  .res-pagination a,.res-search button { display:inline-flex;align-items:center;min-height:44px;padding:10px 16px;border:1px solid rgba(20,20,20,.12);border-radius:12px;background:#fff;color:var(--v7-ink);text-decoration:none }
  .res-search { margin-bottom:28px;max-width:720px }
  .res-search label { display:block;font-weight:600;margin-bottom:8px }
  .res-search-row { display:flex;gap:8px }
  .res-search input { min-width:0;flex:1;padding:12px 16px;background:#fff;border:1px solid rgba(20,20,20,.2);border-radius:12px;font-size:16px;color:var(--v7-ink) }
  .res-search p { min-height:24px;margin:8px 0 0;font-size:14px }
  #resource-search-results:not([hidden]) { margin-bottom:60px }
  .res-tools-sec { border-top:1px solid rgba(20,20,20,.08);padding-top:48px }
  .res-tools-box { background:var(--v7-ink);color:#faf9f6;border-radius:24px;padding:clamp(24px,4vw,48px) }
  .res-tools-box .res-ey,.res-tools-box p { color:#e3e1da }
  .res-tools-box h2 { color:#faf9f6;font-family:'Satoshi',sans-serif;font-size:clamp(24px,3.2vw,36px);margin:10px 0 14px }
  .res-tools-box p { max-width:680px;line-height:1.6;margin-bottom:24px }
  .res-tools-btns { display:flex;flex-wrap:wrap;gap:12px }
  .res-tools-btns a { display:inline-flex;align-items:center;min-height:44px;background:#fff;color:var(--v7-ink);padding:12px 20px;border-radius:24px;font-weight:600;text-decoration:none }
  .res-direct { display:inline-flex;align-items:center;min-height:44px;margin-top:16px;color:#faf9f6;text-underline-offset:4px }
  a:focus-visible,button:focus-visible,input:focus-visible { outline:3px solid #a34510;outline-offset:4px }
  @media(max-width:1040px) { .res-cards-grid { grid-template-columns:repeat(2,minmax(0,1fr)) } }
  @media(max-width:640px) { .res-cards-grid { grid-template-columns:minmax(0,1fr);gap:18px }.res-search-row { flex-wrap:wrap }.res-tools-btns { flex-direction:column }.res-tools-btns a { width:100% } }
</style>
