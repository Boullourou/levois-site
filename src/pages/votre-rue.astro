  // — Étape LECTURE —————————————————————————————————————————————
  function ecranLecture(etat: Etat): string {
    const l = etat.lecture;
    const n = l?.n ?? 0;

    if (n < 15) {
      return `
        <p class="vr-tun-q">Trop peu de ventes ressemblent réellement à votre bien.</p>
        <p class="vr-tun-body">
          Nous préférons vous le dire plutôt que d'inventer une précision.
