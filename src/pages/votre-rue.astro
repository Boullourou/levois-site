import {buildLocalReading, getLocalQuestions, localImpact, localContinuation, localDependencies, withLocalObservation, type LocalObservation} from '../lib/experience/local-experience';
  type Tx = {
    id: string; d: string; v: number; t: string; lat: number; lon: number;
    no?: string; vo?: string; cp?: string; co?: string; sb?: number; p?: number; st?: number; lots?: number;
  };
  type Meta = { status: string; generatedAt: string | null; dateVenteLaPlusRecente: string | null; anneesIncluses?: number[]; source?: string; sourceUrl?: string };

  const form = document.getElementById('vr-form') as HTMLFormElement;
  const input = document.getElementById('vr-adresse') as HTMLInputElement;
  const sugList = document.getElementById('vr-suggestions') as HTMLUListElement;
  const scene = document.getElementById('vr-scene') as HTMLElement;
  const geoErreur = document.getElementById('vr-geo-erreur') as HTMLElement;
  const fraicheurEl = document.getElementById('vr-fraicheur') as HTMLElement;

  const BIAIS = { lon: 1.4890, lat: 48.4470 };
  const GEOCODE = 'https://data.geopf.fr/geocodage/search';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const eur = new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 });
  const moisAn = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' });
  const jourMoisAn = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
  const dateComplete = (d: string) => { const dt = new Date(d + 'T00:00:00'); return isNaN(dt.getTime()) ? d : jourMoisAn.format(dt); };
  const dateMois = (d: string) => { const dt = new Date(d + 'T00:00:00'); return isNaN(dt.getTime()) ? d : moisAn.format(dt); };
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  const wait = (ms: number) => new Promise((r) => setTimeout(r, reduced ? 0 : ms));

  let dataset: Tx[] | null = null;
  let meta: Meta | null = null;
  let selection: { lon: number; lat: number; label: string } | null = null;
  let lastModel: any = null;
  let localContext = readContext('local');
  const incomingEntry = entryFromUrl(new URL(location.href));
  if (incomingEntry.door !== 'unknown') localContext.entry = incomingEntry;
  function localSnapshot(model: any, status: LocalObservation['status'] = model ? 'ready' : 'unavailable') {
    const years = meta?.anneesIncluses?.filter(year => Number.isInteger(year)).sort((a,b)=>a-b) || [];
    localContext = withLocalObservation(localContext, {
      schemaVersion:1, status, label:(selection?.label || input.value.trim()).slice(0,300),
      source:'DVF · DGFiP / Etalab', sourceUrl:'https://files.data.gouv.fr/geo-dvf/latest/csv/',
      period:years.length ? `${years[0]}–${years[years.length-1]}` : 'Période non disponible',
      generatedAt:meta?.generatedAt || null, latestSale:meta?.dateVenteLaPlusRecente || null,
      radius:model?.Rw ?? (status==='empty'?3000:null), count:model?.nbVentes ?? (status==='empty'?0:null),
      houses:model?.ppmM || null, apartments:model?.ppmA || null, filters:'',
    });
    localContext.reading = buildLocalReading(localContext);
    saveContext(localContext);
  }


  // ——— Fraîcheur affichée d'emblée ———
  (async () => {
    try {
      const {data:m}=await requestJson<Meta>('/data/dvf-meta.json',{},12000);
      meta = m;
      if (m.status === 'ready' && m.dateVenteLaPlusRecente) {
        fraicheurEl.textContent = `Données DVF disponibles jusqu'au ${dateComplete(m.dateVenteLaPlusRecente)}`;
        fraicheurEl.hidden = false;
      }
    } catch {}
  })();

  async function chargerDonnees() {
    if (dataset) return;
    const [d,m]=await Promise.all([requestJson<Tx[]>('/data/dvf-secteur.json'),requestJson<Meta>('/data/dvf-meta.json')]);
    if(!d.response.ok||!m.response.ok||!Array.isArray(d.data))throw new Error('Ventes indisponibles');
    dataset=d.data;meta=m.data;
  }

  async function geocoder(q: string, autocomplete: boolean, limit: number) {
    const url = new URL(GEOCODE);
    url.searchParams.set('q', q);
    url.searchParams.set('limit', String(limit));
    url.searchParams.set('lon', String(BIAIS.lon));
    url.searchParams.set('lat', String(BIAIS.lat));
    if (autocomplete) url.searchParams.set('autocomplete', '1');
    const {response:rep,data:json}=await requestJson<any>(url.toString(),{},10000);
    if (!rep.ok) throw new Error(`geocode ${rep.status}`);
    const feats = Array.isArray(json.features) ? json.features : [];
    return feats.filter((f: any) => String(f?.properties?.citycode || '').startsWith('28'));
  }

  function distance(aLat: number, aLon: number, bLat: number, bLon: number) {
    const R = 6371000;
    const dLat = ((bLat - aLat) * Math.PI) / 180, dLon = ((bLon - aLon) * Math.PI) / 180;
    const la1 = (aLat * Math.PI) / 180, la2 = (bLat * Math.PI) / 180;
    const h = Math.sin(dLat / 2) ** 2 + Math.cos(la1) * Math.cos(la2) * Math.sin(dLon / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h));
  }
  const distLisible = (m: number) => (m < 1000 ? `à environ ${Math.round(m / 50) * 50} m` : `à environ ${(m / 1000).toFixed(1).replace('.', ',')} km`);
  const median = (a: number[]) => { if (!a.length) return null; const s = [...a].sort((x, y) => x - y), m = Math.floor(s.length / 2); return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2; };
  const quantile = (a: number[], q: number) => { if (a.length < 2) return a[0] ?? null; const s = [...a].sort((x, y) => x - y); const pos = (s.length - 1) * q, b = Math.floor(pos), r = pos - b; return s[b + 1] !== undefined ? s[b] + r * (s[b + 1] - s[b]) : s[b]; };

  const multiLots = (t: Tx) => Boolean(t.lots && t.lots > 1);
  const typePluriel = (t: string) => (t === 'Maison' ? 'des maisons' : 'des appartements');
  const typePlurielNu = (t: string) => (t === 'Maison' ? 'maisons' : 'appartements');

  function bienCourt(t: Tx) {
    const b = [t.t]; if (t.sb) b.push(`${t.sb} m²`); if (t.p) b.push(`${t.p} pièce${t.p > 1 ? 's' : ''}`);
    if (multiLots(t)) b.push(`vente de ${t.lots} lots`);
    return b.join(' · ');
  }
  function adresse(t: Tx) {
    const rue = [t.no, t.vo].filter(Boolean).join(' '), ville = [t.cp, t.co].filter(Boolean).join(' ');
    return rue && ville ? `${rue}, ${ville}` : rue || ville || 'Adresse approximative';
  }

  // ——— Tendance : régression linéaire sur les médianes ANNUELLES du €/m² ———
  // Bien plus robuste que deux fenêtres isolées : utilise toutes les années
  // (2021→2025), amortit le bruit d'une année atypique, et reflète la tendance
  // de fond. Une comparaison de deux fenêtres pouvait afficher une « baisse »
  // là où le marché est en réalité stable (retour après un pic ponctuel).
  function computeTrend(all: any[], dom: string, minR: number) {
    // Échelle « secteur » : rayon d'au moins 1500 m pour des médianes annuelles
    // stables (les petits rayons font osciller la tendance d'année en année).
    const radii = minR >= 3000 ? [3000] : [minR, 3000];
    let arr: any[] = [];
    for (const r of radii) {
      const s = all.filter((t) => t._dist <= r && t.t === dom && !t.lots && t.sb);
      arr = s;
      if (s.length >= 150) break;
    }
    const xs: number[] = [], ys: number[] = [];
    for (let y = 2021; y <= 2025; y++) {
      const g = arr.filter((t) => t.d.startsWith(String(y))).map((t) => t.v / t.sb);
      if (g.length >= 20) { xs.push(y); ys.push(median(g) as number); } // année fiable seulement
    }
    if (xs.length < 3) return null; // pas assez de recul → pas de tendance affichée

    // Droite de régression (moindres carrés) sur les médianes annuelles.
    const ANNEE_REF = 2021, ANNEE_FIN = 2025; // bornes FIXES, identiques pour toute adresse
    const n = xs.length, x0 = xs[0];
    const X = xs.map((y) => y - x0);
    const sx = X.reduce((a, b) => a + b, 0), sy = ys.reduce((a, b) => a + b, 0);
    const sxx = X.reduce((a, b) => a + b * b, 0), sxy = X.reduce((a, b, i) => a + b * ys[i], 0);
    const slope = (n * sxy - sx * sy) / (n * sxx - sx * sx); // €/m² par an
    const intercept = (sy - slope * sx) / n;

    // ——— Conversion pente → pourcentage : RÈGLE UNIQUE, indépendante de l'adresse ———
    // On évalue la droite ajustée à deux années FIXES (2021 et 2025), jamais aux
    // années réellement présentes. Le pourcentage est la variation de la valeur
    // ajustée entre ces deux bornes, normalisée par la valeur ajustée de l'année
    // de RÉFÉRENCE CONSTANTE (2021) :
    //     delta% = (ajustée(2025) − ajustée(2021)) / ajustée(2021) × 100
    // La référence (2021) et l'amplitude (4 ans) ne dépendent jamais de l'adresse ;
    // seule la pente, elle, reflète les données locales.
    const yhat = (annee: number) => intercept + slope * (annee - x0);
    const ref = yhat(ANNEE_REF);
    const delta = ((yhat(ANNEE_FIN) - ref) / ref) * 100;

    // Seuil de stabilité : |delta| < 3 % → prix globalement stables.
    const dir = delta >= 3 ? 'hausse' : delta <= -3 ? 'baisse' : 'stable';
    return { delta, dir, anneeDebut: ANNEE_REF, anneeFin: ANNEE_FIN, annualMeds: xs.map((y, i) => ({ year: y, med: Math.round(ys[i]) })) };
  }

  // ——— Modèle : tous les indicateurs, calculés sur les vraies données ———
  function computeModel(lat: number, lon: number) {
    const all = (dataset as Tx[]).map((t) => ({ ...t, _dist: distance(lat, lon, t.lat, t.lon) })).sort((a, b) => a._dist - b._dist);

    const hab = (arr: any[]) => arr.filter((t) => (t.t === 'Maison' || t.t === 'Appartement') && !t.lots);
    let Rw = 3000, near = hab(all.filter((t) => t._dist <= 3000));
    for (const r of [700, 1500, 3000]) {
      const s = hab(all.filter((t) => t._dist <= r));
      if (s.length >= 150) { Rw = r; near = s; break; }
      if (r === 3000) { Rw = 3000; near = s; }
    }
    if (!near.length) return null;

    const nM = near.filter((t) => t.t === 'Maison').length;
    const nA = near.filter((t) => t.t === 'Appartement').length;
    const dom = nM >= nA ? 'Maison' : 'Appartement';
    const nbVentes = near.length;

    const ppmStats = (arr: any[]) => {
      const vals = arr.filter((t: any) => t.sb > 0).map((t: any) => t.v / t.sb);
      if (vals.length < 20) return null;
      return { median: median(vals)!, q1: quantile(vals, 0.25)!, q3: quantile(vals, 0.75)!, n: vals.length };
    };
    const ppmM = ppmStats(near.filter((t) => t.t === 'Maison'));
    const ppmA = ppmStats(near.filter((t) => t.t === 'Appartement'));

    const D = computeTrend(all, dom, Math.max(Rw, 1500));

    let aSet: any[] = [];
    for (const r of [700, 1500, 3000]) { aSet = all.filter((t) => t._dist <= r); if (aSet.length) break; }
    const derniere = [...aSet].sort((a, b) => (a.d < b.d ? 1 : a.d > b.d ? -1 : a._dist - b._dist))[0];
    const activite = near.filter((t) => t.t === dom && t.d >= '2025').length >= 5;
    const autres = [...aSet].sort((a, b) => (a.d < b.d ? 1 : -1)).filter((t) => t.id !== derniere?.id).slice(0, 4);

    const surfaceEffect = (() => {
      const appts = near.filter((t) => t.t === 'Appartement' && t.sb > 0);
      if (appts.length < 40) return null;
      const small = appts.filter((t) => t.sb < 50);
      const large = appts.filter((t) => t.sb >= 80);
      if (small.length < 20 || large.length < 20) return null;
      const ppmSmall = small.map((t) => t.v / t.sb).sort((a: number, b: number) => a - b);
      const ppmLarge = large.map((t) => t.v / t.sb).sort((a: number, b: number) => a - b);
      const medS = median(ppmSmall) as number;
      const medL = median(ppmLarge) as number;
      const deltaPct = Math.round(((medS - medL) / medL) * 100);
      if (Math.abs(deltaPct) < 10) return null;
      return { smallLabel: '< 50 m²', smallMed: Math.round(medS), smallN: small.length, largeLabel: '≥ 80 m²', largeMed: Math.round(medL), largeN: large.length, deltaPct };
    })();
    const n2024 = near.filter((t) => t.d.startsWith('2024')).length;
    const n2025 = near.filter((t) => t.d.startsWith('2025')).length;
    const ppmArr2 = (arr: any[]) => arr.filter((t: any) => t.sb > 0).map((t: any) => Math.round(t.v / t.sb)).sort((a: number, b: number) => a - b);
    const sampleArr = (arr: number[], n: number) => arr.length <= n ? arr : Array.from({ length: n }, (_: any, i: number) => arr[Math.floor(i * arr.length / n)]);
    const ppmDotsM = sampleArr(ppmArr2(near.filter((t) => t.t === 'Maison')), 60);
    const ppmDotsA = sampleArr(ppmArr2(near.filter((t) => t.t === 'Appartement')), 60);
    return { nbVentes, Rw, dom, nM, nA, ppmM, ppmA, ppmDotsM, ppmDotsA, D, derniere, activite, autres, surfaceEffect, n2024, n2025 };
  }

  // ——— « En clair » : phrases par règles fixes ———
  function enClair(model: any) {
    const s1 = model.activite
      ? `Autour de cette adresse, ${typePluriel(model.dom)} continuent de se vendre.`
      : `Autour de cette adresse, ${typePluriel(model.dom)} se vendent, mais plus rarement.`;
    let s2 = '';
    if (model.D) {
      if (model.D.dir === 'stable') s2 = 'Les prix observés sont globalement stables ces dernières années.';
      else if (model.D.dir === 'hausse') s2 = 'Les prix observés sont plutôt orientés à la hausse ces dernières années.';
      else s2 = 'Les prix observés sont plutôt orientés à la baisse ces dernières années.';
    }
    return { s1, s2 };
  }

  // ——— Animations ———
  function animeCompteur(el: HTMLElement, to: number, dur = 1100) {
    if (reduced) { el.textContent = eur.format(to); return; }
    const t0 = performance.now();
    const step = (now: number) => {
      const p = Math.min(1, (now - t0) / dur);
      const e = 1 - Math.pow(1 - p, 3);
      el.textContent = eur.format(Math.round(to * e));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  // Applique l'état final d'une animation de bloc (utilisé au reveal et en reduced-motion)
  function jouerAnim(el: HTMLElement, instantane: boolean) {
    const anim = el.dataset.anim;
    if (anim === 'count') {
      el.querySelectorAll<HTMLElement>('[data-count]').forEach((n) => {
        if (instantane) n.textContent = eur.format(Number(n.dataset.count));
        else animeCompteur(n, Number(n.dataset.count));
      });
    } else if (anim === 'slider') {
      const dot = el.querySelector<HTMLElement>('.vr-range-dot');
      if (dot && dot.dataset.pos) dot.style.left = dot.dataset.pos;
    } else if (anim === 'gauge') {
      const cur = el.querySelector<HTMLElement>('.vr-gauge-cursor');
      if (cur && cur.dataset.pos) cur.style.left = cur.dataset.pos;
    }
  }

  const observer = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const el = e.target as HTMLElement;
      el.classList.add('is-in');
      jouerAnim(el, false);
      observer.unobserve(el);
    }
  }, { threshold: 0.3, rootMargin: '0px 0px -8% 0px' });

  function reveler(el: HTMLElement) {
    if (reduced) { el.classList.add('is-in'); jouerAnim(el, true); return; }
    observer.observe(el);
  }

  // ——— Rendu de l'infographie ———
  const rayonTxt = (r: number) => (r < 1000 ? `${r} m` : `${(r / 1000).toLocaleString('fr-FR')} km`);
  // Position du curseur sur la jauge baisse/stable/hausse : domaine [-10 %, +10 %].
  const gaugePos = (delta: number) => Math.max(4, Math.min(96, ((delta + 10) / 20) * 100));

  function iconeTendance(dir: string) {
    if (dir === 'hausse') return '<svg viewBox="0 0 24 24" fill="none" stroke="#ea580c" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17L11 10l4 4 6-6"/><path d="M15 8h6v6"/></svg>';
    if (dir === 'baisse') return '<svg viewBox="0 0 24 24" fill="none" stroke="#58615B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7l7 7 4-4 6 6"/><path d="M15 16h6v-6"/></svg>';
    return '<svg viewBox="0 0 24 24" fill="none" stroke="#58615B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"/><path d="M16 8l4 4-4 4"/></svg>';
  }
  function tendanceTitre(dir: string) {
    if (dir === 'hausse') return 'Prix orientés à la hausse';
    if (dir === 'baisse') return 'Prix orientés à la baisse';
    return 'Prix globalement stables';
  }

  // Repli empilé (reduced-motion / secours) — cartes verticales lisibles.
  function construireStack(model: any) {
    const ppmDom = model.dom === 'Maison' ? model.ppmM : model.ppmA;
    const ppmAlt = model.dom === 'Maison' ? model.ppmA : model.ppmM;
    const altType = model.dom === 'Maison' ? 'Appartement' : 'Maison';
    const parts: string[] = [];

    parts.push(`
      <div class="vr-head">
        <p class="vr-head-eyebrow">Autour de cette adresse</p>
        ${selection?.label ? `<p class="vr-head-adr">${esc(selection.label)}</p>` : ''}
      </div>`);

    // ① Activité
    parts.push(`
      <div class="vr-block" data-anim="count">
        <div class="vr-card">
          <p class="vr-num vr-b-num"><span data-count="${model.nbVentes}">0</span></p>
          <p class="vr-b-l">ventes enregistrées · 2021–2025</p>
          <p class="vr-sub vr-b-sub">dans un rayon d'environ ${rayonTxt(model.Rw)}</p>
        </div>
      </div>`);

    // ② Composition maisons / appartements
    parts.push(`
      <div class="vr-block" data-anim="count">
        <div class="vr-card">
          <p class="vr-label">Les types de biens vendus</p>
          <div style="display:flex;gap:1.5rem;flex-wrap:wrap;margin-top:0.5rem">
            <div><p class="vr-num" style="font-size:clamp(2rem,8vw,2.8rem)"><span data-count="${model.nM}">0</span></p><p class="vr-sub">maisons</p></div>
            <div><p class="vr-num" style="font-size:clamp(2rem,8vw,2.8rem)"><span data-count="${model.nA}">0</span></p><p class="vr-sub">appartements</p></div>
          </div>
          <p class="vr-sub" style="margin-top:0.8rem">Deux marchés différents. Mieux vaut ne pas les mélanger.</p>
        </div>
      </div>`);

    // ③ Prix €/m² par type
    if (ppmDom) {
      const q1 = Math.round(ppmDom.q1), q3 = Math.round(ppmDom.q3), med = Math.round(ppmDom.median);
      const pos = q3 > q1 ? Math.max(6, Math.min(94, ((med - q1) / (q3 - q1)) * 100)) : 50;
      let altHtml = '';
      if (ppmAlt) {
        altHtml = `<div class="vr-ppm-alt"><p class="vr-ppm-alt-type">${esc(typePlurielNu(altType))}</p><p class="vr-ppm-alt-val">${eur.format(Math.round(ppmAlt.median))} €/m²</p><p class="vr-ppm-alt-range">fourchette ${eur.format(Math.round(ppmAlt.q1))} – ${eur.format(Math.round(ppmAlt.q3))} €/m² · ${ppmAlt.n} ventes</p></div>`;
      }
      parts.push(`
        <div class="vr-block" data-anim="slider">
          <div class="vr-card">
            <p class="vr-label">Le prix au m² observé · ${esc(typePlurielNu(model.dom))}</p>
            <p class="vr-num vr-c-num">${eur.format(med)} €/m²</p>
            <div class="vr-range">
              <div class="vr-range-line">
                <span class="vr-range-cap g">${eur.format(q1)}</span>
                <span class="vr-range-cap d">${eur.format(q3)}</span>
                <span class="vr-range-dot" data-pos="${pos.toFixed(0)}%" style="left:50%"></span>
              </div>
              <div class="vr-range-arrows" aria-hidden="true"><span>←</span><span>→</span></div>
              <p class="vr-note-sample lv-note">${ppmDom.n} ventes avec surface renseignée · même type · rayon ${rayonTxt(model.Rw)} · 2021–2025</p><p class="vr-c-phrase">La moitié des ${esc(typePlurielNu(model.dom))} se sont vendues entre <strong>${eur.format(q1)}</strong> et <strong>${eur.format(q3)} €/m²</strong>.</p>
            </div>
            ${altHtml}
          </div>
        </div>`);
    }

    // ④ Tendance
    if (model.D) {
      const pct = `${model.D.delta >= 0 ? '+' : ''}${model.D.delta.toFixed(1).replace('.', ',')} %`;
      const pos = gaugePos(model.D.delta), dir = model.D.dir;
      parts.push(`
        <div class="vr-block" data-anim="gauge">
          <div class="vr-card">
            <p class="vr-label">La trajectoire des ventes passées</p>
            <div class="vr-d-head">
              <span class="vr-d-ico" aria-hidden="true">${iconeTendance(dir)}</span>
              <span class="vr-d-title">${tendanceTitre(dir)}</span>
            </div>
            <div class="vr-gauge">
              <div class="vr-gauge-track"><span class="vr-gauge-cursor" data-pos="${pos.toFixed(0)}%" style="left:50%"></span></div>
              <div class="vr-gauge-lbls">
                <span class="${dir === 'baisse' ? 'on' : ''}">Baisse</span>
                <span class="${dir === 'stable' ? 'on' : ''}">Stable</span>
                <span class="${dir === 'hausse' ? 'on' : ''}">Hausse</span>
              </div>
            </div>
            <p class="vr-d-pct">${pct} sur le prix au m², estimé sur ${model.D.anneeDebut}–${model.D.anneeFin}</p>
          </div>
        </div>`);
    }

    // ⑤ Limitation
    parts.push(`
      <div class="vr-block" data-anim="fade">
        <div class="vr-card vr-card--warm">
          <p class="vr-label">À retenir</p>
          <p class="vr-ec">Un même quartier. Des biens très différents.</p>
          <p class="vr-sub" style="margin-top:0.8rem;line-height:1.55">Une adresse donne le contexte, elle ne suffit pas à situer votre bien. État, disposition, exposition et travaux restent à vérifier. Ces ventes passées ne décrivent ni une offre disponible ni le prix actuel d’un bien.</p>
        </div>
        <p class="vr-maj">${majLigne()}</p>
      </div>`);

    // Ventes détaillées (secondaire)
    if (model.autres.length) {
      const d = model.derniere;
      parts.push(`
        <div class="vr-block" data-anim="fade">
          <details class="vr-details">
            <summary>Voir les ventes autour de chez moi</summary>
            <div>
              <div class="vr-autre">
                <span>${esc(bienCourt(d))}<span class="vr-autre-sub">${esc(adresse(d))} · ${esc(dateMois(d.d))} · ${esc(distLisible(d._dist))}</span></span>
                <span class="vr-autre-prix">${eur.format(d.v)} €</span>
              </div>
              ${model.autres.map((t: any) => `
                <div class="vr-autre">
                  <span>${esc(bienCourt(t))}<span class="vr-autre-sub">${esc(adresse(t))} · ${esc(dateMois(t.d))} · ${esc(distLisible(t._dist))}</span></span>
                  <span class="vr-autre-prix">${eur.format(t.v)} €</span>
                </div>`).join('')}
            </div>
          </details>
        </div>`);
    }

    parts.push(construireConversion());

    scene.innerHTML = `<div class="vr-results">${parts.join('')}</div>`;
    scene.querySelectorAll<HTMLElement>('.vr-block').forEach((b) => reveler(b));
    brancherConversion(model);
  }

  // Ventes détaillées (réutilisé par le repli et la séquence)
  function blocDetails(model: any) {
    const d = model.derniere;
    if (!model.autres.length) return '';
    return `
      <details class="vr-details">
        <summary>Voir les ventes autour de chez moi</summary>
        <div>
          <div class="vr-autre"><span>${esc(bienCourt(d))}<span class="vr-autre-sub">${esc(adresse(d))} · ${esc(dateMois(d.d))} · ${esc(distLisible(d._dist))}</span></span><span class="vr-autre-prix">${eur.format(d.v)} €</span></div>
          ${model.autres.map((t: any) => `<div class="vr-autre"><span>${esc(bienCourt(t))}<span class="vr-autre-sub">${esc(adresse(t))} · ${esc(dateMois(t.d))} · ${esc(distLisible(t._dist))}</span></span><span class="vr-autre-prix">${eur.format(t.v)} €</span></div>`).join('')}
        </div>
      </details>`;
  }

  // ——— Infographique premium — 7 blocs, IntersectionObserver ———
  function majLigne() {
    if (!meta) return '';
    const parts: string[] = [];
    if (meta.dateVenteLaPlusRecente) parts.push(`Données DVF disponibles jusqu'au ${dateComplete(meta.dateVenteLaPlusRecente)}`);
    if (meta.generatedAt) parts.push(`extraites le ${jourMoisAn.format(new Date(meta.generatedAt))}`);
    return esc(parts.join(' · ')) + ' · Source : DVF (DGFiP).';
  }

  // Valeur locale, puis question personnelle. Aucun contact n’est demandé ici.
  function construireConversion() {
    return `<div class="vr-block is-in" data-anim="fade"><div class="vr-conv" id="vr-conv">
      <p class="vr-conv-eyebrow">Le repère devient utile avec votre question</p>
      <h2 class="vr-conv-titre">Et pour votre projet ?</h2>
      <p class="vr-conv-intro">Deux réponses pour distinguer ce que ces ventes vous apprennent et ce qu’il faudra vérifier. Votre lecture apparaît ici, sans coordonnées.</p>
      <div class="vr-paths" id="vr-paths">
        <button type="button" class="vr-path vr-path--1" data-path="lecture"><span><span class="vr-path-t">Relier les repères à ma question</span><span class="vr-path-d">Acheter, vendre, coordonner ou simplement comprendre</span></span><span aria-hidden="true">→</span></button>
        <button type="button" class="vr-path vr-path--2" data-path="garder"><span><span class="vr-path-t">Garder les repères seuls</span><span class="vr-path-d">La source, les limites et la prochaine vérification</span></span><span aria-hidden="true">↗</span></button>
      </div><div id="vr-panneau"></div>
    </div></div>`;
  }
  function brancherConversion(model: any, status?: LocalObservation['status']) {
    localSnapshot(model,status);
    const paths=document.getElementById('vr-paths');
    const panneau=document.getElementById('vr-panneau');
    if(!paths || !panneau) return;
    paths.querySelectorAll<HTMLButtonElement>('[data-path]').forEach(button=>button.addEventListener('click',()=>{
      if(button.dataset.path==='garder') rendreLecture(panneau);
      else panneauQualif(panneau);
      panneau.scrollIntoView({behavior:reduced?'auto':'smooth',block:'nearest'});
    }));
  }
  function rendreLecture(panneau:HTMLElement) {
    const reading=buildLocalReading(localContext);
    localContext.reading=reading;
    const stored=saveContext(localContext);
    const continuation=localContinuation(localContext);
    panneau.innerHTML=`<div class="vr-panneau vr-local-reading"><p class="lv-eyebrow">Votre lecture · avant toute coordonnée</p><h2 tabindex="-1" style="font-size:29px;margin:15px 0 25px">Ce que vous pouvez en faire.</h2>${readingSectionsHTML(reading,localContext)}${nextHTML(reading)}${limitsHTML(reading)}
      <p class="lv-note">Version ${reading.revision} · méthode ${reading.methodVersion}. La copie, la relecture écrite et l’échange sont des suites distinctes.</p>
      ${stored?'':'<p class="lv-error">La session ne peut pas être enregistrée sur cet appareil. Votre lecture reste visible : vous pouvez la copier ou l’imprimer ici.</p>'}
      <div class="lv-actions">${stored?'<a class="lv-button" href="/lecture">Garder ma lecture et choisir la suite ↗</a>':''}<button type="button" class="lv-secondary" data-local-copy>Copier ma lecture</button><button type="button" class="lv-text-link" data-local-print>Imprimer</button><button type="button" class="lv-text-link" data-local-correct>Corriger ma question</button><a class="lv-text-link" href="${continuation.href}">${continuation.label} ↗</a></div><p class="lv-note" data-local-status role="status"></p></div>`;
    panneau.querySelector<HTMLElement>('h2')?.focus({preventScroll:true});
    panneau.querySelector('[data-local-correct]')?.addEventListener('click',()=>panneauQualif(panneau,true));
    panneau.querySelector('[data-local-print]')?.addEventListener('click',()=>window.print());
    panneau.querySelector('[data-local-copy]')?.addEventListener('click',async()=>{
      const content=[reading.title,`Version ${reading.revision} · ${reading.generatedAt} · ${reading.methodVersion}`,...reading.sections.flatMap(section=>[section.title,...section.items.map(item=>item.text)]),'Votre prochaine décision utile',reading.nextDecision.text,reading.nextDecision.why,...reading.limits].join('\n\n');
      const status=panneau.querySelector<HTMLElement>('[data-local-status]')!;
      try{await navigator.clipboard.writeText(content);status.textContent='Lecture copiée, sans envoi ni appel.';}catch{status.textContent='La copie automatique est indisponible. Sélectionnez le texte visible ou imprimez cette page.';}
    });
  }
  function panneauQualif(panneau:HTMLElement, startOver=false) {
    const questions=getLocalQuestions(localContext);
    const q=startOver?questions[0]:questions.find(question=>!Object.hasOwn(localContext.answers,question.id));
    if(!q){rendreLecture(panneau);return;}
    panneau.innerHTML=`<div class="vr-panneau"><p class="lv-eyebrow">${q.sequence} sur 2 · ${esc(q.sequenceTitle)}</p><h2 tabindex="-1" class="vr-q-label" style="font-size:27px;margin:15px 0 20px">${esc(q.title)}</h2><div class="vr-q-opts">${q.choices!.map(option=>`<button type="button" class="vr-q-opt" data-local-answer="${esc(option.value)}" aria-pressed="${localContext.answers[q.id]?.value===option.value}">${esc(option.label)}</button>`).join('')}</div>
      ${q.sequence===2?`<div class="lv-impact">${impactHTML(localImpact('local_intention',localContext))}</div>`:''}
      <div class="lv-actions"><button class="lv-text-link" type="button" data-local-read>Lire avec ce que je sais déjà</button>${q.sequence===2?'<button type="button" class="lv-text-link" data-local-back>Revenir à mon intention</button>':''}</div></div>`;
    panneau.querySelector<HTMLElement>('h2')?.focus({preventScroll:true});
    panneau.querySelectorAll<HTMLButtonElement>('[data-local-answer]').forEach(button=>button.addEventListener('click',()=>{
      localContext=setAnswer(localContext,q.id,button.dataset.localAnswer!,localDependencies);
      localContext.reading=buildLocalReading(localContext);saveContext(localContext);
      if(q.sequence===2)rendreLecture(panneau);else panneauQualif(panneau);
    }));
    panneau.querySelector('[data-local-read]')?.addEventListener('click',()=>rendreLecture(panneau));
    panneau.querySelector('[data-local-back]')?.addEventListener('click',()=>panneauQualif(panneau,true));
  }

  // Les états incomplets gardent une valeur autonome et une lecture personnelle.
  function afficherEtatLocal(status:LocalObservation['status'],title:string,message:string) {
    scene.hidden=false;lastModel=null;
    scene.innerHTML=`<div class="vr-vide"><h2 tabindex="-1" style="font-size:29px;margin-bottom:16px">${esc(title)}</h2><p class="lv-intro" style="font-size:16px">${esc(message)}</p><p class="lv-limit" style="margin-top:20px">Un chiffre absent ne devient jamais zéro. Vous pouvez préciser l’adresse, consulter le repère communal ci-dessous ou clarifier votre question.</p></div>${construireConversion()}`;
    brancherConversion(null,status);
  }
  function afficherDonneesEnAttente() {
    afficherEtatLocal('unavailable','Les ventes ne sont pas disponibles pour cette recherche.','Le chargement ou la couverture des données ne permet pas d’afficher un repère fiable. Aucune date de disponibilité n’est promise. La lecture de votre question reste possible.');
  }
  function afficherAucun(label:string) {
    afficherEtatLocal('empty','Aucune vente retenue dans ce périmètre.',`Autour de « ${label} », aucune vente correspondant aux filtres n’a été retrouvée dans un rayon de 3 km. La base n’est pas exhaustive et ne couvre que les communes indiquées.`);
  }
  function afficherAdresseIndeterminee() {
    afficherEtatLocal('address_unconfirmed','L’adresse reste à préciser.','Aucune adresse n’a été confirmée dans le périmètre de recherche. Ajoutez la commune ou choisissez une proposition. Aucun résultat n’est attribué automatiquement à une adresse ambiguë.');
  }

  // ——— Moment d'analyse (adossé au calcul réel, sans fausse attente) ———
  async function jouerAnalyseEtRendre(lat: number, lon: number) {
    const messages = ['Recherche des ventes autour de chez vous…', 'Comparaison des ventes enregistrées…', "Lecture de l'évolution du secteur…"];
    scene.hidden = false;
    scene.innerHTML = `<div class="vr-analyse">${messages.map((m, i) => `<div class="vr-analyse-step" data-i="${i}"><span class="vr-analyse-dot"></span><span>${m}</span></div>`).join('')}</div>`;
    const steps = Array.from(scene.querySelectorAll<HTMLElement>('.vr-analyse-step'));
    const activer = (i: number) => steps.forEach((s, j) => { s.classList.toggle('is-active', j === i); s.classList.toggle('is-done', j < i); });

    activer(0);
    const model = computeModel(lat, lon); // calcul réel
    steps[0].classList.add('is-done');
    activer(1);
    activer(2);
    steps.forEach((s) => { s.classList.remove('is-active'); s.classList.add('is-done'); });


    if (!model) { afficherAucun(selection?.label || input.value); return; }
    lastModel = model;
    construireStack(model);
    const head=scene.querySelector<HTMLElement>('.vr-head');
    if(head){head.tabIndex=-1;head.focus({preventScroll:true});head.scrollIntoView({block:'start',behavior:'instant'});}

  }

  // ——— Autocomplétion ———
  let debounce = 0, activeIdx = -1, currentSugs: any[] = [];
  const fermerSug = () => { sugList.hidden = true; input.setAttribute('aria-expanded', 'false'); activeIdx = -1; input.removeAttribute('aria-activedescendant'); };
  function rendreSug(feats: any[]) {
    currentSugs = feats;
    if (!feats.length) { fermerSug(); return; }
    sugList.innerHTML = feats.map((f, i) => { const pr = f.properties || {}; const sub = [pr.postcode, pr.city].filter(Boolean).join(' '); return `<li role="option" id="vr-sug-${i}" aria-selected="false" data-idx="${i}">${esc(pr.label || pr.name || '')}<span class="vr-sug-sub">${esc(sub)}</span></li>`; }).join('');
    sugList.hidden = false; input.setAttribute('aria-expanded', 'true'); activeIdx = -1;
  }
  function choisir(i: number) {
    const f = currentSugs[i]; if (!f) return;
    const [lon, lat] = f.geometry.coordinates;
    selection = { lon, lat, label: f.properties?.label || input.value };
    input.value = selection.label; window.clearTimeout(debounce); fermerSug(); lancer();
  }
  input.addEventListener('input', () => {
    selection = null; geoErreur.classList.add('hidden');
    const q = input.value.trim(); window.clearTimeout(debounce);
    if (q.length < 3) { fermerSug(); return; }
    debounce = window.setTimeout(async () => { try { const choices=await geocoder(q,true,6); if(input.value.trim()===q&&!selection)rendreSug(choices); } catch { fermerSug(); } }, 260);
  });
  input.addEventListener('keydown', (e) => {
    if (sugList.hidden) return;
    const items = Array.from(sugList.querySelectorAll('li'));
    if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, items.length - 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); }
    else if (e.key === 'Enter' && activeIdx >= 0) { e.preventDefault(); choisir(activeIdx); return; }
    else if (e.key === 'Escape') { fermerSug(); return; } else return;
    items.forEach((el, i) => el.setAttribute('aria-selected', i === activeIdx ? 'true' : 'false'));
    if (items[activeIdx]) {input.setAttribute('aria-activedescendant',items[activeIdx].id);items[activeIdx].scrollIntoView({ block: 'nearest' });}
  });
  sugList.addEventListener('click', (e) => { const li = (e.target as HTMLElement).closest('li'); if (li) choisir(Number((li as HTMLElement).dataset.idx)); });
  document.addEventListener('click', (e) => { if (!form.contains(e.target as Node)) fermerSug(); });

  // ——— Lancement ———
  async function lancer() {
    geoErreur.classList.add('hidden');
    scene.hidden = false;
    scene.innerHTML = `<div class="vr-analyse"><div class="vr-analyse-step is-active"><span class="vr-analyse-dot"></span><span>Recherche des ventes autour de chez vous…</span></div></div>`;
    try { await chargerDonnees(); } catch {
      geoErreur.textContent = 'Impossible de charger les données pour le moment. Réessayez dans un instant.';
      geoErreur.classList.remove('hidden'); afficherDonneesEnAttente(); return;
    }
    if (!meta || meta.status !== 'ready' || !dataset || !dataset.length) { afficherDonneesEnAttente(); return; }

    let coords = selection;
    if (!coords) {
      const q = input.value.trim();
      if (q.length < 3) { scene.hidden = true; geoErreur.textContent = "Indiquez d'abord votre rue ou votre adresse."; geoErreur.classList.remove('hidden'); return; }
      try { const feats = await geocoder(q, false, 6); if (!feats.length) { afficherAdresseIndeterminee(); return; } scene.hidden=true; rendreSug(feats); input.focus(); geoErreur.textContent='Choisissez l’adresse à explorer dans la liste.'; geoErreur.classList.remove('hidden'); return; }
      catch { geoErreur.textContent = 'Le service de recherche d’adresse est momentanément indisponible.'; geoErreur.classList.remove('hidden'); afficherAdresseIndeterminee(); return; }
    }
    await jouerAnalyseEtRendre(coords.lat, coords.lon);
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); fermerSug(); lancer(); });
  const initialQuery=new URLSearchParams(location.search).get('q');
  if(initialQuery&&initialQuery.length>=3&&initialQuery.length<=180){
    input.value=initialQuery;
    if(new URLSearchParams(location.search).get('confirmee')==='1'){
      (async()=>{try{const choices=await geocoder(initialQuery,false,6);const exact=choices.find(f=>f.properties?.label===initialQuery);if(exact){const [lon,lat]=exact.geometry.coordinates;selection={lon,lat,label:initialQuery};lancer();}else{rendreSug(choices);input.focus();}}catch{geoErreur.textContent='La recherche est momentanément indisponible. Réessayez.';geoErreur.classList.remove('hidden');}})();
    }else{input.dispatchEvent(new Event('input',{bubbles:true}));input.focus();}
  }

</script>
