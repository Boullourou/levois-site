  function brancherLecture(panneau: HTMLElement, etat: Etat, model: any) {
    panneau.querySelector<HTMLButtonElement>('#vr-tun-next')!.addEventListener('click', () => {
      // Si N insuffisant, le bouton devient direct vers Mouaad
      if ((etat.lecture?.n ?? 0) < 15) { panneauMouaad(panneau); return; }
      etat.step += 1; rendreTunnel(panneau, etat, model);
    });
  }

