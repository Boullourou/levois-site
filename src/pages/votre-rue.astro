        { value: 'nsp', label: 'Je ne sais pas encore' } ] },
      { key: 'horizon', label: 'Dans quel délai ?', options: [
        { value: 'rapidement', label: 'Rapidement' }, { value: 'dans-annee', label: "Dans l'année" }, { value: 'sans-date', label: 'Pas pressé' } ] },
    ],
  };

  function brancherConversion(model: any) {
    const paths = document.getElementById('vr-paths')!;
    const panneau = document.getElementById('vr-panneau')!;
    paths.querySelectorAll<HTMLButtonElement>('.vr-path').forEach((btn) => {
      btn.addEventListener('click', () => {
        const p = btn.dataset.path;
        if (p === 'mouaad') panneauMouaad(panneau);
        else if (p === 'explorer') panneauExplorer(panneau);
        else panneauQualif(panneau, model);
        panneau.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'nearest' });
      });
    });
  }

  function panneauMouaad(panneau: HTMLElement) {
    panneau.innerHTML = `
      <div class="vr-panneau">
        <p class="vr-q-label">Parlons de votre projet.</p>
        <p class="font-sans text-[15px] text-brun leading-relaxed" style="margin-bottom:1.1rem">
          Pas d'étape à remplir : contactez Mouaad directement, il vous répond personnellement.
        </p>
        <div class="vr-contact-liens">
          <a href="tel:+33781380121" class="btn-primaire">Appeler Mouaad</a>
          <a href="mailto:mouaad@levois.fr" class="btn-secondaire">Écrire un e-mail</a>
          <a href="/contact?src=votre-rue" class="btn-secondaire">Être rappelé</a>
        </div>
      </div>`;
  }

  function panneauExplorer(panneau: HTMLElement) {
    panneau.innerHTML = `
      <div class="vr-panneau">
        <p class="vr-q-label">Continuer à comprendre.</p>
        <div class="vr-explorer">
          <a href="/situer-ma-vente?src=votre-rue"><b>Situer ma vente</b> — un diagnostic en 3 minutes, sans coordonnées</a>
          <a href="/methode"><b>La méthode LEVOIS</b> — lire le marché avant de décider</a>
          <a href="/ressources/annonce-vue-peu-de-contacts"><b>Pourquoi une vente bloque</b> — annonce vue, peu de contacts</a>
          <a href="/ressources"><b>Toutes les ressources</b> — comprendre chaque étape</a>
        </div>
      </div>`;
  }

  // Micro-qualification : une question par écran, progression visible
  function panneauQualif(panneau: HTMLElement, model: any) {
    const state: any = { intentionKey: null, intention: null, tag: null, answers: {} };

    const rendre = (steps: any[], idx: number) => {
      const total = 1 + steps.length + 1; // intention + questions + contact
      const dots = Array.from({ length: total }, (_, i) => `<span class="vr-q-dot ${i <= idx ? 'is-on' : ''}"></span>`).join('');
      // idx 0 = intention ; 1..steps.length = questions ; total-1 = contact
      if (idx === 0) {
        panneau.innerHTML = `
          <div class="vr-panneau">
            <div class="vr-q-progress">${dots}</div>
            <p class="vr-q-label">Où en êtes-vous ?</p>
            <div class="vr-q-opts">${INTENTIONS.map((it) => `<button type="button" class="vr-q-opt" data-k="${it.key}">${it.label}</button>`).join('')}</div>
          </div>`;
        panneau.querySelectorAll<HTMLButtonElement>('.vr-q-opt').forEach((b) => b.addEventListener('click', () => {
          const it = INTENTIONS.find((x) => x.key === b.dataset.k)!;
          state.intentionKey = it.key; state.intention = it.label; state.tag = it.tag;
          const st = QUALIF[it.key] || [];
          if (st.length) rendre(st, 1); else rendreContact(st);
        }));
        return;
      }
      const q = steps[idx - 1];
      panneau.innerHTML = `
        <div class="vr-panneau">
          <div class="vr-q-progress">${dots}</div>
          <p class="vr-q-label">${esc(q.label)}</p>
          <div class="vr-q-opts">${q.options.map((o: any) => `<button type="button" class="vr-q-opt" data-v="${o.value}">${esc(o.label)}</button>`).join('')}</div>
          <button type="button" class="vr-q-back">← Revenir</button>
        </div>`;
      panneau.querySelectorAll<HTMLButtonElement>('.vr-q-opt').forEach((b) => b.addEventListener('click', () => {
        state.answers[q.key] = { value: b.dataset.v, label: b.textContent };
        if (idx < steps.length) rendre(steps, idx + 1); else rendreContact(steps);
      }));
      panneau.querySelector<HTMLButtonElement>('.vr-q-back')!.addEventListener('click', () => { if (idx === 1) rendre(steps, 0); else rendre(steps, idx - 1); });
    };

    const rendreContact = (steps: any[]) => {
      const total = 1 + steps.length + 1;
      const dots = Array.from({ length: total }, () => `<span class="vr-q-dot is-on"></span>`).join('');
      panneau.innerHTML = `
        <div class="vr-panneau">
          <div class="vr-q-progress">${dots}</div>
          <p class="vr-q-label">Où vous envoyer votre analyse personnalisée ?</p>
          <p class="font-sans text-[14px] text-brun" style="margin-bottom:1rem">
            Elle réunit le récapitulatif des ventes autour de votre adresse, votre situation, les ressources adaptées — et, quand c'est utile, une lecture préparée par Mouaad. Aucune estimation automatique de votre bien : une aide à comprendre, honnête.
          </p>
          <form id="vr-lead" novalidate>
            <div class="vr-champ"><label for="vr-prenom">Prénom</label><input id="vr-prenom" name="prenom" type="text" autocomplete="given-name" required /></div>
            <div class="vr-champ"><label for="vr-email">E-mail</label><input id="vr-email" name="email" type="email" inputmode="email" autocomplete="email" required /></div>
            <div class="vr-champ"><label for="vr-tel">Téléphone <span style="color:#58615B">(facultatif)</span></label><input id="vr-tel" name="telephone" type="tel" inputmode="tel" autocomplete="tel" /></div>
            <div style="position:absolute;left:-9999px" aria-hidden="true"><label>Site</label><input name="site_web" tabindex="-1" autocomplete="off" /></div>
            <label class="vr-consent"><input type="checkbox" id="vr-consent" required /><span>J'accepte d'être recontacté au sujet de ma demande — et pour rien d'autre. <a href="/confidentialite" class="text-argile underline">En savoir plus</a>.</span></label>
            <p id="vr-lead-err" class="font-sans text-sm text-argile hidden" role="alert" style="margin-bottom:0.6rem"></p>
            <button type="submit" class="btn-primaire" id="vr-lead-envoi">Recevoir mon analyse personnalisée</button>
            <button type="button" class="vr-q-back">← Revenir</button>
          </form>
        </div>`;
      panneau.querySelector<HTMLButtonElement>('.vr-q-back')!.addEventListener('click', () => { if (steps.length) rendre(steps, steps.length); else rendre(steps, 0); });
      brancherEnvoiLead(panneau, model, state);
    };

    rendre([], 0);
  }

  function brancherEnvoiLead(panneau: HTMLElement, model: any, state: any) {
    const f = panneau.querySelector<HTMLFormElement>('#vr-lead')!;
    const err = panneau.querySelector<HTMLElement>('#vr-lead-err')!;
    const btn = panneau.querySelector<HTMLButtonElement>('#vr-lead-envoi')!;
    let envoiEnCours = false;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (envoiEnCours) return;
      err.classList.add('hidden');
      if (!f.checkValidity()) { f.reportValidity(); return; }
      envoiEnCours = true; btn.disabled = true; btn.textContent = 'Envoi…';
      const fd = new FormData(f);
      const d = model.derniere;
      // Synthèse et coordonnées transmises uniquement après accord explicite.
      const payload = {
        type: 'votre-rue', consentement: !!f.querySelector<HTMLInputElement>('#vr-consent')?.checked,
        source: 'QR /votre-rue',
        adresseRecherchee: selection?.label || '',
        commune: d?.co || '',
        intention: state.intention, intentionKey: state.intentionKey, profil: state.tag,
        qualification: Object.fromEntries(Object.entries(state.answers).map(([k, v]: any) => [k, v.label])),
        prenom: fd.get('prenom'), email: fd.get('email'), telephone: fd.get('telephone') || null,
        site_web: fd.get('site_web') || '',
        contexteInfographie: {
          nbVentes: model.nbVentes, rayon: model.Rw,
          composition: { maisons: model.nM, appartements: model.nA },
          ppmMaisons: model.ppmM ? { median: Math.round(model.ppmM.median), q1: Math.round(model.ppmM.q1), q3: Math.round(model.ppmM.q3) } : null,
          ppmAppartements: model.ppmA ? { median: Math.round(model.ppmA.median), q1: Math.round(model.ppmA.q1), q3: Math.round(model.ppmA.q3) } : null,
          tendance: model.D ? { direction: model.D.dir, pct: Number(model.D.delta.toFixed(1)) } : null,
        },
      };
      try {
        const {response:rep,data} = await requestJson<any>('/api/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (rep.ok && data?.ok === true) {
          panneau.innerHTML = `
            <div class="vr-panneau">
              <p class="vr-q-label">C'est noté, ${esc(String(fd.get('prenom') || ''))}.</p>
              <p class="font-sans text-[15px] text-brun leading-relaxed">Votre demande et le récapitulatif des ventes ont été transmis à Mouaad. Il pourra vous répondre au sujet de votre situation. Vous pouvez aussi le joindre directement : <a href="tel:+33781380121" class="text-argile underline">07 81 38 01 21</a>.</p>
            </div>`;
        } else {

          err.textContent = data?.message || "L'envoi n'a pas abouti. Vous pouvez réessayer ou écrire à mouaad@levois.fr.";
          err.classList.remove('hidden');
        }
      } catch {
        err.textContent = "L'envoi n'a pas abouti. Vous pouvez réessayer ou écrire à mouaad@levois.fr.";
        err.classList.remove('hidden');
      } finally {
        envoiEnCours = false; btn.disabled = false; btn.textContent = 'Recevoir mon analyse personnalisée';
      }
    });
  }

  // ——— États vides / attente ———
  function afficherDonneesEnAttente() {
    scene.hidden = false;
    scene.innerHTML = `<div class="vr-vide"><p class="font-display text-xl text-encre mb-2">L'accès aux ventes de votre secteur est en cours de finalisation.</p>
      <p class="font-sans text-[15px] text-brun leading-relaxed">Les données publiques de ventes (DVF) seront disponibles ici très prochainement. En attendant, Mouaad peut vous transmettre les ventes récentes autour de votre adresse.</p>
      <div class="flex flex-wrap gap-3 mt-5"><a href="/contact?src=votre-rue" class="btn-primaire">Demander à Mouaad</a><a href="/situer-ma-vente?src=votre-rue" class="btn-secondaire">Situer ma vente</a></div></div>`;
  }
  function afficherAucun(label: string) {
    scene.hidden = false;
    scene.innerHTML = `<div class="vr-vide"><p class="font-display text-xl text-encre mb-2">Aucune vente retrouvée à proximité immédiate.</p>
      <p class="font-sans text-[15px] text-brun leading-relaxed">Autour de « ${esc(label)} », aucune vente ne figure pour l'instant dans les données publiques disponibles (DVF). Cette base n'est pas exhaustive.</p>
      <div class="flex flex-wrap gap-3 mt-5"><a href="/situer-ma-vente?src=votre-rue" class="btn-primaire">Situer ma vente</a><a href="/contact?src=votre-rue" class="btn-secondaire">Échanger avec Mouaad</a></div></div>`;
  }

  // ——— Moment d'analyse (adossé au calcul réel, sans fausse attente) ———
  async function jouerAnalyseEtRendre(lat: number, lon: number) {
    const messages = ['Recherche des ventes autour de chez vous…', 'Comparaison des ventes récentes…', "Lecture de l'évolution du secteur…"];
    scene.hidden = false;
    scene.innerHTML = `<div class="vr-analyse">${messages.map((m, i) => `<div class="vr-analyse-step" data-i="${i}"><span class="vr-analyse-dot"></span><span>${m}</span></div>`).join('')}</div>`;
    const steps = Array.from(scene.querySelectorAll<HTMLElement>('.vr-analyse-step'));
    const activer = (i: number) => steps.forEach((s, j) => { s.classList.toggle('is-active', j === i); s.classList.toggle('is-done', j < i); });

    activer(0);
    const model = computeModel(lat, lon); // calcul réel
    steps[0].classList.add('is-done');
    activer(1);
    activer(2);
    steps.forEach((s) => { s.classList.remove('is-active'); s.classList.add('is-done'); });


    if (!model) { afficherAucun(selection?.label || input.value); return; }
    lastModel = model;
    construireStack(model);
    const head=scene.querySelector<HTMLElement>('.vr-head');
    if(head){head.tabIndex=-1;head.focus({preventScroll:true});head.scrollIntoView({block:'start',behavior:'instant'});}

  }

  // ——— Autocomplétion ———
  let debounce = 0, activeIdx = -1, currentSugs: any[] = [];
  const fermerSug = () => { sugList.hidden = true; input.setAttribute('aria-expanded', 'false'); activeIdx = -1; input.removeAttribute('aria-activedescendant'); };
  function rendreSug(feats: any[]) {
    currentSugs = feats;
    if (!feats.length) { fermerSug(); return; }
    sugList.innerHTML = feats.map((f, i) => { const pr = f.properties || {}; const sub = [pr.postcode, pr.city].filter(Boolean).join(' '); return `<li role="option" id="vr-sug-${i}" aria-selected="false" data-idx="${i}">${esc(pr.label || pr.name || '')}<span class="vr-sug-sub">${esc(sub)}</span></li>`; }).join('');
    sugList.hidden = false; input.setAttribute('aria-expanded', 'true'); activeIdx = -1;
  }
  function choisir(i: number) {
    const f = currentSugs[i]; if (!f) return;
    const [lon, lat] = f.geometry.coordinates;
    selection = { lon, lat, label: f.properties?.label || input.value };
    input.value = selection.label; window.clearTimeout(debounce); fermerSug(); lancer();
  }
  input.addEventListener('input', () => {
    selection = null; geoErreur.classList.add('hidden');
    const q = input.value.trim(); window.clearTimeout(debounce);
    if (q.length < 3) { fermerSug(); return; }
    debounce = window.setTimeout(async () => { try { const choices=await geocoder(q,true,6); if(input.value.trim()===q&&!selection)rendreSug(choices); } catch { fermerSug(); } }, 260);
  });
  input.addEventListener('keydown', (e) => {
    if (sugList.hidden) return;
    const items = Array.from(sugList.querySelectorAll('li'));
    if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, items.length - 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); }
    else if (e.key === 'Enter' && activeIdx >= 0) { e.preventDefault(); choisir(activeIdx); return; }
    else if (e.key === 'Escape') { fermerSug(); return; } else return;
    items.forEach((el, i) => el.setAttribute('aria-selected', i === activeIdx ? 'true' : 'false'));
    if (items[activeIdx]) {input.setAttribute('aria-activedescendant',items[activeIdx].id);items[activeIdx].scrollIntoView({ block: 'nearest' });}
  });
  sugList.addEventListener('click', (e) => { const li = (e.target as HTMLElement).closest('li'); if (li) choisir(Number((li as HTMLElement).dataset.idx)); });
  document.addEventListener('click', (e) => { if (!form.contains(e.target as Node)) fermerSug(); });

  // ——— Lancement ———
  async function lancer() {
    geoErreur.classList.add('hidden');
    scene.hidden = false;
    scene.innerHTML = `<div class="vr-analyse"><div class="vr-analyse-step is-active"><span class="vr-analyse-dot"></span><span>Recherche des ventes autour de chez vous…</span></div></div>`;
    try { await chargerDonnees(); } catch {
      geoErreur.textContent = 'Impossible de charger les données pour le moment. Réessayez dans un instant.';
      geoErreur.classList.remove('hidden'); scene.hidden = true; return;
    }
    if (!meta || meta.status !== 'ready' || !dataset || !dataset.length) { afficherDonneesEnAttente(); return; }

    let coords = selection;
    if (!coords) {
      const q = input.value.trim();
      if (q.length < 3) { scene.hidden = true; geoErreur.textContent = "Indiquez d'abord votre rue ou votre adresse."; geoErreur.classList.remove('hidden'); return; }
      try { const feats = await geocoder(q, false, 6); if (!feats.length) { afficherAucun(q); return; } scene.hidden=true; rendreSug(feats); input.focus(); geoErreur.textContent='Choisissez l’adresse à explorer dans la liste.'; geoErreur.classList.remove('hidden'); return; }
      catch { geoErreur.textContent = 'Adresse non reconnue. Précisez la rue et la commune.'; geoErreur.classList.remove('hidden'); scene.hidden = true; return; }
    }
    await jouerAnalyseEtRendre(coords.lat, coords.lon);
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); fermerSug(); lancer(); });
  const initialQuery=new URLSearchParams(location.search).get('q');
  if(initialQuery&&initialQuery.length>=3&&initialQuery.length<=180){
    input.value=initialQuery;
    if(new URLSearchParams(location.search).get('confirmee')==='1'){
      (async()=>{try{const choices=await geocoder(initialQuery,false,6);const exact=choices.find(f=>f.properties?.label===initialQuery);if(exact){const [lon,lat]=exact.geometry.coordinates;selection={lon,lat,label:initialQuery};lancer();}else{rendreSug(choices);input.focus();}}catch{geoErreur.textContent='La recherche est momentanément indisponible. Réessayez.';geoErreur.classList.remove('hidden');}})();
    }else{input.dispatchEvent(new Event('input',{bubbles:true}));input.focus();}
  }

</script>
