---
import Layout from '../layouts/Layout.astro';

// Données calculées depuis les CSV DVF officiels (commune 28209), millésimes 2024 et 2025.
// 121 ventes de maisons et appartements, dédupliquées par id_mutation + (type, surface, pièces, parcelle).
// 4 vraies ventes en bloc exclues. Méthode validée par contre-vérification externe juin 2026.
// Images : vues streetview Yanport (pix.yanport.com), anonymes, sans identification du bien.

const secteurs = [
  {
    nom: "Sud — quartiers récents",
    n: 36, detail: "10 maisons · 26 appartements",
    medianes: [["Maisons", "235 450 €"], ["Appartements", "123 000 €"]],
    rues: "Rues Primo Levi, George Sand, Pablo Neruda, Louise Michel, Charles Darwin, Nelson Mandela, d'Ouarville, de Longsault, résidence des Marcoins",
    biens: [
      { type: "Appartement", surface: 39, pieces: 2, prix: "104 900 €", rue: "Rue George Sand", date: "nov 2025", img: "https://pix.yanport.com/cities/47893941/streetview/2-rue-george-sand.jpeg" },
      { type: "Appartement", surface: 44, pieces: 2, prix: "130 000 €", rue: "Rue Primo Levi", date: "oct 2025", img: "https://pix.yanport.com/cities/47893941/streetview/15-rue-primo-levi.jpeg" },
    ],
  },
  {
    nom: "Avenue de la Paix / Vaux de Lèves",
    n: 28, detail: "9 maisons · 19 appartements",
    medianes: [["Maisons", "178 250 €"], ["Appartements", "110 000 €"]],
    rues: "Avenue de la Paix, rue des Vaux de Lèves, rue Hoche Allart",
    biens: [
      { type: "Maison", surface: 64, pieces: 4, prix: "178 250 €", rue: "Avenue de la Paix", date: "déc 2025", img: "https://pix.yanport.com/cities/47893941/streetview/66-av-de-la-paix.jpeg" },
      { type: "Appartement", surface: 49, pieces: 2, prix: "149 900 €", rue: "Rue des Vaux de Lèves", date: "sep 2025", img: "https://pix.yanport.com/cities/47893941/streetview/4-rue-des-vaux-de-leves.jpeg" },
    ],
  },
  {
    nom: "Centre et abords",
    n: 13, detail: "13 maisons",
    medianes: [["Maisons", "230 000 €"]],
    rues: "Rues de la Voie Romaine, des Picheloups, des Osiers, du Bois Lion, Jean Jaurès, Bernard Jumentier, de la Chacatière, avenues Soutine et Gérard Philipe, allée des Charmes",
    biens: [
      { type: "Maison", surface: 89, pieces: 5, prix: "208 000 €", rue: "Rue du Bois Lion", date: "déc 2025", img: "https://pix.yanport.com/cities/47893941/streetview/1-rue-du-bois-lion.jpeg" },
      { type: "Maison", surface: 111, pieces: 5, prix: "300 000 €", rue: "Rue Bernard Jumentier", date: "sep 2025", img: "https://pix.yanport.com/cities/47893941/streetview/4-rue-bernard-jumentier.jpeg" },
    ],
  },
  {
    nom: "Nord-Ouest — Chavannes / Proust",
    n: 17, detail: "17 maisons",
    medianes: [["Maisons", "202 950 €"]],
    rues: "Route de Chavannes, avenue Marcel Proust, rue des Hauts de Fresnay, allées du Clos Renault, des Buissons, des Perdrix et des Bleuets",
    biens: [
      { type: "Maison", surface: 67, pieces: 4, prix: "205 000 €", rue: "Allée des Perdrix", date: "sep 2025", img: "https://pix.yanport.com/cities/47893941/streetview/3-all-des-perdrix.jpeg" },
      { type: "Maison", surface: 94, pieces: 4, prix: "175 000 €", rue: "Avenue Marcel Proust", date: "aoû 2025", img: "https://pix.yanport.com/cities/47893941/streetview/72-av-marcel-proust.jpeg" },
    ],
  },
  {
    nom: "Nord-Est — Bailleau / Jean Moulin",
    n: 24, detail: "23 maisons · 1 appartement",
    medianes: [["Maisons", "206 450 €"]],
    rues: "Rues de Bailleau, des Trois Maisons, Jean Moulin, Jules Vallain, du Bout du Val, Alphonse Jacquet, route du Bois de Lèves",
    biens: [
      { type: "Maison", surface: 96, pieces: 4, prix: "220 000 €", rue: "Rue Jean Moulin", date: "déc 2025", img: "https://pix.yanport.com/cities/47893941/streetview/9-rue-jean-moulin.jpeg" },
      { type: "Maison", surface: 90, pieces: 4, prix: "110 000 €", rue: "Rue de Bailleau", date: "déc 2025", img: "https://pix.yanport.com/cities/47893941/streetview/6-rue-de-bailleau.jpeg" },
    ],
  },
];
---

<Layout
  title="Prix immobilier à Lèves — les ventes réelles, quartier par quartier"
  description="Prix immobilier à Lèves (28300) : 121 ventes réelles 2024-2025 issues des données publiques des notaires (DVF). Prix médians par quartier, exemples concrets avec photos."
>

  <article class="max-w-page mx-auto px-edge md:px-edge-md pt-section md:pt-section-md pb-section-md">

    <!-- HERO -->
    <header class="mb-12 md:mb-16 max-w-editorial fade-up">
      <div class="eyebrow mb-6">Données notaires · Lèves 28300</div>
      <h1 class="text-hero text-sapin leading-[0.95] mb-8">
        Combien s'est vendue<br/>
        <em class="font-normal italic text-sapin-deep">la dernière maison de votre rue ?</em>
      </h1>
      <span class="rule-ocre"></span>
    </header>

    <!-- INTRO PERSONNELLE -->
    <section class="mb-12 max-w-prose fade-up">
      <p class="text-body-lg text-muted leading-relaxed">
        J'ai compilé ces chiffres parce qu'ils n'existaient pas sous cette forme pour Lèves.
        Quand un habitant me demande ce que vaut sa maison, je préfère lui montrer ce qui
        s'est réellement vendu autour de chez lui — plutôt que de balancer un chiffre sorti
        d'un algorithme qui n'a jamais mis les pieds dans le quartier.
      </p>
      <p class="text-body-lg text-muted leading-relaxed mt-4">
        Ce que vous voyez ici, c'est la réalité du marché. Pas des estimations, pas des
        moyennes nationales — des actes de vente enregistrés chez les notaires. La différence
        entre un bien qui se vend en quelques semaines et le même bien qui reste invendu un an,
        c'est rarement ce qu'on croit : c'est souvent une question de comprendre à qui il
        correspond, pourquoi il est vendu, et comment le mettre en valeur pour que les bonnes
        personnes s'y projettent.
      </p>
    </section>

    <!-- CHIFFRES GLOBAUX -->
    <section class="mb-section md:mb-section-md fade-up">
      <div class="grid sm:grid-cols-3 gap-px bg-beige border border-beige">
        <div class="bg-cream p-6 md:p-8">
          <div class="eyebrow-muted mb-3">Sur deux ans</div>
          <div class="text-display text-sapin leading-none mb-2">121</div>
          <p class="text-[15px] text-muted">ventes de maisons et d'appartements enregistrées à Lèves en 2024 et 2025.</p>
        </div>
        <div class="bg-cream-soft p-6 md:p-8">
          <div class="eyebrow-muted mb-3">Maisons · 75 ventes</div>
          <div class="text-display text-sapin leading-none mb-2">210 000 €</div>
          <p class="text-[15px] text-muted">prix médian, soit environ 2 329 €/m².</p>
        </div>
        <div class="bg-cream-soft p-6 md:p-8">
          <div class="eyebrow-muted mb-3">Appartements · 46 ventes</div>
          <div class="text-display text-sapin leading-none mb-2">117 660 €</div>
          <p class="text-[15px] text-muted">prix médian, soit environ 2 407 €/m².</p>
        </div>
      </div>
      <p class="text-[13px] text-muted mt-4">
        Source : données publiques DVF · arrêtées à décembre 2025 · prochaine mise à jour avec l'observatoire trimestriel.
      </p>
    </section>

    <!-- PAR SECTEUR avec cartes visuelles -->
    <section class="mb-section md:mb-section-md">
      <h2 class="text-h2 text-sapin mb-3 fade-up">Quartier par quartier</h2>
      <span class="rule-ocre fade-up"></span>
      <p class="text-body-lg text-muted max-w-prose mt-6 mb-12 fade-up">
        Retrouvez votre rue dans la liste sous chaque secteur — c'est elle qui compte,
        plus que le nom du secteur.
      </p>

      <div class="space-y-12">
        {secteurs.map((s) => (
          <div class="fade-up">
            <!-- En-tête secteur -->
            <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-2 mb-4 pb-4 border-b border-beige">
              <h3 class="text-h3 text-sapin">{s.nom}</h3>
              <div class="eyebrow-muted shrink-0">{s.n} ventes · {s.detail}</div>
            </div>

            <!-- Médianes -->
            <div class="flex flex-wrap gap-x-10 gap-y-2 mb-6">
              {s.medianes.map(([label, val]) => (
                <div>
                  <span class="text-[13px] uppercase tracking-wider text-muted">{label}, prix médian</span>
                  <div class="text-h3 text-sapin">{val}</div>
                </div>
              ))}
            </div>

            <!-- Cartes visuelles -->
            <div class="grid sm:grid-cols-2 gap-4 mb-5">
              {s.biens.map((b) => (
                <div class="border border-beige rounded-md overflow-hidden bg-cream">
                  <div class="aspect-[16/9] overflow-hidden bg-beige">
                    <img
                      src={b.img}
                      alt={`Vue de ${b.rue} à Lèves`}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-4">
                    <div class="flex items-start justify-between gap-2 mb-2">
                      <div>
                        <div class="eyebrow-muted mb-1">{b.type} · {b.date}</div>
                        <div class="text-[15px] text-ink font-medium">{b.rue}</div>
                      </div>
                      <div class="text-right shrink-0">
                        <div class="text-h3 text-sapin">{b.prix}</div>
                      </div>
                    </div>
                    <div class="flex gap-4 text-[13px] text-muted mt-2">
                      <span>{b.surface} m²</span>
                      {b.pieces && <span>{b.pieces} pièces</span>}
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <!-- Rues du secteur -->
            <p class="text-[13px] text-muted leading-relaxed">
              <span class="uppercase tracking-wider">Principales rues :</span> {s.rues}.
            </p>
          </div>
        ))}
      </div>

      <!-- Butte Celtique + disclaimer -->
      <div class="mt-10 max-w-prose fade-up">
        <p class="text-[15px] text-muted">
          Et un mot sur le quartier de la Butte Celtique — celui où j'habite :
          aucune revente n'y a été enregistrée en 2024-2025. C'est un quartier
          récent, où l'on s'installe et où l'on reste.
        </p>
        <p class="text-[13px] italic text-muted mt-3">
          Découpage indicatif, affiné au fil des retours d'habitants. Les vues de rue
          sont fournies par Yanport et n'identifient pas le bien vendu.
        </p>
      </div>
    </section>

    <!-- VOTRE RUE N'APPARAÎT PAS -->
    <section class="mb-section md:mb-section-md fade-up">
      <div class="border border-beige rounded-md p-6 md:p-8 max-w-editorial">
        <h2 class="text-h3 text-sapin mb-3">Votre rue n'est pas dans les données ?</h2>
        <p class="text-[15px] text-muted leading-relaxed mb-6">
          Les données DVF couvrent les ventes enregistrées chez les notaires —
          certaines rues n'ont eu aucune transaction en 2024-2025. C'est aussi
          une information : un quartier stable où l'on reste. Si vous voulez
          un point précis sur votre adresse, dites-le moi directement : je vous
          réponds personnellement.
        </p>
        <form
          action="https://formspree.io/f/xnjynroj"
          method="POST"
          class="space-y-4"
        >
          <input type="hidden" name="_subject" value="Demande adresse spécifique" />
          <input type="hidden" name="_next" value="https://levois.fr/merci" />
          <label class="block">
            <span class="text-eyebrow uppercase text-muted">Votre email (facultatif)</span>
            <input
              type="email"
              name="email"
              class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin text-[15px]"
              placeholder="prenom@exemple.fr"
            />
          </label>
          <label class="block">
            <span class="text-eyebrow uppercase text-muted">Votre rue</span>
            <input
              type="text"
              name="rue"
              required
              class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin text-[15px]"
              placeholder="Ex : Allée des Bleuets"
            />
          </label>
          <button
            type="submit"
            class="inline-flex items-center gap-3 bg-sapin text-cream px-6 py-3 rounded-full hover:bg-sapin-deep transition-colors text-[15px]"
          >
            M'envoyer une réponse personnelle
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
          </button>
          <p class="text-[12px] text-muted">
            C'est moi qui réponds, sous 24h. Un échange, rien de plus.
          </p>
        </form>
      </div>
    </section>

    <!-- GÉORISQUES -->
    <section class="mb-section md:mb-section-md fade-up">
      <div class="border border-beige/60 rounded-md p-6 md:p-8 max-w-editorial bg-cream-soft">
        <div class="eyebrow-muted mb-3">Autre ressource utile pour votre bien</div>
        <h2 class="text-h3 text-sapin mb-3">État des risques de votre adresse</h2>
        <p class="text-[15px] text-muted leading-relaxed mb-5">
          Avant toute vente ou achat à Lèves, vous pouvez consulter l'état des
          risques de votre adresse en 30 secondes — c'est gratuit, officiel,
          et obligatoire dans tout compromis de vente.
        </p>
        <a
          href="https://errial.georisques.gouv.fr"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-eyebrow uppercase text-sapin hover:text-ocre transition-colors border-b border-sapin pb-1"
        >
          Consulter les risques de mon adresse (Géorisques)
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
        </a>
        <p class="text-[12px] text-muted mt-3">
          Service public officiel, aucune donnée transmise à levois.fr.
        </p>
      </div>
    </section>

    <!-- MICRO-IDENTITÉ -->
    <section class="mb-section md:mb-section-md fade-up">
      <div class="flex items-center gap-5 bg-cream-soft border border-beige rounded-md p-6 md:p-8 max-w-editorial">
        <img
          src="/portrait-avatar.webp"
          alt="Mouaad Boullourou"
          width="72"
          height="72"
          class="w-16 h-16 rounded-full object-cover border border-beige shrink-0"
          loading="lazy"
        />
        <p class="text-[15px] text-ink/85 leading-relaxed">
          Mouaad, votre voisin rue de la Butte Celtique. Conseiller immobilier
          indépendant SAFTI, disponible 7j/7. Je tiens ces chiffres à jour pour
          les habitants de Lèves.
        </p>
      </div>
    </section>

    <!-- OPT-IN OBSERVATOIRE -->
    <section class="bg-sapin text-cream rounded-md p-8 md:p-12 mb-section fade-up">
      <div class="max-w-editorial">
        <div class="text-eyebrow uppercase tracking-widest text-ocre-soft mb-4">Rester informé</div>
        <h2 class="text-h2 mb-4">
          Recevez la mise à jour de ces chiffres<br/>
          <em class="italic font-normal">chaque trimestre.</em>
        </h2>
        <p class="text-[15px] opacity-80 leading-relaxed mb-10 max-w-prose">
          L'observatoire immobilier de Lèves, gratuit, par email. Désinscription
          en un clic à tout moment.
        </p>
        <form
          action="https://formspree.io/f/xnjynroj"
          method="POST"
          class="space-y-5"
        >
          <input type="hidden" name="_subject" value="[Votre rue] Inscription observatoire" />
          <input type="hidden" name="_next" value="https://levois.fr/merci" />
          <div class="grid sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="text-eyebrow uppercase text-ocre-soft">Prénom</span>
              <input type="text" name="prenom" class="mt-1 w-full bg-sapin-deep border border-ocre/30 text-cream rounded-md px-4 py-2.5 focus:outline-none focus:border-ocre placeholder-cream/40" />
            </label>
            <label class="block">
              <span class="text-eyebrow uppercase text-ocre-soft">Email *</span>
              <input type="email" name="email" required class="mt-1 w-full bg-sapin-deep border border-ocre/30 text-cream rounded-md px-4 py-2.5 focus:outline-none focus:border-ocre placeholder-cream/40" />
            </label>
          </div>
          <label class="flex items-start gap-3 text-xs opacity-80">
            <input type="checkbox" name="consentement" value="oui" required class="mt-0.5 accent-ocre" />
            <span>J'accepte de recevoir l'observatoire trimestriel par email. Désinscription en un clic à tout moment.</span>
          </label>
          <button type="submit" class="bg-ocre text-sapin-deep px-7 py-3.5 rounded-full hover:bg-ocre-soft transition-colors text-[15px] font-medium inline-flex items-center gap-3">
            M'inscrire
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
          </button>
        </form>
      </div>
    </section>

    <!-- PORTE DE SORTIE UNIQUE -->
    <section class="bg-cream-soft border border-beige rounded-md p-8 md:p-12 fade-up">
      <div class="max-w-editorial">
        <div class="eyebrow mb-4">Et pour votre bien ?</div>
        <h2 class="text-h2 text-sapin mb-4">
          Un doute sur le prix<br/>
          <em class="italic font-normal">de votre bien ?</em>
        </h2>
        <p class="text-body-lg text-muted leading-relaxed mb-8 max-w-prose">
          Ce qui s'est vendu dans votre secteur, c'est sur cette page. Ce qui est en vente
          en ce moment, ce qui n'a pas trouvé preneur et pourquoi — ça, c'est ce que je vous
          apporte en 20 minutes.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="tel:+33781380121" class="inline-flex items-center justify-center gap-2 bg-sapin text-cream px-5 py-3 rounded-full hover:bg-sapin-deep transition-colors text-[15px] font-medium">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.68A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            Appeler
          </a>
          <a href="sms:+33781380121" class="inline-flex items-center justify-center gap-2 border border-sapin text-sapin px-5 py-3 rounded-full hover:bg-sapin hover:text-cream transition-colors text-[15px] font-medium">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
            SMS
          </a>
          <a href="mailto:mouaad@levois.fr" class="inline-flex items-center justify-center gap-2 border border-sapin text-sapin px-5 py-3 rounded-full hover:bg-sapin hover:text-cream transition-colors text-[15px] font-medium">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Écrire
          </a>
        </div>
        <p class="text-[12px] text-muted mt-3">07 81 38 01 21 · mouaad@levois.fr · Disponible 7j/7</p>
      </div>
    </section>

  </article>
</Layout>
