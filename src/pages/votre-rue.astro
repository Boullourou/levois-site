---
/**
 * /votre-rue — expérience « infographie » du QR encart publicitaire.
 *
 * URL protégée (imprimée). Ne pas supprimer/renommer/rediriger sans validation.
 *
 * Transforme les DVF en une lecture immédiate, compréhensible en quelques
 * secondes par quelqu'un qui ne connaît rien à l'immobilier :
 *   adresse → courte analyse animée → 4 informations → « En clair »
 *   → ventes détaillées (facultatif) → tunnel de conversion.
 *
 * Honnêteté (impératif) : tout est calculé sur les vraies données DVF générées
 * par scripts/build-dvf.mjs. Aucun chiffre fictif. Aucun indicateur non
 * calculable (demande, délai de vente, visites, tension : jamais affichés ni
 * sous-entendus). Aucune estimation du bien du visiteur. Aucun faux temps de
 * chargement : les messages d'analyse accompagnent le calcul réel.
 *
 * Géocodage : Géoplateforme (BAN) — service actuel de l'État.
 * Conversion : les réponses de qualification + le contexte sont destinés à
 * /api/lead (backend migré à l'itération suivante — cf. commentaire d'envoi).
 */
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Les prix réels de votre secteur"
  description="Combien s'est vendue la dernière maison de votre quartier ? Les ventes réelles de votre secteur, à partir des données publiques DVF. Sans inscription."
  noindex={true}
>
  <div class="max-w-editorial mx-auto px-edge md:px-edge-md pt-10 md:pt-16 pb-section md:pb-section-md">

    <!-- ① Promesse + saisie -->
    <header class="mb-8 md:mb-10">
      <p class="eyebrow mb-4">Les prix réels de votre secteur · Lèves &amp; bassin chartrain</p>
      <h1 class="vr-titre text-encre mb-4">
        Combien s’est vendue la dernière maison de votre quartier&nbsp;?
      </h1>
      <p class="font-sans text-body-lg text-brun max-w-prose">
        Les ventes réellement enregistrées autour de chez vous.
        Sans inscription, sans qu’on vous rappelle. La réponse en 30&nbsp;secondes.
      </p>
      <p id="vr-fraicheur" class="vr-fraicheur" hidden></p>
    </header>

    <form id="vr-form" class="vr-search carte p-5 md:p-6" autocomplete="off" novalidate>
      <label for="vr-adresse" class="block font-sans text-sm text-brun mb-2">
        Votre rue ou votre adresse
      </label>
      <div class="vr-field">
        <div class="vr-combo">
          <input
            id="vr-adresse" type="text" name="adresse" inputmode="text"
            autocomplete="off" spellcheck="false"
            placeholder="Ex : rue de la République, Lèves"
            class="vr-input" role="combobox" aria-expanded="false"
            aria-controls="vr-suggestions" aria-autocomplete="list"
          />
          <ul id="vr-suggestions" class="vr-suggestions" role="listbox" aria-label="Adresses proposées" hidden></ul>
        </div>
        <button type="submit" id="vr-submit" class="btn-primaire vr-submit">Voir les ventes</button>
      </div>
      <p class="font-sans text-[13px] text-brun/70 mt-3">
        Aucune création de compte. Aucun e-mail ni téléphone demandé pour obtenir le résultat.
      </p>
      <p id="vr-geo-erreur" class="font-sans text-sm text-argile mt-2 hidden" role="alert"></p>
    </form>

    <!-- ②③④⑤⑥ Scène (analyse → infographie → En clair → détails → conversion) -->
    <section id="vr-scene" aria-live="polite" hidden></section>

    <!-- ⑦ Méthode & limites (accessibles mais discrètes) -->
    <details id="vr-methode" class="vr-methode">
      <summary>Méthode, source et limites</summary>
      <div class="vr-methode-corps">
        <p>
          Source : Demandes de valeurs foncières (DVF), DGFiP — données publiques ouvertes,
          géolocalisées par Etalab. Chaque vente affichée est une transaction réellement
          enregistrée.
        </p>
        <p>
          Les prix « médians » et les fourchettes sont calculés sur les ventes du même type de
          bien (maison ou appartement) dans un rayon autour de l’adresse. L’évolution est estimée
          par une droite de tendance (régression) sur les médianes annuelles du prix au m²
          (2021 à 2025), pour éviter qu’une seule année atypique ne fausse la lecture.
          Le pourcentage affiché compare la valeur de cette droite en 2025 à sa valeur en 2021
          (année de référence fixe, identique pour toutes les adresses) ; en dessous de ±3 %,
          les prix sont considérés comme globalement stables. Le pourcentage justifie la
          conclusion, il n’en est pas l’essentiel.
        </p>
        <p>
          Ce que ces données <strong>ne disent pas</strong> : la valeur précise de votre bien, la
          demande, les délais de vente, le nombre de visites. Une vente voisine est un repère de
          prix, pas une estimation de votre bien. La base DVF n’est pas exhaustive : certaines
          ventes peuvent en être absentes.
        </p>
      </div>
    </details>

  </div>
</Layout>

<!-- is:global OBLIGATOIRE : l'infographie est injectée en JS (innerHTML), donc
     sans l'attribut de scope Astro (data-astro-cid). Une feuille scopée ne
     matcherait aucun élément injecté → contenu rendu sans aucun style.
     Tous les sélecteurs sont préfixés .vr- : aucun risque de collision. -->
<style is:global>
  .vr-titre {
    font-family: 'Fraunces', Georgia, serif; font-weight: 500;
    font-size: clamp(1.9rem, 5vw, 3rem); line-height: 1.08; letter-spacing: -0.02em;
  }
  .vr-fraicheur {
    display: inline-flex; align-items: center; gap: 0.45rem; margin-top: 1rem;
    font-family: 'Instrument Sans', sans-serif; font-size: 0.85rem; color: #6B5D4F;
    background: #F0E2D8; border-radius: 999px; padding: 0.35rem 0.85rem;
  }
  .vr-fraicheur::before { content: ''; width: 7px; height: 7px; border-radius: 999px; background: #A85638; flex: 0 0 auto; }

  .vr-field { display: flex; flex-direction: column; gap: 0.75rem; }
  @media (min-width: 560px) { .vr-field { flex-direction: row; align-items: flex-start; } }
  .vr-combo { position: relative; flex: 1; }
  .vr-input {
    width: 100%; background: #F7F2EA; border: 1px solid #E8DFD0; border-radius: 12px;
    padding: 0.85rem 1rem; font-family: 'Instrument Sans', sans-serif; font-size: 1rem;
    color: #211C16; min-height: 52px;
  }
  .vr-input:focus { outline: 2px solid #A85638; outline-offset: 2px; border-color: #A85638; }
  .vr-submit { min-height: 52px; white-space: nowrap; }
  @media (max-width: 559px) { .vr-submit { width: 100%; } }

  .vr-suggestions {
    position: absolute; z-index: 20; left: 0; right: 0; top: calc(100% + 6px);
    background: #FDFBF6; border: 1px solid #E8DFD0; border-radius: 12px;
    box-shadow: 0 24px 48px -28px rgba(33,28,22,0.5);
    list-style: none; margin: 0; padding: 0.35rem; max-height: 320px; overflow-y: auto;
  }
  .vr-suggestions li {
    padding: 0.65rem 0.75rem; border-radius: 8px; cursor: pointer;
    font-family: 'Instrument Sans', sans-serif; font-size: 0.95rem; color: #211C16; line-height: 1.35;
  }
  .vr-suggestions li .vr-sug-sub { display: block; font-size: 0.82rem; color: #6B5D4F; }
  .vr-suggestions li[aria-selected="true"], .vr-suggestions li:hover { background: #F0E2D8; }

  /* ——— Analyse ——— */
  .vr-analyse { padding: 2.5rem 0 1rem; }
  .vr-analyse-step {
    display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0;
    font-family: 'Instrument Sans', sans-serif; font-size: 1.02rem; color: #B8AA97;
    transition: color 0.3s ease;
  }
  .vr-analyse-step.is-active { color: #211C16; }
  .vr-analyse-step.is-done { color: #6B5D4F; }
  .vr-analyse-dot {
    width: 20px; height: 20px; border-radius: 999px; flex: 0 0 auto; position: relative;
    border: 2px solid currentColor;
  }
  .vr-analyse-step.is-active .vr-analyse-dot::after {
    content: ''; position: absolute; inset: 3px; border-radius: 999px; background: #A85638;
    animation: vr-pulse 0.9s ease-in-out infinite;
  }
  .vr-analyse-step.is-done .vr-analyse-dot { background: #A85638; border-color: #A85638; }
  .vr-analyse-step.is-done .vr-analyse-dot::after {
    content: ''; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  }
  @keyframes vr-pulse { 0%,100% { transform: scale(0.7); opacity: 0.6; } 50% { transform: scale(1); opacity: 1; } }

  /* ——— Résultats : séquence compacte de cartes ——— */
  .vr-results { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; }
  .vr-head { margin: 0.25rem 0 0.1rem; }
  .vr-head-eyebrow { font-family: 'Instrument Sans', sans-serif; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #A85638; }
  .vr-head-adr { font-family: 'Instrument Sans', sans-serif; font-size: 0.95rem; color: #6B5D4F; margin-top: 0.25rem; }

  .vr-block { opacity: 0; transform: translateY(14px); transition: opacity 0.6s cubic-bezier(0.22,1,0.36,1), transform 0.6s cubic-bezier(0.22,1,0.36,1); }
  .vr-block.is-in { opacity: 1; transform: none; }

  .vr-card { background: #FDFBF6; border: 1px solid #E8DFD0; border-radius: 20px; padding: 1.5rem 1.35rem; }
  @media (min-width: 768px) { .vr-card { padding: 1.9rem; } }
  .vr-card--dark { background: #211C16; border-color: #211C16; }
  .vr-card--warm { background: #F0E2D8; border-color: #EAD9C7; }

  .vr-label { font-family: 'Instrument Sans', sans-serif; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #A85638; }
  .vr-card--dark .vr-label { color: #C97B52; }
  .vr-num { font-family: 'Fraunces', Georgia, serif; font-weight: 500; line-height: 1; letter-spacing: -0.02em; color: #211C16; }
  .vr-card--dark .vr-num { color: #F7F2EA; }
  .vr-sub { font-family: 'Instrument Sans', sans-serif; color: #6B5D4F; }
  .vr-card--dark .vr-sub { color: rgba(247,242,234,0.7); }

  /* B — compteur de ventes */
  .vr-b-num { font-size: clamp(3.4rem, 16vw, 5rem); }
  .vr-b-l { font-family: 'Instrument Sans', sans-serif; font-size: 1.1rem; color: #211C16; margin-top: 0.15rem; }
  .vr-b-sub { font-size: 0.9rem; margin-top: 0.45rem; }

  /* C — prix du milieu + curseur de fourchette */
  .vr-c-num { font-size: clamp(2.7rem, 12vw, 3.8rem); }
  .vr-c-lbl { margin-top: 0.55rem; }
  .vr-range { margin-top: 1.8rem; }
  .vr-range-line { position: relative; height: 3px; background: #E0D3BF; margin: 0 0.2rem; border-radius: 3px; }
  .vr-range-dot { position: absolute; top: 50%; width: 18px; height: 18px; border-radius: 999px; background: #A85638; box-shadow: 0 0 0 4px #FDFBF6, 0 2px 8px rgba(168,86,56,0.55); transform: translate(-50%, -50%); transition: left 0.9s cubic-bezier(0.22,1,0.36,1); }
  .vr-range-cap { position: absolute; top: -1.55rem; font-family: 'Instrument Sans', sans-serif; font-size: 0.92rem; color: #211C16; font-weight: 600; }
  .vr-range-cap.g { left: 0; } .vr-range-cap.d { right: 0; }
  .vr-range-arrows { display: flex; justify-content: space-between; color: #C0B29B; font-size: 1rem; margin-top: 0.35rem; padding: 0 0.1rem; }
  .vr-c-phrase { font-family: 'Instrument Sans', sans-serif; font-size: 0.98rem; color: #6B5D4F; margin-top: 1rem; line-height: 1.5; }
  .vr-c-m2 { font-family: 'Instrument Sans', sans-serif; font-size: 0.88rem; color: #6B5D4F; opacity: 0.85; margin-top: 0.55rem; }

  /* D — tendance : titre + jauge baisse/stable/hausse */
  .vr-d-head { display: flex; align-items: center; gap: 0.65rem; margin-top: 0.7rem; }
  .vr-d-ico { width: 32px; height: 32px; flex: 0 0 auto; }
  .vr-d-ico svg { width: 100%; height: 100%; }
  .vr-d-title { font-family: 'Fraunces', serif; font-weight: 500; font-size: clamp(1.4rem, 5vw, 1.9rem); line-height: 1.1; color: #211C16; }
  .vr-d-pct { font-family: 'Instrument Sans', sans-serif; font-size: 0.9rem; color: #6B5D4F; margin-top: 0.9rem; }
  .vr-gauge { margin-top: 1.3rem; }
  .vr-gauge-track { position: relative; height: 12px; border-radius: 999px; background: linear-gradient(90deg, #DCD2C0 0 33%, #EFE6D6 33% 67%, #E6C3AB 67% 100%); }
  .vr-gauge-cursor { position: absolute; top: -5px; width: 4px; height: 22px; border-radius: 2px; background: #211C16; transform: translateX(-50%); transition: left 0.9s cubic-bezier(0.22,1,0.36,1); }
  .vr-gauge-lbls { display: flex; justify-content: space-between; margin-top: 0.55rem; font-family: 'Instrument Sans', sans-serif; font-size: 0.76rem; letter-spacing: 0.08em; text-transform: uppercase; color: #9C8E7C; }
  .vr-gauge-lbls .on { color: #A85638; font-weight: 600; }

  /* A — dernière vente */
  .vr-a-num { font-size: clamp(2.5rem, 11vw, 3.4rem); margin-top: 0.7rem; }
  .vr-a-bien { font-family: 'Instrument Sans', sans-serif; font-size: 1.02rem; margin-top: 0.5rem; color: rgba(247,242,234,0.92); }
  .vr-a-meta { font-family: 'Instrument Sans', sans-serif; font-size: 0.92rem; margin-top: 0.35rem; }

  /* En clair */
  .vr-ec { font-family: 'Fraunces', serif; font-weight: 500; font-size: clamp(1.3rem, 4.6vw, 1.8rem); line-height: 1.32; color: #211C16; margin-top: 0.7rem; }
  .vr-maj { font-family: 'Instrument Sans', sans-serif; font-size: 0.8rem; color: #6B5D4F; margin-top: 0.9rem; }

  /* Ventes détaillées (secondaire) */
  .vr-details { margin-top: 0.1rem; }
  .vr-details summary {
    cursor: pointer; font-family: 'Instrument Sans', sans-serif; font-weight: 600; color: #A85638;
    padding: 0.9rem 0; list-style: none; display: inline-flex; align-items: center; gap: 0.5rem;
  }
  .vr-details summary::-webkit-details-marker { display: none; }
  .vr-details summary::before { content: '＋'; font-weight: 400; }
  .vr-details[open] summary::before { content: '－'; }
  .vr-autre { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem 1rem; padding: 0.85rem 0; border-top: 1px solid #EDE3D4; font-family: 'Instrument Sans', sans-serif; }
  .vr-autre-sub { display: block; font-size: 0.85rem; color: #6B5D4F; }
  .vr-autre-prix { font-weight: 600; color: #211C16; }

  /* ——— Conversion : rupture forte (carte sombre) ——— */
  .vr-conv { background: #211C16; color: #F7F2EA; border-radius: 24px; padding: 2rem 1.5rem; margin-top: 1.75rem; }
  @media (min-width: 768px) { .vr-conv { padding: 2.75rem; } }
  .vr-conv-eyebrow { font-family: 'Instrument Sans', sans-serif; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #C97B52; margin-bottom: 0.8rem; }
  .vr-conv-titre { font-family: 'Fraunces', serif; font-weight: 500; font-size: clamp(1.8rem, 6.5vw, 2.6rem); line-height: 1.08; color: #F7F2EA; margin-bottom: 0.7rem; }
  .vr-conv-intro { font-family: 'Instrument Sans', sans-serif; font-size: 1.02rem; line-height: 1.6; color: rgba(247,242,234,0.72); margin-bottom: 1.6rem; }
  .vr-paths { display: grid; gap: 0.7rem; }
  .vr-path { text-align: left; width: 100%; border: 0; border-radius: 16px; padding: 1.15rem 1.3rem; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1rem; transition: transform 0.2s, box-shadow 0.2s, background 0.2s, border-color 0.2s; }
  .vr-path-t { font-family: 'Fraunces', serif; font-weight: 500; font-size: 1.18rem; display: block; }
  .vr-path-d { font-family: 'Instrument Sans', sans-serif; font-size: 0.88rem; margin-top: 0.2rem; display: block; }
  .vr-path-arrow { flex: 0 0 auto; font-size: 1.15rem; }
  .vr-path--1 { background: #A85638; }
  .vr-path--1 .vr-path-t { color: #FBF3EC; } .vr-path--1 .vr-path-d { color: rgba(251,243,236,0.82); } .vr-path--1 .vr-path-arrow { color: #FBF3EC; }
  .vr-path--1:hover { background: #B5623F; transform: translateY(-2px); box-shadow: 0 18px 40px -22px rgba(168,86,56,0.85); }
  .vr-path--2 { background: #F7F2EA; }
  .vr-path--2 .vr-path-t { color: #211C16; } .vr-path--2 .vr-path-d { color: #6B5D4F; } .vr-path--2 .vr-path-arrow { color: #A85638; }
  .vr-path--2:hover { transform: translateY(-2px); box-shadow: 0 18px 40px -24px rgba(0,0,0,0.55); }
  .vr-path--3 { background: transparent; border: 1px solid rgba(247,242,234,0.26); }
  .vr-path--3 .vr-path-t { color: #F7F2EA; font-size: 1.04rem; } .vr-path--3 .vr-path-d { color: rgba(247,242,234,0.6); } .vr-path--3 .vr-path-arrow { color: rgba(247,242,234,0.6); }
  .vr-path--3:hover { border-color: #C97B52; }

  /* Panneau (qualif / contact / explorer) — carte claire imbriquée dans la conversion sombre */
  .vr-panneau { margin-top: 1.35rem; background: #FDFBF6; border-radius: 16px; padding: 1.5rem 1.35rem; }
  .vr-panneau:empty { display: none; }
  .vr-q-progress { display: flex; gap: 0.35rem; margin-bottom: 1.25rem; }
  .vr-q-dot { height: 4px; flex: 1; border-radius: 999px; background: #E8DFD0; }
  .vr-q-dot.is-on { background: #A85638; }
  .vr-q-label { font-family: 'Fraunces', serif; font-weight: 500; font-size: 1.35rem; line-height: 1.2; color: #211C16; margin-bottom: 1.1rem; }
  .vr-q-opts { display: grid; gap: 0.6rem; }
  .vr-q-opt {
    text-align: left; background: #F7F2EA; border: 1px solid #E8DFD0; border-radius: 12px;
    padding: 0.9rem 1.1rem; cursor: pointer; font-family: 'Instrument Sans', sans-serif; font-size: 1rem; color: #211C16;
    transition: border-color 0.15s, background 0.15s;
  }
  .vr-q-opt:hover { border-color: #A85638; background: #F0E2D8; }
  .vr-q-back { background: none; border: 0; color: #6B5D4F; font-family: 'Instrument Sans', sans-serif; font-size: 0.9rem; cursor: pointer; margin-top: 1rem; padding: 0.3rem 0; }
  .vr-q-back:hover { color: #A85638; }

  .vr-champ { display: block; margin-bottom: 0.9rem; }
  .vr-champ label { display: block; font-family: 'Instrument Sans', sans-serif; font-size: 0.9rem; color: #6B5D4F; margin-bottom: 0.4rem; }
  .vr-champ input {
    width: 100%; background: #F7F2EA; border: 1px solid #E8DFD0; border-radius: 12px; padding: 0.8rem 1rem;
    font-family: 'Instrument Sans', sans-serif; font-size: 1rem; color: #211C16; min-height: 50px;
  }
  .vr-champ input:focus { outline: 2px solid #A85638; outline-offset: 2px; border-color: #A85638; }
  .vr-consent { display: flex; align-items: flex-start; gap: 0.6rem; font-family: 'Instrument Sans', sans-serif; font-size: 0.88rem; color: #6B5D4F; line-height: 1.5; margin: 0.5rem 0 1rem; cursor: pointer; }
  .vr-consent input { margin-top: 0.15rem; width: 18px; height: 18px; accent-color: #A85638; flex: 0 0 auto; }
  .vr-contact-liens { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .vr-explorer { display: grid; gap: 0.6rem; }
  .vr-explorer a { display: block; background: #F7F2EA; border: 1px solid #E8DFD0; border-radius: 12px; padding: 0.9rem 1.1rem; font-family: 'Instrument Sans', sans-serif; color: #211C16; transition: border-color 0.15s; }
  .vr-explorer a:hover { border-color: #A85638; }
  .vr-explorer a b { font-family: 'Fraunces', serif; font-weight: 500; }

  .vr-vide { background: #FDFBF6; border: 1px solid #E8DFD0; border-radius: 20px; padding: 1.75rem 1.5rem; }

  .vr-methode { margin-top: 2.5rem; font-family: 'Instrument Sans', sans-serif; }
  .vr-methode summary { cursor: pointer; font-size: 0.85rem; color: #6B5D4F; }
  .vr-methode-corps { margin-top: 0.8rem; display: grid; gap: 0.7rem; }
  .vr-methode-corps p { font-size: 0.85rem; color: #6B5D4F; line-height: 1.6; }

  /* ——————————————————————————————————————————————————————————————
     Séquence cinématographique (scroll-driven, stage épinglé « à la Jack »)
     Piloté en continu par le scroll : chaque temps naît du précédent, morphing
     réversible. Repli empilé en reduced-motion (voir plus bas).
     —————————————————————————————————————————————————————————————— */
  .vr-cine { position: relative; }
  .vr-stage {
    position: sticky;
    top: var(--vr-header, 64px);
    height: calc(100svh - var(--vr-header, 64px));
    overflow: hidden;
    display: block;
    background: #F7F2EA;
    border-radius: 22px;
  }
  .vr-scene {
    position: absolute; inset: 0;
    display: flex; align-items: center;
    padding: 1.5rem clamp(1.25rem, 6vw, 3.5rem);
    opacity: 0; will-change: opacity, transform;
    background: #F7F2EA; color: #211C16;
  }
  .vr-scene[data-bg="vif"] { background: #FDFBF6; }
  .vr-scene[data-bg="encre"] { background: #211C16; color: #F7F2EA; }
  .vr-scene[data-bg="argile"] { background: #F0E2D8; }
  .vr-sc-inner { width: 100%; max-width: 34rem; margin: 0 auto; }

  .vr-sc-kicker { font-family: 'Instrument Sans', sans-serif; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #A85638; margin-bottom: 1.1rem; }
  .vr-scene[data-bg="encre"] .vr-sc-kicker { color: #C97B52; }
  .vr-sc-num { font-family: 'Fraunces', Georgia, serif; font-weight: 500; line-height: 0.98; letter-spacing: -0.02em; font-size: clamp(3.6rem, 20vw, 6.5rem); color: inherit; }
  .vr-sc-lead { font-family: 'Instrument Sans', sans-serif; font-size: clamp(1.05rem, 3.5vw, 1.35rem); margin-top: 0.6rem; }
  .vr-sc-note { font-family: 'Instrument Sans', sans-serif; font-size: 0.95rem; color: #6B5D4F; margin-top: 0.6rem; line-height: 1.5; }
  .vr-scene[data-bg="encre"] .vr-sc-note { color: rgba(247,242,234,0.66); }

  /* C — prix + curseur de fourchette (plein écran) */
  .vr-sc-range { margin-top: 2rem; }
  .vr-sc-range .vr-range-line { position: relative; height: 3px; background: #E0D3BF; margin: 0 0.2rem; border-radius: 3px; }
  .vr-sc-range .vr-range-dot { position: absolute; top: 50%; left: 50%; width: 20px; height: 20px; border-radius: 999px; background: #A85638; box-shadow: 0 0 0 5px #FDFBF6, 0 2px 8px rgba(168,86,56,0.55); transform: translate(-50%, -50%); }
  .vr-sc-range .vr-range-cap { position: absolute; top: -1.7rem; font-family: 'Instrument Sans', sans-serif; font-size: 0.95rem; color: #211C16; font-weight: 600; }
  .vr-sc-range .vr-range-cap.g { left: 0; } .vr-sc-range .vr-range-cap.d { right: 0; }
  .vr-sc-range .vr-range-arrows { display: flex; justify-content: space-between; color: #C0B29B; font-size: 1.05rem; margin-top: 0.4rem; }
  .vr-c-phrase { font-family: 'Instrument Sans', sans-serif; font-size: 1rem; color: #6B5D4F; margin-top: 1.2rem; line-height: 1.5; }
  .vr-c-m2 { font-family: 'Instrument Sans', sans-serif; font-size: 0.9rem; color: #6B5D4F; opacity: 0.85; margin-top: 0.55rem; }

  /* D — tendance plein écran */
  .vr-sc-dhead { display: flex; align-items: center; gap: 0.7rem; }
  .vr-sc-dico { width: 40px; height: 40px; flex: 0 0 auto; } .vr-sc-dico svg { width: 100%; height: 100%; }
  .vr-sc-title { font-family: 'Fraunces', serif; font-weight: 500; font-size: clamp(1.7rem, 6.5vw, 2.6rem); line-height: 1.08; }
  .vr-sc-gauge { margin-top: 1.7rem; }
  .vr-sc-gauge .vr-gauge-track { position: relative; height: 14px; border-radius: 999px; background: linear-gradient(90deg, #DCD2C0 0 33%, #EFE6D6 33% 67%, #E6C3AB 67% 100%); }
  .vr-sc-gauge .vr-gauge-cursor { position: absolute; top: -5px; left: 50%; width: 5px; height: 24px; border-radius: 2px; background: #211C16; transform: translateX(-50%); }
  .vr-sc-gauge .vr-gauge-lbls { display: flex; justify-content: space-between; margin-top: 0.6rem; font-family: 'Instrument Sans', sans-serif; font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: #9C8E7C; }
  .vr-sc-gauge .vr-gauge-lbls .on { color: #A85638; font-weight: 600; }
  .vr-d-pct { font-family: 'Instrument Sans', sans-serif; font-size: 0.9rem; color: #6B5D4F; margin-top: 1rem; }

  .vr-sc-ec { font-family: 'Fraunces', serif; font-weight: 500; font-size: clamp(1.5rem, 5.4vw, 2.2rem); line-height: 1.32; }

  /* Repère de progression de la séquence */
  .vr-cine-dots { position: absolute; left: 50%; bottom: 1.4rem; transform: translateX(-50%); display: flex; gap: 0.5rem; z-index: 6; }
  .vr-cine-dot { width: 7px; height: 7px; border-radius: 999px; background: rgba(107,93,79,0.28); transition: background 0.3s, transform 0.3s; }
  .vr-cine-dot.on { background: #A85638; transform: scale(1.35); }
  .vr-scene[data-bg="encre"] ~ .vr-cine-dots .vr-cine-dot { background: rgba(247,242,234,0.3); }

  .vr-after { margin-top: 1.5rem; }

  @media (prefers-reduced-motion: reduce) {
    .vr-block { opacity: 1; transform: none; transition: none; }
    .vr-range-dot, .vr-gauge-cursor { transition: none; }
    .vr-analyse-step.is-active .vr-analyse-dot::after { animation: none; }
    /* Séquence cinématographique désactivée : repli empilé lisible */
    .vr-stage { position: static; height: auto; overflow: visible; background: transparent; border-radius: 0; }
    .vr-scene { position: relative; opacity: 1 !important; transform: none !important; margin-bottom: 0.75rem; border-radius: 20px; }
    .vr-cine-dots { display: none; }
  }
</style>

<script>
  type Tx = {
    id: string; d: string; v: number; t: string; lat: number; lon: number;
    no?: string; vo?: string; cp?: string; co?: string; sb?: number; p?: number; st?: number; lots?: number;
  };
  type Meta = { status: string; generatedAt: string | null; dateVenteLaPlusRecente: string | null };

  const form = document.getElementById('vr-form') as HTMLFormElement;
  const input = document.getElementById('vr-adresse') as HTMLInputElement;
  const sugList = document.getElementById('vr-suggestions') as HTMLUListElement;
  const scene = document.getElementById('vr-scene') as HTMLElement;
  const geoErreur = document.getElementById('vr-geo-erreur') as HTMLElement;
  const fraicheurEl = document.getElementById('vr-fraicheur') as HTMLElement;

  const BIAIS = { lon: 1.4890, lat: 48.4470 };
  const GEOCODE = 'https://data.geopf.fr/geocodage/search';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const eur = new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 });
  const moisAn = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' });
  const jourMoisAn = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
  const dateComplete = (d: string) => { const dt = new Date(d + 'T00:00:00'); return isNaN(dt.getTime()) ? d : jourMoisAn.format(dt); };
  const dateMois = (d: string) => { const dt = new Date(d + 'T00:00:00'); return isNaN(dt.getTime()) ? d : moisAn.format(dt); };
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  const wait = (ms: number) => new Promise((r) => setTimeout(r, reduced ? 0 : ms));

  let dataset: Tx[] | null = null;
  let meta: Meta | null = null;
  let selection: { lon: number; lat: number; label: string } | null = null;
  let lastModel: any = null;

  // ——— Fraîcheur affichée d'emblée ———
  (async () => {
    try {
      const m = (await (await fetch('/data/dvf-meta.json')).json()) as Meta;
      meta = m;
      if (m.status === 'ready' && m.dateVenteLaPlusRecente) {
        fraicheurEl.textContent = `Données DVF disponibles jusqu’au ${dateComplete(m.dateVenteLaPlusRecente)}`;
        fraicheurEl.hidden = false;
      }
    } catch {}
  })();

  async function chargerDonnees() {
    if (dataset) return;
    const [d, m] = await Promise.all([fetch('/data/dvf-secteur.json'), fetch('/data/dvf-meta.json')]);
    dataset = (await d.json()) as Tx[];
    meta = (await m.json()) as Meta;
  }

  async function geocoder(q: string, autocomplete: boolean, limit: number) {
    const url = new URL(GEOCODE);
    url.searchParams.set('q', q);
    url.searchParams.set('limit', String(limit));
    url.searchParams.set('lon', String(BIAIS.lon));
    url.searchParams.set('lat', String(BIAIS.lat));
    if (autocomplete) url.searchParams.set('autocomplete', '1');
    const rep = await fetch(url.toString());
    if (!rep.ok) throw new Error(`geocode ${rep.status}`);
    const json = await rep.json();
    const feats = Array.isArray(json.features) ? json.features : [];
    return feats.filter((f: any) => String(f?.properties?.citycode || '').startsWith('28'));
  }

  function distance(aLat: number, aLon: number, bLat: number, bLon: number) {
    const R = 6371000;
    const dLat = ((bLat - aLat) * Math.PI) / 180, dLon = ((bLon - aLon) * Math.PI) / 180;
    const la1 = (aLat * Math.PI) / 180, la2 = (bLat * Math.PI) / 180;
    const h = Math.sin(dLat / 2) ** 2 + Math.cos(la1) * Math.cos(la2) * Math.sin(dLon / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h));
  }
  const distLisible = (m: number) => (m < 1000 ? `à environ ${Math.round(m / 50) * 50} m` : `à environ ${(m / 1000).toFixed(1).replace('.', ',')} km`);
  const median = (a: number[]) => { if (!a.length) return null; const s = [...a].sort((x, y) => x - y), m = Math.floor(s.length / 2); return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2; };
  const quantile = (a: number[], q: number) => { if (a.length < 2) return a[0] ?? null; const s = [...a].sort((x, y) => x - y); const pos = (s.length - 1) * q, b = Math.floor(pos), r = pos - b; return s[b + 1] !== undefined ? s[b] + r * (s[b + 1] - s[b]) : s[b]; };

  const multiLots = (t: Tx) => Boolean(t.lots && t.lots > 1);
  const typePluriel = (t: string) => (t === 'Maison' ? 'des maisons' : 'des appartements');
  const typePlurielNu = (t: string) => (t === 'Maison' ? 'maisons' : 'appartements');

  function bienCourt(t: Tx) {
    const b = [t.t]; if (t.sb) b.push(`${t.sb} m²`); if (t.p) b.push(`${t.p} pièce${t.p > 1 ? 's' : ''}`);
    if (multiLots(t)) b.push(`vente de ${t.lots} lots`);
    return b.join(' · ');
  }
  function adresse(t: Tx) {
    const rue = [t.no, t.vo].filter(Boolean).join(' '), ville = [t.cp, t.co].filter(Boolean).join(' ');
    return rue && ville ? `${rue}, ${ville}` : rue || ville || 'Adresse approximative';
  }

  // ——— Tendance : régression linéaire sur les médianes ANNUELLES du €/m² ———
  // Bien plus robuste que deux fenêtres isolées : utilise toutes les années
  // (2021→2025), amortit le bruit d'une année atypique, et reflète la tendance
  // de fond. Une comparaison de deux fenêtres pouvait afficher une « baisse »
  // là où le marché est en réalité stable (retour après un pic ponctuel).
  function computeTrend(all: any[], dom: string, minR: number) {
    // Échelle « secteur » : rayon d'au moins 1500 m pour des médianes annuelles
    // stables (les petits rayons font osciller la tendance d'année en année).
    const radii = minR >= 3000 ? [3000] : [minR, 3000];
    let arr: any[] = [];
    for (const r of radii) {
      const s = all.filter((t) => t._dist <= r && t.t === dom && !t.lots && t.sb);
      arr = s;
      if (s.length >= 150) break;
    }
    const xs: number[] = [], ys: number[] = [];
    for (let y = 2021; y <= 2025; y++) {
      const g = arr.filter((t) => t.d.startsWith(String(y))).map((t) => t.v / t.sb);
      if (g.length >= 20) { xs.push(y); ys.push(median(g) as number); } // année fiable seulement
    }
    if (xs.length < 3) return null; // pas assez de recul → pas de tendance affichée

    // Droite de régression (moindres carrés) sur les médianes annuelles.
    const ANNEE_REF = 2021, ANNEE_FIN = 2025; // bornes FIXES, identiques pour toute adresse
    const n = xs.length, x0 = xs[0];
    const X = xs.map((y) => y - x0);
    const sx = X.reduce((a, b) => a + b, 0), sy = ys.reduce((a, b) => a + b, 0);
    const sxx = X.reduce((a, b) => a + b * b, 0), sxy = X.reduce((a, b, i) => a + b * ys[i], 0);
    const slope = (n * sxy - sx * sy) / (n * sxx - sx * sx); // €/m² par an
    const intercept = (sy - slope * sx) / n;

    // ——— Conversion pente → pourcentage : RÈGLE UNIQUE, indépendante de l'adresse ———
    // On évalue la droite ajustée à deux années FIXES (2021 et 2025), jamais aux
    // années réellement présentes. Le pourcentage est la variation de la valeur
    // ajustée entre ces deux bornes, normalisée par la valeur ajustée de l'année
    // de RÉFÉRENCE CONSTANTE (2021) :
    //     delta% = (ajustée(2025) − ajustée(2021)) / ajustée(2021) × 100
    // La référence (2021) et l'amplitude (4 ans) ne dépendent jamais de l'adresse ;
    // seule la pente, elle, reflète les données locales.
    const yhat = (annee: number) => intercept + slope * (annee - x0);
    const ref = yhat(ANNEE_REF);
    const delta = ((yhat(ANNEE_FIN) - ref) / ref) * 100;

    // Seuil de stabilité : |delta| < 3 % → prix globalement stables.
    const dir = delta >= 3 ? 'hausse' : delta <= -3 ? 'baisse' : 'stable';
    return { delta, dir, anneeDebut: ANNEE_REF, anneeFin: ANNEE_FIN };
  }

  // ——— Modèle : tous les indicateurs, calculés sur les vraies données ———
  function computeModel(lat: number, lon: number) {
    const all = (dataset as Tx[]).map((t) => ({ ...t, _dist: distance(lat, lon, t.lat, t.lon) })).sort((a, b) => a._dist - b._dist);

    // A — dernière vente à proximité (rayon serré)
    let aSet: any[] = [];
    for (const r of [700, 1500, 3000]) { aSet = all.filter((t) => t._dist <= r); if (aSet.length) break; }
    if (!aSet.length) return null;
    const derniere = [...aSet].sort((a, b) => (a.d < b.d ? 1 : a.d > b.d ? -1 : a._dist - b._dist))[0];

    // Rayon de travail : plus petit rayon totalisant ≥ 150 ventes d'habitation
    const hab = (arr: any[]) => arr.filter((t) => (t.t === 'Maison' || t.t === 'Appartement') && !t.lots);
    let Rw = 3000, near = hab(all.filter((t) => t._dist <= 3000));
    for (const r of [700, 1500, 3000]) {
      const s = hab(all.filter((t) => t._dist <= r));
      if (s.length >= 150) { Rw = r; near = s; break; }
      if (r === 3000) { Rw = 3000; near = s; }
    }
    const nM = near.filter((t) => t.t === 'Maison').length, nA = near.filter((t) => t.t === 'Appartement').length;
    const dom = nM >= nA ? 'Maison' : 'Appartement';
    const domArr = near.filter((t) => t.t === dom);

    // B — nombre de ventes (habitation, dans Rw)
    const nbVentes = near.length;

    // C — prix médian + fourchette Q1–Q3 + €/m² médian (type dominant)
    const prices = domArr.map((t) => t.v);
    const ppm = domArr.filter((t) => t.sb).map((t) => t.v / (t.sb as number));
    const C = domArr.length >= 25 ? { median: median(prices), q1: quantile(prices, 0.25), q3: quantile(prices, 0.75), ppm: median(ppm), n: domArr.length } : null;

    // D — tendance €/m² 2022-2023 vs 2024-2025 (type dominant).
    // Rayon PROPRE, élargi jusqu'à ≥ 40 ventes/période pour éviter le bruit de
    // petit échantillon (une médiane locale sur ~15 ventes est instable et
    // pourrait afficher une « baisse » là où le secteur est en réalité stable).
    const D = computeTrend(all, dom, Math.max(Rw, 1500));

    const activite = domArr.filter((t) => t.d >= '2025').length >= 5;
    const autres = [...aSet].sort((a, b) => (a.d < b.d ? 1 : -1)).filter((t) => t.id !== derniere.id).slice(0, 4);

    return { derniere, dom, nbVentes, Rw, C, D, activite, autres };
  }

  // ——— « En clair » : phrases par règles fixes ———
  function enClair(model: any) {
    const s1 = model.activite
      ? `Autour de cette adresse, ${typePluriel(model.dom)} continuent de se vendre.`
      : `Autour de cette adresse, ${typePluriel(model.dom)} se vendent, mais plus rarement.`;
    let s2 = '';
    if (model.D) {
      if (model.D.dir === 'stable') s2 = 'Les prix observés sont globalement stables ces dernières années.';
      else if (model.D.dir === 'hausse') s2 = 'Les prix observés sont plutôt orientés à la hausse ces dernières années.';
      else s2 = 'Les prix observés sont plutôt orientés à la baisse ces dernières années.';
    }
    return { s1, s2 };
  }

  // ——— Animations ———
  function animeCompteur(el: HTMLElement, to: number, dur = 1100) {
    if (reduced) { el.textContent = eur.format(to); return; }
    const t0 = performance.now();
    const step = (now: number) => {
      const p = Math.min(1, (now - t0) / dur);
      const e = 1 - Math.pow(1 - p, 3);
      el.textContent = eur.format(Math.round(to * e));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  // Applique l'état final d'une animation de bloc (utilisé au reveal et en reduced-motion)
  function jouerAnim(el: HTMLElement, instantane: boolean) {
    const anim = el.dataset.anim;
    if (anim === 'count') {
      const n = el.querySelector<HTMLElement>('[data-count]');
      if (n) { if (instantane) n.textContent = eur.format(Number(n.dataset.count)); else animeCompteur(n, Number(n.dataset.count)); }
    } else if (anim === 'slider') {
      const dot = el.querySelector<HTMLElement>('.vr-range-dot');
      if (dot && dot.dataset.pos) dot.style.left = dot.dataset.pos;
    } else if (anim === 'gauge') {
      const cur = el.querySelector<HTMLElement>('.vr-gauge-cursor');
      if (cur && cur.dataset.pos) cur.style.left = cur.dataset.pos;
    }
  }

  const observer = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const el = e.target as HTMLElement;
      el.classList.add('is-in');
      jouerAnim(el, false);
      observer.unobserve(el);
    }
  }, { threshold: 0.3, rootMargin: '0px 0px -8% 0px' });

  function reveler(el: HTMLElement) {
    if (reduced) { el.classList.add('is-in'); jouerAnim(el, true); return; }
    observer.observe(el);
  }

  // ——— Rendu de l'infographie ———
  const rayonTxt = (r: number) => (r < 1000 ? `${r} m` : `${(r / 1000).toLocaleString('fr-FR')} km`);
  // Position du curseur sur la jauge baisse/stable/hausse : domaine [-10 %, +10 %].
  const gaugePos = (delta: number) => Math.max(4, Math.min(96, ((delta + 10) / 20) * 100));

  function iconeTendance(dir: string) {
    if (dir === 'hausse') return '<svg viewBox="0 0 24 24" fill="none" stroke="#A85638" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17L11 10l4 4 6-6"/><path d="M15 8h6v6"/></svg>';
    if (dir === 'baisse') return '<svg viewBox="0 0 24 24" fill="none" stroke="#8A7C6A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7l7 7 4-4 6 6"/><path d="M15 16h6v-6"/></svg>';
    return '<svg viewBox="0 0 24 24" fill="none" stroke="#8A7C6A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"/><path d="M16 8l4 4-4 4"/></svg>';
  }
  function tendanceTitre(dir: string) {
    if (dir === 'hausse') return 'Prix orientés à la hausse';
    if (dir === 'baisse') return 'Prix orientés à la baisse';
    return 'Prix globalement stables';
  }

  // Repli empilé (reduced-motion / secours) — cartes verticales lisibles.
  function construireStack(model: any) {
    const ec = enClair(model);
    const d = model.derniere;
    const parts: string[] = [];

    // En-tête
    parts.push(`
      <div class="vr-head">
        <p class="vr-head-eyebrow">Autour de cette adresse</p>
        ${selection?.label ? `<p class="vr-head-adr">${esc(selection.label)}</p>` : ''}
      </div>`);

    // ① B — combien de ventes
    parts.push(`
      <div class="vr-block" data-anim="count">
        <div class="vr-card">
          <p class="vr-num vr-b-num"><span data-count="${model.nbVentes}">0</span></p>
          <p class="vr-b-l">ventes retrouvées</p>
          <p class="vr-sub vr-b-sub">dans un rayon d’environ ${rayonTxt(model.Rw)} · depuis 2021</p>
        </div>
      </div>`);

    // ② C — le prix du milieu
    if (model.C) {
      const q1 = Math.round(model.C.q1), q3 = Math.round(model.C.q3), med = Math.round(model.C.median);
      const pos = q3 > q1 ? Math.max(6, Math.min(94, ((med - q1) / (q3 - q1)) * 100)) : 50;
      parts.push(`
        <div class="vr-block" data-anim="slider">
          <div class="vr-card">
            <p class="vr-num vr-c-num">${eur.format(med)} €</p>
            <p class="vr-label vr-c-lbl">Le prix du milieu</p>
            <div class="vr-range">
              <div class="vr-range-line">
                <span class="vr-range-cap g">${eur.format(q1)} €</span>
                <span class="vr-range-cap d">${eur.format(q3)} €</span>
                <span class="vr-range-dot" data-pos="${pos.toFixed(0)}%" style="left:50%"></span>
              </div>
              <div class="vr-range-arrows" aria-hidden="true"><span>←</span><span>→</span></div>
              <p class="vr-c-phrase">La moitié des ${esc(typePlurielNu(model.dom))} se sont vendues entre <strong>${eur.format(q1)} €</strong> et <strong>${eur.format(q3)} €</strong>.</p>
              ${model.C.ppm ? `<p class="vr-c-m2">≈ ${eur.format(Math.round(model.C.ppm))} €/m²</p>` : ''}
            </div>
          </div>
        </div>`);
    }

    // ③ D — la tendance
    if (model.D) {
      const pct = `${model.D.delta >= 0 ? '+' : ''}${model.D.delta.toFixed(1).replace('.', ',')} %`;
      const pos = gaugePos(model.D.delta), dir = model.D.dir;
      parts.push(`
        <div class="vr-block" data-anim="gauge">
          <div class="vr-card">
            <p class="vr-label">Les prix, dans le temps</p>
            <div class="vr-d-head">
              <span class="vr-d-ico" aria-hidden="true">${iconeTendance(dir)}</span>
              <span class="vr-d-title">${tendanceTitre(dir)}</span>
            </div>
            <div class="vr-gauge">
              <div class="vr-gauge-track"><span class="vr-gauge-cursor" data-pos="${pos.toFixed(0)}%" style="left:50%"></span></div>
              <div class="vr-gauge-lbls">
                <span class="${dir === 'baisse' ? 'on' : ''}">Baisse</span>
                <span class="${dir === 'stable' ? 'on' : ''}">Stable</span>
