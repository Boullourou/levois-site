---
/**
 * /votre-rue — expérience « infographie » du QR encart publicitaire.
 *
 * URL protégée (imprimée). Ne pas supprimer/renommer/rediriger sans validation.
 *
 * Transforme les DVF en une lecture immédiate, compréhensible en quelques
 * secondes par quelqu'un qui ne connaît rien à l'immobilier :
 *   adresse → courte analyse animée → 4 informations → « En clair »
 *   → ventes détaillées (facultatif) → tunnel de conversion.
 *
 * Honnêteté (impératif) : tout est calculé sur les vraies données DVF générées
 * par scripts/build-dvf.mjs. Aucun chiffre fictif. Aucun indicateur non
 * calculable (demande, délai de vente, visites, tension : jamais affichés ni
 * sous-entendus). Aucune estimation du bien du visiteur. Aucun faux temps de
 * chargement : les messages d'analyse accompagnent le calcul réel.
 *
 * Géocodage : Géoplateforme (BAN) — service actuel de l'État.
 * Conversion : les réponses de qualification + le contexte sont destinés à
 * /api/lead (backend migré à l'itération suivante — cf. commentaire d'envoi).
 */
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Les prix réels de votre secteur"
  description="Combien s'est vendue la dernière maison de votre quartier ? Les ventes réelles de votre secteur, à partir des données publiques DVF. Sans inscription."
  noindex={true}
>
  <div class="max-w-editorial mx-auto px-edge md:px-edge-md pt-10 md:pt-16 pb-section md:pb-section-md">

    <!-- ① Promesse + saisie -->
    <header class="mb-8 md:mb-10">
      <p class="eyebrow mb-4">Les prix réels de votre secteur · Lèves &amp; bassin chartrain</p>
      <h1 class="vr-titre text-encre mb-4">
        Combien s'est vendue la dernière maison de votre quartier&nbsp;?
      </h1>
      <p class="font-sans text-body-lg text-brun max-w-prose">
        Les ventes réellement enregistrées autour de chez vous.
        Sans inscription, sans qu'on vous rappelle. La réponse en 30&nbsp;secondes.
      </p>
      <p id="vr-fraicheur" class="vr-fraicheur" hidden></p>
    </header>

    <form id="vr-form" class="vr-search carte p-5 md:p-6" autocomplete="off" novalidate>
      <label for="vr-adresse" class="block font-sans text-sm text-brun mb-2">
        Votre rue ou votre adresse
      </label>
      <div class="vr-field">
        <div class="vr-combo">
          <input
            id="vr-adresse" type="text" name="adresse" inputmode="text"
            autocomplete="off" spellcheck="false"
            placeholder="Ex : rue de la République, Lèves"
            class="vr-input" role="combobox" aria-expanded="false"
            aria-controls="vr-suggestions" aria-autocomplete="list"
          />
          <ul id="vr-suggestions" class="vr-suggestions" role="listbox" aria-label="Adresses proposées" hidden></ul>
        </div>
        <button type="submit" id="vr-submit" class="btn-primaire vr-submit">Voir les ventes</button>
      </div>
      <p class="font-sans text-[13px] text-brun/70 mt-3">
        Aucune création de compte. Aucun e-mail ni téléphone demandé pour obtenir le résultat.
      </p>
      <p id="vr-geo-erreur" class="font-sans text-sm text-argile mt-2 hidden" role="alert"></p>
    </form>

    <!-- ②③④⑤⑥ Scène (analyse → infographie → En clair → détails → conversion) -->
    <section id="vr-scene" aria-live="polite" hidden></section>

    <!-- ⑦ Méthode & limites (accessibles mais discrètes) -->
    <details id="vr-methode" class="vr-methode">
      <summary>Méthode, source et limites</summary>
      <div class="vr-methode-corps">
        <p>
          Source : Demandes de valeurs foncières (DVF), DGFiP — données publiques ouvertes,
          géolocalisées par Etalab. Chaque vente affichée est une transaction réellement
          enregistrée.
        </p>
        <p>
          Les prix « médians » et les fourchettes sont calculés sur les ventes du même type de
          bien (maison ou appartement) dans un rayon autour de l'adresse. L'évolution est estimée
          par une droite de tendance (régression) sur les médianes annuelles du prix au m²
          (2021 à 2025), pour éviter qu'une seule année atypique ne fausse la lecture.
          Le pourcentage affiché compare la valeur de cette droite en 2025 à sa valeur en 2021
          (année de référence fixe, identique pour toutes les adresses) ; en dessous de ±3 %,
          les prix sont considérés comme globalement stables. Le pourcentage justifie la
          conclusion, il n'en est pas l'essentiel.
        </p>
        <p>
          Ce que ces données <strong>ne disent pas</strong> : la valeur précise de votre bien, la
          demande, les délais de vente, le nombre de visites. Une vente voisine est un repère de
          prix, pas une estimation de votre bien. La base DVF n'est pas exhaustive : certaines
          ventes peuvent en être absentes.
        </p>
      </div>
    </details>

  </div>
</Layout>

<!-- is:global OBLIGATOIRE : l'infographie est injectée en JS (innerHTML), donc
     sans l'attribut de scope Astro (data-astro-cid). Une feuille scopée ne
     matcherait aucun élément injecté → contenu rendu sans aucun style.
     Tous les sélecteurs sont préfixés .vr- : aucun risque de collision. -->
<style is:global>
  .vr-titre {
    font-family: 'Fraunces', Georgia, serif; font-weight: 500;
    font-size: clamp(1.9rem, 5vw, 3rem); line-height: 1.08; letter-spacing: -0.02em;
  }
  .vr-fraicheur {
    display: inline-flex; align-items: center; gap: 0.45rem; margin-top: 1rem;
    font-family: 'Instrument Sans', sans-serif; font-size: 0.85rem; color: #6B5D4F;
    background: #F0E2D8; border-radius: 999px; padding: 0.35rem 0.85rem;
  }
  .vr-fraicheur::before { content: ''; width: 7px; height: 7px; border-radius: 999px; background: #A85638; flex: 0 0 auto; }

  .vr-field { display: flex; flex-direction: column; gap: 0.75rem; }
  @media (min-width: 560px) { .vr-field { flex-direction: row; align-items: flex-start; } }
  .vr-combo { position: relative; flex: 1; }
  .vr-input {
    width: 100%; background: #F7F2EA; border: 1px solid #E8DFD0; border-radius: 12px;
    padding: 0.85rem 1rem; font-family: 'Instrument Sans', sans-serif; font-size: 1rem;
    color: #211C16; min-height: 52px;
  }
  .vr-input:focus { outline: 2px solid #A85638; outline-offset: 2px; border-color: #A85638; }
  .vr-submit { min-height: 52px; white-space: nowrap; }
  @media (max-width: 559px) { .vr-submit { width: 100%; } }

  .vr-suggestions {
    position: absolute; z-index: 20; left: 0; right: 0; top: calc(100% + 6px);
    background: #FDFBF6; border: 1px solid #E8DFD0; border-radius: 12px;
    box-shadow: 0 24px 48px -28px rgba(33,28,22,0.5);
    list-style: none; margin: 0; padding: 0.35rem; max-height: 320px; overflow-y: auto;
  }
  .vr-suggestions li {
    padding: 0.65rem 0.75rem; border-radius: 8px; cursor: pointer;
    font-family: 'Instrument Sans', sans-serif; font-size: 0.95rem; color: #211C16; line-height: 1.35;
  }
  .vr-suggestions li .vr-sug-sub { display: block; font-size: 0.82rem; color: #6B5D4F; }
  .vr-suggestions li[aria-selected="true"], .vr-suggestions li:hover { background: #F0E2D8; }

  /* ——— Analyse ——— */
  .vr-analyse { padding: 2.5rem 0 1rem; }
  .vr-analyse-step {
    display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0;
    font-family: 'Instrument Sans', sans-serif; font-size: 1.02rem; color: #B8AA97;
    transition: color 0.3s ease;
  }
  .vr-analyse-step.is-active { color: #211C16; }
  .vr-analyse-step.is-done { color: #6B5D4F; }
  .vr-analyse-dot {
    width: 20px; height: 20px; border-radius: 999px; flex: 0 0 auto; position: relative;
    border: 2px solid currentColor;
  }
  .vr-analyse-step.is-active .vr-analyse-dot::after {
    content: ''; position: absolute; inset: 3px; border-radius: 999px; background: #A85638;
    animation: vr-pulse 0.9s ease-in-out infinite;
  }
  .vr-analyse-step.is-done .vr-analyse-dot { background: #A85638; border-color: #A85638; }
  .vr-analyse-step.is-done .vr-analyse-dot::after {
    content: ''; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  }
  @keyframes vr-pulse { 0%,100% { transform: scale(0.7); opacity: 0.6; } 50% { transform: scale(1); opacity: 1; } }

  /* ——— Console d'analyse : le chargement fait partie de l'expérience ———
     Même fond que le bloc héro (#1B4332) : la console ne disparaît pas,
     elle devient le héro. Le calcul est réel, seule la révélation est cadencée. */
  .vr-scan {
    position: relative; overflow: hidden;
    background: #1B4332; border-radius: 22px;
    padding: 2rem clamp(1.25rem, 5vw, 2.25rem) 1.75rem;
    opacity: 0; transform: translateY(12px) scale(0.985);
    animation: vr-scan-in 0.55s cubic-bezier(0.25,0.46,0.45,0.94) forwards;
  }
  @keyframes vr-scan-in { to { opacity: 1; transform: none; } }
  .vr-scan::before {
    content: ''; position: absolute; top: -55%; left: 50%;
    width: 130%; height: 150%; transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(168,213,162,0.17), transparent 62%);
    pointer-events: none;
  }
  .vr-scan-inner { position: relative; }
  .vr-scan-kicker {
    font-family: 'Instrument Sans', sans-serif; font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase; color: rgba(168,213,162,0.8);
    display: flex; align-items: center; gap: 0.55rem;
  }
  .vr-scan-pulse {
    width: 7px; height: 7px; border-radius: 999px; background: #A8D5A2; flex: 0 0 auto;
    animation: vr-scan-blip 1.1s ease-in-out infinite;
  }
  @keyframes vr-scan-blip { 0%,100% { opacity: 0.3; transform: scale(0.7); } 50% { opacity: 1; transform: scale(1); } }
  .vr-scan-grid { display: block; width: 100%; height: 62px; margin: 1.15rem 0 1.35rem; }
  .vr-scan-cell { opacity: 0.09; transition: opacity 0.4s ease; }
  .vr-scan-steps { display: grid; }
  .vr-scan-step {
    display: grid; grid-template-columns: 16px 1fr auto;
    align-items: center; gap: 0.7rem; padding: 0.6rem 0;
    border-top: 1px solid rgba(255,255,255,0.07);
    font-family: 'Instrument Sans', sans-serif; font-size: 0.9rem;
    color: rgba(255,255,255,0.3); transition: color 0.4s ease;
  }
  .vr-scan-step:first-child { border-top: 0; }
  .vr-scan-step.is-active { color: rgba(255,255,255,0.92); }
  .vr-scan-step.is-done { color: rgba(255,255,255,0.55); }
  .vr-scan-mark {
    width: 16px; height: 16px; border-radius: 999px; position: relative;
    border: 1.5px solid currentColor;
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  .vr-scan-step.is-active .vr-scan-mark::after {
    content: ''; position: absolute; inset: 3px; border-radius: 999px; background: #A8D5A2;
    animation: vr-scan-blip 0.85s ease-in-out infinite;
  }
  .vr-scan-step.is-done .vr-scan-mark { background: #A8D5A2; border-color: #A8D5A2; }
  .vr-scan-val {
    font-family: 'Fraunces', serif; font-weight: 500; font-size: 0.98rem;
    color: #A8D5A2; white-space: nowrap;
    opacity: 0; transform: translateX(-8px);
    transition: opacity 0.45s ease, transform 0.5s cubic-bezier(0.34,1.56,0.64,1);
  }
  .vr-scan-val.on { opacity: 1; transform: none; }
  .vr-scan.is-out {
    opacity: 0; transform: translateY(-8px) scale(0.99);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  /* ——— Résultats : séquence compacte de cartes ——— */
  .vr-results { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; }
  .vr-head { margin: 0.25rem 0 0.1rem; }
  .vr-head-eyebrow { font-family: 'Instrument Sans', sans-serif; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #A85638; }
  .vr-head-adr { font-family: 'Instrument Sans', sans-serif; font-size: 0.95rem; color: #6B5D4F; margin-top: 0.25rem; }

  .vr-block { opacity: 0; transform: translateY(14px); transition: opacity 0.6s cubic-bezier(0.22,1,0.36,1), transform 0.6s cubic-bezier(0.22,1,0.36,1); }
  .vr-block.is-in { opacity: 1; transform: none; }

  .vr-card { background: #FDFBF6; border: 1px solid #E8DFD0; border-radius: 20px; padding: 1.5rem 1.35rem; }
  @media (min-width: 768px) { .vr-card { padding: 1.9rem; } }
  .vr-card--dark { background: #211C16; border-color: #211C16; }
  .vr-card--warm { background: #F0E2D8; border-color: #EAD9C7; }

  .vr-label { font-family: 'Instrument Sans', sans-serif; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #A85638; }
  .vr-card--dark .vr-label { color: #C97B52; }
  .vr-num { font-family: 'Fraunces', Georgia, serif; font-weight: 500; line-height: 1; letter-spacing: -0.02em; color: #211C16; }
  .vr-card--dark .vr-num { color: #F7F2EA; }
  .vr-sub { font-family: 'Instrument Sans', sans-serif; color: #6B5D4F; }
  .vr-card--dark .vr-sub { color: rgba(247,242,234,0.7); }

  /* B — compteur de ventes */
  .vr-b-num { font-size: clamp(3.4rem, 16vw, 5rem); }
  .vr-b-l { font-family: 'Instrument Sans', sans-serif; font-size: 1.1rem; color: #211C16; margin-top: 0.15rem; }
  .vr-b-sub { font-size: 0.9rem; margin-top: 0.45rem; }

  /* C — prix du milieu + curseur de fourchette */
  .vr-c-num { font-size: clamp(2.7rem, 12vw, 3.8rem); }
  .vr-c-lbl { margin-top: 0.55rem; }
  .vr-range { margin-top: 1.8rem; }
  .vr-range-line { position: relative; height: 3px; background: #E0D3BF; margin: 0 0.2rem; border-radius: 3px; }
  .vr-range-dot { position: absolute; top: 50%; width: 18px; height: 18px; border-radius: 999px; background: #A85638; box-shadow: 0 0 0 4px #FDFBF6, 0 2px 8px rgba(168,86,56,0.55); transform: translate(-50%, -50%); transition: left 0.9s cubic-bezier(0.22,1,0.36,1); }
  .vr-range-cap { position: absolute; top: -1.55rem; font-family: 'Instrument Sans', sans-serif; font-size: 0.92rem; color: #211C16; font-weight: 600; }
  .vr-range-cap.g { left: 0; } .vr-range-cap.d { right: 0; }
  .vr-range-arrows { display: flex; justify-content: space-between; color: #C0B29B; font-size: 1rem; margin-top: 0.35rem; padding: 0 0.1rem; }
  .vr-c-phrase { font-family: 'Instrument Sans', sans-serif; font-size: 0.98rem; color: #6B5D4F; margin-top: 1rem; line-height: 1.5; }
  .vr-c-m2 { font-family: 'Instrument Sans', sans-serif; font-size: 0.88rem; color: #6B5D4F; opacity: 0.85; margin-top: 0.55rem; }

  /* D — tendance : titre + jauge baisse/stable/hausse */
  .vr-d-head { display: flex; align-items: center; gap: 0.65rem; margin-top: 0.7rem; }
  .vr-d-ico { width: 32px; height: 32px; flex: 0 0 auto; }
  .vr-d-ico svg { width: 100%; height: 100%; }
  .vr-d-title { font-family: 'Fraunces', serif; font-weight: 500; font-size: clamp(1.4rem, 5vw, 1.9rem); line-height: 1.1; color: #211C16; }
  .vr-d-pct { font-family: 'Instrument Sans', sans-serif; font-size: 0.9rem; color: #6B5D4F; margin-top: 0.9rem; }
  .vr-gauge { margin-top: 1.3rem; }
  .vr-gauge-track { position: relative; height: 12px; border-radius: 999px; background: linear-gradient(90deg, #DCD2C0 0 33%, #EFE6D6 33% 67%, #E6C3AB 67% 100%); }
  .vr-gauge-cursor { position: absolute; top: -5px; width: 4px; height: 22px; border-radius: 2px; background: #211C16; transform: translateX(-50%); transition: left 0.9s cubic-bezier(0.22,1,0.36,1); }
  .vr-gauge-lbls { display: flex; justify-content: space-between; margin-top: 0.55rem; font-family: 'Instrument Sans', sans-serif; font-size: 0.76rem; letter-spacing: 0.08em; text-transform: uppercase; color: #9C8E7C; }
  .vr-gauge-lbls .on { color: #A85638; font-weight: 600; }

  /* A — dernière vente */
  .vr-a-num { font-size: clamp(2.5rem, 11vw, 3.4rem); margin-top: 0.7rem; }
  .vr-a-bien { font-family: 'Instrument Sans', sans-serif; font-size: 1.02rem; margin-top: 0.5rem; color: rgba(247,242,234,0.92); }
  .vr-a-meta { font-family: 'Instrument Sans', sans-serif; font-size: 0.92rem; margin-top: 0.35rem; }

  /* En clair */
  .vr-ec { font-family: 'Fraunces', serif; font-weight: 500; font-size: clamp(1.3rem, 4.6vw, 1.8rem); line-height: 1.32; color: #211C16; margin-top: 0.7rem; }
  .vr-maj { font-family: 'Instrument Sans', sans-serif; font-size: 0.8rem; color: #6B5D4F; margin-top: 0.9rem; }

  /* Ventes détaillées (secondaire) */
  .vr-details { margin-top: 0.1rem; }
  .vr-details summary {
    cursor: pointer; font-family: 'Instrument Sans', sans-serif; font-weight: 600; color: #A85638;
    padding: 0.9rem 0; list-style: none; display: inline-flex; align-items: center; gap: 0.5rem;
  }
  .vr-details summary::-webkit-details-marker { display: none; }
  .vr-details summary::before { content: '＋'; font-weight: 400; }
  .vr-details[open] summary::before { content: '－'; }
  .vr-autre { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem 1rem; padding: 0.85rem 0; border-top: 1px solid #EDE3D4; font-family: 'Instrument Sans', sans-serif; }
  .vr-autre-sub { display: block; font-size: 0.85rem; color: #6B5D4F; }
  .vr-autre-prix { font-weight: 600; color: #211C16; }

  /* ——— Conversion : rupture forte (carte sombre) ——— */
  .vr-conv { background: #211C16; color: #F7F2EA; border-radius: 24px; padding: 2rem 1.5rem; margin-top: 1.75rem; }
  @media (min-width: 768px) { .vr-conv { padding: 2.75rem; } }
  .vr-conv-eyebrow { font-family: 'Instrument Sans', sans-serif; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #C97B52; margin-bottom: 0.8rem; }
  .vr-conv-titre { font-family: 'Fraunces', serif; font-weight: 500; font-size: clamp(1.8rem, 6.5vw, 2.6rem); line-height: 1.08; color: #F7F2EA; margin-bottom: 0.7rem; }
  .vr-conv-intro { font-family: 'Instrument Sans', sans-serif; font-size: 1.02rem; line-height: 1.6; color: rgba(247,242,234,0.72); margin-bottom: 1.6rem; }
  .vr-paths { display: grid; gap: 0.7rem; }
  .vr-path { text-align: left; width: 100%; border: 0; border-radius: 16px; padding: 1.15rem 1.3rem; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1rem; transition: transform 0.2s, box-shadow 0.2s, background 0.2s, border-color 0.2s; }
  .vr-path-t { font-family: 'Fraunces', serif; font-weight: 500; font-size: 1.18rem; display: block; }
  .vr-path-d { font-family: 'Instrument Sans', sans-serif; font-size: 0.88rem; margin-top: 0.2rem; display: block; }
  .vr-path-arrow { flex: 0 0 auto; font-size: 1.15rem; }
  .vr-path--1 { background: #A85638; }
  .vr-path--1 .vr-path-t { color: #FBF3EC; } .vr-path--1 .vr-path-d { color: rgba(251,243,236,0.82); } .vr-path--1 .vr-path-arrow { color: #FBF3EC; }
  .vr-path--1:hover { background: #B5623F; transform: translateY(-2px); box-shadow: 0 18px 40px -22px rgba(168,86,56,0.85); }
  .vr-path--2 { background: #F7F2EA; }
  .vr-path--2 .vr-path-t { color: #211C16; } .vr-path--2 .vr-path-d { color: #6B5D4F; } .vr-path--2 .vr-path-arrow { color: #A85638; }
  .vr-path--2:hover { transform: translateY(-2px); box-shadow: 0 18px 40px -24px rgba(0,0,0,0.55); }
  .vr-path--3 { background: transparent; border: 1px solid rgba(247,242,234,0.26); }
  .vr-path--3 .vr-path-t { color: #F7F2EA; font-size: 1.04rem; } .vr-path--3 .vr-path-d { color: rgba(247,242,234,0.6); } .vr-path--3 .vr-path-arrow { color: rgba(247,242,234,0.6); }
  .vr-path--3:hover { border-color: #C97B52; }

  /* Panneau (qualif / contact / explorer) — carte claire imbriquée dans la conversion sombre */
  .vr-panneau { margin-top: 1.35rem; background: #FDFBF6; border-radius: 16px; padding: 1.5rem 1.35rem; }
  .vr-panneau:empty { display: none; }
  .vr-q-progress { display: flex; gap: 0.35rem; margin-bottom: 1.25rem; }
  .vr-q-dot { height: 4px; flex: 1; border-radius: 999px; background: #E8DFD0; }
  .vr-q-dot.is-on { background: #A85638; }
  .vr-q-label { font-family: 'Fraunces', serif; font-weight: 500; font-size: 1.35rem; line-height: 1.2; color: #211C16; margin-bottom: 1.1rem; }
  .vr-q-opts { display: grid; gap: 0.6rem; }
  .vr-q-opt {
    text-align: left; background: #F7F2EA; border: 1px solid #E8DFD0; border-radius: 12px;
    padding: 0.9rem 1.1rem; cursor: pointer; font-family: 'Instrument Sans', sans-serif; font-size: 1rem; color: #211C16;
    transition: border-color 0.15s, background 0.15s;
  }
  .vr-q-opt:hover { border-color: #A85638; background: #F0E2D8; }
  .vr-q-back { background: none; border: 0; color: #6B5D4F; font-family: 'Instrument Sans', sans-serif; font-size: 0.9rem; cursor: pointer; margin-top: 1rem; padding: 0.3rem 0; }
  .vr-q-back:hover { color: #A85638; }

  .vr-champ { display: block; margin-bottom: 0.9rem; }
  .vr-champ label { display: block; font-family: 'Instrument Sans', sans-serif; font-size: 0.9rem; color: #6B5D4F; margin-bottom: 0.4rem; }
  .vr-champ input {
    width: 100%; background: #F7F2EA; border: 1px solid #E8DFD0; border-radius: 12px; padding: 0.8rem 1rem;
    font-family: 'Instrument Sans', sans-serif; font-size: 1rem; color: #211C16; min-height: 50px;
  }
  .vr-champ input:focus { outline: 2px solid #A85638; outline-offset: 2px; border-color: #A85638; }
  .vr-consent { display: flex; align-items: flex-start; gap: 0.6rem; font-family: 'Instrument Sans', sans-serif; font-size: 0.88rem; color: #6B5D4F; line-height: 1.5; margin: 0.5rem 0 1rem; cursor: pointer; }
  .vr-consent input { margin-top: 0.15rem; width: 18px; height: 18px; accent-color: #A85638; flex: 0 0 auto; }
  .vr-contact-liens { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .vr-explorer { display: grid; gap: 0.6rem; }
  .vr-explorer a { display: block; background: #F7F2EA; border: 1px solid #E8DFD0; border-radius: 12px; padding: 0.9rem 1.1rem; font-family: 'Instrument Sans', sans-serif; color: #211C16; transition: border-color 0.15s; }
  .vr-explorer a:hover { border-color: #A85638; }
  .vr-explorer a b { font-family: 'Fraunces', serif; font-weight: 500; }

  .vr-vide { background: #FDFBF6; border: 1px solid #E8DFD0; border-radius: 20px; padding: 1.75rem 1.5rem; }

  .vr-methode { margin-top: 2.5rem; font-family: 'Instrument Sans', sans-serif; }
  .vr-methode summary { cursor: pointer; font-size: 0.85rem; color: #6B5D4F; }
  .vr-methode-corps { margin-top: 0.8rem; display: grid; gap: 0.7rem; }
  .vr-methode-corps p { font-size: 0.85rem; color: #6B5D4F; line-height: 1.6; }

  /* ——————————————————————————————————————————————————————————————
     Infographique premium — 7 blocs, IntersectionObserver
     Repli empilé : construireStack (prefers-reduced-motion).
     —————————————————————————————————————————————————————————————— */

  .vr-cine-wrap {
    display: grid; gap: 0; border-radius: 22px; overflow: hidden;
    box-shadow: 0 2px 6px rgba(33,28,22,0.05), 0 30px 70px -30px rgba(33,28,22,0.3);
  }

  .vr-bloc { position: relative; padding: 2.25rem clamp(1.25rem, 5vw, 2.25rem) 2.5rem; }
  /* Contrastes assumés entre les moments (les beiges précédents étaient à 2 % d'écart). */
  .vr-bloc--hero  { background: #1B4332; padding-top: 2.75rem; padding-bottom: 2.75rem; }
  .vr-bloc--b1    { background: #F8F3EA; }
  .vr-bloc--b2    { background: #E9DFCE; }
  .vr-bloc--surf  { background: #F8F3EA; }
  .vr-bloc--spark { background: #E9DFCE; }
  .vr-bloc--tx    { background: #F8F3EA; border-top: 1px solid rgba(33,28,22,0.07); }
  .vr-bloc--conc  { background: #1F2937; }

  /* Profondeur ambiante — halo chaud très diffus sur les blocs sombres */
  .vr-bloc--hero::before, .vr-bloc--conc::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
  }
  .vr-bloc--hero::before {
    background: radial-gradient(ellipse 85% 60% at 25% 0%, rgba(168,213,162,0.15), transparent 70%);
  }
  .vr-bloc--conc::before {
    background: radial-gradient(ellipse 85% 70% at 80% 100%, rgba(193,90,43,0.2), transparent 70%);
  }
  .vr-bloc--hero > *, .vr-bloc--conc > * { position: relative; }

  .vr-kicker {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase;
    margin-bottom: 0.4rem;
    display: flex; align-items: baseline; gap: 0.6rem;
  }
  /* Numérotation éditoriale 01 / 02 / 03 — repère de système */
  .vr-kicker-num {
    font-family: 'Fraunces', serif; font-weight: 500; font-size: 0.82rem;
    letter-spacing: 0; opacity: 0.55;
  }
  .vr-kicker-num::after {
    content: ''; display: inline-block; width: 14px; height: 1px;
    background: currentColor; vertical-align: middle;
    margin-left: 0.55rem; opacity: 0.5;
  }

  /* Carte-objet : chaque visualisation est un objet posé, pas un SVG nu sur le fond */
  .vr-viz {
    background: #FFFFFF; border-radius: 18px;
    border: 1px solid rgba(33,28,22,0.05);
    padding: 1.25rem 1rem 1.1rem;
    box-shadow: 0 1px 2px rgba(33,28,22,0.05), 0 16px 36px -14px rgba(33,28,22,0.22);
  }
  .vr-grid-line { stroke: rgba(33,28,22,0.07); stroke-width: 1; }

  /* Tuiles-stat : les comptages deviennent de vrais objets chiffrés */
  .vr-tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; margin-top: 0.9rem; }
  .vr-tile {
    background: #FFFFFF; border: 1px solid rgba(33,28,22,0.06); border-radius: 14px;
    padding: 0.85rem 0.9rem 0.8rem;
    box-shadow: 0 1px 2px rgba(33,28,22,0.04), 0 10px 24px -14px rgba(33,28,22,0.2);
    opacity: 0; transform: translateY(10px) scale(0.97);
    transition: opacity 0.5s ease, transform 0.55s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  .vr-tile.on { opacity: 1; transform: none; }
  .vr-tile.is-muted { opacity: 0.42; }
  .vr-tile-lbl {
    font-family: 'Instrument Sans', sans-serif; font-size: 0.68rem; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase; color: #9C8E7C;
    display: flex; align-items: center; gap: 0.35rem;
  }
  .vr-tile-ico { width: 8px; height: 8px; border-radius: 999px; flex: 0 0 auto; }
  .vr-tile-val {
    font-family: 'Fraunces', serif; font-weight: 600; letter-spacing: -0.02em;
    font-size: clamp(1.9rem, 8vw, 2.6rem); line-height: 1.05; margin-top: 0.3rem;
  }
  .vr-tile-val--M { color: #C15A2B; }
  .vr-tile-val--A { color: #3A6FB0; }
  .vr-tile-bar { height: 4px; border-radius: 999px; background: rgba(33,28,22,0.07); margin-top: 0.5rem; overflow: hidden; }
  .vr-tile-bar span {
    display: block; height: 100%; border-radius: 999px; width: 0%;
    transition: width 0.9s cubic-bezier(0.25,0.46,0.45,0.94) 0.15s;
  }
  .vr-tile-pct {
    font-family: 'Instrument Sans', sans-serif; font-size: 0.72rem;
    color: #6B5D4F; margin-top: 0.35rem;
  }
  .vr-kicker--light { color: rgba(255,255,255,0.5); }
  .vr-kicker--terra { color: #C15A2B; }
  .vr-kicker--ink   { color: #9C8E7C; }

  .vr-titre {
    font-family: 'Fraunces', serif; font-weight: 500;
    font-size: clamp(1.2rem, 4.2vw, 1.6rem); line-height: 1.22;
    margin-bottom: 1.25rem;
  }
  .vr-titre--dark { color: #211C16; }

  /* Héro */
  .vr-hero-counter {
    font-family: 'Fraunces', serif; font-weight: 600;
    font-size: clamp(3.5rem, 14vw, 6rem); line-height: 1;
    color: #A8D5A2; letter-spacing: -0.02em;
    margin: 0.2rem 0 0.05rem;
  }
  .vr-hero-count-lbl {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.8rem; letter-spacing: 0.09em; text-transform: uppercase;
    color: rgba(255,255,255,0.55); font-weight: 500;
  }
  .vr-hero-bars { margin-top: 1.75rem; display: grid; gap: 0.65rem; }
  .vr-hero-bar-row {
    display: grid; grid-template-columns: 2.8rem 1fr 2.8rem;
    align-items: center; gap: 0.65rem;
  }
  .vr-hero-bar-yr {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.78rem; font-weight: 600; color: rgba(255,255,255,0.5);
  }
  .vr-hero-bar-track {
    height: 12px; border-radius: 999px;
    background: rgba(255,255,255,0.12); overflow: hidden;
  }
  .vr-hero-bar-fill {
    height: 100%; border-radius: 999px;
    background: #A8D5A2; width: 0%;
    transition: width 1.1s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  .vr-hero-bar-n {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.82rem; font-weight: 600; color: rgba(255,255,255,0.75);
    text-align: right;
  }
  .vr-hero-badge {
    display: inline-flex; align-items: center;
    background: rgba(168,213,162,0.15); border: 1px solid rgba(168,213,162,0.3);
    border-radius: 999px; padding: 0.2rem 0.65rem; margin-top: 1rem;
    font-family: 'Instrument Sans', sans-serif; font-size: 0.78rem; font-weight: 600;
    color: #A8D5A2;
  }

  /* Bloc dots — nuage de points */
  .vr-dots-svg { display: block; width: 100%; height: 130px; margin: 0 auto 0.5rem; }
  .vr-dot { transition: transform 0.95s cubic-bezier(0.25,0.46,0.45,0.94), fill 0.5s ease, opacity 0.6s ease; }

  .vr-dot-legend {
    display: flex; gap: 1.75rem; justify-content: center; margin-bottom: 0.75rem;
    font-family: 'Instrument Sans', sans-serif; font-size: 0.82rem;
    color: #211C16; align-items: center;
    opacity: 0; transition: opacity 0.5s ease;
  }
  .vr-dot-legend-ico {
    display: inline-block; width: 10px; height: 10px;
    border-radius: 999px; margin-right: 0.35rem;
    vertical-align: middle; position: relative; top: -1px;
  }
  .vr-dot-counts {
    display: flex; gap: 2.5rem; justify-content: center;
    margin-bottom: 1rem;
    opacity: 0; transition: opacity 0.55s ease;
  }
  .vr-dot-count {
    font-family: 'Fraunces', serif; font-weight: 600;
    font-size: clamp(2.2rem, 9vw, 3.2rem); line-height: 1; display: block;
    letter-spacing: -0.02em;
  }
  .vr-dot-count--M { color: #C15A2B; }
  .vr-dot-count--A { color: #3A6FB0; }
  .vr-dot-count-item {
    font-family: 'Instrument Sans', sans-serif; font-size: 0.8rem;
    color: #6B5D4F; font-weight: 500; letter-spacing: 0.04em; text-align: center;
  }

  /* Textes narratifs des phases */
  .vr-phase-txt {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(0.9rem, 2.8vw, 1rem); line-height: 1.62; color: #6B5D4F;
    transition: opacity 0.5s ease;
  }
  .vr-pt1 {
    font-family: 'Fraunces', serif; font-weight: 400;
    font-size: clamp(1rem, 3.5vw, 1.2rem); color: #211C16;
    margin-top: 0.25rem; margin-bottom: 0.25rem;
  }
  .vr-pt2 { margin-top: 0; }
  /* Les deux textes de phase occupent la même cellule : le premier s'efface
     sans laisser de trou, la hauteur reste celle du plus long. */
  .vr-phase-stack { display: grid; margin-top: 1.1rem; }
  .vr-phase-stack > * { grid-area: 1 / 1; align-self: start; }

  /* Distribution */
  .vr-dist-type-pill {
    display: inline-block; border-radius: 999px;
    padding: 0.18rem 0.75rem; margin-bottom: 1rem;
    font-family: 'Instrument Sans', sans-serif; font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.07em; text-transform: uppercase;
  }
  .vr-dist-type-pill--M { background: rgba(193,90,43,0.1); color: #C15A2B; }
  .vr-dist-type-pill--A { background: rgba(58,111,176,0.1); color: #3A6FB0; }

  .vr-dist-wrap { max-width: 42rem; }
  .vr-dist-svg { display: block; width: 100%; overflow: visible; }
  .vr-dist-zone { transition: opacity 0.8s ease; }
  .vr-dist-dot { opacity: 0; transition: opacity 0.25s ease; }
  .vr-dist-med-line { transition: opacity 0.5s ease; }
  .vr-dist-axis-lbl {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.62rem; fill: #BBAA96; letter-spacing: 0.04em;
  }
  /* Lecture du prix médian : un seul grand chiffre, en HTML — jamais de
     collision possible, contrairement aux labels positionnés dans le SVG. */
  .vr-dist-readout {
    text-align: center; margin-top: 0.85rem;
    opacity: 0; transform: translateY(10px) scale(0.97);
    transition: opacity 0.55s ease, transform 0.6s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  .vr-dist-readout.on { opacity: 1; transform: none; }
  .vr-dist-med-num {
    font-family: 'Fraunces', serif; font-weight: 600; letter-spacing: -0.02em;
    font-size: clamp(2.1rem, 9vw, 3rem); line-height: 1;
  }
  .vr-dist-med-num span { font-size: 0.42em; font-weight: 500; letter-spacing: 0; }
  .vr-dist-med-cap {
    font-family: 'Instrument Sans', sans-serif; font-size: 0.7rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: #9C8E7C; margin-top: 0.35rem;
  }
  .vr-dist-note {
    font-family: 'Instrument Sans', sans-serif; font-size: 0.88rem;
    color: #6B5D4F; line-height: 1.58; margin-top: 0.9rem;
    opacity: 0; transform: translateY(6px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }

  /* Effet surface */
  .vr-surf-trio {
    display: grid; grid-template-columns: 1fr auto 1fr;
    align-items: center; gap: 0.5rem; max-width: 42rem; text-align: center;
  }
  .vr-surf-col-val {
    font-family: 'Fraunces', serif; font-weight: 500;
    font-size: clamp(1.3rem, 5vw, 1.85rem); line-height: 1.1; color: #211C16;
  }
  .vr-surf-col-lbl {
    font-family: 'Instrument Sans', sans-serif; font-size: 0.7rem;
    color: #6B5D4F; letter-spacing: 0.04em; text-transform: uppercase; margin-top: 0.2rem;
  }
  .vr-surf-delta-wrap { text-align: center; padding: 0 0.25rem; }
  .vr-surf-delta {
    font-family: 'Fraunces', serif; font-weight: 600;
    font-size: clamp(1.8rem, 8vw, 2.8rem); line-height: 1; color: #C15A2B;
    opacity: 0; transform: scale(0.7);
    transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.34,1.56,0.64,1);
  }
  .vr-surf-delta.on { opacity: 1; transform: none; }
  .vr-surf-arrow { font-size: 0.85rem; color: #9C8E7C; display: block; margin-top: 0.15rem; }
  .vr-surf-note {
    font-family: 'Instrument Sans', sans-serif; font-size: 0.88rem;
    color: #6B5D4F; line-height: 1.58; margin-top: 1.1rem; max-width: 24rem;
  }

  /* Sparkline — grande */
  .vr-spark-wrap { max-width: 42rem; }
  .vr-spark-svg { display: block; width: 100%; overflow: visible; }
  .vr-spark-path { fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .vr-spark-dot { opacity: 0; transition: opacity 0.3s ease; }
  .vr-spark-dot.on { opacity: 1; }
  .vr-spark-yr { font-family: 'Instrument Sans', sans-serif; font-size: 0.72rem; fill: #9C8E7C; text-anchor: middle; }
  .vr-spark-val { font-family: 'Fraunces', serif; font-size: 0.78rem; font-weight: 500; fill: #211C16; text-anchor: middle; opacity: 0; transition: opacity 0.3s ease; }
  .vr-spark-val.on { opacity: 1; }
  .vr-spark-dir { font-family: 'Fraunces', serif; font-weight: 500; font-size: clamp(1.05rem,3.5vw,1.35rem); color: #211C16; margin-top: 0.65rem; }
  .vr-spark-pct { font-family: 'Instrument Sans', sans-serif; font-size: 0.85rem; color: #6B5D4F; margin-top: 0.15rem; }

  /* Ventes réelles — cartes avec stagger */
  .vr-tx-cards { display: grid; gap: 0.7rem; }
  .vr-tx-card {
    background: #FFFFFF; border: 1px solid #E8DFD0; border-radius: 14px;
    padding: 0.85rem 1rem; display: grid;
    grid-template-columns: 2.2rem 1fr auto; gap: 0.6rem; align-items: start;
    opacity: 0; transform: translateY(10px);
    transition: opacity 0.45s ease, transform 0.45s ease;
  }
  .vr-tx-card.on { opacity: 1; transform: none; }
  .vr-tx-ico {
    width: 2.1rem; height: 2.1rem; border-radius: 8px; display: flex;
    align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0;
  }
  .vr-tx-ico--M { background: rgba(193,90,43,0.1); }
  .vr-tx-ico--A { background: rgba(58,111,176,0.1); }
  .vr-tx-info { min-width: 0; }
  .vr-tx-name { font-family: 'Instrument Sans', sans-serif; font-size: 0.88rem; font-weight: 600; color: #211C16; }
  .vr-tx-addr {
    font-family: 'Instrument Sans', sans-serif; font-size: 0.78rem;
    color: #6B5D4F; margin-top: 0.12rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .vr-tx-meta { font-family: 'Instrument Sans', sans-serif; font-size: 0.72rem; color: #9C8E7C; margin-top: 0.1rem; }
  .vr-tx-right { text-align: right; flex-shrink: 0; }
  .vr-tx-price { font-family: 'Fraunces', serif; font-weight: 500; font-size: 1rem; color: #211C16; white-space: nowrap; }
  .vr-tx-ppm {
    display: inline-block; margin-top: 0.25rem;
    border-radius: 999px; padding: 0.1rem 0.5rem;
    font-family: 'Instrument Sans', sans-serif; font-size: 0.68rem; font-weight: 600; white-space: nowrap;
  }
  .vr-tx-ppm--M { background: rgba(193,90,43,0.1); color: #C15A2B; }
  .vr-tx-ppm--A { background: rgba(58,111,176,0.1); color: #3A6FB0; }
  .vr-tx-more summary { font-family: 'Instrument Sans', sans-serif; font-size: 0.85rem; color: #6B5D4F; cursor: pointer; padding: 0.4rem 0; list-style: none; }
  .vr-tx-more summary::-webkit-details-marker { display: none; }
  .vr-tx-more[open] summary { margin-bottom: 0.7rem; }

  /* Conclusion */
  .vr-conc-eyebrow {
    font-family: 'Instrument Sans', sans-serif; font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase; color: rgba(243,237,228,0.45);
    margin-bottom: 0.75rem;
  }
  .vr-conc-hl {
    font-family: 'Fraunces', serif; font-weight: 500;
    font-size: clamp(1.3rem,5vw,1.75rem); line-height: 1.25; color: #FFFFFF;
    margin-bottom: 1.25rem;
  }
  .vr-conc-body {
    font-family: 'Instrument Sans', sans-serif; font-size: clamp(0.9rem,3vw,1rem);
    line-height: 1.68; color: rgba(243,237,228,0.75); margin-bottom: 1.75rem;
  }
  .vr-conc-body p + p { margin-top: 0.75rem; }
  .vr-conc-cta {
    display: block; width: 100%; background: #C15A2B; color: #FFFFFF;
    border-radius: 12px; padding: 0.95rem 1.5rem;
    font-family: 'Instrument Sans', sans-serif; font-size: 1rem; font-weight: 600;
    letter-spacing: 0.04em; text-align: center; text-decoration: none;
    border: none; cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  .vr-conc-cta:hover { background: #A84D23; transform: translateY(-1px); }
  .vr-conc-cta:active { transform: none; }

  /* Animation entrée (IntersectionObserver) — l'objet arrive, il ne glisse pas */
  .vr-bloc-anim {
    opacity: 0; transform: translateY(22px) scale(0.982);
    transition: opacity 0.65s ease, transform 0.75s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  .vr-bloc-anim.is-on { opacity: 1; transform: none; }

  /* ——————————————————————————————————————————————————————————————
     TUNNEL PERSONNALISÉ — « SITUER MON BIEN DANS CE MARCHÉ »
     Deux moments visuellement distincts :
     — DVF (fond crème, chaque question réduit le compteur) ;
     — DÉCLARATIF (fond différent, compteur figé, message pédagogique).
     —————————————————————————————————————————————————————————————— */
  .vr-tun {
    background: #F8F3EA; border-radius: 22px;
    padding: 1.75rem clamp(1.25rem, 4vw, 2.25rem) 2rem;
    box-shadow: 0 1px 3px rgba(33,28,22,0.04), 0 22px 48px -22px rgba(33,28,22,0.25);
    margin-top: 1.25rem;
    animation: vr-tun-in 0.5s cubic-bezier(0.25,0.46,0.45,0.94) both;
  }
  @keyframes vr-tun-in {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }
  .vr-tun--declaratif { background: #F0EAE0; }
  .vr-tun--email      { background: #FDFBF6; }

  .vr-tun-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 1rem; }
  .vr-tun-titre {
    font-family: 'Instrument Sans', sans-serif; font-size: 0.68rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: #9C8E7C;
  }
  .vr-tun--declaratif .vr-tun-titre { color: #C15A2B; }
  .vr-tun-dots { display: flex; gap: 0.3rem; flex-shrink: 0; }
  .vr-tun-dot {
    width: 6px; height: 6px; border-radius: 999px; background: rgba(33,28,22,0.15);
    transition: background 0.3s ease;
  }
  .vr-tun-dot.is-on { background: #C15A2B; }

  /* Progression — la chaîne réductrice */
  .vr-tun-prog {
    display: grid; gap: 0.25rem; margin: 0 0 1.25rem;
    padding: 0.9rem 1rem; background: rgba(255,255,255,0.6); border-radius: 12px;
    border: 1px solid rgba(33,28,22,0.05);
  }
  .vr-tun-prog--gele { background: rgba(255,255,255,0.4); }
  .vr-tun-step { display: grid; grid-template-columns: 3.2rem 1fr; align-items: baseline; gap: 0.6rem; }
  .vr-tun-n {
