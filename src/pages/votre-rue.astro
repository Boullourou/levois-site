  // ——— Console d'analyse (adossée au calcul réel, sans fausse attente) ———
  // Le calcul est instantané : seule la RÉVÉLATION est cadencée, et chaque
  // étape se résout avec sa vraie valeur issue du modèle.
  async function jouerAnalyseEtRendre(lat: number, lon: number) {
    scene.hidden = false;

    const GW = 360, COLS = 26, ROWS = 4, CW = GW / COLS, CH = 13;
    let cells = '';
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        cells += `<rect class="vr-scan-cell" x="${(c * CW + 1.5).toFixed(1)}" y="${r * CH + 2}" width="${(CW - 3).toFixed(1)}" height="9" rx="2.5" fill="#A8D5A2" data-ci="${r * COLS + c}"/>`;
      }
    }
    const etapes = [
      "Ventes détectées autour de l'adresse",
      'Tri par type de bien',
      'Lecture des niveaux de prix',
    ];
    scene.innerHTML = `
      <div class="vr-scan" id="vr-scan">
        <div class="vr-scan-inner">
          <p class="vr-scan-kicker"><span class="vr-scan-pulse"></span>Analyse en cours</p>
          <svg class="vr-scan-grid" viewBox="0 0 ${GW} ${ROWS * CH}" preserveAspectRatio="none" aria-hidden="true">${cells}</svg>
          <div class="vr-scan-steps">
            ${etapes.map((t, i) => `<div class="vr-scan-step" data-i="${i}"><span class="vr-scan-mark"></span><span>${t}</span><span class="vr-scan-val" data-v="${i}"></span></div>`).join('')}
          </div>
        </div>
      </div>`;

    const steps = Array.from(scene.querySelectorAll<HTMLElement>('.vr-scan-step'));
    const activer = (i: number) => steps.forEach((s, j) => { s.classList.toggle('is-active', j === i); s.classList.toggle('is-done', j < i); });
    const resoudre = (i: number, txt: string) => {
      const v = scene.querySelector<HTMLElement>(`.vr-scan-val[data-v="${i}"]`);
      if (v) { v.textContent = txt; v.classList.add('on'); }
    };
    // Les cellules s'allument progressivement pendant toute la séquence.
    const cellEls = Array.from(scene.querySelectorAll<SVGRectElement>('.vr-scan-cell'));
    const scanTouts: ReturnType<typeof setTimeout>[] = [];
    cellEls.forEach((el, i) => {
      scanTouts.push(setTimeout(() => { el.style.opacity = String(0.25 + (i % 5) * 0.14); }, 60 + i * 11));
    });

    activer(0);
    const model = computeModel(lat, lon); // calcul réel, immédiat
    await wait(520);
    if (!model) {
      scanTouts.forEach(clearTimeout);
      afficherAucun(selection?.label || input.value);
      return;
    }
    resoudre(0, `${model.nbVentes} ventes`);
    await wait(560);

    activer(1);
    await wait(420);
    resoudre(1, `${model.nM} · ${model.nA}`);
    await wait(560);

    activer(2);
    await wait(420);
    const ppmDom = model.dom === 'Maison' ? model.ppmM : model.ppmA;
    resoudre(2, ppmDom ? `${eur.format(Math.round(ppmDom.median))} €/m²` : '—');
    await wait(620);

    steps.forEach((s) => { s.classList.remove('is-active'); s.classList.add('is-done'); });
    scanTouts.forEach(clearTimeout);

    lastModel = model;
    // Motion : repli empilé lisible si l'utilisateur limite les animations.
    if (reduced) {
      construireStack(model);
      const head = scene.querySelector<HTMLElement>('.vr-head');
      if (head) head.scrollIntoView({ block: 'start' });
      return;
    }
    // La console ne disparaît pas : elle devient le héro (même fond #1B4332).
    const scanEl = scene.querySelector<HTMLElement>('#vr-scan');
    if (scanEl) { scanEl.classList.add('is-out'); await wait(340); }
    construireCine(model);
  }

  // ——— Autocomplétion ———
  let debounce = 0, activeIdx = -1, currentSugs: any[] = [];
  const fermerSug = () => { sugList.hidden = true; input.setAttribute('aria-expanded', 'false'); activeIdx = -1; };
  function rendreSug(feats: any[]) {
    currentSugs = feats;
    if (!feats.length) { fermerSug(); return; }
    sugList.innerHTML = feats.map((f, i) => { const pr = f.properties || {}; const sub = [pr.postcode, pr.city].filter(Boolean).join(' '); return `<li role="option" id="vr-sug-${i}" aria-selected="false" data-idx="${i}">${esc(pr.label || pr.name || '')}<span class="vr-sug-sub">${esc(sub)}</span></li>`; }).join('');
    sugList.hidden = false; input.setAttribute('aria-expanded', 'true'); activeIdx = -1;
  }
  function choisir(i: number) {
    const f = currentSugs[i]; if (!f) return;
    const [lon, lat] = f.geometry.coordinates;
    selection = { lon, lat, label: f.properties?.label || input.value };
    input.value = selection.label; fermerSug(); lancer();
  }
  input.addEventListener('input', () => {
    selection = null; geoErreur.classList.add('hidden');
    const q = input.value.trim(); window.clearTimeout(debounce);
    if (q.length < 3) { fermerSug(); return; }
    debounce = window.setTimeout(async () => { try { rendreSug(await geocoder(q, true, 6)); } catch { fermerSug(); } }, 260);
  });
  input.addEventListener('keydown', (e) => {
    if (sugList.hidden) return;
    const items = Array.from(sugList.querySelectorAll('li'));
    if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, items.length - 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); }
    else if (e.key === 'Enter' && activeIdx >= 0) { e.preventDefault(); choisir(activeIdx); return; }
    else if (e.key === 'Escape') { fermerSug(); return; } else return;
    items.forEach((el, i) => el.setAttribute('aria-selected', i === activeIdx ? 'true' : 'false'));
    if (items[activeIdx]) items[activeIdx].scrollIntoView({ block: 'nearest' });
  });
  sugList.addEventListener('click', (e) => { const li = (e.target as HTMLElement).closest('li'); if (li) choisir(Number((li as HTMLElement).dataset.idx)); });
  document.addEventListener('click', (e) => { if (!form.contains(e.target as Node)) fermerSug(); });

  // ——— Lancement ———
  async function lancer() {
    if (cineCleanup) { cineCleanup(); cineCleanup = null; } // détacher un moteur précédent
    scene.hidden = false;
    scene.innerHTML = `<div class="vr-analyse"><div class="vr-analyse-step is-active"><span class="vr-analyse-dot"></span><span>Recherche des ventes autour de chez vous…</span></div></div>`;
    try { await chargerDonnees(); } catch {
      geoErreur.textContent = 'Impossible de charger les données pour le moment. Réessayez dans un instant.';
      geoErreur.classList.remove('hidden'); scene.hidden = true; return;
    }
    if (!meta || meta.status !== 'ready' || !dataset || !dataset.length) { afficherDonneesEnAttente(); return; }

    let coords = selection;
    if (!coords) {
      const q = input.value.trim();
      if (q.length < 3) { scene.hidden = true; geoErreur.textContent = "Indiquez d'abord votre rue ou votre adresse."; geoErreur.classList.remove('hidden'); return; }
      try { const feats = await geocoder(q, false, 1); if (!feats.length) { afficherAucun(q); return; } const [lon, lat] = feats[0].geometry.coordinates; coords = { lon, lat, label: feats[0].properties?.label || q }; selection = coords; }
      catch { geoErreur.textContent = 'Adresse non reconnue. Précisez la rue et la commune.'; geoErreur.classList.remove('hidden'); scene.hidden = true; return; }
    }
    await jouerAnalyseEtRendre(coords.lat, coords.lon);
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); fermerSug(); lancer(); });
</script>
