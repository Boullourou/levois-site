---
/**
 * /votre-rue — expérience « infographie » du QR encart publicitaire.
 *
 * URL protégée (imprimée). Ne pas supprimer/renommer/rediriger sans validation.
 *
 * Transforme les DVF en une lecture immédiate, compréhensible en quelques
 * secondes par quelqu'un qui ne connaît rien à l'immobilier :
 *   adresse → courte analyse animée → 4 informations → « En clair »
 *   → ventes détaillées (facultatif) → tunnel de conversion.
 *
 * Honnêteté (impératif) : tout est calculé sur les vraies données DVF générées
 * par scripts/build-dvf.mjs. Aucun chiffre fictif. Aucun indicateur non
 * calculable (demande, délai de vente, visites, tension : jamais affichés ni
 * sous-entendus). Aucune estimation du bien du visiteur. Aucun faux temps de
 * chargement : les messages d'analyse accompagnent le calcul réel.
 *
 * Géocodage : Géoplateforme (BAN) — service actuel de l'État.
 * Conversion : les réponses de qualification + le contexte sont destinés à
 * /api/lead uniquement après consentement explicite.
 */
import CahierLayout from '../layouts/CahierLayout.astro';
import VotreRueResultDemo from '../components/cahier/VotreRueResultDemo.astro';
import '../styles/global.css';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Échantillon DVF autour de la rue de la Ravaudière à Lèves — maisons',
  description: 'Démonstration de lecture prudente de ventes de maisons avec surface connue, observées dans les données DVF intégrées au site.',
  inLanguage: 'fr-FR',
  license: 'https://www.etalab.gouv.fr/licence-ouverte-open-licence/',
  temporalCoverage: '2021-01-08/2025-12-19',
  spatialCoverage: { '@type': 'Place', name: 'Lèves, Eure-et-Loir, France' },
  isBasedOn: 'https://www.data.gouv.fr/fr/datasets/demandes-de-valeurs-foncieres-geolocalisees/',
};
---

<CahierLayout
  title="Ventes autour de votre rue"
  description="Une exploration locale prudente des ventes enregistrées autour d’une adresse, avec période, rayon, échantillon et limites."
  pageClass="cc-local-page"
  schema={schema}
>
  <VotreRueResultDemo />

  <section class="cc-live-tool" aria-labelledby="cc-live-tool-title">
    <details>
      <summary id="cc-live-tool-title">Explorer une autre adresse</summary>
      <p class="cc-live-tool__intro">L’outil opérationnel reste disponible derrière cette preuve de direction artistique. Il conserve sa méthode prudente et ses protections existantes.</p>
  <div class="max-w-editorial mx-auto px-edge md:px-edge-md pt-10 md:pt-16 pb-section md:pb-section-md">

    <!-- ① Promesse + saisie -->
    <header class="mb-8 md:mb-10">
      <p class="eyebrow mb-4">Les prix réels de votre secteur · Lèves &amp; bassin chartrain</p>
      <h2 class="vr-page-title text-encre mb-4">
        Quelles ventes comparer autour de votre adresse&nbsp;?
      </h2>
      <p class="font-sans text-body-lg text-brun max-w-prose">
        Un échantillon de ventes réellement enregistrées, pour le type de bien que vous choisissez.
        Sans inscription et sans coordonnées de contact.
      </p>
      <p id="vr-fraicheur" class="vr-fraicheur" hidden></p>
    </header>

    <form id="vr-form" method="post" action="/votre-rue/" class="vr-search carte p-5 md:p-6" autocomplete="off">
      <label for="vr-adresse" class="block font-sans text-sm text-brun mb-2">
        Votre adresse avec numéro
      </label>
      <div class="vr-field">
        <div class="vr-combo">
          <input
            id="vr-adresse" type="text" name="adresse" inputmode="text"
            maxlength="240" required
            autocomplete="off" spellcheck="false"
            placeholder="Ex : 8 rue de la Ravaudière, Lèves"
            class="vr-input" role="combobox" aria-expanded="false"
            aria-controls="vr-suggestions" aria-autocomplete="list"
          />
          <ul id="vr-suggestions" class="vr-suggestions" role="listbox" aria-label="Adresses proposées" hidden></ul>
        </div>
        <button type="submit" id="vr-submit" class="btn-primaire vr-submit">Rechercher l'adresse</button>
      </div>
      <p class="vr-geocodage-info">
        Votre saisie reste dans votre navigateur jusqu'à l'appui sur «&nbsp;Rechercher l'adresse&nbsp;».
        Elle est alors envoyée à <strong>Géoplateforme (IGN)</strong> uniquement pour proposer des
        correspondances géographiques. <a href="/confidentialite">En savoir plus</a>.
      </p>
      <p id="vr-adresse-confirmee" class="vr-adresse-confirmee" role="status" hidden>
        <strong>Adresse confirmée&nbsp;:</strong> <span id="vr-adresse-confirmee-label"></span>
        <span id="vr-adresse-confirmee-type"></span>
      </p>
      <label for="vr-type-bien" class="block font-sans text-sm text-brun mt-4 mb-2">
        Type de bien à analyser
      </label>
      <select id="vr-type-bien" name="typeBien" class="vr-input vr-type-bien" required>
        <option value="">Choisissez un type</option>
        <option value="Maison">Maison</option>
        <option value="Appartement">Appartement</option>
      </select>
      <p class="font-sans text-[13px] text-brun/70 mt-3">
        Le résultat ne mélange pas les types de biens. Aucun e-mail ni téléphone n'est demandé pour l'obtenir.
      </p>
      <p id="vr-geo-erreur" class="font-sans text-sm text-argile mt-2 hidden" role="alert"></p>
    </form>

    <!-- ②③④⑤⑥ Scène (analyse → infographie → En clair → détails → conversion) -->
    <section id="vr-scene" aria-live="polite" hidden></section>

    <!-- ⑦ Méthode & limites (accessibles mais discrètes) -->
    <details id="vr-methode" class="vr-methode">
      <summary>Méthode, source et limites</summary>
      <div class="vr-methode-corps">
        <p>
          Source : Demandes de valeurs foncières (DVF), DGFiP — données publiques ouvertes,
          géolocalisées par Etalab. Chaque vente affichée est une transaction réellement
          enregistrée.
        </p>
        <p>
          Les prix « médians » et les fourchettes sont calculés sur un échantillon d'au moins
          20 ventes du type de bien choisi, avec surface connue et hors mutations multi-lots.
          Le plus petit rayon atteignant ce seuil est retenu parmi 250&nbsp;m, 500&nbsp;m,
          700&nbsp;m, 1&nbsp;km, 1,5&nbsp;km, 2&nbsp;km et 3&nbsp;km.
          En dessous du seuil à 3&nbsp;km, aucun résultat de marché n'est affiché. L'évolution est estimée
          par une droite de tendance (régression) sur les médianes annuelles du prix au m²
          (2021 à 2025), pour éviter qu'une seule année atypique ne fausse la lecture.
          Le pourcentage affiché compare la valeur de cette droite en 2025 à sa valeur en 2021
          (année de référence fixe, identique pour toutes les adresses) ; en dessous de ±3 %,
          les prix sont considérés comme globalement stables. Le pourcentage justifie la
          conclusion, il n'en est pas l'essentiel.
        </p>
        <p>
          Ce que ces données <strong>ne disent pas</strong> : la valeur précise de votre bien, la
          demande, les délais de vente, le nombre de visites. Une vente voisine est un repère de
          prix, pas une estimation de votre bien. La base DVF n'est pas exhaustive : certaines
          ventes peuvent en être absentes.
        </p>
      </div>
    </details>

  </div>
    </details>
  </section>
</CahierLayout>

<!-- is:global OBLIGATOIRE : l'infographie est injectée en JS (innerHTML), donc
     sans l'attribut de scope Astro (data-astro-cid). Une feuille scopée ne
     matcherait aucun élément injecté → contenu rendu sans aucun style.
     Tous les sélecteurs sont préfixés .vr- : aucun risque de collision. -->
<style is:global>
  .vr-page-title {
    font-family: 'Public Sans', system-ui, sans-serif; font-weight: 700;
    font-size: clamp(1.9rem, 5vw, 3rem); line-height: 1.08; letter-spacing: -0.02em;
  }
  .vr-fraicheur {
    display: inline-flex; align-items: center; gap: 0.45rem; margin-top: 1rem;
    font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.85rem; color: #58615B;
    background: #D7FF42; border-radius: 999px; padding: 0.35rem 0.85rem;
  }
  .vr-fraicheur::before { content: ''; width: 7px; height: 7px; border-radius: 999px; background: #243CFF; flex: 0 0 auto; }

  .vr-field { display: flex; flex-direction: column; gap: 0.75rem; }
  @media (min-width: 560px) { .vr-field { flex-direction: row; align-items: flex-start; } }
  .vr-combo { position: relative; flex: 1; }
  .vr-input {
    width: 100%; background: #F2F5EF; border: 1px solid #C9CEC8; border-radius: 0;
    padding: 0.85rem 1rem; font-family: 'Public Sans', system-ui, sans-serif; font-size: 1rem;
    color: #111522; min-height: 52px;
  }
  .vr-input:focus { outline: 2px solid #243CFF; outline-offset: 2px; border-color: #243CFF; }
  .vr-submit { min-height: 52px; white-space: nowrap; }
  @media (max-width: 559px) { .vr-submit { width: 100%; } }
  .vr-type-bien { max-width: 22rem; min-height: 52px; }
  .vr-geocodage-info {
    margin-top: 0.75rem; font-family: 'Public Sans', system-ui, sans-serif;
    font-size: 0.82rem; line-height: 1.55; color: #58615B;
  }
  .vr-geocodage-info a { color: #243CFF; text-decoration: underline; }
  .vr-adresse-confirmee {
    margin-top: 0.9rem; padding: 0.75rem 0.85rem; border-left: 4px solid #243CFF;
    background: #F2F5EF; font-family: 'Public Sans', system-ui, sans-serif;
    font-size: 0.9rem; line-height: 1.5; color: #111522;
  }
  .vr-adresse-confirmee > span:last-child { color: #58615B; }

  .vr-suggestions {
    position: absolute; z-index: 20; left: 0; right: 0; top: calc(100% + 6px);
    background: #FFFFFF; border: 1px solid #C9CEC8; border-radius: 0;
    box-shadow: none;
    list-style: none; margin: 0; padding: 0.35rem; max-height: 320px; overflow-y: auto;
  }
  .vr-suggestions li {
    padding: 0.65rem 0.75rem; border-radius: 0; cursor: pointer;
    font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.95rem; color: #111522; line-height: 1.35;
  }
  .vr-suggestions li .vr-sug-sub { display: block; font-size: 0.82rem; color: #58615B; }
  .vr-suggestions li[aria-selected="true"], .vr-suggestions li:hover { background: #D7FF42; }

  /* ——— Analyse ——— */
  .vr-analyse { padding: 2.5rem 0 1rem; }
  .vr-analyse-step {
    display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0;
    font-family: 'Public Sans', system-ui, sans-serif; font-size: 1.02rem; color: #58615B;
    transition: color 0.3s ease;
  }
  .vr-analyse-step.is-active { color: #111522; }
  .vr-analyse-step.is-done { color: #58615B; }
  .vr-analyse-dot {
    width: 20px; height: 20px; border-radius: 999px; flex: 0 0 auto; position: relative;
    border: 2px solid currentColor;
  }
  .vr-analyse-step.is-active .vr-analyse-dot::after {
    content: ''; position: absolute; inset: 3px; border-radius: 999px; background: #243CFF;
    animation: vr-pulse 0.9s ease-in-out infinite;
  }
  .vr-analyse-step.is-done .vr-analyse-dot { background: #243CFF; border-color: #243CFF; }
  .vr-analyse-step.is-done .vr-analyse-dot::after {
    content: ''; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  }
  @keyframes vr-pulse { 0%,100% { transform: scale(0.7); opacity: 0.6; } 50% { transform: scale(1); opacity: 1; } }

  /* ——— Résultats : séquence compacte de cartes ——— */
  .vr-results { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; }
  .vr-head { margin: 0.25rem 0 0.1rem; }
  .vr-head-eyebrow { font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #243CFF; }
  .vr-head-adr { font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.95rem; color: #58615B; margin-top: 0.25rem; }

  .vr-result-scope {
    margin: 1.5rem 0 0; padding: 1.15rem 1.25rem; border: 2px solid #111522;
    background: #FFFFFF; font-family: 'Public Sans', system-ui, sans-serif;
  }
  .vr-result-scope h2 { margin: 0 0 0.8rem; color: #111522; font-size: 1.05rem; font-weight: 700; }
  .vr-result-scope dl { display: grid; grid-template-columns: minmax(8rem, auto) 1fr; gap: 0.45rem 1rem; }
  .vr-result-scope dt { color: #58615B; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
  .vr-result-scope dd { margin: 0; color: #111522; font-size: 0.9rem; font-weight: 600; }
  @media (max-width: 559px) {
    .vr-result-scope dl { grid-template-columns: 1fr; gap: 0.15rem; }
    .vr-result-scope dd { margin-bottom: 0.55rem; }
  }

  .vr-block { opacity: 0; transform: translateY(14px); transition: opacity 0.6s cubic-bezier(0.22,1,0.36,1), transform 0.6s cubic-bezier(0.22,1,0.36,1); }
  .vr-block.is-in { opacity: 1; transform: none; }

  .vr-card { background: #FFFFFF; border: 1px solid #C9CEC8; border-radius: 0; padding: 1.5rem 1.35rem; }
  @media (min-width: 768px) { .vr-card { padding: 1.9rem; } }
  .vr-card--dark { background: #111522; border-color: #111522; }
  .vr-card--warm { background: #D7FF42; border-color: #C9CEC8; }

  .vr-label { font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #243CFF; }
  .vr-card--dark .vr-label { color: #D7FF42; }
  .vr-num { font-family: 'Public Sans', system-ui, sans-serif; font-weight: 700; line-height: 1; letter-spacing: -0.02em; color: #111522; }
  .vr-card--dark .vr-num { color: #F2F5EF; }
  .vr-sub { font-family: 'Public Sans', system-ui, sans-serif; color: #58615B; }
  .vr-card--dark .vr-sub { color: rgba(242,245,239,0.7); }

  /* B — compteur de ventes */
  .vr-b-num { font-size: clamp(3.4rem, 16vw, 5rem); }
  .vr-b-l { font-family: 'Public Sans', system-ui, sans-serif; font-size: 1.1rem; color: #111522; margin-top: 0.15rem; }
  .vr-b-sub { font-size: 0.9rem; margin-top: 0.45rem; }

  /* C — prix du milieu + curseur de fourchette */
  .vr-c-num { font-size: clamp(2.7rem, 12vw, 3.8rem); }
  .vr-c-lbl { margin-top: 0.55rem; }
  .vr-range { margin-top: 1.8rem; }
  .vr-range-line { position: relative; height: 3px; background: #C9CEC8; margin: 0 0.2rem; border-radius: 3px; }
  .vr-range-dot { position: absolute; top: 50%; width: 18px; height: 18px; border-radius: 999px; background: #243CFF; box-shadow: none; transform: translate(-50%, -50%); transition: left 0.9s cubic-bezier(0.22,1,0.36,1); }
  .vr-range-cap { position: absolute; top: -1.55rem; font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.92rem; color: #111522; font-weight: 600; }
  .vr-range-cap.g { left: 0; } .vr-range-cap.d { right: 0; }
  .vr-range-arrows { display: flex; justify-content: space-between; color: #58615B; font-size: 1rem; margin-top: 0.35rem; padding: 0 0.1rem; }
  .vr-c-phrase { font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.98rem; color: #58615B; margin-top: 1rem; line-height: 1.5; }
  .vr-c-m2 { font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.88rem; color: #58615B; opacity: 0.85; margin-top: 0.55rem; }

  /* D — tendance : titre + jauge baisse/stable/hausse */
  .vr-d-head { display: flex; align-items: center; gap: 0.65rem; margin-top: 0.7rem; }
  .vr-d-ico { width: 32px; height: 32px; flex: 0 0 auto; }
  .vr-d-ico svg { width: 100%; height: 100%; }
  .vr-d-title { font-family: 'Public Sans', system-ui, sans-serif; font-weight: 700; font-size: clamp(1.4rem, 5vw, 1.9rem); line-height: 1.1; color: #111522; }
  .vr-d-pct { font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.9rem; color: #58615B; margin-top: 0.9rem; }
  .vr-gauge { margin-top: 1.3rem; }
  .vr-gauge-track { position: relative; height: 12px; border-radius: 999px; background: #C9CEC8; }
  .vr-gauge-cursor { position: absolute; top: -5px; width: 4px; height: 22px; border-radius: 2px; background: #111522; transform: translateX(-50%); transition: left 0.9s cubic-bezier(0.22,1,0.36,1); }
  .vr-gauge-lbls { display: flex; justify-content: space-between; margin-top: 0.55rem; font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.76rem; letter-spacing: 0.08em; text-transform: uppercase; color: #58615B; }
  .vr-gauge-lbls .on { color: #243CFF; font-weight: 600; }

  /* A — dernière vente */
  .vr-a-num { font-size: clamp(2.5rem, 11vw, 3.4rem); margin-top: 0.7rem; }
  .vr-a-bien { font-family: 'Public Sans', system-ui, sans-serif; font-size: 1.02rem; margin-top: 0.5rem; color: rgba(242,245,239,0.92); }
  .vr-a-meta { font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.92rem; margin-top: 0.35rem; }

  /* En clair */
  .vr-ec { font-family: 'Public Sans', system-ui, sans-serif; font-weight: 700; font-size: clamp(1.3rem, 4.6vw, 1.8rem); line-height: 1.32; color: #111522; margin-top: 0.7rem; }
  .vr-maj { font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.8rem; color: #58615B; margin-top: 0.9rem; }

  /* Ventes détaillées (secondaire) */
  .vr-details { margin-top: 0.1rem; }
  .vr-details summary {
    cursor: pointer; font-family: 'Public Sans', system-ui, sans-serif; font-weight: 600; color: #243CFF;
    padding: 0.9rem 0; list-style: none; display: inline-flex; align-items: center; gap: 0.5rem;
  }
  .vr-details summary::-webkit-details-marker { display: none; }
  .vr-details summary::before { content: '＋'; font-weight: 400; }
  .vr-details[open] summary::before { content: '－'; }
  .vr-autre { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem 1rem; padding: 0.85rem 0; border-top: 1px solid #C9CEC8; font-family: 'Public Sans', system-ui, sans-serif; }
  .vr-autre-sub { display: block; font-size: 0.85rem; color: #58615B; }
  .vr-autre-prix { font-weight: 600; color: #111522; }

  /* ——— Conversion : rupture forte (carte sombre) ——— */
  .vr-conv { background: #111522; color: #F2F5EF; border-radius: 0; padding: 2rem 1.5rem; margin-top: 1.75rem; }
  @media (min-width: 768px) { .vr-conv { padding: 2.75rem; } }
  .vr-conv-eyebrow { font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #D7FF42; margin-bottom: 0.8rem; }
  .vr-conv-titre { font-family: 'Public Sans', system-ui, sans-serif; font-weight: 700; font-size: clamp(1.8rem, 6.5vw, 2.6rem); line-height: 1.08; color: #F2F5EF; margin-bottom: 0.7rem; }
  .vr-conv-intro { font-family: 'Public Sans', system-ui, sans-serif; font-size: 1.02rem; line-height: 1.6; color: rgba(242,245,239,0.72); margin-bottom: 1.6rem; }
  .vr-paths { display: grid; gap: 0.7rem; }
  .vr-path { text-align: left; width: 100%; border: 0; border-radius: 0; padding: 1.15rem 1.3rem; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1rem; transition: transform 0.2s, background 0.2s, border-color 0.2s; }
  .vr-path-t { font-family: 'Public Sans', system-ui, sans-serif; font-weight: 700; font-size: 1.18rem; display: block; }
  .vr-path-d { font-family: 'Public Sans', system-ui, sans-serif; font-size: 0.88rem; margin-top: 0.2rem; display: block; }
  .vr-path-arrow { flex: 0 0 auto; font-size: 1.15rem; }
  .vr-path--1 { background: #243CFF; }
  .vr-path--1 .vr-path-t { color: #F2F5EF; } .vr-path--1 .vr-path-d { color: rgba(242,245,239,0.82); } .vr-path--1 .vr-path-arrow { color: #F2F5EF; }
  .vr-path--1:hover { background: #202635; transform: translateY(-2px); box-shadow: none; }
  .vr-path--2 { background: #F2F5EF; }
  .vr-path--2 .vr-path-t { color: #111522; } .vr-path--2 .vr-path-d { color: #58615B; } .vr-path--2 .vr-path-arrow { color: #243CFF; }
  .vr-path--2:hover { transform: translateY(-2px); box-shadow: none; }
  .vr-path--3 { background: transparent; border: 1px solid rgba(242,245,239,0.26); }
  .vr-path--3 .vr-path-t { color: #F2F5EF; font-size: 1.04rem; } .vr-path--3 .vr-path-d { color: rgba(242,245,239,0.6); } .vr-path--3 .vr-path-arrow { color: rgba(242,245,239,0.6); }
  .vr-path--3:hover { border-color: #D7FF42; }

  /* Panneau (qualif / contact / explorer) — carte claire imbriquée dans la conversion sombre */
  .vr-panneau { margin-top: 1.35rem; background: #FFFFFF; border-radius: 0; padding: 1.5rem 1.35rem; }
  .vr-panneau:empty { display: none; }
  .vr-q-progress { display: flex; gap: 0.35rem; margin-bottom: 1.25rem; }
  .vr-q-dot { height: 4px; flex: 1; border-radius: 999px; background: #C9CEC8; }
  .vr-q-dot.is-on { background: #243CFF; }
  .vr-q-label { font-family: 'Public Sans', system-ui, sans-serif; font-weight: 700; font-size: 1.35rem; line-height: 1.2; color: #111522; margin-bottom: 1.1rem; }
  .vr-q-opts { display: grid; gap: 0.6rem; }
  .vr-q-opt {
    text-align: left; background: #F2F5EF; border: 1px solid #C9CEC8; border-radius: 0;
    padding: 0.9rem 1.1rem; cursor: pointer; font-family: 'Public Sans', system-ui, sans-serif; font-size: 1rem; color: #111522;
    transition: border-color 0.15s, background 0.15s;
  }
