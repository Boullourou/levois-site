<script>
  import {
    boundedGeocodingQuery,
    geocodingCandidates,
    selectMarketScope,
    type GeocodingCandidate,
    type MarketTransaction,
    type PropertyType,
  } from '../lib/votre-rue';
  import {
    ATTRIBUTION_STORAGE_KEY,
    attributionFromVisit,
    mergeAttribution,
    parseStoredAttribution,
  } from '../lib/attribution';

  type Tx = MarketTransaction;
  type Meta = {
    status: string;
    generatedAt: string | null;
    dateVenteLaPlusRecente: string | null;
    dateVenteLaPlusAncienne?: string | null;
  };

  const form = document.getElementById('vr-form') as HTMLFormElement;
  const input = document.getElementById('vr-adresse') as HTMLInputElement;
  const typeBien = document.getElementById('vr-type-bien') as HTMLSelectElement;
  const submit = document.getElementById('vr-submit') as HTMLButtonElement;
  const sugList = document.getElementById('vr-suggestions') as HTMLUListElement;
  const scene = document.getElementById('vr-scene') as HTMLElement;
  const geoErreur = document.getElementById('vr-geo-erreur') as HTMLElement;
  const fraicheurEl = document.getElementById('vr-fraicheur') as HTMLElement;
  const adresseConfirmee = document.getElementById('vr-adresse-confirmee') as HTMLElement;
  const adresseConfirmeeLabel = document.getElementById('vr-adresse-confirmee-label') as HTMLElement;
  const adresseConfirmeeType = document.getElementById('vr-adresse-confirmee-type') as HTMLElement;

  const BIAIS = { lon: 1.4890, lat: 48.4470 };
  const GEOCODE = 'https://data.geopf.fr/geocodage/search';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const eur = new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 });
  const moisAn = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' });
  const jourMoisAn = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
  const dateComplete = (d: string) => { const dt = new Date(d + 'T00:00:00'); return isNaN(dt.getTime()) ? d : jourMoisAn.format(dt); };
  const dateMois = (d: string) => { const dt = new Date(d + 'T00:00:00'); return isNaN(dt.getTime()) ? d : moisAn.format(dt); };
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  const wait = (ms: number) => new Promise((r) => setTimeout(r, reduced ? 0 : ms));

  function attributionBornee() {
    const current = attributionFromVisit(window.location.href, document.referrer);
    try {
      return mergeAttribution(
        parseStoredAttribution(sessionStorage.getItem(ATTRIBUTION_STORAGE_KEY)),
        current,
      );
    } catch {
      return current;
    }
  }

  let dataset: Tx[] | null = null;
  let meta: Meta | null = null;
  let selection: GeocodingCandidate | null = null;
  let lastModel: any = null;

  // ——— Fraîcheur affichée d'emblée ———
  (async () => {
    try {
      const m = (await (await fetch('/data/dvf-meta.json')).json()) as Meta;
      meta = m;
      if (m.status === 'ready' && m.dateVenteLaPlusRecente) {
        fraicheurEl.textContent = `Données DVF disponibles jusqu'au ${dateComplete(m.dateVenteLaPlusRecente)}`;
        fraicheurEl.hidden = false;
      }
    } catch {}
  })();

  async function chargerDonnees() {
    if (dataset) return;
    const [d, m] = await Promise.all([fetch('/data/dvf-secteur.json'), fetch('/data/dvf-meta.json')]);
    dataset = (await d.json()) as Tx[];
    meta = (await m.json()) as Meta;
  }

  async function geocoder(q: string, limit: number) {
    const url = new URL(GEOCODE);
    url.searchParams.set('q', boundedGeocodingQuery(q));
    url.searchParams.set('limit', String(limit));
    url.searchParams.set('lon', String(BIAIS.lon));
    url.searchParams.set('lat', String(BIAIS.lat));
    const rep = await fetch(url.toString());
    if (!rep.ok) throw new Error(`geocode ${rep.status}`);
    const json = await rep.json();
    const feats = Array.isArray(json.features) ? json.features : [];
    return geocodingCandidates(feats);
  }
  const distLisible = (m: number) => (m < 1000 ? `à environ ${Math.round(m / 50) * 50} m` : `à environ ${(m / 1000).toFixed(1).replace('.', ',')} km`);
  const median = (a: number[]) => { if (!a.length) return null; const s = [...a].sort((x, y) => x - y), m = Math.floor(s.length / 2); return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2; };
  const quantile = (a: number[], q: number) => { if (a.length < 2) return a[0] ?? null; const s = [...a].sort((x, y) => x - y); const pos = (s.length - 1) * q, b = Math.floor(pos), r = pos - b; return s[b + 1] !== undefined ? s[b] + r * (s[b + 1] - s[b]) : s[b]; };

  const multiLots = (t: Tx) => Boolean(t.lots && t.lots > 1);
  const typePluriel = (t: string) => (t === 'Maison' ? 'des maisons' : 'des appartements');
  const typePlurielNu = (t: string) => (t === 'Maison' ? 'maisons' : 'appartements');

  function bienCourt(t: Tx) {
    const b = [t.t]; if (t.sb) b.push(`${t.sb} m²`); if (t.p) b.push(`${t.p} pièce${t.p > 1 ? 's' : ''}`);
    if (multiLots(t)) b.push(`vente de ${t.lots} lots`);
    return b.join(' · ');
  }
  function adresse(t: Tx) {
    const rue = [t.no, t.vo].filter(Boolean).join(' '), ville = [t.cp, t.co].filter(Boolean).join(' ');
    return rue && ville ? `${rue}, ${ville}` : rue || ville || 'Adresse approximative';
  }

  // ——— Tendance : régression linéaire sur les médianes ANNUELLES du €/m² ———
  // Bien plus robuste que deux fenêtres isolées : utilise toutes les années
  // (2021→2025), amortit le bruit d'une année atypique, et reflète la tendance
  // de fond. Une comparaison de deux fenêtres pouvait afficher une « baisse »
  // là où le marché est en réalité stable (retour après un pic ponctuel).
  function computeTrend(sample: any[]) {
    // La tendance emploie exactement l'échantillon, le type et le rayon affichés.
    // Si chaque année 2021–2025 n'apporte pas assez d'observations, elle est
    // suspendue au lieu d'élargir silencieusement le périmètre.
    const arr = sample;
    const xs: number[] = [], ys: number[] = [];
    for (let y = 2021; y <= 2025; y++) {
      const g = arr.filter((t) => t.d.startsWith(String(y))).map((t) => t.v / t.sb);
      if (g.length >= 20) { xs.push(y); ys.push(median(g) as number); } // année fiable seulement
    }
    if (xs.length !== 5) return null; // période complète absente → pas de tendance affichée

    // Droite de régression (moindres carrés) sur les médianes annuelles.
    const ANNEE_REF = 2021, ANNEE_FIN = 2025; // bornes FIXES, identiques pour toute adresse
    const n = xs.length, x0 = xs[0];
    const X = xs.map((y) => y - x0);
    const sx = X.reduce((a, b) => a + b, 0), sy = ys.reduce((a, b) => a + b, 0);
    const sxx = X.reduce((a, b) => a + b * b, 0), sxy = X.reduce((a, b, i) => a + b * ys[i], 0);
    const slope = (n * sxy - sx * sy) / (n * sxx - sx * sx); // €/m² par an
    const intercept = (sy - slope * sx) / n;

    // ——— Conversion pente → pourcentage : RÈGLE UNIQUE, indépendante de l'adresse ———
    // On évalue la droite ajustée à deux années FIXES (2021 et 2025), jamais aux
    // années réellement présentes. Le pourcentage est la variation de la valeur
    // ajustée entre ces deux bornes, normalisée par la valeur ajustée de l'année
    // de RÉFÉRENCE CONSTANTE (2021) :
    //     delta% = (ajustée(2025) − ajustée(2021)) / ajustée(2021) × 100
    // La référence (2021) et l'amplitude (4 ans) ne dépendent jamais de l'adresse ;
    // seule la pente, elle, reflète les données locales.
    const yhat = (annee: number) => intercept + slope * (annee - x0);
    const ref = yhat(ANNEE_REF);
    const delta = ((yhat(ANNEE_FIN) - ref) / ref) * 100;

    // Seuil de stabilité : |delta| < 3 % → prix globalement stables.
    const dir = delta >= 3 ? 'hausse' : delta <= -3 ? 'baisse' : 'stable';
    return { delta, dir, anneeDebut: ANNEE_REF, anneeFin: ANNEE_FIN, annualMeds: xs.map((y, i) => ({ year: y, med: Math.round(ys[i]) })) };
  }

  // ——— Modèle : tous les indicateurs, calculés sur les vraies données ———
  function computeModel(lat: number, lon: number, dom: PropertyType) {
    const scope = selectMarketScope(dataset as Tx[], lat, lon, dom);
    if (!scope) return null;

    const { sample: near, context, radius: Rw, periodFrom, periodTo } = scope;
    const nM = context.filter((t) => t.t === 'Maison').length;
    const nA = context.filter((t) => t.t === 'Appartement').length;
    const nbVentes = near.length;

    const ppmStats = (arr: any[]) => {
      const vals = arr.filter((t: any) => t.sb > 0).map((t: any) => t.v / t.sb);
      if (vals.length < 20) return null;
      return { median: median(vals)!, q1: quantile(vals, 0.25)!, q3: quantile(vals, 0.75)!, n: vals.length };
    };
    const ppmM = ppmStats(context.filter((t) => t.t === 'Maison'));
    const ppmA = ppmStats(context.filter((t) => t.t === 'Appartement'));

    const D = computeTrend(near);

    const derniere = [...near].sort((a, b) => (a.d < b.d ? 1 : a.d > b.d ? -1 : a._dist - b._dist))[0];
    const activite = near.filter((t) => t.d >= '2025').length >= 5;
    const autres = [...near].sort((a, b) => (a.d < b.d ? 1 : -1)).filter((t) => t.id !== derniere?.id).slice(0, 4);

    const surfaceEffect = (() => {
      if (dom !== 'Appartement') return null;
      const appts = near.filter((t) => t.sb && t.sb > 0);
      if (appts.length < 40) return null;
      const small = appts.filter((t) => t.sb < 50);
      const large = appts.filter((t) => t.sb >= 80);
      if (small.length < 20 || large.length < 20) return null;
      const ppmSmall = small.map((t) => t.v / t.sb).sort((a: number, b: number) => a - b);
      const ppmLarge = large.map((t) => t.v / t.sb).sort((a: number, b: number) => a - b);
      const medS = median(ppmSmall) as number;
      const medL = median(ppmLarge) as number;
      const deltaPct = Math.round(((medS - medL) / medL) * 100);
      if (Math.abs(deltaPct) < 10) return null;
      return { smallLabel: '< 50 m²', smallMed: Math.round(medS), smallN: small.length, largeLabel: '≥ 80 m²', largeMed: Math.round(medL), largeN: large.length, deltaPct };
    })();
    const n2024 = near.filter((t) => t.d.startsWith('2024')).length;
    const n2025 = near.filter((t) => t.d.startsWith('2025')).length;
    const ppmArr2 = (arr: any[]) => arr.filter((t: any) => t.sb > 0).map((t: any) => Math.round(t.v / t.sb)).sort((a: number, b: number) => a - b);
    const sampleArr = (arr: number[], n: number) => arr.length <= n ? arr : Array.from({ length: n }, (_: any, i: number) => arr[Math.floor(i * arr.length / n)]);
    const ppmDotsM = sampleArr(ppmArr2(near.filter((t) => t.t === 'Maison')), 60);
    const ppmDotsA = sampleArr(ppmArr2(near.filter((t) => t.t === 'Appartement')), 60);
    return {
      nbVentes, Rw, dom, nM, nA, ppmM, ppmA, ppmDotsM, ppmDotsA, D,
      derniere, activite, autres, surfaceEffect, n2024, n2025, periodFrom, periodTo,
    };
  }

  // ——— « En clair » : phrases par règles fixes ———
  function enClair(model: any) {
    const s1 = model.activite
      ? `Autour de cette adresse, ${typePluriel(model.dom)} continuent de se vendre.`
      : `Autour de cette adresse, ${typePluriel(model.dom)} se vendent, mais plus rarement.`;
    let s2 = '';
    if (model.D) {
      if (model.D.dir === 'stable') s2 = 'Les prix observés sont globalement stables ces dernières années.';
      else if (model.D.dir === 'hausse') s2 = 'Les prix observés sont plutôt orientés à la hausse ces dernières années.';
      else s2 = 'Les prix observés sont plutôt orientés à la baisse ces dernières années.';
    }
    return { s1, s2 };
  }

  // ——— Animations ———
  function animeCompteur(el: HTMLElement, to: number, dur = 1100) {
    if (reduced) { el.textContent = eur.format(to); return; }
    const t0 = performance.now();
    const step = (now: number) => {
      const p = Math.min(1, (now - t0) / dur);
      const e = 1 - Math.pow(1 - p, 3);
      el.textContent = eur.format(Math.round(to * e));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  // Applique l'état final d'une animation de bloc (utilisé au reveal et en reduced-motion)
  function jouerAnim(el: HTMLElement, instantane: boolean) {
    const anim = el.dataset.anim;
    if (anim === 'count') {
      el.querySelectorAll<HTMLElement>('[data-count]').forEach((n) => {
        if (instantane) n.textContent = eur.format(Number(n.dataset.count));
        else animeCompteur(n, Number(n.dataset.count));
      });
    } else if (anim === 'slider') {
      const dot = el.querySelector<HTMLElement>('.vr-range-dot');
      if (dot && dot.dataset.pos) dot.style.left = dot.dataset.pos;
    } else if (anim === 'gauge') {
      const cur = el.querySelector<HTMLElement>('.vr-gauge-cursor');
      if (cur && cur.dataset.pos) cur.style.left = cur.dataset.pos;
    }
  }

  const observer = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const el = e.target as HTMLElement;
      el.classList.add('is-in');
      jouerAnim(el, false);
      observer.unobserve(el);
    }
  }, { threshold: 0.3, rootMargin: '0px 0px -8% 0px' });

  function reveler(el: HTMLElement) {
    if (reduced) { el.classList.add('is-in'); jouerAnim(el, true); return; }
    observer.observe(el);
  }

  // ——— Rendu de l'infographie ———
  const rayonTxt = (r: number) => (r < 1000 ? `${r} m` : `${(r / 1000).toLocaleString('fr-FR')} km`);
  function construirePerimetre(model: any) {
    const typeLabel = model.dom === 'Maison' ? 'Maisons' : 'Appartements';
    const adresseLabel = selection?.label || '';
    const adresseType = selection?.kindLabel || '';
    return `
      <section class="vr-result-scope" aria-label="Périmètre du résultat">
        <h2>Périmètre vérifiable du résultat</h2>
        <dl>
          <dt>Adresse confirmée</dt><dd>${esc(adresseLabel)}${adresseType ? ` · ${esc(adresseType)}` : ''}</dd>
          <dt>Type de résultat</dt><dd>${typeLabel}</dd>
          <dt>Période</dt><dd>Du ${esc(dateComplete(model.periodFrom))} au ${esc(dateComplete(model.periodTo))}</dd>
          <dt>Rayon</dt><dd>${esc(rayonTxt(model.Rw))}</dd>
          <dt>Échantillon</dt><dd>${model.nbVentes} ventes ${typeLabel.toLocaleLowerCase('fr-FR')} retenues</dd>
        </dl>
      </section>`;
  }
  // Position du curseur sur la jauge baisse/stable/hausse : domaine [-10 %, +10 %].
  const gaugePos = (delta: number) => Math.max(4, Math.min(96, ((delta + 10) / 20) * 100));

  function iconeTendance(dir: string) {
    if (dir === 'hausse') return '<svg viewBox="0 0 24 24" fill="none" stroke="#243CFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17L11 10l4 4 6-6"/><path d="M15 8h6v6"/></svg>';
    if (dir === 'baisse') return '<svg viewBox="0 0 24 24" fill="none" stroke="#58615B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7l7 7 4-4 6 6"/><path d="M15 16h6v-6"/></svg>';
    return '<svg viewBox="0 0 24 24" fill="none" stroke="#58615B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"/><path d="M16 8l4 4-4 4"/></svg>';
  }
  function tendanceTitre(dir: string) {
    if (dir === 'hausse') return 'Prix orientés à la hausse';
    if (dir === 'baisse') return 'Prix orientés à la baisse';
    return 'Prix globalement stables';
  }

  // Repli empilé (reduced-motion / secours) — cartes verticales lisibles.
  function construireStack(model: any) {
    const ppmDom = model.dom === 'Maison' ? model.ppmM : model.ppmA;
    const ppmAlt = model.dom === 'Maison' ? model.ppmA : model.ppmM;
    const altType = model.dom === 'Maison' ? 'Appartement' : 'Maison';
    const parts: string[] = [];

    parts.push(construirePerimetre(model));
    parts.push(`
      <div class="vr-head">
        <p class="vr-head-eyebrow">Autour de cette adresse</p>
        ${selection?.label ? `<p class="vr-head-adr">${esc(selection.label)}</p>` : ''}
      </div>`);

    // ① Activité
    parts.push(`
      <div class="vr-block" data-anim="count">
        <div class="vr-card">
          <p class="vr-num vr-b-num"><span data-count="${model.nbVentes}">0</span></p>
          <p class="vr-b-l">ventes de ${esc(typePlurielNu(model.dom))} retenues</p>
          <p class="vr-sub vr-b-sub">du ${esc(dateComplete(model.periodFrom))} au ${esc(dateComplete(model.periodTo))}, dans un rayon de ${rayonTxt(model.Rw)}</p>
        </div>
      </div>`);

    // ② Composition maisons / appartements
    parts.push(`
      <div class="vr-block" data-anim="count">
        <div class="vr-card">
          <p class="vr-label">Ce qui se vend ici</p>
          <div style="display:flex;gap:1.5rem;flex-wrap:wrap;margin-top:0.5rem">
            <div><p class="vr-num" style="font-size:clamp(2rem,8vw,2.8rem)"><span data-count="${model.nM}">0</span></p><p class="vr-sub">maisons</p></div>
            <div><p class="vr-num" style="font-size:clamp(2rem,8vw,2.8rem)"><span data-count="${model.nA}">0</span></p><p class="vr-sub">appartements</p></div>
          </div>
          <p class="vr-sub" style="margin-top:0.8rem">Deux marchés différents. Mieux vaut ne pas les mélanger.</p>
        </div>
      </div>`);

    // ③ Prix €/m² par type
    if (ppmDom) {
      const q1 = Math.round(ppmDom.q1), q3 = Math.round(ppmDom.q3), med = Math.round(ppmDom.median);
      const pos = q3 > q1 ? Math.max(6, Math.min(94, ((med - q1) / (q3 - q1)) * 100)) : 50;
      let altHtml = '';
      if (ppmAlt) {
        altHtml = `<div class="vr-ppm-alt"><p class="vr-ppm-alt-type">${esc(typePlurielNu(altType))}</p><p class="vr-ppm-alt-val">${eur.format(Math.round(ppmAlt.median))} €/m²</p><p class="vr-ppm-alt-range">fourchette ${eur.format(Math.round(ppmAlt.q1))} – ${eur.format(Math.round(ppmAlt.q3))} €/m²</p></div>`;
      }
      parts.push(`
        <div class="vr-block" data-anim="slider">
          <div class="vr-card">
            <p class="vr-label">Le prix au m² observé · ${esc(typePlurielNu(model.dom))}</p>
            <p class="vr-num vr-c-num">${eur.format(med)} €/m²</p>
            <div class="vr-range">
              <div class="vr-range-line">
                <span class="vr-range-cap g">${eur.format(q1)}</span>
                <span class="vr-range-cap d">${eur.format(q3)}</span>
                <span class="vr-range-dot" data-pos="${pos.toFixed(0)}%" style="left:50%"></span>
              </div>
              <div class="vr-range-arrows" aria-hidden="true"><span>←</span><span>→</span></div>
              <p class="vr-c-phrase">La moitié des ${esc(typePlurielNu(model.dom))} se sont vendues entre <strong>${eur.format(q1)}</strong> et <strong>${eur.format(q3)} €/m²</strong>.</p>
            </div>
            ${altHtml}
          </div>
        </div>`);
    }

    // ④ Tendance
    if (model.D) {
      const pct = `${model.D.delta >= 0 ? '+' : ''}${model.D.delta.toFixed(1).replace('.', ',')} %`;
      const pos = gaugePos(model.D.delta), dir = model.D.dir;
      parts.push(`
        <div class="vr-block" data-anim="gauge">
          <div class="vr-card">
            <p class="vr-label">Les prix, dans le temps</p>
            <div class="vr-d-head">
              <span class="vr-d-ico" aria-hidden="true">${iconeTendance(dir)}</span>
              <span class="vr-d-title">${tendanceTitre(dir)}</span>
            </div>
            <div class="vr-gauge">
              <div class="vr-gauge-track"><span class="vr-gauge-cursor" data-pos="${pos.toFixed(0)}%" style="left:50%"></span></div>
              <div class="vr-gauge-lbls">
                <span class="${dir === 'baisse' ? 'on' : ''}">Baisse</span>
                <span class="${dir === 'stable' ? 'on' : ''}">Stable</span>
                <span class="${dir === 'hausse' ? 'on' : ''}">Hausse</span>
              </div>
            </div>
            <p class="vr-d-pct">${pct} sur le prix au m², estimé sur ${model.D.anneeDebut}–${model.D.anneeFin}</p>
          </div>
        </div>`);
    }

    // ⑤ Limitation
    parts.push(`
      <div class="vr-block" data-anim="fade">
        <div class="vr-card vr-card--warm">
          <p class="vr-label">À retenir</p>
          <p class="vr-ec">Un même quartier. Des biens très différents.</p>
          <p class="vr-sub" style="margin-top:0.8rem;line-height:1.55">Une adresse donne le contexte, elle ne suffit pas à situer votre bien. Surface, état, exposition, travaux : chaque propriété est unique, et ces statistiques de quartier ne peuvent pas le refléter.</p>
        </div>
        <p class="vr-maj">${majLigne()}</p>
      </div>`);

    // Ventes détaillées (secondaire)
    if (model.autres.length) {
      const d = model.derniere;
      parts.push(`
        <div class="vr-block" data-anim="fade">
          <details class="vr-details">
            <summary>Voir les ventes autour de chez moi</summary>
            <div>
              <div class="vr-autre">
                <span>${esc(bienCourt(d))}<span class="vr-autre-sub">${esc(adresse(d))} · ${esc(dateMois(d.d))} · ${esc(distLisible(d._dist))}</span></span>
                <span class="vr-autre-prix">${eur.format(d.v)} €</span>
              </div>
              ${model.autres.map((t: any) => `
                <div class="vr-autre">
                  <span>${esc(bienCourt(t))}<span class="vr-autre-sub">${esc(adresse(t))} · ${esc(dateMois(t.d))} · ${esc(distLisible(t._dist))}</span></span>
                  <span class="vr-autre-prix">${eur.format(t.v)} €</span>
                </div>`).join('')}
            </div>
          </details>
        </div>`);
    }

    parts.push(construireConversion());

    scene.innerHTML = `<div class="vr-results">${parts.join('')}</div>`;
    scene.querySelectorAll<HTMLElement>('.vr-block').forEach((b) => reveler(b));
    brancherConversion(model);
  }

  // Ventes détaillées (réutilisé par le repli et la séquence)
  function blocDetails(model: any) {
    const d = model.derniere;
    if (!model.autres.length) return '';
    return `
      <details class="vr-details">
        <summary>Voir les ventes autour de chez moi</summary>
        <div>
          <div class="vr-autre"><span>${esc(bienCourt(d))}<span class="vr-autre-sub">${esc(adresse(d))} · ${esc(dateMois(d.d))} · ${esc(distLisible(d._dist))}</span></span><span class="vr-autre-prix">${eur.format(d.v)} €</span></div>
          ${model.autres.map((t: any) => `<div class="vr-autre"><span>${esc(bienCourt(t))}<span class="vr-autre-sub">${esc(adresse(t))} · ${esc(dateMois(t.d))} · ${esc(distLisible(t._dist))}</span></span><span class="vr-autre-prix">${eur.format(t.v)} €</span></div>`).join('')}
        </div>
      </details>`;
  }

  // ——— Infographique premium — 7 blocs, IntersectionObserver ———
  let cineCleanup: null | (() => void) = null;

  function construireCine(model: any) {
    if (cineCleanup) { cineCleanup(); cineCleanup = null; }

    const ios: IntersectionObserver[] = [];
    const touts: ReturnType<typeof setTimeout>[] = [];
    const later = (ms: number, fn: () => void) => { touts.push(setTimeout(fn, ms)); };
    const observe = (id: string, fn: () => void) => {
      const el = scene.querySelector(id);
      if (!el) return;
      const io = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) { io.disconnect(); fn(); }
      }, { threshold: 0.08 });
      io.observe(el);
      ios.push(io);
    };

    const domColor = model.dom === 'Maison' ? '#243CFF' : '#202635';
    const D = model.D;
    const sf = model.surfaceEffect;

    // ——— Nuage de points (positions déterministes) ———
    const NDOTS = 44;
    const propM = model.nM / Math.max(model.nM + model.nA, 1);
    const nDotM = Math.max(4, Math.min(40, Math.round(NDOTS * propM)));
    const SW = 360, SH = 130, CX = SW / 2, CY = SH / 2;
    let _s = 0x9e3779b9;
    const rnd = () => { _s = ((_s ^ (_s >>> 16)) * 0x45d9f3b) >>> 0; _s = ((_s ^ (_s >>> 16)) * 0x45d9f3b) >>> 0; _s ^= _s >>> 16; return (_s >>> 0) / 0x100000000; };
    type Dot = { x0: number; y0: number; dx: number; dy: number; isM: boolean };
    const dots: Dot[] = Array.from({ length: NDOTS }, (_, i) => {
      const isM = i < nDotM;
      const x0 = CX + (rnd() * 2 - 1) * 8, y0 = CY + (rnd() * 2 - 1) * 8;
      const x1 = isM ? 14 + rnd() * 100 : SW - 114 + rnd() * 100, y1 = 10 + rnd() * 110;
      return { x0, y0, dx: x1 - x0, dy: y1 - y0, isM };
    });
    const dotSvg = dots.map((d, i) =>
      `<circle class="vr-dot" cx="${d.x0.toFixed(1)}" cy="${d.y0.toFixed(1)}" r="${d.isM ? 5 : 4}" fill="#C9CEC8" data-di="${i}"/>`
    ).join('');

    // ——— Distribution jitter (€/m² réels) ———
    const ppmDom = model.dom === 'Maison' ? model.ppmM : model.ppmA;
    const ppmDots: number[] = (model.dom === 'Maison' ? model.ppmDotsM : model.ppmDotsA) || [];
    let distHtml = '';
    if (ppmDom && ppmDots.length >= 5) {
      const q1 = ppmDom.q1, med = ppmDom.median, q3 = ppmDom.q3;
      const iqr = q3 - q1;
      const xMin = Math.max(Math.min(...ppmDots), q1 - 1.5 * iqr);
      const xMax = Math.min(Math.max(...ppmDots), q3 + 1.5 * iqr);
      const DW = 360, DH = 64, YN = 6, YX = 58;
      const xs = (v: number) => Math.max(2, Math.min(DW - 2, ((v - xMin) / Math.max(xMax - xMin, 1)) * DW));
      const q1x = xs(q1), medx = xs(med), q3x = xs(q3), zoneW = Math.max(0, q3x - q1x);
      let _s2 = 0xabcdef01;
      const rnd2 = () => { _s2 = ((_s2 ^ (_s2 >>> 16)) * 0x45d9f3b) >>> 0; _s2 = ((_s2 ^ (_s2 >>> 16)) * 0x45d9f3b) >>> 0; _s2 ^= _s2 >>> 16; return (_s2 >>> 0) / 0x100000000; };
      const visible = ppmDots.filter((v: number) => v >= xMin && v <= xMax);
      const ddots = visible.map((v: number, i: number) =>
        `<circle class="vr-dist-dot" cx="${xs(v).toFixed(1)}" cy="${(YN + rnd2() * (YX - YN)).toFixed(1)}" r="3.5" fill="${domColor}" data-di="${i}"/>`
      ).join('');
      const pillCls = model.dom === 'Maison' ? 'vr-dist-type-pill--M' : 'vr-dist-type-pill--A';
      const pillTxt = model.dom === 'Maison' ? 'Maisons' : 'Appartements';
      const lblY = DH + 16;
      const q1LblX = Math.max(q1x, 28);
      const q3LblX = Math.min(q3x, DW - 28);
      distHtml = `
        <div class="vr-bloc vr-bloc--b2 vr-bloc-anim" id="vr-b-dist">
          <p class="vr-kicker vr-kicker--ink">CE QUE LES PRIX MONTRENT</p>
          <p class="vr-titre vr-titre--dark">Les prix dans ce secteur</p>
          <span class="vr-dist-type-pill ${pillCls}">${esc(pillTxt)}</span>
          <div class="vr-dist-wrap">
            <svg class="vr-dist-svg" viewBox="0 0 ${DW} ${DH + 42}" aria-hidden="true">
              <rect class="vr-dist-zone" id="vr-dz" x="${q1x.toFixed(1)}" y="${YN - 4}" width="${zoneW.toFixed(1)}" height="${YX - YN + 8}" rx="4" fill="${domColor}" fill-opacity="0.15" style="opacity:0"/>
              ${ddots}
              <line class="vr-dist-med-line" id="vr-dml" x1="${medx.toFixed(1)}" y1="${YN - 8}" x2="${medx.toFixed(1)}" y2="${YX + 8}" stroke="${domColor}" stroke-width="2.5" stroke-dasharray="4 2" style="opacity:0"/>
              <text x="2" y="${lblY}" class="vr-dist-axis-lbl">${eur.format(Math.round(xMin))} €/m²</text>
              <text x="${DW - 2}" y="${lblY}" class="vr-dist-axis-lbl" text-anchor="end">${eur.format(Math.round(xMax))} €/m²</text>
              <text id="vr-q1-lbl" class="vr-dist-zone-lbl" x="${q1LblX.toFixed(1)}" y="${(DH + 30).toFixed(1)}" text-anchor="middle" style="opacity:0">${eur.format(Math.round(q1))}</text>
              <text id="vr-q1-sub" class="vr-dist-zone-sub" x="${q1LblX.toFixed(1)}" y="${(DH + 40).toFixed(1)}" text-anchor="middle" style="opacity:0">1er quartile</text>
              <text id="vr-dml-txt" class="vr-dist-med-big" x="${medx.toFixed(1)}" y="${(DH + 30).toFixed(1)}" text-anchor="middle" style="opacity:0">${eur.format(Math.round(med))}</text>
              <text id="vr-dml-sub" class="vr-dist-zone-sub" x="${medx.toFixed(1)}" y="${(DH + 40).toFixed(1)}" text-anchor="middle" style="opacity:0">médiane</text>
              <text id="vr-q3-lbl" class="vr-dist-zone-lbl" x="${q3LblX.toFixed(1)}" y="${(DH + 30).toFixed(1)}" text-anchor="middle" style="opacity:0">${eur.format(Math.round(q3))}</text>
              <text id="vr-q3-sub" class="vr-dist-zone-sub" x="${q3LblX.toFixed(1)}" y="${(DH + 40).toFixed(1)}" text-anchor="middle" style="opacity:0">3e quartile</text>
            </svg>
            <p class="vr-dist-note" id="vr-dn">La moitié des ${esc(typePlurielNu(model.dom))} vendues se situent dans la zone colorée. Les données constatent cet écart — elles n'en expliquent pas encore toutes les causes.</p>
          </div>
        </div>`;
    }

    // ——— Effet surface ———
    let surfHtml = '';
    if (sf) {
      const sign = sf.deltaPct > 0 ? '+' : '';
      surfHtml = `
        <div class="vr-bloc vr-bloc--surf vr-bloc-anim" id="vr-b-surf">
          <p class="vr-kicker vr-kicker--terra">L'EFFET DE LA SURFACE</p>
          <p class="vr-titre vr-titre--dark">Même le prix au m² n'est pas unique</p>
          <div class="vr-surf-trio">
            <div>
              <div class="vr-surf-col-val">${eur.format(sf.smallMed)} €/m²</div>
              <div class="vr-surf-col-lbl">${esc(sf.smallLabel)}</div>
            </div>
            <div class="vr-surf-delta-wrap">
              <div class="vr-surf-delta" id="vr-sd">${sign}${sf.deltaPct} %</div>
              <span class="vr-surf-arrow">→</span>
            </div>
            <div>
              <div class="vr-surf-col-val">${eur.format(sf.largeMed)} €/m²</div>
              <div class="vr-surf-col-lbl">${esc(sf.largeLabel)}</div>
            </div>
          </div>
          <p class="vr-surf-note">Écart constaté entre petits et grands appartements dans ce secteur. DVF constate cet écart — il ne l'explique pas.</p>
        </div>`;
    }

    // ——— Sparkline ———
    let sparkHtml = '';
    const hasSpark = !!D && Array.isArray(D.annualMeds) && D.annualMeds.length >= 3;
    if (hasSpark) {
      const meds = D.annualMeds as { year: number; med: number }[];
      const spW = 360, spH = 120, topM = 22, botM = 30, availH = spH - topM - botM;
      const xPts = meds.map((_: any, i: number) => 24 + (i / (meds.length - 1)) * (spW - 48));
      const vals = meds.map((m: any) => m.med);
      const minV = Math.min(...vals), maxV = Math.max(...vals), rng = maxV - minV || 1;
      const yPts = vals.map((v: number) => topM + ((maxV - v) / rng) * availH);
      const lineD = xPts.map((x: number, i: number) => `${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${yPts[i].toFixed(1)}`).join(' ');
      const pct = `${D.delta >= 0 ? '+' : ''}${D.delta.toFixed(1).replace('.', ',')} % sur ${D.anneeDebut}–${D.anneeFin}`;
      const dirTxt = D.dir === 'hausse' ? 'Tendance à la hausse sur 5 ans' : D.dir === 'baisse' ? 'Tendance à la baisse sur 5 ans' : 'Prix globalement stables sur 5 ans';
      const spDots = meds.map((m: any, i: number) => [
        `<circle class="vr-spark-dot" cx="${xPts[i].toFixed(1)}" cy="${yPts[i].toFixed(1)}" r="5" fill="${domColor}" data-si="${i}"/>`,
        `<text class="vr-spark-val" x="${xPts[i].toFixed(1)}" y="${(yPts[i] - 10).toFixed(1)}" data-si="${i}">${eur.format(m.med)}</text>`
      ].join('')).join('');
      const spLabels = meds.map((m: any, i: number) => `<text class="vr-spark-yr" x="${xPts[i].toFixed(1)}" y="${spH - 4}">${m.year}</text>`).join('');
      sparkHtml = `
        <div class="vr-bloc vr-bloc--spark vr-bloc-anim" id="vr-b-spark">
          <p class="vr-kicker vr-kicker--ink">5 ANS DE MARCHÉ</p>
          <p class="vr-titre vr-titre--dark">La trajectoire des prix</p>
          <div class="vr-spark-wrap">
            <svg class="vr-spark-svg" viewBox="0 0 ${spW} ${spH}" aria-hidden="true">
              <path d="${lineD}" class="vr-spark-path" id="vr-sp" stroke="${domColor}"/>
              ${spDots}${spLabels}
            </svg>
            <p class="vr-spark-dir">${esc(dirTxt)}</p>
            <p class="vr-spark-pct">${esc(pct)}</p>
          </div>
        </div>`;
    }

    // ——— Ventes réelles ———
    const allTx = [model.derniere, ...(model.autres || [])].filter(Boolean).slice(0, 5);
    let txHtml = '';
    if (allTx.length) {
      const card = (tx: any) => {
        const isM = tx.t === 'Maison';
        const ico = isM ? '🏠' : '🏢';
        const surf = tx.sb > 0 ? `${Math.round(tx.sb)} m²` : '';
        const pieces = tx.p > 0 ? `${tx.p} pièce${tx.p > 1 ? 's' : ''}` : '';
        const meta = [surf, pieces, dateMois(tx.d)].filter(Boolean).join(' · ');
        const ppmVal = tx.sb > 0 ? Math.round(tx.v / tx.sb) : 0;
        const ppmCls = isM ? 'vr-tx-ppm--M' : 'vr-tx-ppm--A';
        return `<div class="vr-tx-card">
          <div class="vr-tx-ico ${isM ? 'vr-tx-ico--M' : 'vr-tx-ico--A'}">${ico}</div>
          <div class="vr-tx-info">
            <div class="vr-tx-name">${esc(bienCourt(tx))}</div>
            <div class="vr-tx-addr">${esc(adresse(tx))}</div>
            <div class="vr-tx-meta">${esc(meta)}</div>
          </div>
          <div class="vr-tx-right">
            <div class="vr-tx-price">${eur.format(tx.v)} €</div>
            ${ppmVal > 0 ? `<span class="vr-tx-ppm ${ppmCls}">${eur.format(ppmVal)} €/m²</span>` : ''}
          </div>
        </div>`;
      };
      const first = allTx.slice(0, 3).map(card).join('');
      const more = allTx.length > 3
        ? `<details class="vr-tx-more"><summary>Voir ${allTx.length - 3} vente${allTx.length - 3 > 1 ? 's' : ''} de plus →</summary>${allTx.slice(3).map(card).join('')}</details>`
        : '';
      txHtml = `
        <div class="vr-bloc vr-bloc--tx vr-bloc-anim" id="vr-b-tx">
          <p class="vr-kicker vr-kicker--ink">VENTES RÉCENTES</p>
          <p class="vr-titre vr-titre--dark">Quelques ventes autour de chez vous</p>
          <div class="vr-tx-cards" id="vr-tx-cards">${first}${more}</div>
        </div>`;
    }

    // ——— Héro ———
    const maxBar = Math.max(model.n2024 || 0, model.n2025 || 0, 1);
    const p24 = Math.round(((model.n2024 || 0) / maxBar) * 100);
    const p25 = Math.round(((model.n2025 || 0) / maxBar) * 100);
    let heroBadge = '';
    if ((model.n2024 || 0) > 0 && (model.n2025 || 0) > 0) {
      const diff = Math.round(((model.n2025 - model.n2024) / model.n2024) * 100);
      heroBadge = `<span class="vr-hero-badge">${diff >= 0 ? '+' : ''}${diff} % entre 2024 et 2025</span>`;
    }
    const heroBars = (model.n2024 || 0) > 0 || (model.n2025 || 0) > 0 ? `
      <div class="vr-hero-bars">
        <div class="vr-hero-bar-row">
          <span class="vr-hero-bar-yr">2024</span>
          <div class="vr-hero-bar-track"><div class="vr-hero-bar-fill" data-pct="${p24}"></div></div>
          <span class="vr-hero-bar-n">${model.n2024 || 0}</span>
        </div>
        <div class="vr-hero-bar-row">
          <span class="vr-hero-bar-yr">2025</span>
          <div class="vr-hero-bar-track"><div class="vr-hero-bar-fill" data-pct="${p25}"></div></div>
          <span class="vr-hero-bar-n">${model.n2025 || 0}</span>
        </div>
      </div>
      ${heroBadge}` : '';

    // ——— Conclusion dynamique ———
    const concP1 = `Ce résultat repose sur ${model.nbVentes} ventes de ${esc(typePlurielNu(model.dom))}, avec surface connue et hors mutations multi-lots. Même dans cet échantillon homogène, les écarts restent importants.`;
    const concP2 = `Une adresse permet de comprendre votre marché. Pas encore de savoir où votre bien se place dedans.`;
    const concP3 = `Pour aller plus loin, il faut maintenant identifier les ventes qui ressemblent réellement à votre bien.`;

    // ——— Assemblage HTML ———
    scene.innerHTML = `
      ${construirePerimetre(model)}
      <div class="vr-cine-wrap">
        <div class="vr-bloc vr-bloc--hero" id="vr-b-hero">
          <p class="vr-kicker vr-kicker--light">Analyse locale</p>
          <div class="vr-hero-counter" id="vr-hc" data-count="${model.nbVentes}">0</div>
          <p class="vr-hero-count-lbl">ventes de ${esc(typePlurielNu(model.dom))} analysées</p>
          ${heroBars}
        </div>
        <div class="vr-bloc vr-bloc--b1 vr-bloc-anim" id="vr-b-dots">
          <p class="vr-kicker vr-kicker--terra">CE QUI S'EST VENDU</p>
          <p class="vr-titre vr-titre--dark">Deux marchés différents autour de chez vous</p>
          <svg class="vr-dots-svg" viewBox="0 0 ${SW} ${SH}" aria-hidden="true">${dotSvg}</svg>
          <div class="vr-dot-legend" id="vr-dl">
            <span><span class="vr-dot-legend-ico" style="background:#243CFF"></span>Maisons</span>
            <span><span class="vr-dot-legend-ico" style="background:#202635"></span>Appartements</span>
          </div>
          <div class="vr-dot-counts" id="vr-dc">
            <div class="vr-dot-count-item"><span class="vr-dot-count vr-dot-count--M">${model.nM}</span> maisons</div>
            <div class="vr-dot-count-item"><span class="vr-dot-count vr-dot-count--A">${model.nA}</span> appartements</div>
          </div>
          <p class="vr-phase-txt vr-pt1" id="vr-pt1">${model.nM + model.nA} ventes de logements figurent dans ce rayon. Elles ne sont pas toutes comparables entre elles.</p>
          <p class="vr-phase-txt vr-pt2" id="vr-pt2" style="opacity:0">Pour le résultat ${model.dom === 'Maison' ? 'maisons' : 'appartements'}, ${model.nbVentes} ventes du type choisi, avec surface connue et hors mutations multi-lots, sont retenues.</p>
        </div>
        ${distHtml}
        ${surfHtml}
        ${sparkHtml}
        ${txHtml}
        <div class="vr-bloc vr-bloc--conc vr-bloc-anim" id="vr-b-conc">
          <p class="vr-conc-eyebrow">CE QUE ÇA CHANGE POUR VOUS</p>
          <p class="vr-conc-hl">Le bon prix ne vient pas d'une moyenne. Il vient d'une comparaison pertinente.</p>
          <div class="vr-conc-body">
            <p>${esc(concP1)}</p>
            <p>${esc(concP2)}</p>
            <p>${esc(concP3)}</p>
          </div>
          <button class="vr-conc-cta" type="button">SITUER MON BIEN DANS CE MARCHÉ →</button>
        </div>
      </div>
      <div class="vr-after">
        <p class="vr-maj">${majLigne()}</p>
        ${construireConversion()}
      </div>`;
    brancherConversion(model);

    // ——— Animations ———

    // Héro : déclenché immédiatement (visible au-dessus du fold)
    const hc = scene.querySelector<HTMLElement>('#vr-hc');
    if (hc) animeCompteur(hc, model.nbVentes);
    later(600, () => {
      scene.querySelectorAll<HTMLElement>('.vr-hero-bar-fill').forEach((b) => {
        b.style.width = (b.dataset.pct || '0') + '%';
      });
    });

    // CE QUI S'EST VENDU
    observe('#vr-b-dots', () => {
      const el = scene.querySelector<HTMLElement>('#vr-b-dots');
      if (el) el.classList.add('is-on');
      const dotEls = Array.from(scene.querySelectorAll<SVGCircleElement>('.vr-dot'));
      // Phase 1 : nuage se colore et se sépare
      later(300, () => {
        dotEls.forEach((d, i) => {
          d.style.transform = `translate(${dots[i].dx.toFixed(1)}px,${dots[i].dy.toFixed(1)}px)`;
          d.style.fill = dots[i].isM ? '#243CFF' : '#202635';
        });
        const dl = scene.querySelector<HTMLElement>('#vr-dl');
        if (dl) dl.style.opacity = '1';
      });
      // Phase 2 : compteurs apparaissent
      later(750, () => {
        const dc = scene.querySelector<HTMLElement>('#vr-dc');
        if (dc) dc.style.opacity = '1';
      });
      // Phase 3 : non-dominant s'estompe, texte bascule
      later(1200, () => {
        const isDomM = model.dom === 'Maison';
        dotEls.forEach((d, i) => {
          if (dots[i].isM !== isDomM) d.style.opacity = '0.2';
        });
        const pt1 = scene.querySelector<HTMLElement>('#vr-pt1');
        if (pt1) pt1.style.opacity = '0';
        later(350, () => {
          const pt2 = scene.querySelector<HTMLElement>('#vr-pt2');
          if (pt2) pt2.style.opacity = '1';
        });
      });
    });

    // CE QUE LES PRIX MONTRENT
    if (distHtml) {
      observe('#vr-b-dist', () => {
        const el = scene.querySelector<HTMLElement>('#vr-b-dist');
        if (el) el.classList.add('is-on');
        const ddots = Array.from(scene.querySelectorAll<SVGCircleElement>('.vr-dist-dot'));
        const stagger = Math.max(8, Math.floor(500 / Math.max(ddots.length, 1)));
        ddots.forEach((d, i) => later(i * stagger, () => { d.style.opacity = '0.72'; }));
        const zoneDelay = ddots.length * stagger + 250;
        later(zoneDelay, () => {
          const dz = scene.querySelector<HTMLElement>('#vr-dz');
          if (dz) dz.style.opacity = '1';
        });
        later(zoneDelay + 450, () => {
          const dml = scene.querySelector<HTMLElement>('#vr-dml');
          if (dml) dml.style.opacity = '1';
          ['#vr-q1-lbl','#vr-q1-sub','#vr-dml-txt','#vr-dml-sub','#vr-q3-lbl','#vr-q3-sub'].forEach((sel) => {
            const el2 = scene.querySelector<HTMLElement>(sel);
            if (el2) el2.style.opacity = '1';
          });
        });
        later(zoneDelay + 750, () => {
          const dn = scene.querySelector<HTMLElement>('#vr-dn');
          if (dn) { dn.style.opacity = '1'; dn.style.transform = 'none'; }
        });
      });
    }

    // L'EFFET DE LA SURFACE
    if (sf) {
      observe('#vr-b-surf', () => {
        const el = scene.querySelector<HTMLElement>('#vr-b-surf');
        if (el) el.classList.add('is-on');
        later(400, () => {
          const sd = scene.querySelector<HTMLElement>('#vr-sd');
          if (sd) sd.classList.add('on');
        });
      });
    }

    // 5 ANS DE MARCHÉ
    if (hasSpark) {
      observe('#vr-b-spark', () => {
        const el = scene.querySelector<HTMLElement>('#vr-b-spark');
        if (el) el.classList.add('is-on');
        const sp = scene.querySelector<SVGPathElement>('#vr-sp');
        if (sp) {
          const l = sp.getTotalLength();
          sp.style.strokeDasharray = l + 'px';
          sp.style.strokeDashoffset = l + 'px';
          sp.getBoundingClientRect();
          sp.style.transition = 'stroke-dashoffset 1.8s cubic-bezier(0.25,0.46,0.45,0.94)';
          sp.style.strokeDashoffset = '0';
        }
        const meds = D.annualMeds as { year: number; med: number }[];
        meds.forEach((_: any, i: number) => {
          later(350 + i * 320, () => {
            const dot = scene.querySelector<SVGCircleElement>(`.vr-spark-dot[data-si="${i}"]`);
            if (dot) dot.classList.add('on');
            const val = scene.querySelector<SVGTextElement>(`.vr-spark-val[data-si="${i}"]`);
            if (val) val.classList.add('on');
          });
        });
      });
    }

    // VENTES RÉCENTES — stagger
    if (txHtml) {
      observe('#vr-b-tx', () => {
        const el = scene.querySelector<HTMLElement>('#vr-b-tx');
        if (el) el.classList.add('is-on');
        const cards = Array.from(scene.querySelectorAll<HTMLElement>('#vr-tx-cards .vr-tx-card'));
        cards.forEach((c, i) => later(i * 120, () => c.classList.add('on')));
      });
    }

    // CONCLUSION
    observe('#vr-b-conc', () => {
      const el = scene.querySelector<HTMLElement>('#vr-b-conc');
      if (el) el.classList.add('is-on');
    });

    // Scroll doux vers le haut du résultat
    const headerH = document.getElementById('site-header')?.offsetHeight ?? 64;
    const top = scene.getBoundingClientRect().top + window.scrollY - headerH - 8;
    window.scrollTo({ top, behavior: 'smooth' });

    cineCleanup = () => { ios.forEach((io) => io.disconnect()); touts.forEach(clearTimeout); };
  }



  function majLigne() {
    if (!meta) return '';
    const parts: string[] = [];
    if (meta.dateVenteLaPlusRecente) parts.push(`Données DVF disponibles jusqu'au ${dateComplete(meta.dateVenteLaPlusRecente)}`);
    if (meta.generatedAt) parts.push(`extraites le ${jourMoisAn.format(new Date(meta.generatedAt))}`);
    return esc(parts.join(' · ')) + ' · Source : DVF (DGFiP).';
  }

  // ——— Conversion : 3 chemins ———
