      </p>
      <button type="button" class="vr-tun-next" id="vr-tun-next">Continuer →</button>`;
  }
  function brancherRupture(panneau: HTMLElement, etat: Etat, model: any) {
    panneau.querySelector<HTMLButtonElement>('#vr-tun-next')!.addEventListener('click', () => {
      etat.step += 1; rendreTunnel(panneau, etat, model);
