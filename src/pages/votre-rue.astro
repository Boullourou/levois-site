          <label class="vr-consent"><input type="checkbox" id="vr-tun-consent" required /><span>J'accepte d'être recontacté au sujet de ma demande — et pour rien d'autre. <a href="/confidentialite" class="text-argile underline">En savoir plus</a>.</span></label>
          <p id="vr-tun-mail-err" class="vr-tun-err" hidden role="alert"></p>
          <button type="submit" class="btn-primaire" id="vr-tun-mail-envoi">Envoyer</button>
          <button type="button" class="vr-q-back" id="vr-tun-mail-back">← Revenir</button>
        </form>
      </div>`;
    panneau.querySelector<HTMLButtonElement>('#vr-tun-mail-back')!.addEventListener('click', () => {
      rendreTunnel(panneau, etat, model);
    });
    brancherEnvoiLead(panneau, etat, model);
  }

  function brancherEnvoiLead(panneau: HTMLElement, etat: Etat, model: any) {
    const f = panneau.querySelector<HTMLFormElement>('#vr-tun-mail')!;
    const err = panneau.querySelector<HTMLElement>('#vr-tun-mail-err')!;
    const btn = panneau.querySelector<HTMLButtonElement>('#vr-tun-mail-envoi')!;
    let envoiEnCours = false;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (envoiEnCours) return;
      err.hidden = true;
      const fd = new FormData(f);
      const consent = (panneau.querySelector<HTMLInputElement>('#vr-tun-consent'))?.checked;
      if (!f.checkValidity() || !consent) { f.reportValidity(); return; }
      envoiEnCours = true; btn.disabled = true; btn.textContent = 'Envoi…';
      const payload = {
        prenom: fd.get('prenom'),
        email: fd.get('email'),
        site_web: fd.get('site_web') || '',
        consent: !!consent,
        adresseRecherchee: selection?.label || '',
        cible: {
          type: etat.type, sb: etat.sb, p: etat.p, st: etat.st,
          exterieur: etat.exterieur, etat: etat.etatDeclare,
        },
        lecture: etat.lecture,
        progression: etat.progression,
      };
      try {
        const rep = await fetch('/api/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (rep.ok) {
          panneau.innerHTML = `
            <div class="vr-tun vr-tun--email">
              <p class="vr-tun-q">C'est envoyé, ${esc(String(fd.get('prenom') || ''))}.</p>
              <p class="vr-tun-body">Vous recevez votre lecture par e-mail dans les prochaines minutes. Mouaad reste joignable directement au <a href="tel:+33781380121" class="text-argile underline">07 81 38 01 21</a>.</p>
            </div>`;
        } else {
          const data = await rep.json().catch(() => null);
          err.textContent = data?.message || "L'envoi n'a pas abouti. Vous pouvez réessayer ou écrire à mouaad@levois.fr.";
          err.hidden = false;
        }
      } catch {
        err.textContent = "L'envoi n'a pas abouti. Vous pouvez réessayer ou écrire à mouaad@levois.fr.";
        err.hidden = false;
      } finally {
        envoiEnCours = false; btn.disabled = false; btn.textContent = 'Envoyer';
      }
    });
  }

