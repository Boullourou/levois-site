      ${heroBadge}` : '';

    // ——— Conclusion dynamique ———
    const concP1 = `Nous sommes partis de ${model.nbVentes} ventes. Nous avons déjà écarté celles qui ne correspondent pas au même type de bien. Mais même parmi les ${esc(typePlurielNu(model.dom))}, les écarts restent importants.`;
    const concP2 = `Une adresse permet de comprendre votre marché. Pas encore de savoir où votre bien se place dedans.`;
    const concP3 = `Pour aller plus loin, il faut maintenant identifier les ventes qui ressemblent réellement à votre bien.`;

    // ——— Assemblage HTML ———
    // Les blocs sont conditionnels : la numérotation éditoriale est attribuée
