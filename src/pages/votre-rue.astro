          <div class="vr-viz">
            <svg class="vr-dots-svg" viewBox="0 0 ${SW} ${SH}" aria-hidden="true">${dotSvg}</svg>
            <div class="vr-dot-legend" id="vr-dl">
              <span><span class="vr-dot-legend-ico" style="background:#C15A2B"></span>Maisons</span>
              <span><span class="vr-dot-legend-ico" style="background:#3A6FB0"></span>Appartements</span>
            </div>
          </div>
          <div class="vr-tiles" id="vr-dc">
            <div class="vr-tile" data-t="M">
              <p class="vr-tile-lbl"><span class="vr-tile-ico" style="background:#C15A2B"></span>Maisons</p>
              <p class="vr-tile-val vr-tile-val--M">${model.nM}</p>
              <div class="vr-tile-bar"><span data-pct="${pctM}" style="background:#C15A2B"></span></div>
              <p class="vr-tile-pct">${pctM} % des ventes</p>
            </div>
            <div class="vr-tile" data-t="A">
              <p class="vr-tile-lbl"><span class="vr-tile-ico" style="background:#3A6FB0"></span>Appartements</p>
              <p class="vr-tile-val vr-tile-val--A">${model.nA}</p>
              <div class="vr-tile-bar"><span data-pct="${pctA}" style="background:#3A6FB0"></span></div>
              <p class="vr-tile-pct">${pctA} % des ventes</p>
            </div>
          </div>
          <div class="vr-phase-stack">
            <p class="vr-phase-txt vr-pt1" id="vr-pt1">${model.nbVentes} ventes autour de cette adresse. Mais toutes ne sont pas comparables entre elles.</p>
            <p class="vr-phase-txt vr-pt2" id="vr-pt2" style="opacity:0">Pour comprendre le marché ${model.dom === 'Maison' ? "d'une maison" : "d'un appartement"}, les ventes de l'autre type doivent déjà être écartées.</p>
          </div>
        </div>
        ${distHtml}
        ${surfHtml}
        ${sparkHtml}
        ${txHtml}
        <div class="vr-bloc vr-bloc--conc vr-bloc-anim" id="vr-b-conc">
          <p class="vr-conc-eyebrow">CE QUE ÇA CHANGE POUR VOUS</p>
          <p class="vr-conc-hl">Le bon prix ne vient pas d'une moyenne. Il vient d'une comparaison pertinente.</p>
          <div class="vr-conc-body">
            <p>${esc(concP1)}</p>
            <p>${esc(concP2)}</p>
