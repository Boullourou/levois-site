  // ——— Séquence cinématographique (scroll-driven, stage épinglé) ———
  let cineCleanup: null | (() => void) = null;

  function construireCine(model: any) {
    if (cineCleanup) { cineCleanup(); cineCleanup = null; }
    const ec = enClair(model);
    const d = model.derniere;
    const C = model.C, D = model.D;
    const posC = C && C.q3 > C.q1 ? Math.max(6, Math.min(94, ((C.median - C.q1) / (C.q3 - C.q1)) * 100)) : 50;
    const posD = D ? gaugePos(D.delta) : 50;

    const sc: string[] = [];
    // ① ventes
    sc.push(`
      <div class="vr-scene" data-scene="0">
        <div class="vr-sc-inner">
          <p class="vr-sc-kicker">Autour de cette adresse</p>
          <p class="vr-sc-num" data-count>0</p>
          <p class="vr-sc-lead">ventes retrouvées près de vous</p>
          <p class="vr-sc-note">dans un rayon d’environ ${rayonTxt(model.Rw)} · depuis 2021</p>
        </div>
      </div>`);
    // ② prix du milieu
    if (C) {
      const q1 = Math.round(C.q1), q3 = Math.round(C.q3);
      sc.push(`
        <div class="vr-scene" data-scene="1" data-bg="vif">
          <div class="vr-sc-inner">
            <p class="vr-sc-kicker">Le prix du milieu</p>
            <p class="vr-sc-num" data-price>0 €</p>
            <div class="vr-sc-range">
              <div class="vr-range-line">
                <span class="vr-range-cap g">${eur.format(q1)} €</span>
                <span class="vr-range-cap d">${eur.format(q3)} €</span>
                <span class="vr-range-dot"></span>
              </div>
              <div class="vr-range-arrows" aria-hidden="true"><span>←</span><span>→</span></div>
              <p class="vr-c-phrase">La moitié des ${esc(typePlurielNu(model.dom))} se sont vendues entre <strong>${eur.format(q1)} €</strong> et <strong>${eur.format(q3)} €</strong>.</p>
              ${C.ppm ? `<p class="vr-c-m2">≈ ${eur.format(Math.round(C.ppm))} €/m²</p>` : ''}
            </div>
          </div>
        </div>`);
    }
    // ③ tendance
    if (D) {
      const pct = `${D.delta >= 0 ? '+' : ''}${D.delta.toFixed(1).replace('.', ',')} %`;
      sc.push(`
        <div class="vr-scene" data-scene="2">
          <div class="vr-sc-inner">
            <p class="vr-sc-kicker">Les prix, dans le temps</p>
            <div class="vr-sc-dhead"><span class="vr-sc-dico" aria-hidden="true">${iconeTendance(D.dir)}</span><span class="vr-sc-title">${tendanceTitre(D.dir)}</span></div>
            <div class="vr-sc-gauge">
              <div class="vr-gauge-track"><span class="vr-gauge-cursor"></span></div>
              <div class="vr-gauge-lbls"><span class="${D.dir === 'baisse' ? 'on' : ''}">Baisse</span><span class="${D.dir === 'stable' ? 'on' : ''}">Stable</span><span class="${D.dir === 'hausse' ? 'on' : ''}">Hausse</span></div>
            </div>
            <p class="vr-d-pct">${pct} sur le prix au m², estimé sur ${D.anneeDebut}–${D.anneeFin}</p>
          </div>
        </div>`);
    }
    // ④ dernière vente (chapitre sombre)
    sc.push(`
      <div class="vr-scene" data-scene="3" data-bg="encre">
        <div class="vr-sc-inner">
          <p class="vr-sc-kicker">Dernière vente près de chez vous</p>
          <p class="vr-sc-num" data-aprice>0 €</p>
          <p class="vr-sc-lead">${esc(bienCourt(d))}</p>
          <p class="vr-sc-note">${esc(distLisible(d._dist))} · ${esc(dateMois(d.d))}</p>
        </div>
      </div>`);
    // ⑤ en clair
    sc.push(`
      <div class="vr-scene" data-scene="4" data-bg="argile">
        <div class="vr-sc-inner">
          <p class="vr-sc-kicker">En clair</p>
          <p class="vr-sc-ec">${esc(ec.s1)}${ec.s2 ? ' ' + esc(ec.s2) : ''}</p>
        </div>
      </div>`);

    const N = sc.length;
    const dots = Array.from({ length: N }, (_, i) => `<span class="vr-cine-dot${i === 0 ? ' on' : ''}"></span>`).join('');

    scene.innerHTML = `
      <div class="vr-cine" style="height:${N * 90 + 40}svh">
        <div class="vr-stage">
          ${sc.join('')}
          <div class="vr-cine-dots" aria-hidden="true">${dots}</div>
        </div>
      </div>
      <div class="vr-after">
        <p class="vr-maj">${majLigne()}</p>
        ${blocDetails(model)}
        ${construireConversion()}
      </div>`;
    brancherConversion(model);

    // Moteur scroll
    const track = scene.querySelector<HTMLElement>('.vr-cine')!;
    const scEls = Array.from(scene.querySelectorAll<HTMLElement>('.vr-scene'));
    const dotEls = Array.from(scene.querySelectorAll<HTMLElement>('.vr-cine-dot'));
    const header = document.getElementById('site-header');
    let headerH = header?.offsetHeight ?? 64;
    document.documentElement.style.setProperty('--vr-header', headerH + 'px');

    const countEl = scene.querySelector<HTMLElement>('[data-count]');
    const priceEl = scene.querySelector<HTMLElement>('[data-price]');
    const apriceEl = scene.querySelector<HTMLElement>('[data-aprice]');
    const dotC = scEls[1]?.querySelector<HTMLElement>('.vr-range-dot') || null;
    const cursorD = scene.querySelector<HTMLElement>('.vr-gauge-cursor');

    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const lead = 0.12;
    const seg = N > 1 ? (1 - 2 * lead) / (N - 1) : 1;
    const centers = scEls.map((_, i) => lead + seg * i);
    let targetP = 0, curP = 0, running = false;

    const render = (p: number) => {
      let best = 0, bestOp = -1;
      scEls.forEach((el, i) => {
        const t = (p - centers[i]) / seg;
        // Opacité : plateau plein pour la 1re scène avant son centre et la
        // dernière après le sien ; triangulaire (largeur seg) ailleurs → une
        // scène dominante à la fois, fondu croisé continu.
        let op: number;
        if (i === 0 && p <= centers[0]) op = 1;
        else if (i === N - 1 && p >= centers[N - 1]) op = 1;
        else op = clamp01(1 - Math.abs(t));
        if (op > bestOp) { bestOp = op; best = i; }
        el.style.opacity = op.toFixed(3);
        el.style.visibility = op < 0.01 ? 'hidden' : 'visible';
        el.style.zIndex = String(Math.round(op * 100));
        el.style.transform = `translateY(${(t * 16).toFixed(1)}px) scale(${(1 - Math.min(Math.abs(t), 1) * 0.05).toFixed(3)})`;
        // Construction interne (compteur, curseurs) : 0→1 avec un léger maintien
        // avant le centre. Réversible (décroît au scroll inverse).
        const build = i === 0
          ? clamp01(p / (lead * 0.6))
          : clamp01((p - (centers[i] - seg)) / (seg * 0.7));
        if (i === 0 && countEl) countEl.textContent = eur.format(Math.round(model.nbVentes * build));
        if (i === 1) { if (priceEl && C) priceEl.textContent = eur.format(Math.round(C.median * build)) + ' €'; if (dotC) dotC.style.left = (50 + (posC - 50) * build).toFixed(1) + '%'; }
        if (i === 2 && cursorD) cursorD.style.left = (50 + (posD - 50) * build).toFixed(1) + '%';
        if (i === 3 && apriceEl) apriceEl.textContent = eur.format(Math.round(d.v * build)) + ' €';
      });
      dotEls.forEach((dt, i) => dt.classList.toggle('on', i === best));
    };

    const inView = () => { const r = track.getBoundingClientRect(); return r.bottom > -40 && r.top < window.innerHeight + 40; };
    const loop = () => {
      curP += (targetP - curP) * 0.16;
      const settled = Math.abs(targetP - curP) < 0.0004;
      if (settled) curP = targetP;
      render(curP);
      if (settled && !inView()) { running = false; return; }
      requestAnimationFrame(loop);
    };
    const wake = () => { if (!running) { running = true; requestAnimationFrame(loop); } };
    const measure = () => {
      const h = header?.offsetHeight ?? headerH;
      if (h !== headerH) { headerH = h; document.documentElement.style.setProperty('--vr-header', h + 'px'); }
      const stageH = window.innerHeight - headerH;
      const total = track.offsetHeight - stageH;
      const scrolled = -track.getBoundingClientRect().top + headerH;
      targetP = total > 0 ? clamp01(scrolled / total) : 0;
      wake();
    };
    window.addEventListener('scroll', measure, { passive: true });
    window.addEventListener('resize', measure, { passive: true });
    cineCleanup = () => { window.removeEventListener('scroll', measure); window.removeEventListener('resize', measure); running = false; };
    render(0);
    measure();
    // Amener le début de la séquence juste sous l'en-tête (p ≈ 0).
    const y = track.getBoundingClientRect().top + window.scrollY - headerH - 4;
    window.scrollTo({ top: y, behavior: 'smooth' });
  }

  function majLigne() {
