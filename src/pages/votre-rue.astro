---
/**
 * /votre-rue — expérience « infographie » du QR encart publicitaire.
 *
 * URL protégée (imprimée). Ne pas supprimer/renommer/rediriger sans validation.
 *
 * Transforme les DVF en une lecture immédiate, compréhensible en quelques
 * secondes par quelqu'un qui ne connaît rien à l'immobilier :
 *   adresse → courte analyse animée → 4 informations → « En clair »
 *   → ventes détaillées (facultatif) → tunnel de conversion.
 *
 * Honnêteté (impératif) : tout est calculé sur les vraies données DVF générées
 * par scripts/build-dvf.mjs. Aucun chiffre fictif. Aucun indicateur non
 * calculable (demande, délai de vente, visites, tension : jamais affichés ni
 * sous-entendus). Aucune estimation du bien du visiteur. Aucun faux temps de
 * chargement : les messages d'analyse accompagnent le calcul réel.
 *
 * Géocodage : Géoplateforme (BAN) — service actuel de l'État.
 * Conversion : les réponses de qualification + le contexte sont destinés à
 * /api/lead (backend migré à l'itération suivante — cf. commentaire d'envoi).
 */
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Les prix réels de votre secteur"
  description="Combien s'est vendue la dernière maison de votre quartier ? Les ventes réelles de votre secteur, à partir des données publiques DVF. Sans inscription."
  noindex={true}
>
  <div class="max-w-editorial mx-auto px-edge md:px-edge-md pt-10 md:pt-16 pb-section md:pb-section-md">

    <!-- ① Promesse + saisie -->
    <header class="mb-8 md:mb-10">
      <p class="eyebrow mb-4">Les prix réels de votre secteur · Lèves &amp; bassin chartrain</p>
      <h1 class="vr-titre text-encre mb-4">
        Combien s'est vendue la dernière maison de votre quartier&nbsp;?
      </h1>
      <p class="font-sans text-body-lg text-brun max-w-prose">
        Les ventes réellement enregistrées autour de chez vous.
        Sans inscription, sans qu'on vous rappelle. La réponse en 30&nbsp;secondes.
      </p>
      <p id="vr-fraicheur" class="vr-fraicheur" hidden></p>
    </header>

    <form id="vr-form" class="vr-search carte p-5 md:p-6" autocomplete="off" novalidate>
      <label for="vr-adresse" class="block font-sans text-sm text-brun mb-2">
        Votre rue ou votre adresse
      </label>
      <div class="vr-field">
        <div class="vr-combo">
          <input
            id="vr-adresse" type="text" name="adresse" inputmode="text"
            autocomplete="off" spellcheck="false"
            placeholder="Ex : rue de la République, Lèves"
            class="vr-input" role="combobox" aria-expanded="false"
            aria-controls="vr-suggestions" aria-autocomplete="list"
          />
          <ul id="vr-suggestions" class="vr-suggestions" role="listbox" aria-label="Adresses proposées" hidden></ul>
        </div>
        <button type="submit" id="vr-submit" class="btn-primaire vr-submit">Voir les ventes</button>
      </div>
      <p class="font-sans text-[13px] text-brun/70 mt-3">
        Aucune création de compte. Aucun e-mail ni téléphone demandé pour obtenir le résultat.
      </p>
      <p id="vr-geo-erreur" class="font-sans text-sm text-argile mt-2 hidden" role="alert"></p>
    </form>

    <!-- ②③④⑤⑥ Scène (analyse → infographie → En clair → détails → conversion) -->
    <section id="vr-scene" aria-live="polite" hidden></section>

    <!-- ⑦ Méthode & limites (accessibles mais discrètes) -->
    <details id="vr-methode" class="vr-methode">
      <summary>Méthode, source et limites</summary>
      <div class="vr-methode-corps">
        <p>
          Source : Demandes de valeurs foncières (DVF), DGFiP — données publiques ouvertes,
          géolocalisées par Etalab. Chaque vente affichée est une transaction réellement
          enregistrée.
        </p>
        <p>
          Les prix « médians » et les fourchettes sont calculés sur les ventes du même type de
          bien (maison ou appartement) dans un rayon autour de l'adresse. L'évolution est estimée
          par une droite de tendance (régression) sur les médianes annuelles du prix au m²
          (2021 à 2025), pour éviter qu'une seule année atypique ne fausse la lecture.
          Le pourcentage affiché compare la valeur de cette droite en 2025 à sa valeur en 2021
          (année de référence fixe, identique pour toutes les adresses) ; en dessous de ±3 %,
          les prix sont considérés comme globalement stables. Le pourcentage justifie la
          conclusion, il n'en est pas l'essentiel.
        </p>
        <p>
          Ce que ces données <strong>ne disent pas</strong> : la valeur précise de votre bien, la
          demande, les délais de vente, le nombre de visites. Une vente voisine est un repère de
          prix, pas une estimation de votre bien. La base DVF n'est pas exhaustive : certaines
          ventes peuvent en être absentes.
        </p>
      </div>
    </details>

  </div>
</Layout>

<!-- is:global OBLIGATOIRE : l'infographie est injectée en JS (innerHTML), donc
     sans l'attribut de scope Astro (data-astro-cid). Une feuille scopée ne
     matcherait aucun élément injecté → contenu rendu sans aucun style.
     Tous les sélecteurs sont préfixés .vr- : aucun risque de collision. -->
<style is:global>
  .vr-titre {
    font-family: 'Fraunces', Georgia, serif; font-weight: 500;
    font-size: clamp(1.9rem, 5vw, 3rem); line-height: 1.08; letter-spacing: -0.02em;
  }
  .vr-fraicheur {
    display: inline-flex; align-items: center; gap: 0.45rem; margin-top: 1rem;
    font-family: 'Instrument Sans', sans-serif; font-size: 0.85rem; color: #6B5D4F;
    background: #F0E2D8; border-radius: 999px; padding: 0.35rem 0.85rem;
  }
  .vr-fraicheur::before { content: ''; width: 7px; height: 7px; border-radius: 999px; background: #A85638; flex: 0 0 auto; }

  .vr-field { display: flex; flex-direction: column; gap: 0.75rem; }
  @media (min-width: 560px) { .vr-field { flex-direction: row; align-items: flex-start; } }
  .vr-combo { position: relative; flex: 1; }
  .vr-input {
    width: 100%; background: #F7F2EA; border: 1px solid #E8DFD0; border-radius: 12px;
    padding: 0.85rem 1rem; font-family: 'Instrument Sans', sans-serif; font-size: 1rem;
    color: #211C16; min-height: 52px;
  }
  .vr-input:focus { outline: 2px solid #A85638; outline-offset: 2px; border-color: #A85638; }
  .vr-submit { min-height: 52px; white-space: nowrap; }
  @media (max-width: 559px) { .vr-submit { width: 100%; } }

  .vr-suggestions {
    position: absolute; z-index: 20; left: 0; right: 0; top: calc(100% + 6px);
    background: #FDFBF6; border: 1px solid #E8DFD0; border-radius: 12px;
    box-shadow: 0 24px 48px -28px rgba(33,28,22,0.5);
    list-style: none; margin: 0; padding: 0.35rem; max-height: 320px; overflow-y: auto;
  }
  .vr-suggestions li {
    padding: 0.65rem 0.75rem; border-radius: 8px; cursor: pointer;
    font-family: 'Instrument Sans', sans-serif; font-size: 0.95rem; color: #211C16; line-height: 1.35;
  }
  .vr-suggestions li .vr-sug-sub { display: block; font-size: 0.82rem; color: #6B5D4F; }
  .vr-suggestions li[aria-selected="true"], .vr-suggestions li:hover { background: #F0E2D8; }

  /* ——— Analyse ——— */
  .vr-analyse { padding: 2.5rem 0 1rem; }
  .vr-analyse-step {
    display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0;
    font-family: 'Instrument Sans', sans-serif; font-size: 1.02rem; color: #B8AA97;
    transition: color 0.3s ease;
  }
  .vr-analyse-step.is-active { color: #211C16; }
  .vr-analyse-step.is-done { color: #6B5D4F; }
  .vr-analyse-dot {
    width: 20px; height: 20px; border-radius: 999px; flex: 0 0 auto; position: relative;
    border: 2px solid currentColor;
  }
  .vr-analyse-step.is-active .vr-analyse-dot::after {
    content: ''; position: absolute; inset: 3px; border-radius: 999px; background: #A85638;
    animation: vr-pulse 0.9s ease-in-out infinite;
  }
  .vr-analyse-step.is-done .vr-analyse-dot { background: #A85638; border-color: #A85638; }
  .vr-analyse-step.is-done .vr-analyse-dot::after {
    content: ''; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  }
  @keyframes vr-pulse { 0%,100% { transform: scale(0.7); opacity: 0.6; } 50% { transform: scale(1); opacity: 1; } }

  /* ——— Résultats : séquence compacte de cartes ——— */
  .vr-results { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; }
  .vr-head { margin: 0.25rem 0 0.1rem; }
  .vr-head-eyebrow { font-family: 'Instrument Sans', sans-serif; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #A85638; }
  .vr-head-adr { font-family: 'Instrument Sans', sans-serif; font-size: 0.95rem; color: #6B5D4F; margin-top: 0.25rem; }

  .vr-block { opacity: 0; transform: translateY(14px); transition: opacity 0.6s cubic-bezier(0.22,1,0.36,1), transform 0.6s cubic-bezier(0.22,1,0.36,1); }
  .vr-block.is-in { opacity: 1; transform: none; }

  .vr-card { background: #FDFBF6; border: 1px solid #E8DFD0; border-radius: 20px; padding: 1.5rem 1.35rem; }
  @media (min-width: 768px) { .vr-card { padding: 1.9rem; } }
  .vr-card--dark { background: #211C16; border-color: #211C16; }
  .vr-card--warm { background: #F0E2D8; border-color: #EAD9C7; }

  .vr-label { font-family: 'Instrument Sans', sans-serif; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #A85638; }
  .vr-card--dark .vr-label { color: #C97B52; }
  .vr-num { font-family: 'Fraunces', Georgia, serif; font-weight: 500; line-height: 1; letter-spacing: -0.02em; color: #211C16; }
  .vr-card--dark .vr-num { color: #F7F2EA; }
  .vr-sub { font-family: 'Instrument Sans', sans-serif; color: #6B5D4F; }
  .vr-card--dark .vr-sub { color: rgba(247,242,234,0.7); }

  /* B — compteur de ventes */
  .vr-b-num { font-size: clamp(3.4rem, 16vw, 5rem); }
  .vr-b-l { font-family: 'Instrument Sans', sans-serif; font-size: 1.1rem; color: #211C16; margin-top: 0.15rem; }
  .vr-b-sub { font-size: 0.9rem; margin-top: 0.45rem; }

  /* C — prix du milieu + curseur de fourchette */
  .vr-c-num { font-size: clamp(2.7rem, 12vw, 3.8rem); }
  .vr-c-lbl { margin-top: 0.55rem; }
  .vr-range { margin-top: 1.8rem; }
  .vr-range-line { position: relative; height: 3px; background: #E0D3BF; margin: 0 0.2rem; border-radius: 3px; }
  .vr-range-dot { position: absolute; top: 50%; width: 18px; height: 18px; border-radius: 999px; background: #A85638; box-shadow: 0 0 0 4px #FDFBF6, 0 2px 8px rgba(168,86,56,0.55); transform: translate(-50%, -50%); transition: left 0.9s cubic-bezier(0.22,1,0.36,1); }
  .vr-range-cap { position: absolute; top: -1.55rem; font-family: 'Instrument Sans', sans-serif; font-size: 0.92rem; color: #211C16; font-weight: 600; }
  .vr-range-cap.g { left: 0; } .vr-range-cap.d { right: 0; }
  .vr-range-arrows { display: flex; justify-content: space-between; color: #C0B29B; font-size: 1rem; margin-top: 0.35rem; padding: 0 0.1rem; }
  .vr-c-phrase { font-family: 'Instrument Sans', sans-serif; font-size: 0.98rem; color: #6B5D4F; margin-top: 1rem; line-height: 1.5; }
  .vr-c-m2 { font-family: 'Instrument Sans', sans-serif; font-size: 0.88rem; color: #6B5D4F; opacity: 0.85; margin-top: 0.55rem; }

  /* D — tendance : titre + jauge baisse/stable/hausse */
  .vr-d-head { display: flex; align-items: center; gap: 0.65rem; margin-top: 0.7rem; }
  .vr-d-ico { width: 32px; height: 32px; flex: 0 0 auto; }
  .vr-d-ico svg { width: 100%; height: 100%; }
  .vr-d-title { font-family: 'Fraunces', serif; font-weight: 500; font-size: clamp(1.4rem, 5vw, 1.9rem); line-height: 1.1; color: #211C16; }
  .vr-d-pct { font-family: 'Instrument Sans', sans-serif; font-size: 0.9rem; color: #6B5D4F; margin-top: 0.9rem; }
  .vr-gauge { margin-top: 1.3rem; }
  .vr-gauge-track { position: relative; height: 12px; border-radius: 999px; background: linear-gradient(90deg, #DCD2C0 0 33%, #EFE6D6 33% 67%, #E6C3AB 67% 100%); }
  .vr-gauge-cursor { position: absolute; top: -5px; width: 4px; height: 22px; border-radius: 2px; background: #211C16; transform: translateX(-50%); transition: left 0.9s cubic-bezier(0.22,1,0.36,1); }
  .vr-gauge-lbls { display: flex; justify-content: space-between; margin-top: 0.55rem; font-family: 'Instrument Sans', sans-serif; font-size: 0.76rem; letter-spacing: 0.08em; text-transform: uppercase; color: #9C8E7C; }
  .vr-gauge-lbls .on { color: #A85638; font-weight: 600; }

  /* A — dernière vente */
  .vr-a-num { font-size: clamp(2.5rem, 11vw, 3.4rem); margin-top: 0.7rem; }
  .vr-a-bien { font-family: 'Instrument Sans', sans-serif; font-size: 1.02rem; margin-top: 0.5rem; color: rgba(247,242,234,0.92); }
  .vr-a-meta { font-family: 'Instrument Sans', sans-serif; font-size: 0.92rem; margin-top: 0.35rem; }

  /* En clair */
  .vr-ec { font-family: 'Fraunces', serif; font-weight: 500; font-size: clamp(1.3rem, 4.6vw, 1.8rem); line-height: 1.32; color: #211C16; margin-top: 0.7rem; }
  .vr-maj { font-family: 'Instrument Sans', sans-serif; font-size: 0.8rem; color: #6B5D4F; margin-top: 0.9rem; }

  /* Ventes détaillées (secondaire) */
  .vr-details { margin-top: 0.1rem; }
  .vr-details summary {
    cursor: pointer; font-family: 'Instrument Sans', sans-serif; font-weight: 600; color: #A85638;
    padding: 0.9rem 0; list-style: none; display: inline-flex; align-items: center; gap: 0.5rem;
  }
  .vr-details summary::-webkit-details-marker { display: none; }
  .vr-details summary::before { content: '＋'; font-weight: 400; }
  .vr-details[open] summary::before { content: '－'; }
  .vr-autre { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem 1rem; padding: 0.85rem 0; border-top: 1px solid #EDE3D4; font-family: 'Instrument Sans', sans-serif; }
  .vr-autre-sub { display: block; font-size: 0.85rem; color: #6B5D4F; }
  .vr-autre-prix { font-weight: 600; color: #211C16; }

  /* ——— Conversion : rupture forte (carte sombre) ——— */
  .vr-conv { background: #211C16; color: #F7F2EA; border-radius: 24px; padding: 2rem 1.5rem; margin-top: 1.75rem; }
  @media (min-width: 768px) { .vr-conv { padding: 2.75rem; } }
  .vr-conv-eyebrow { font-family: 'Instrument Sans', sans-serif; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #C97B52; margin-bottom: 0.8rem; }
  .vr-conv-titre { font-family: 'Fraunces', serif; font-weight: 500; font-size: clamp(1.8rem, 6.5vw, 2.6rem); line-height: 1.08; color: #F7F2EA; margin-bottom: 0.7rem; }
  .vr-conv-intro { font-family: 'Instrument Sans', sans-serif; font-size: 1.02rem; line-height: 1.6; color: rgba(247,242,234,0.72); margin-bottom: 1.6rem; }
  .vr-paths { display: grid; gap: 0.7rem; }
  .vr-path { text-align: left; width: 100%; border: 0; border-radius: 16px; padding: 1.15rem 1.3rem; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1rem; transition: transform 0.2s, box-shadow 0.2s, background 0.2s, border-color 0.2s; }
  .vr-path-t { font-family: 'Fraunces', serif; font-weight: 500; font-size: 1.18rem; display: block; }
  .vr-path-d { font-family: 'Instrument Sans', sans-serif; font-size: 0.88rem; margin-top: 0.2rem; display: block; }
  .vr-path-arrow { flex: 0 0 auto; font-size: 1.15rem; }
  .vr-path--1 { background: #A85638; }
  .vr-path--1 .vr-path-t { color: #FBF3EC; } .vr-path--1 .vr-path-d { color: rgba(251,243,236,0.82); } .vr-path--1 .vr-path-arrow { color: #FBF3EC; }
  .vr-path--1:hover { background: #B5623F; transform: translateY(-2px); box-shadow: 0 18px 40px -22px rgba(168,86,56,0.85); }
  .vr-path--2 { background: #F7F2EA; }
  .vr-path--2 .vr-path-t { color: #211C16; } .vr-path--2 .vr-path-d { color: #6B5D4F; } .vr-path--2 .vr-path-arrow { color: #A85638; }
  .vr-path--2:hover { transform: translateY(-2px); box-shadow: 0 18px 40px -24px rgba(0,0,0,0.55); }
  .vr-path--3 { background: transparent; border: 1px solid rgba(247,242,234,0.26); }
  .vr-path--3 .vr-path-t { color: #F7F2EA; font-size: 1.04rem; } .vr-path--3 .vr-path-d { color: rgba(247,242,234,0.6); } .vr-path--3 .vr-path-arrow { color: rgba(247,242,234,0.6); }
  .vr-path--3:hover { border-color: #C97B52; }

  /* Panneau (qualif / contact / explorer) — carte claire imbriquée dans la conversion sombre */
  .vr-panneau { margin-top: 1.35rem; background: #FDFBF6; border-radius: 16px; padding: 1.5rem 1.35rem; }
  .vr-panneau:empty { display: none; }
  .vr-q-progress { display: flex; gap: 0.35rem; margin-bottom: 1.25rem; }
  .vr-q-dot { height: 4px; flex: 1; border-radius: 999px; background: #E8DFD0; }
  .vr-q-dot.is-on { background: #A85638; }
  .vr-q-label { font-family: 'Fraunces', serif; font-weight: 500; font-size: 1.35rem; line-height: 1.2; color: #211C16; margin-bottom: 1.1rem; }
  .vr-q-opts { display: grid; gap: 0.6rem; }
  .vr-q-opt {
    text-align: left; background: #F7F2EA; border: 1px solid #E8DFD0; border-radius: 12px;
    padding: 0.9rem 1.1rem; cursor: pointer; font-family: 'Instrument Sans', sans-serif; font-size: 1rem; color: #211C16;
    transition: border-color 0.15s, background 0.15s;
  }
  .vr-q-opt:hover { border-color: #A85638; background: #F0E2D8; }
  .vr-q-back { background: none; border: 0; color: #6B5D4F; font-family: 'Instrument Sans', sans-serif; font-size: 0.9rem; cursor: pointer; margin-top: 1rem; padding: 0.3rem 0; }
  .vr-q-back:hover { color: #A85638; }

  .vr-champ { display: block; margin-bottom: 0.9rem; }
  .vr-champ label { display: block; font-family: 'Instrument Sans', sans-serif; font-size: 0.9rem; color: #6B5D4F; margin-bottom: 0.4rem; }
  .vr-champ input {
    width: 100%; background: #F7F2EA; border: 1px solid #E8DFD0; border-radius: 12px; padding: 0.8rem 1rem;
    font-family: 'Instrument Sans', sans-serif; font-size: 1rem; color: #211C16; min-height: 50px;
  }
  .vr-champ input:focus { outline: 2px solid #A85638; outline-offset: 2px; border-color: #A85638; }
  .vr-consent { display: flex; align-items: flex-start; gap: 0.6rem; font-family: 'Instrument Sans', sans-serif; font-size: 0.88rem; color: #6B5D4F; line-height: 1.5; margin: 0.5rem 0 1rem; cursor: pointer; }
  .vr-consent input { margin-top: 0.15rem; width: 18px; height: 18px; accent-color: #A85638; flex: 0 0 auto; }
  .vr-contact-liens { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .vr-explorer { display: grid; gap: 0.6rem; }
  .vr-explorer a { display: block; background: #F7F2EA; border: 1px solid #E8DFD0; border-radius: 12px; padding: 0.9rem 1.1rem; font-family: 'Instrument Sans', sans-serif; color: #211C16; transition: border-color 0.15s; }
  .vr-explorer a:hover { border-color: #A85638; }
  .vr-explorer a b { font-family: 'Fraunces', serif; font-weight: 500; }

  .vr-vide { background: #FDFBF6; border: 1px solid #E8DFD0; border-radius: 20px; padding: 1.75rem 1.5rem; }

  .vr-methode { margin-top: 2.5rem; font-family: 'Instrument Sans', sans-serif; }
  .vr-methode summary { cursor: pointer; font-size: 0.85rem; color: #6B5D4F; }
  .vr-methode-corps { margin-top: 0.8rem; display: grid; gap: 0.7rem; }
  .vr-methode-corps p { font-size: 0.85rem; color: #6B5D4F; line-height: 1.6; }

  /* ——————————————————————————————————————————————————————————————
     Infographique auto-animé (data-driven, pas de scroll requis)
     3 révélations s'enchaînent automatiquement (~8 s).
     L'état final est lisible en 2 s sans avoir vu l'animation.
     Repli empilé géré par construireStack (prefers-reduced-motion).
     —————————————————————————————————————————————————————————————— */

  .vr-infogr {
    background: #F7F2EA;
    border-radius: 22px;
    padding: 1.75rem clamp(1.25rem, 5vw, 2.5rem) 2rem;
    overflow: hidden;
  }

  /* Bloc révélation — fade/slide in séquentiel */
  .vr-ig-rev {
    margin-bottom: 2.25rem;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .vr-ig-rev.is-on { opacity: 1; transform: none; }

  .vr-ig-kicker {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.74rem; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: #A85638; margin-bottom: 0.35rem;
  }
  .vr-ig-titre {
    font-family: 'Fraunces', serif; font-weight: 500;
    font-size: clamp(1.2rem, 4.2vw, 1.65rem); line-height: 1.2;
    color: #211C16; margin-bottom: 1.1rem;
  }

  /* ——— Rév. 1 : nuage de points + distribution ——— */

  .vr-ig-dots-svg { display: block; width: 100%; max-width: 26rem; height: 80px; margin: 0 auto 0.55rem; }

  .ig-dot { transition: transform 0.95s cubic-bezier(0.25, 0.46, 0.45, 0.94), fill 0.5s ease; }

  .vr-ig-legend {
    display: flex; gap: 1.5rem; justify-content: center;
    margin-bottom: 1rem; transition: opacity 0.5s ease;
    font-family: 'Instrument Sans', sans-serif; font-size: 0.82rem; color: #211C16;
  }
  .vr-ig-leg-dot {
    display: inline-block; width: 8px; height: 8px; border-radius: 999px;
    margin-right: 0.32rem; vertical-align: middle; position: relative; top: -1px;
  }

  /* Axe distribution IQR */
  .vr-ig-dist-wrap { max-width: 22rem; margin: 0.25rem auto 0; }
  .vr-ig-dist-track {
    position: relative; height: 16px;
    background: #E0D3BF; border-radius: 999px; overflow: hidden;
  }
  .vr-ig-dist-iqr {
    position: absolute; inset: 0 auto 0 0; width: 0%;
    background: rgba(168,86,56,0.22); border-radius: 999px;
    transition: width 0.95s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .vr-ig-dist-med {
    position: absolute; top: -3px; bottom: -3px; width: 4px;
    background: #A85638; border-radius: 2px;
    transform: translateX(-50%); opacity: 0;
    transition: opacity 0.45s ease;
  }
  .vr-ig-dist-lbls {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-top: 0.5rem;
    font-family: 'Instrument Sans', sans-serif; font-size: 0.82rem; color: #211C16; font-weight: 600;
  }
  .vr-ig-dist-lbls span:nth-child(2) { color: #A85638; font-size: 0.78rem; transition: opacity 0.45s ease; }
  .vr-ig-dist-sublbls {
    display: flex; justify-content: space-between;
    font-family: 'Instrument Sans', sans-serif; font-size: 0.7rem;
    color: #9C8E7C; letter-spacing: 0.06em; text-transform: uppercase;
    margin-top: 0.15rem; padding: 0 0.05rem;
  }
  .vr-ig-iqr-note {
    font-family: 'Instrument Sans', sans-serif; font-size: 0.9rem;
    color: #6B5D4F; margin-top: 1rem; line-height: 1.55;
    transition: opacity 0.5s ease;
  }

  /* ——— Rév. 2 : effet surface (appartements) ——— */

  .vr-ig-sep { height: 1px; background: #E8DFD0; margin: 0 0 2.25rem; }
  .vr-ig-bars { display: grid; gap: 0.8rem; max-width: 22rem; }
  .vr-ig-bar-row { display: grid; grid-template-columns: 5.5rem 1fr 6rem; align-items: center; gap: 0.65rem; }
  .vr-ig-bar-label { font-family: 'Instrument Sans', sans-serif; font-size: 0.82rem; color: #6B5D4F; }
  .vr-ig-bar-track { height: 11px; border-radius: 999px; background: #E0D3BF; overflow: hidden; }
  .vr-ig-bar-fill { height: 100%; border-radius: 999px; width: 0%; transition: width 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94); }
  .vr-ig-bar-fill--hi { background: #A85638; }
  .vr-ig-bar-fill--lo { background: #C0B29B; }
  .vr-ig-bar-val { font-family: 'Fraunces', serif; font-weight: 500; font-size: 0.95rem; color: #211C16; text-align: right; }
  .vr-ig-surf-note { font-family: 'Instrument Sans', sans-serif; font-size: 0.88rem; color: #6B5D4F; margin-top: 0.85rem; line-height: 1.55; max-width: 22rem; }

  /* ——— Rév. 3 : sparkline temporelle ——— */

  .vr-ig-spark-wrap { max-width: 22rem; }
  .vr-ig-spark-svg { display: block; width: 100%; overflow: visible; }
  .vr-ig-spark-path { fill: none; stroke: #A85638; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .vr-ig-spark-dot { fill: #A85638; opacity: 0; transition: opacity 0.3s ease; }
  .vr-ig-spark-dot.on { opacity: 1; }
  .vr-ig-spark-yr { font-family: 'Instrument Sans', sans-serif; font-size: 0.72rem; fill: #9C8E7C; text-anchor: middle; }
  .vr-ig-spark-dir { font-family: 'Fraunces', serif; font-weight: 500; font-size: clamp(1.05rem, 3.5vw, 1.35rem); color: #211C16; margin-top: 0.65rem; }
  .vr-ig-spark-pct { font-family: 'Instrument Sans', sans-serif; font-size: 0.85rem; color: #6B5D4F; margin-top: 0.2rem; }

  /* ——— Conclusion ——— */
  .vr-conclusion {
    padding-top: 2rem; margin-top: 1rem;
    border-top: 1.5px solid #E0D3BF;
    opacity: 0; transform: translateY(12px);
    transition: opacity 0.65s ease, transform 0.65s ease;
  }
  .vr-conclusion.is-on { opacity: 1; transform: none; }
  .vr-conc-eyebrow {
    font-family: 'Instrument Sans', sans-serif; font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase; color: #8A7C6A; margin-bottom: 1rem;
  }
  .vr-conc-body { font-family: 'Instrument Sans', sans-serif; font-size: clamp(0.98rem, 3vw, 1.1rem); line-height: 1.68; color: #211C16; }

  /* Gardées — utilisées par construireStack */
  .vr-ppm-alt { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #E8DFD0; }
  .vr-ppm-alt-type { font-family: 'Instrument Sans', sans-serif; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #8A7C6A; }
  .vr-ppm-alt-val { font-family: 'Fraunces', serif; font-weight: 500; font-size: 1.3rem; color: #211C16; margin-top: 0.25rem; }
  .vr-ppm-alt-range { font-family: 'Instrument Sans', sans-serif; font-size: 0.88rem; color: #6B5D4F; margin-top: 0.15rem; }

  .vr-after { margin-top: 1.5rem; }

  @media (prefers-reduced-motion: reduce) {
    .vr-block { opacity: 1; transform: none; transition: none; }
    .vr-range-dot, .vr-gauge-cursor { transition: none; }
    .vr-analyse-step.is-active .vr-analyse-dot::after { animation: none; }
    .vr-ig-rev { opacity: 1; transform: none; transition: none; }
    .ig-dot { transition: none; }
    .vr-ig-bar-fill { transition: none; }
    .vr-ig-dist-iqr { transition: none; width: 100%; }
    .vr-ig-dist-med { transition: none; opacity: 1; }
    .vr-ig-iqr-note { transition: none; opacity: 1; }
    .vr-ig-legend { transition: none; opacity: 1 !important; }
    .vr-ig-spark-dot { transition: none; opacity: 1; }
    .vr-conclusion { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  type Tx = {
    id: string; d: string; v: number; t: string; lat: number; lon: number;
    no?: string; vo?: string; cp?: string; co?: string; sb?: number; p?: number; st?: number; lots?: number;
  };
  type Meta = { status: string; generatedAt: string | null; dateVenteLaPlusRecente: string | null };

  const form = document.getElementById('vr-form') as HTMLFormElement;
  const input = document.getElementById('vr-adresse') as HTMLInputElement;
  const sugList = document.getElementById('vr-suggestions') as HTMLUListElement;
  const scene = document.getElementById('vr-scene') as HTMLElement;
  const geoErreur = document.getElementById('vr-geo-erreur') as HTMLElement;
  const fraicheurEl = document.getElementById('vr-fraicheur') as HTMLElement;

  const BIAIS = { lon: 1.4890, lat: 48.4470 };
  const GEOCODE = 'https://data.geopf.fr/geocodage/search';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const eur = new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 });
  const moisAn = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' });
  const jourMoisAn = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
  const dateComplete = (d: string) => { const dt = new Date(d + 'T00:00:00'); return isNaN(dt.getTime()) ? d : jourMoisAn.format(dt); };
  const dateMois = (d: string) => { const dt = new Date(d + 'T00:00:00'); return isNaN(dt.getTime()) ? d : moisAn.format(dt); };
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  const wait = (ms: number) => new Promise((r) => setTimeout(r, reduced ? 0 : ms));

  let dataset: Tx[] | null = null;
  let meta: Meta | null = null;
  let selection: { lon: number; lat: number; label: string } | null = null;
  let lastModel: any = null;

  // ——— Fraîcheur affichée d'emblée ———
  (async () => {
    try {
      const m = (await (await fetch('/data/dvf-meta.json')).json()) as Meta;
      meta = m;
      if (m.status === 'ready' && m.dateVenteLaPlusRecente) {
        fraicheurEl.textContent = `Données DVF disponibles jusqu'au ${dateComplete(m.dateVenteLaPlusRecente)}`;
        fraicheurEl.hidden = false;
      }
    } catch {}
  })();

  async function chargerDonnees() {
    if (dataset) return;
    const [d, m] = await Promise.all([fetch('/data/dvf-secteur.json'), fetch('/data/dvf-meta.json')]);
    dataset = (await d.json()) as Tx[];
    meta = (await m.json()) as Meta;
  }

  async function geocoder(q: string, autocomplete: boolean, limit: number) {
    const url = new URL(GEOCODE);
    url.searchParams.set('q', q);
    url.searchParams.set('limit', String(limit));
    url.searchParams.set('lon', String(BIAIS.lon));
    url.searchParams.set('lat', String(BIAIS.lat));
    if (autocomplete) url.searchParams.set('autocomplete', '1');
    const rep = await fetch(url.toString());
    if (!rep.ok) throw new Error(`geocode ${rep.status}`);
    const json = await rep.json();
    const feats = Array.isArray(json.features) ? json.features : [];
    return feats.filter((f: any) => String(f?.properties?.citycode || '').startsWith('28'));
  }

  function distance(aLat: number, aLon: number, bLat: number, bLon: number) {
    const R = 6371000;
    const dLat = ((bLat - aLat) * Math.PI) / 180, dLon = ((bLon - aLon) * Math.PI) / 180;
    const la1 = (aLat * Math.PI) / 180, la2 = (bLat * Math.PI) / 180;
    const h = Math.sin(dLat / 2) ** 2 + Math.cos(la1) * Math.cos(la2) * Math.sin(dLon / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h));
  }
  const distLisible = (m: number) => (m < 1000 ? `à environ ${Math.round(m / 50) * 50} m` : `à environ ${(m / 1000).toFixed(1).replace('.', ',')} km`);
  const median = (a: number[]) => { if (!a.length) return null; const s = [...a].sort((x, y) => x - y), m = Math.floor(s.length / 2); return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2; };
  const quantile = (a: number[], q: number) => { if (a.length < 2) return a[0] ?? null; const s = [...a].sort((x, y) => x - y); const pos = (s.length - 1) * q, b = Math.floor(pos), r = pos - b; return s[b + 1] !== undefined ? s[b] + r * (s[b + 1] - s[b]) : s[b]; };

  const multiLots = (t: Tx) => Boolean(t.lots && t.lots > 1);
  const typePluriel = (t: string) => (t === 'Maison' ? 'des maisons' : 'des appartements');
  const typePlurielNu = (t: string) => (t === 'Maison' ? 'maisons' : 'appartements');

  function bienCourt(t: Tx) {
    const b = [t.t]; if (t.sb) b.push(`${t.sb} m²`); if (t.p) b.push(`${t.p} pièce${t.p > 1 ? 's' : ''}`);
    if (multiLots(t)) b.push(`vente de ${t.lots} lots`);
    return b.join(' · ');
  }
  function adresse(t: Tx) {
    const rue = [t.no, t.vo].filter(Boolean).join(' '), ville = [t.cp, t.co].filter(Boolean).join(' ');
    return rue && ville ? `${rue}, ${ville}` : rue || ville || 'Adresse approximative';
  }

  // ——— Tendance : régression linéaire sur les médianes ANNUELLES du €/m² ———
  // Bien plus robuste que deux fenêtres isolées : utilise toutes les années
  // (2021→2025), amortit le bruit d'une année atypique, et reflète la tendance
  // de fond. Une comparaison de deux fenêtres pouvait afficher une « baisse »
  // là où le marché est en réalité stable (retour après un pic ponctuel).
  function computeTrend(all: any[], dom: string, minR: number) {
    // Échelle « secteur » : rayon d'au moins 1500 m pour des médianes annuelles
    // stables (les petits rayons font osciller la tendance d'année en année).
    const radii = minR >= 3000 ? [3000] : [minR, 3000];
    let arr: any[] = [];
    for (const r of radii) {
      const s = all.filter((t) => t._dist <= r && t.t === dom && !t.lots && t.sb);
      arr = s;
      if (s.length >= 150) break;
    }
    const xs: number[] = [], ys: number[] = [];
    for (let y = 2021; y <= 2025; y++) {
      const g = arr.filter((t) => t.d.startsWith(String(y))).map((t) => t.v / t.sb);
      if (g.length >= 20) { xs.push(y); ys.push(median(g) as number); } // année fiable seulement
    }
    if (xs.length < 3) return null; // pas assez de recul → pas de tendance affichée

    // Droite de régression (moindres carrés) sur les médianes annuelles.
    const ANNEE_REF = 2021, ANNEE_FIN = 2025; // bornes FIXES, identiques pour toute adresse
    const n = xs.length, x0 = xs[0];
    const X = xs.map((y) => y - x0);
    const sx = X.reduce((a, b) => a + b, 0), sy = ys.reduce((a, b) => a + b, 0);
    const sxx = X.reduce((a, b) => a + b * b, 0), sxy = X.reduce((a, b, i) => a + b * ys[i], 0);
    const slope = (n * sxy - sx * sy) / (n * sxx - sx * sx); // €/m² par an
    const intercept = (sy - slope * sx) / n;

    // ——— Conversion pente → pourcentage : RÈGLE UNIQUE, indépendante de l'adresse ———
    // On évalue la droite ajustée à deux années FIXES (2021 et 2025), jamais aux
    // années réellement présentes. Le pourcentage est la variation de la valeur
    // ajustée entre ces deux bornes, normalisée par la valeur ajustée de l'année
    // de RÉFÉRENCE CONSTANTE (2021) :
    //     delta% = (ajustée(2025) − ajustée(2021)) / ajustée(2021) × 100
    // La référence (2021) et l'amplitude (4 ans) ne dépendent jamais de l'adresse ;
    // seule la pente, elle, reflète les données locales.
    const yhat = (annee: number) => intercept + slope * (annee - x0);
    const ref = yhat(ANNEE_REF);
    const delta = ((yhat(ANNEE_FIN) - ref) / ref) * 100;

    // Seuil de stabilité : |delta| < 3 % → prix globalement stables.
    const dir = delta >= 3 ? 'hausse' : delta <= -3 ? 'baisse' : 'stable';
    return { delta, dir, anneeDebut: ANNEE_REF, anneeFin: ANNEE_FIN, annualMeds: xs.map((y, i) => ({ year: y, med: Math.round(ys[i]) })) };
  }

  // ——— Modèle : tous les indicateurs, calculés sur les vraies données ———
  function computeModel(lat: number, lon: number) {
    const all = (dataset as Tx[]).map((t) => ({ ...t, _dist: distance(lat, lon, t.lat, t.lon) })).sort((a, b) => a._dist - b._dist);

    const hab = (arr: any[]) => arr.filter((t) => (t.t === 'Maison' || t.t === 'Appartement') && !t.lots);
    let Rw = 3000, near = hab(all.filter((t) => t._dist <= 3000));
    for (const r of [700, 1500, 3000]) {
      const s = hab(all.filter((t) => t._dist <= r));
      if (s.length >= 150) { Rw = r; near = s; break; }
      if (r === 3000) { Rw = 3000; near = s; }
    }
    if (!near.length) return null;

    const nM = near.filter((t) => t.t === 'Maison').length;
    const nA = near.filter((t) => t.t === 'Appartement').length;
    const dom = nM >= nA ? 'Maison' : 'Appartement';
    const nbVentes = near.length;

    const ppmStats = (arr: any[]) => {
      const vals = arr.filter((t: any) => t.sb > 0).map((t: any) => t.v / t.sb);
      if (vals.length < 20) return null;
      return { median: median(vals)!, q1: quantile(vals, 0.25)!, q3: quantile(vals, 0.75)!, n: vals.length };
    };
    const ppmM = ppmStats(near.filter((t) => t.t === 'Maison'));
    const ppmA = ppmStats(near.filter((t) => t.t === 'Appartement'));

    const D = computeTrend(all, dom, Math.max(Rw, 1500));

    let aSet: any[] = [];
    for (const r of [700, 1500, 3000]) { aSet = all.filter((t) => t._dist <= r); if (aSet.length) break; }
    const derniere = [...aSet].sort((a, b) => (a.d < b.d ? 1 : a.d > b.d ? -1 : a._dist - b._dist))[0];
    const activite = near.filter((t) => t.t === dom && t.d >= '2025').length >= 5;
    const autres = [...aSet].sort((a, b) => (a.d < b.d ? 1 : -1)).filter((t) => t.id !== derniere?.id).slice(0, 4);

    const surfaceEffect = (() => {
      const appts = near.filter((t) => t.t === 'Appartement' && t.sb > 0);
      if (appts.length < 40) return null;
      const small = appts.filter((t) => t.sb < 50);
      const large = appts.filter((t) => t.sb >= 80);
      if (small.length < 20 || large.length < 20) return null;
      const ppmSmall = small.map((t) => t.v / t.sb).sort((a: number, b: number) => a - b);
      const ppmLarge = large.map((t) => t.v / t.sb).sort((a: number, b: number) => a - b);
      const medS = median(ppmSmall) as number;
      const medL = median(ppmLarge) as number;
      const deltaPct = Math.round(((medS - medL) / medL) * 100);
      if (Math.abs(deltaPct) < 10) return null;
      return { smallLabel: '< 50 m²', smallMed: Math.round(medS), smallN: small.length, largeLabel: '≥ 80 m²', largeMed: Math.round(medL), largeN: large.length, deltaPct };
    })();
    return { nbVentes, Rw, dom, nM, nA, ppmM, ppmA, D, derniere, activite, autres, surfaceEffect };
  }

  // ——— « En clair » : phrases par règles fixes ———
  function enClair(model: any) {
    const s1 = model.activite
      ? `Autour de cette adresse, ${typePluriel(model.dom)} continuent de se vendre.`
      : `Autour de cette adresse, ${typePluriel(model.dom)} se vendent, mais plus rarement.`;
    let s2 = '';
    if (model.D) {
      if (model.D.dir === 'stable') s2 = 'Les prix observés sont globalement stables ces dernières années.';
      else if (model.D.dir === 'hausse') s2 = 'Les prix observés sont plutôt orientés à la hausse ces dernières années.';
      else s2 = 'Les prix observés sont plutôt orientés à la baisse ces dernières années.';
    }
    return { s1, s2 };
  }

  // ——— Animations ———
  function animeCompteur(el: HTMLElement, to: number, dur = 1100) {
    if (reduced) { el.textContent = eur.format(to); return; }
    const t0 = performance.now();
    const step = (now: number) => {
      const p = Math.min(1, (now - t0) / dur);
      const e = 1 - Math.pow(1 - p, 3);
      el.textContent = eur.format(Math.round(to * e));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  // Applique l'état final d'une animation de bloc (utilisé au reveal et en reduced-motion)
  function jouerAnim(el: HTMLElement, instantane: boolean) {
    const anim = el.dataset.anim;
    if (anim === 'count') {
      el.querySelectorAll<HTMLElement>('[data-count]').forEach((n) => {
        if (instantane) n.textContent = eur.format(Number(n.dataset.count));
        else animeCompteur(n, Number(n.dataset.count));
      });
    } else if (anim === 'slider') {
      const dot = el.querySelector<HTMLElement>('.vr-range-dot');
      if (dot && dot.dataset.pos) dot.style.left = dot.dataset.pos;
    } else if (anim === 'gauge') {
      const cur = el.querySelector<HTMLElement>('.vr-gauge-cursor');
      if (cur && cur.dataset.pos) cur.style.left = cur.dataset.pos;
    }
  }

  const observer = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const el = e.target as HTMLElement;
      el.classList.add('is-in');
      jouerAnim(el, false);
      observer.unobserve(el);
    }
  }, { threshold: 0.3, rootMargin: '0px 0px -8% 0px' });

  function reveler(el: HTMLElement) {
    if (reduced) { el.classList.add('is-in'); jouerAnim(el, true); return; }
    observer.observe(el);
  }

  // ——— Rendu de l'infographie ———
  const rayonTxt = (r: number) => (r < 1000 ? `${r} m` : `${(r / 1000).toLocaleString('fr-FR')} km`);
  // Position du curseur sur la jauge baisse/stable/hausse : domaine [-10 %, +10 %].
  const gaugePos = (delta: number) => Math.max(4, Math.min(96, ((delta + 10) / 20) * 100));

  function iconeTendance(dir: string) {
    if (dir === 'hausse') return '<svg viewBox="0 0 24 24" fill="none" stroke="#A85638" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17L11 10l4 4 6-6"/><path d="M15 8h6v6"/></svg>';
    if (dir === 'baisse') return '<svg viewBox="0 0 24 24" fill="none" stroke="#8A7C6A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7l7 7 4-4 6 6"/><path d="M15 16h6v-6"/></svg>';
    return '<svg viewBox="0 0 24 24" fill="none" stroke="#8A7C6A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"/><path d="M16 8l4 4-4 4"/></svg>';
  }
  function tendanceTitre(dir: string) {
    if (dir === 'hausse') return 'Prix orientés à la hausse';
    if (dir === 'baisse') return 'Prix orientés à la baisse';
    return 'Prix globalement stables';
  }

  // Repli empilé (reduced-motion / secours) — cartes verticales lisibles.
  function construireStack(model: any) {
    const ppmDom = model.dom === 'Maison' ? model.ppmM : model.ppmA;
    const ppmAlt = model.dom === 'Maison' ? model.ppmA : model.ppmM;
    const altType = model.dom === 'Maison' ? 'Appartement' : 'Maison';
    const parts: string[] = [];

    parts.push(`
      <div class="vr-head">
        <p class="vr-head-eyebrow">Autour de cette adresse</p>
        ${selection?.label ? `<p class="vr-head-adr">${esc(selection.label)}</p>` : ''}
      </div>`);

    // ① Activité
    parts.push(`
      <div class="vr-block" data-anim="count">
        <div class="vr-card">
          <p class="vr-num vr-b-num"><span data-count="${model.nbVentes}">0</span></p>
          <p class="vr-b-l">ventes réalisées depuis 2021</p>
          <p class="vr-sub vr-b-sub">dans un rayon d'environ ${rayonTxt(model.Rw)}</p>
        </div>
      </div>`);

    // ② Composition maisons / appartements
    parts.push(`
      <div class="vr-block" data-anim="count">
        <div class="vr-card">
          <p class="vr-label">Ce qui se vend ici</p>
          <div style="display:flex;gap:1.5rem;flex-wrap:wrap;margin-top:0.5rem">
            <div><p class="vr-num" style="font-size:clamp(2rem,8vw,2.8rem)"><span data-count="${model.nM}">0</span></p><p class="vr-sub">maisons</p></div>
            <div><p class="vr-num" style="font-size:clamp(2rem,8vw,2.8rem)"><span data-count="${model.nA}">0</span></p><p class="vr-sub">appartements</p></div>
          </div>
          <p class="vr-sub" style="margin-top:0.8rem">Deux marchés différents. Mieux vaut ne pas les mélanger.</p>
        </div>
      </div>`);

    // ③ Prix €/m² par type
    if (ppmDom) {
      const q1 = Math.round(ppmDom.q1), q3 = Math.round(ppmDom.q3), med = Math.round(ppmDom.median);
      const pos = q3 > q1 ? Math.max(6, Math.min(94, ((med - q1) / (q3 - q1)) * 100)) : 50;
      let altHtml = '';
      if (ppmAlt) {
        altHtml = `<div class="vr-ppm-alt"><p class="vr-ppm-alt-type">${esc(typePlurielNu(altType))}</p><p class="vr-ppm-alt-val">${eur.format(Math.round(ppmAlt.median))} €/m²</p><p class="vr-ppm-alt-range">fourchette ${eur.format(Math.round(ppmAlt.q1))} – ${eur.format(Math.round(ppmAlt.q3))} €/m²</p></div>`;
      }
      parts.push(`
        <div class="vr-block" data-anim="slider">
          <div class="vr-card">
            <p class="vr-label">Le prix au m² observé · ${esc(typePlurielNu(model.dom))}</p>
            <p class="vr-num vr-c-num">${eur.format(med)} €/m²</p>
            <div class="vr-range">
              <div class="vr-range-line">
                <span class="vr-range-cap g">${eur.format(q1)}</span>
                <span class="vr-range-cap d">${eur.format(q3)}</span>
                <span class="vr-range-dot" data-pos="${pos.toFixed(0)}%" style="left:50%"></span>
              </div>
              <div class="vr-range-arrows" aria-hidden="true"><span>←</span><span>→</span></div>
              <p class="vr-c-phrase">La moitié des ${esc(typePlurielNu(model.dom))} se sont vendues entre <strong>${eur.format(q1)}</strong> et <strong>${eur.format(q3)} €/m²</strong>.</p>
            </div>
            ${altHtml}
          </div>
        </div>`);
    }

    // ④ Tendance
    if (model.D) {
      const pct = `${model.D.delta >= 0 ? '+' : ''}${model.D.delta.toFixed(1).replace('.', ',')} %`;
      const pos = gaugePos(model.D.delta), dir = model.D.dir;
      parts.push(`
        <div class="vr-block" data-anim="gauge">
          <div class="vr-card">
            <p class="vr-label">Les prix, dans le temps</p>
            <div class="vr-d-head">
              <span class="vr-d-ico" aria-hidden="true">${iconeTendance(dir)}</span>
              <span class="vr-d-title">${tendanceTitre(dir)}</span>
            </div>
            <div class="vr-gauge">
              <div class="vr-gauge-track"><span class="vr-gauge-cursor" data-pos="${pos.toFixed(0)}%" style="left:50%"></span></div>
              <div class="vr-gauge-lbls">
                <span class="${dir === 'baisse' ? 'on' : ''}">Baisse</span>
                <span class="${dir === 'stable' ? 'on' : ''}">Stable</span>
                <span class="${dir === 'hausse' ? 'on' : ''}">Hausse</span>
              </div>
            </div>
            <p class="vr-d-pct">${pct} sur le prix au m², estimé sur ${model.D.anneeDebut}–${model.D.anneeFin}</p>
          </div>
        </div>`);
    }

    // ⑤ Limitation
    parts.push(`
      <div class="vr-block" data-anim="fade">
        <div class="vr-card vr-card--warm">
          <p class="vr-label">À retenir</p>
          <p class="vr-ec">Un même quartier. Des biens très différents.</p>
          <p class="vr-sub" style="margin-top:0.8rem;line-height:1.55">Une adresse donne le contexte, elle ne suffit pas à situer votre bien. Surface, état, exposition, travaux : chaque propriété est unique, et ces statistiques de quartier ne peuvent pas le refléter.</p>
        </div>
        <p class="vr-maj">${majLigne()}</p>
      </div>`);

    // Ventes détaillées (secondaire)
    if (model.autres.length) {
      const d = model.derniere;
      parts.push(`
        <div class="vr-block" data-anim="fade">
          <details class="vr-details">
            <summary>Voir les ventes autour de chez moi</summary>
            <div>
              <div class="vr-autre">
                <span>${esc(bienCourt(d))}<span class="vr-autre-sub">${esc(adresse(d))} · ${esc(dateMois(d.d))} · ${esc(distLisible(d._dist))}</span></span>
                <span class="vr-autre-prix">${eur.format(d.v)} €</span>
              </div>
              ${model.autres.map((t: any) => `
                <div class="vr-autre">
                  <span>${esc(bienCourt(t))}<span class="vr-autre-sub">${esc(adresse(t))} · ${esc(dateMois(t.d))} · ${esc(distLisible(t._dist))}</span></span>
                  <span class="vr-autre-prix">${eur.format(t.v)} €</span>
                </div>`).join('')}
            </div>
          </details>
        </div>`);
    }

    parts.push(construireConversion());

    scene.innerHTML = `<div class="vr-results">${parts.join('')}</div>`;
    scene.querySelectorAll<HTMLElement>('.vr-block').forEach((b) => reveler(b));
    brancherConversion(model);
  }

  // Ventes détaillées (réutilisé par le repli et la séquence)
  function blocDetails(model: any) {
    const d = model.derniere;
    if (!model.autres.length) return '';
    return `
      <details class="vr-details">
        <summary>Voir les ventes autour de chez moi</summary>
        <div>
          <div class="vr-autre"><span>${esc(bienCourt(d))}<span class="vr-autre-sub">${esc(adresse(d))} · ${esc(dateMois(d.d))} · ${esc(distLisible(d._dist))}</span></span><span class="vr-autre-prix">${eur.format(d.v)} €</span></div>
          ${model.autres.map((t: any) => `<div class="vr-autre"><span>${esc(bienCourt(t))}<span class="vr-autre-sub">${esc(adresse(t))} · ${esc(dateMois(t.d))} · ${esc(distLisible(t._dist))}</span></span><span class="vr-autre-prix">${eur.format(t.v)} €</span></div>`).join('')}
        </div>
      </details>`;
  }

  // ——— Infographique auto-animé (data-driven, pas de scroll requis) ———
  let cineCleanup: null | (() => void) = null;

  function construireCine(model: any) {
    if (cineCleanup) { cineCleanup(); cineCleanup = null; }

    const ppmDom = model.dom === 'Maison' ? model.ppmM : model.ppmA;
    const D = model.D;
    const sf = model.surfaceEffect;
    const touts: ReturnType<typeof setTimeout>[] = [];
    const later = (ms: number, fn: () => void) => { touts.push(setTimeout(fn, ms)); };

    // ——— Dot cloud: positions pseudo-aléatoires déterministes ———
    const NDOTS = 42;
    const propM = model.nM / (model.nM + model.nA);
    const nDotM = Math.max(4, Math.min(38, Math.round(NDOTS * propM)));
    const SVG_W = 320, SVG_H = 78;
    const CX = SVG_W / 2, CY = SVG_H / 2;
    let _s = 0x9e3779b9;
    const rnd = () => { _s = ((_s ^ (_s >>> 16)) * 0x45d9f3b) >>> 0; _s = ((_s ^ (_s >>> 16)) * 0x45d9f3b) >>> 0; _s ^= _s >>> 16; return (_s >>> 0) / 0x100000000; };
    type Dot = { x0: number; y0: number; dx: number; dy: number; isM: boolean };
    const dots: Dot[] = Array.from({ length: NDOTS }, (_, i) => {
      const isM = i < nDotM;
      const x0 = CX + (rnd() * 2 - 1) * 32;
      const y0 = CY + (rnd() * 2 - 1) * 20;
      const x1 = isM ? 18 + rnd() * 80 : 222 + rnd() * 80;
      const y1 = 10 + rnd() * 58;
      return { x0, y0, dx: x1 - x0, dy: y1 - y0, isM };
    });

    // ——— Distribution IQR ———
    const hasDist = !!ppmDom;
    let distHtml = '';
    if (hasDist) {
      const pQ1 = Math.round(ppmDom.q1), pMed = Math.round(ppmDom.median), pQ3 = Math.round(ppmDom.q3);
      const medPct = pQ3 > pQ1 ? Math.max(8, Math.min(92, Math.round(((pMed - pQ1) / (pQ3 - pQ1)) * 100))) : 50;
      distHtml = `
        <div class="vr-ig-dist-wrap">
          <div class="vr-ig-dist-track">
            <div class="vr-ig-dist-iqr" id="vr-iqr"></div>
            <div class="vr-ig-dist-med" id="vr-med" style="left:${medPct}%"></div>
          </div>
          <div class="vr-ig-dist-lbls">
            <span>${eur.format(pQ1)}&nbsp;€/m²</span>
            <span id="vr-med-lbl" style="opacity:0">méd.&nbsp;${eur.format(pMed)}&nbsp;€/m²</span>
            <span>${eur.format(pQ3)}&nbsp;€/m²</span>
          </div>
          <div class="vr-ig-dist-sublbls"><span>1er quartile</span><span></span><span>3e quartile</span></div>
          <p class="vr-ig-iqr-note" id="vr-iqr-note" style="opacity:0">La moitié des ${esc(typePlurielNu(model.dom))} vendues entre <strong>${eur.format(pQ1)}</strong> et <strong>${eur.format(pQ3)}&nbsp;€/m²</strong>. Les données constatent cet écart&nbsp;— elles n'en expliquent pas encore toutes les causes.</p>
        </div>`;
    }

    // ——— Révélation 2 : effet surface (appartements) ———
    let rev2Html = '';
    if (sf) {
      const maxV = Math.max(sf.smallMed, sf.largeMed);
      const sPct = Math.round((sf.smallMed / maxV) * 100);
      const lPct = Math.round((sf.largeMed / maxV) * 100);
      rev2Html = `
        <div class="vr-ig-sep"></div>
        <div class="vr-ig-rev" id="vr-rev2">
          <p class="vr-ig-kicker">Révélation 2</p>
          <p class="vr-ig-titre">Même le prix au&nbsp;m² doit être comparé avec prudence</p>
          <div class="vr-ig-viz">
            <div class="vr-ig-bars">
              <div class="vr-ig-bar-row">
                <span class="vr-ig-bar-label">${esc(sf.smallLabel)}</span>
                <div class="vr-ig-bar-track"><div class="vr-ig-bar-fill vr-ig-bar-fill--hi" data-pct="${sPct}"></div></div>
                <span class="vr-ig-bar-val">${eur.format(sf.smallMed)}&nbsp;€/m²</span>
              </div>
              <div class="vr-ig-bar-row">
                <span class="vr-ig-bar-label">${esc(sf.largeLabel)}</span>
                <div class="vr-ig-bar-track"><div class="vr-ig-bar-fill vr-ig-bar-fill--lo" data-pct="${lPct}"></div></div>
                <span class="vr-ig-bar-val">${eur.format(sf.largeMed)}&nbsp;€/m²</span>
              </div>
            </div>
            <p class="vr-ig-surf-note">Écart constaté : les petits appartements (${esc(sf.smallLabel)}) s'échangent en moyenne <strong>${sf.deltaPct > 0 ? '+' : ''}${sf.deltaPct}&nbsp;%</strong> par rapport aux grands (${esc(sf.largeLabel)}). DVF constate cet écart&nbsp;— il ne l'explique pas.</p>
          </div>
        </div>`;
    }

    // ——— Révélation 3 : sparkline temporelle ———
    let rev3Html = '';
    const hasSpark = !!D && Array.isArray(D.annualMeds) && D.annualMeds.length >= 3;
    if (hasSpark) {
      const meds = D.annualMeds as { year: number; med: number }[];
      const spW = 280, spH = 70, topM = 12, botM = 22, availH = spH - topM - botM;
      const xPts = meds.map((_: any, i: number) => 16 + (i / (meds.length - 1)) * (spW - 32));
      const vals = meds.map((m: any) => m.med);
      const minV = Math.min(...vals), maxV = Math.max(...vals), rng = maxV - minV || 1;
      const yPts = vals.map((v: number) => topM + ((maxV - v) / rng) * availH);
      const lineD = xPts.map((x: number, i: number) => `${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${yPts[i].toFixed(1)}`).join(' ');
      const pct = `${D.delta >= 0 ? '+' : ''}${D.delta.toFixed(1).replace('.', ',')} % sur ${D.anneeDebut}–${D.anneeFin}`;
      const dirTxt = D.dir === 'hausse' ? 'Tendance à la hausse' : D.dir === 'baisse' ? 'Tendance à la baisse' : 'Prix globalement stables';
      const circles = meds.map((m: any, i: number) => `<circle class="vr-ig-spark-dot" data-si="${i}" cx="${xPts[i].toFixed(1)}" cy="${yPts[i].toFixed(1)}" r="4"/>`).join('');
      const labels = meds.map((m: any, i: number) => `<text x="${xPts[i].toFixed(1)}" y="${spH - 2}" class="vr-ig-spark-yr">${m.year}</text>`).join('');
      rev3Html = `
        <div class="vr-ig-sep"></div>
        <div class="vr-ig-rev" id="vr-rev3">
          <p class="vr-ig-kicker">Révélation 3</p>
          <p class="vr-ig-titre">Le marché a une histoire</p>
          <div class="vr-ig-viz">
            <div class="vr-ig-spark-wrap">
              <svg class="vr-ig-spark-svg" viewBox="0 0 ${spW} ${spH}" aria-hidden="true">
                <path d="${lineD}" class="vr-ig-spark-path" id="vr-spark-path"/>
                ${circles}
                ${labels}
              </svg>
              <p class="vr-ig-spark-dir">${esc(dirTxt)}</p>
              <p class="vr-ig-spark-pct">${esc(pct)}</p>
            </div>
          </div>
        </div>`;
    }

    // ——— Construction HTML ———
    const domColor = '#A85638', altColor = '#5B7B9B';
    const dotCircles = dots.map((d, i) =>
      `<circle class="ig-dot" cx="${d.x0.toFixed(1)}" cy="${d.y0.toFixed(1)}" r="${d.isM ? 4.5 : 3.5}" fill="#C0B29B" data-di="${i}"/>`
    ).join('');

    scene.innerHTML = `
      <div class="vr-infogr">
        <div class="vr-ig-rev is-on" id="vr-rev1">
          <p class="vr-ig-kicker">Révélation 1</p>
          <p class="vr-ig-titre">Votre quartier n'a pas un prix unique</p>
          <div class="vr-ig-viz">
            <svg class="vr-ig-dots-svg" viewBox="0 0 ${SVG_W} ${SVG_H}" aria-hidden="true">${dotCircles}</svg>
            <div class="vr-ig-legend" id="vr-ig-legend" style="opacity:0">
              <span><span class="vr-ig-leg-dot" style="background:${domColor}"></span>${model.nM} maisons</span>
              <span><span class="vr-ig-leg-dot" style="background:${altColor}"></span>${model.nA} appartements</span>
            </div>
            ${distHtml}
          </div>
        </div>
        ${rev2Html}
        ${rev3Html}
        <div class="vr-conclusion" id="vr-conclusion">
          <p class="vr-conc-eyebrow">CE QUE CES VENTES NOUS APPRENNENT</p>
          <p class="vr-conc-body">Votre quartier n'a pas un prix unique.<br>Les transactions observées montrent une fourchette réelle, et même le prix au&nbsp;m² peut varier selon les biens que l'on compare.<br><br>Une adresse permet de comprendre votre marché. Pas encore de situer votre bien.<br>Pour savoir où il se place dans cette fourchette, il faut maintenant comparer ce qui est comparable.</p>
        </div>
      </div>
      <div class="vr-after">
        <p class="vr-maj">${majLigne()}</p>
        ${blocDetails(model)}
        ${construireConversion()}
      </div>`;
    brancherConversion(model);

    // Initialise sparkline path masquée (dashoffset = longueur totale)
    if (hasSpark) {
      const sp = scene.querySelector<SVGPathElement>('#vr-spark-path');
      if (sp) { const l = sp.getTotalLength(); sp.style.strokeDasharray = l + 'px'; sp.style.strokeDashoffset = l + 'px'; }
    }

    // ——— Timeline d'animation ———
    const dotEls = Array.from(scene.querySelectorAll<SVGCircleElement>('.ig-dot'));
    const legend = scene.querySelector<HTMLElement>('#vr-ig-legend');

    // 800 ms : séparation M/A
    later(800, () => {
      dotEls.forEach((el, i) => {
        el.style.transform = `translate(${dots[i].dx.toFixed(1)}px,${dots[i].dy.toFixed(1)}px)`;
        el.style.fill = dots[i].isM ? domColor : altColor;
      });
      if (legend) legend.style.opacity = '1';
    });

    // 2 000 ms : zone IQR croît
    if (hasDist) {
      later(2000, () => { const iqr = scene.querySelector<HTMLElement>('#vr-iqr'); if (iqr) iqr.style.width = '100%'; });
      later(2700, () => {
        const med = scene.querySelector<HTMLElement>('#vr-med');
        const medLbl = scene.querySelector<HTMLElement>('#vr-med-lbl');
        const note = scene.querySelector<HTMLElement>('#vr-iqr-note');
        if (med) med.style.opacity = '1';
        if (medLbl) medLbl.style.opacity = '1';
        if (note) note.style.opacity = '1';
      });
    }

    // Révélation 2 : effet surface
    let nextT = hasDist ? 3500 : 1500;
    if (sf) {
      later(nextT, () => { const r = scene.querySelector<HTMLElement>('#vr-rev2'); if (r) r.classList.add('is-on'); });
      later(nextT + 500, () => {
        scene.querySelectorAll<HTMLElement>('.vr-ig-bar-fill').forEach((b) => { b.style.width = (b.dataset.pct || '0') + '%'; });
      });
      nextT += 1600;
    }

    // Révélation 3 : sparkline
    if (hasSpark) {
      later(nextT, () => { const r = scene.querySelector<HTMLElement>('#vr-rev3'); if (r) r.classList.add('is-on'); });
      later(nextT + 500, () => {
        const path = scene.querySelector<SVGPathElement>('#vr-spark-path');
        if (path) {
          path.style.transition = 'stroke-dashoffset 1.8s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
          path.style.strokeDashoffset = '0px';
        }
      });
      const meds = D.annualMeds as { year: number; med: number }[];
      meds.forEach((_: any, i: number) => {
        later(nextT + 900 + i * 280, () => {
          const dot = scene.querySelector<SVGCircleElement>(`.vr-ig-spark-dot[data-si="${i}"]`);
          if (dot) dot.classList.add('on');
        });
      });
      later(nextT + 900 + meds.length * 280 + 600, () => {
        const c = scene.querySelector<HTMLElement>('#vr-conclusion'); if (c) c.classList.add('is-on');
      });
    } else {
      later(nextT + 400, () => { const c = scene.querySelector<HTMLElement>('#vr-conclusion'); if (c) c.classList.add('is-on'); });
    }

    // Scroll doux vers le haut du résultat
    const headerH = document.getElementById('site-header')?.offsetHeight ?? 64;
    const top = scene.getBoundingClientRect().top + window.scrollY - headerH - 8;
    window.scrollTo({ top, behavior: 'smooth' });

    cineCleanup = () => { touts.forEach(clearTimeout); };
  }

  function majLigne() {
    if (!meta) return '';
    const parts: string[] = [];
    if (meta.dateVenteLaPlusRecente) parts.push(`Données DVF disponibles jusqu'au ${dateComplete(meta.dateVenteLaPlusRecente)}`);
    if (meta.generatedAt) parts.push(`extraites le ${jourMoisAn.format(new Date(meta.generatedAt))}`);
    return esc(parts.join(' · ')) + ' · Source : DVF (DGFiP).';
  }

  // ——— Conversion : 3 chemins ———
  function construireConversion() {
    return `
      <div class="vr-block" data-anim="fade">
        <div class="vr-conv" id="vr-conv">
          <p class="vr-conv-eyebrow">La suite</p>
          <p class="vr-conv-titre">Et votre bien dans tout ça&nbsp;?</p>
          <p class="vr-conv-intro">Ces ventes dessinent le contexte de votre quartier — mais votre bien a ses propres caractéristiques. Surface, état, exposition : autant de facteurs que les statistiques ne captent pas.</p>
          <div class="vr-paths" id="vr-paths">
            <button type="button" class="vr-path vr-path--1" data-path="lecture">
              <span><span class="vr-path-t">Situer mon bien dans ce marché</span><span class="vr-path-d">Quelques questions · gratuit · sans engagement</span></span>
              <span class="vr-path-arrow" aria-hidden="true">→</span>
            </button>
            <button type="button" class="vr-path vr-path--2" data-path="mouaad">
              <span><span class="vr-path-t">Parler directement avec Mouaad</span><span class="vr-path-d">Pour échanger dès maintenant, sans étape</span></span>
              <span class="vr-path-arrow" aria-hidden="true">→</span>
            </button>
            <button type="button" class="vr-path vr-path--3" data-path="explorer">
              <span><span class="vr-path-t">Continuer à explorer LEVOIS</span><span class="vr-path-d">Vers les contenus utiles du site</span></span>
              <span class="vr-path-arrow" aria-hidden="true">→</span>
            </button>
          </div>
          <div id="vr-panneau"></div>
        </div>
      </div>`;
  }

  // Intentions (qualification commerciale) — clés lisibles côté lead
  const INTENTIONS = [
    { key: 'curieux', label: 'Je suis simplement curieux', tag: 'Curieux' },
    { key: 'reflexion', label: 'Je réfléchis à vendre', tag: 'Vendeur potentiel' },
    { key: 'prochainement', label: 'Je vais vendre prochainement', tag: 'Vendeur prochainement' },
    { key: 'envente', label: 'Mon bien est déjà en vente', tag: 'Déjà en vente' },
    { key: 'acheteur', label: 'Je souhaite acheter dans le secteur', tag: 'Acheteur' },
  ];
  const OPTS_TYPE = [
    { value: 'maison', label: 'Une maison' }, { value: 'appartement', label: 'Un appartement' },
    { value: 'terrain', label: 'Un terrain' }, { value: 'autre', label: 'Autre / je ne sais pas' },
  ];
  const QUALIF: Record<string, Array<{ key: string; label: string; options: Array<{ value: string; label: string }> }>> = {
    curieux: [
      { key: 'curiosite', label: "Qu'est-ce qui vous amène ?", options: [
        { value: 'prix-quartier', label: 'Le prix des ventes de mon quartier' },
        { value: 'valeur-bien', label: "La valeur d'un bien précis" },
        { value: 'curiosite', label: 'Simple curiosité' } ] },
    ],
    reflexion: [
      { key: 'horizon', label: 'Quand envisagez-vous de vendre ?', options: [
        { value: 'dans-annee', label: "Dans l'année" }, { value: '1-2-ans', label: 'Dans 1 à 2 ans' }, { value: 'sans-date', label: 'Pas encore de date' } ] },
      { key: 'typeBien', label: 'Quel type de bien ?', options: OPTS_TYPE },
      { key: 'besoin', label: 'Votre besoin principal ?', options: [
        { value: 'valeur', label: 'Connaître sa valeur' }, { value: 'marche', label: 'Comprendre le marché' },
        { value: 'preparer', label: 'Préparer la vente' }, { value: 'accompagne', label: 'Être accompagné' } ] },
    ],
    prochainement: [
      { key: 'horizon', label: 'Dans quel délai ?', options: [
        { value: 'ce-mois', label: 'Ce mois-ci' }, { value: '1-3-mois', label: 'Dans 1 à 3 mois' }, { value: '3-6-mois', label: 'Dans 3 à 6 mois' } ] },
      { key: 'typeBien', label: 'Quel type de bien ?', options: OPTS_TYPE },
      { key: 'besoin', label: 'Votre besoin principal ?', options: [
        { value: 'valeur', label: 'Connaître sa valeur' }, { value: 'marche', label: 'Comprendre le marché' },
        { value: 'preparer', label: 'Préparer la vente' }, { value: 'accompagne', label: 'Être accompagné' } ] },
    ],
    envente: [
      { key: 'dureeEnVente', label: 'Depuis combien de temps est-il en vente ?', options: [
        { value: 'moins-1-mois', label: "Moins d'un mois" }, { value: '1-3-mois', label: '1 à 3 mois' },
        { value: '3-6-mois', label: '3 à 6 mois' }, { value: 'plus-6-mois', label: 'Plus de 6 mois' } ] },
      { key: 'problemePrincipal', label: "Qu'est-ce qui bloque le plus ?", options: [
        { value: 'peu-visites', label: 'Peu de visites' }, { value: 'visites-sans-offre', label: "Des visites mais pas d'offre" },
        { value: 'offres-basses', label: 'Des offres trop basses' }, { value: 'peu-vue', label: "L'annonce est peu vue" },
        { value: 'je-ne-sais-pas', label: 'Je ne sais pas' } ] },
    ],
    acheteur: [
      { key: 'typeRecherche', label: 'Que recherchez-vous ?', options: OPTS_TYPE },
      { key: 'budget', label: 'Votre budget approximatif ?', options: [
        { value: 'moins-150', label: 'Moins de 150 000 €' }, { value: '150-250', label: '150 à 250 000 €' },
        { value: '250-400', label: '250 à 400 000 €' }, { value: 'plus-400', label: 'Plus de 400 000 €' },
        { value: 'nsp', label: 'Je ne sais pas encore' } ] },
      { key: 'horizon', label: 'Dans quel délai ?', options: [
        { value: 'rapidement', label: 'Rapidement' }, { value: 'dans-annee', label: "Dans l'année" }, { value: 'sans-date', label: 'Pas pressé' } ] },
    ],
  };

  function brancherConversion(model: any) {
    const paths = document.getElementById('vr-paths')!;
    const panneau = document.getElementById('vr-panneau')!;
    paths.querySelectorAll<HTMLButtonElement>('.vr-path').forEach((btn) => {
      btn.addEventListener('click', () => {
        const p = btn.dataset.path;
        if (p === 'mouaad') panneauMouaad(panneau);
        else if (p === 'explorer') panneauExplorer(panneau);
        else panneauQualif(panneau, model);
        panneau.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'nearest' });
      });
    });
  }

  function panneauMouaad(panneau: HTMLElement) {
    panneau.innerHTML = `
      <div class="vr-panneau">
        <p class="vr-q-label">Parlons de votre projet.</p>
        <p class="font-sans text-[15px] text-brun leading-relaxed" style="margin-bottom:1.1rem">
          Pas d'étape à remplir : contactez Mouaad directement, il vous répond personnellement.
        </p>
        <div class="vr-contact-liens">
          <a href="tel:+33781380121" class="btn-primaire">Appeler Mouaad</a>
          <a href="mailto:mouaad@levois.fr" class="btn-secondaire">Écrire un e-mail</a>
          <a href="/contact?src=votre-rue" class="btn-secondaire">Être rappelé</a>
        </div>
      </div>`;
  }

  function panneauExplorer(panneau: HTMLElement) {
    panneau.innerHTML = `
      <div class="vr-panneau">
        <p class="vr-q-label">Continuer à comprendre.</p>
        <div class="vr-explorer">
          <a href="/situer-ma-vente?src=votre-rue"><b>Situer ma vente</b> — un diagnostic en 3 minutes, sans coordonnées</a>
          <a href="/methode"><b>La méthode LEVOIS</b> — lire le marché avant de décider</a>
          <a href="/ressources/annonce-vue-peu-de-contacts"><b>Pourquoi une vente bloque</b> — annonce vue, peu de contacts</a>
          <a href="/ressources"><b>Toutes les ressources</b> — comprendre chaque étape</a>
        </div>
      </div>`;
  }

  // Micro-qualification : une question par écran, progression visible
  function panneauQualif(panneau: HTMLElement, model: any) {
    const state: any = { intentionKey: null, intention: null, tag: null, answers: {} };

    const rendre = (steps: any[], idx: number) => {
      const total = 1 + steps.length + 1; // intention + questions + contact
      const dots = Array.from({ length: total }, (_, i) => `<span class="vr-q-dot ${i <= idx ? 'is-on' : ''}"></span>`).join('');
      // idx 0 = intention ; 1..steps.length = questions ; total-1 = contact
      if (idx === 0) {
        panneau.innerHTML = `
          <div class="vr-panneau">
            <div class="vr-q-progress">${dots}</div>
            <p class="vr-q-label">Où en êtes-vous ?</p>
            <div class="vr-q-opts">${INTENTIONS.map((it) => `<button type="button" class="vr-q-opt" data-k="${it.key}">${it.label}</button>`).join('')}</div>
          </div>`;
        panneau.querySelectorAll<HTMLButtonElement>('.vr-q-opt').forEach((b) => b.addEventListener('click', () => {
          const it = INTENTIONS.find((x) => x.key === b.dataset.k)!;
          state.intentionKey = it.key; state.intention = it.label; state.tag = it.tag;
          const st = QUALIF[it.key] || [];
          if (st.length) rendre(st, 1); else rendreContact(st);
        }));
        return;
      }
      const q = steps[idx - 1];
      panneau.innerHTML = `
        <div class="vr-panneau">
          <div class="vr-q-progress">${dots}</div>
          <p class="vr-q-label">${esc(q.label)}</p>
          <div class="vr-q-opts">${q.options.map((o: any) => `<button type="button" class="vr-q-opt" data-v="${o.value}">${esc(o.label)}</button>`).join('')}</div>
          <button type="button" class="vr-q-back">← Revenir</button>
        </div>`;
      panneau.querySelectorAll<HTMLButtonElement>('.vr-q-opt').forEach((b) => b.addEventListener('click', () => {
        state.answers[q.key] = { value: b.dataset.v, label: b.textContent };
        if (idx < steps.length) rendre(steps, idx + 1); else rendreContact(steps);
      }));
      panneau.querySelector<HTMLButtonElement>('.vr-q-back')!.addEventListener('click', () => { if (idx === 1) rendre(steps, 0); else rendre(steps, idx - 1); });
    };

    const rendreContact = (steps: any[]) => {
      const total = 1 + steps.length + 1;
      const dots = Array.from({ length: total }, () => `<span class="vr-q-dot is-on"></span>`).join('');
      panneau.innerHTML = `
        <div class="vr-panneau">
          <div class="vr-q-progress">${dots}</div>
          <p class="vr-q-label">Où vous envoyer votre analyse personnalisée ?</p>
          <p class="font-sans text-[14px] text-brun" style="margin-bottom:1rem">
            Elle réunit le récapitulatif des ventes autour de votre adresse, votre situation, les ressources adaptées — et, quand c'est utile, une lecture préparée par Mouaad. Aucune estimation automatique de votre bien : une aide à comprendre, honnête.
          </p>
          <form id="vr-lead" novalidate>
            <div class="vr-champ"><label for="vr-prenom">Prénom</label><input id="vr-prenom" name="prenom" type="text" autocomplete="given-name" required /></div>
            <div class="vr-champ"><label for="vr-email">E-mail</label><input id="vr-email" name="email" type="email" inputmode="email" autocomplete="email" required /></div>
            <div class="vr-champ"><label for="vr-tel">Téléphone <span style="color:#B8AA97">(facultatif)</span></label><input id="vr-tel" name="telephone" type="tel" inputmode="tel" autocomplete="tel" /></div>
            <div style="position:absolute;left:-9999px" aria-hidden="true"><label>Site</label><input name="site_web" tabindex="-1" autocomplete="off" /></div>
            <label class="vr-consent"><input type="checkbox" id="vr-consent" required /><span>J'accepte d'être recontacté au sujet de ma demande — et pour rien d'autre. <a href="/confidentialite" class="text-argile underline">En savoir plus</a>.</span></label>
            <p id="vr-lead-err" class="font-sans text-sm text-argile hidden" role="alert" style="margin-bottom:0.6rem"></p>
            <button type="submit" class="btn-primaire" id="vr-lead-envoi">Recevoir mon analyse personnalisée</button>
            <button type="button" class="vr-q-back">← Revenir</button>
          </form>
        </div>`;
      panneau.querySelector<HTMLButtonElement>('.vr-q-back')!.addEventListener('click', () => { if (steps.length) rendre(steps, steps.length); else rendre(steps, 0); });
      brancherEnvoiLead(panneau, model, state);
    };

    rendre([], 0);
  }

  function brancherEnvoiLead(panneau: HTMLElement, model: any, state: any) {
    const f = panneau.querySelector<HTMLFormElement>('#vr-lead')!;
    const err = panneau.querySelector<HTMLElement>('#vr-lead-err')!;
    const btn = panneau.querySelector<HTMLButtonElement>('#vr-lead-envoi')!;
    let envoiEnCours = false;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (envoiEnCours) return;
      err.classList.add('hidden');
      if (!f.checkValidity()) { f.reportValidity(); return; }
      envoiEnCours = true; btn.disabled = true; btn.textContent = 'Envoi…';
      const fd = new FormData(f);
      const d = model.derniere;
      // Charge utile destinée à /api/lead. Le backend est migré vers Cloudflare
      // Pages Functions à l'itération suivante : ce format reste stable.
      const payload = {
        type: 'votre-rue',
        source: 'QR /votre-rue',
        adresseRecherchee: selection?.label || '',
        commune: d?.co || '',
        intention: state.intention, intentionKey: state.intentionKey, profil: state.tag,
        qualification: Object.fromEntries(Object.entries(state.answers).map(([k, v]: any) => [k, v.label])),
        prenom: fd.get('prenom'), email: fd.get('email'), telephone: fd.get('telephone') || null,
        site_web: fd.get('site_web') || '',
        contexteInfographie: {
          nbVentes: model.nbVentes, rayon: model.Rw,
          composition: { maisons: model.nM, appartements: model.nA },
          ppmMaisons: model.ppmM ? { median: Math.round(model.ppmM.median), q1: Math.round(model.ppmM.q1), q3: Math.round(model.ppmM.q3) } : null,
          ppmAppartements: model.ppmA ? { median: Math.round(model.ppmA.median), q1: Math.round(model.ppmA.q1), q3: Math.round(model.ppmA.q3) } : null,
          tendance: model.D ? { direction: model.D.dir, pct: Number(model.D.delta.toFixed(1)) } : null,
        },
      };
      try {
        const rep = await fetch('/api/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (rep.ok) {
          panneau.innerHTML = `
            <div class="vr-panneau">
              <p class="vr-q-label">C'est noté, ${esc(String(fd.get('prenom') || ''))}.</p>
              <p class="font-sans text-[15px] text-brun leading-relaxed">Mouaad prépare votre analyse personnalisée et vous l'envoie sous 24 à 48 h ouvrées. Vous pouvez aussi le joindre directement : <a href="tel:+33781380121" class="text-argile underline">07 81 38 01 21</a>.</p>
            </div>`;
        } else {
          const data = await rep.json().catch(() => null);
          err.textContent = data?.message || "L'envoi n'a pas abouti. Vous pouvez réessayer ou écrire à mouaad@levois.fr.";
          err.classList.remove('hidden');
        }
      } catch {
        err.textContent = "L'envoi n'a pas abouti. Vous pouvez réessayer ou écrire à mouaad@levois.fr.";
        err.classList.remove('hidden');
      } finally {
        envoiEnCours = false; btn.disabled = false; btn.textContent = 'Recevoir mon analyse personnalisée';
      }
    });
  }

  // ——— États vides / attente ———
  function afficherDonneesEnAttente() {
    scene.hidden = false;
    scene.innerHTML = `<div class="vr-vide"><p class="font-display text-xl text-encre mb-2">L'accès aux ventes de votre secteur est en cours de finalisation.</p>
      <p class="font-sans text-[15px] text-brun leading-relaxed">Les données publiques de ventes (DVF) seront disponibles ici très prochainement. En attendant, Mouaad peut vous transmettre les ventes récentes autour de votre adresse.</p>
      <div class="flex flex-wrap gap-3 mt-5"><a href="/contact?src=votre-rue" class="btn-primaire">Demander à Mouaad</a><a href="/situer-ma-vente?src=votre-rue" class="btn-secondaire">Situer ma vente</a></div></div>`;
  }
  function afficherAucun(label: string) {
    scene.hidden = false;
    scene.innerHTML = `<div class="vr-vide"><p class="font-display text-xl text-encre mb-2">Aucune vente retrouvée à proximité immédiate.</p>
      <p class="font-sans text-[15px] text-brun leading-relaxed">Autour de « ${esc(label)} », aucune vente ne figure pour l'instant dans les données publiques disponibles (DVF). Cette base n'est pas exhaustive.</p>
      <div class="flex flex-wrap gap-3 mt-5"><a href="/situer-ma-vente?src=votre-rue" class="btn-primaire">Situer ma vente</a><a href="/contact?src=votre-rue" class="btn-secondaire">Échanger avec Mouaad</a></div></div>`;
  }

  // ——— Moment d'analyse (adossé au calcul réel, sans fausse attente) ———
  async function jouerAnalyseEtRendre(lat: number, lon: number) {
    const messages = ['Recherche des ventes autour de chez vous…', 'Comparaison des ventes récentes…', "Lecture de l'évolution du secteur…"];
    scene.hidden = false;
    scene.innerHTML = `<div class="vr-analyse">${messages.map((m, i) => `<div class="vr-analyse-step" data-i="${i}"><span class="vr-analyse-dot"></span><span>${m}</span></div>`).join('')}</div>`;
    const steps = Array.from(scene.querySelectorAll<HTMLElement>('.vr-analyse-step'));
    const activer = (i: number) => steps.forEach((s, j) => { s.classList.toggle('is-active', j === i); s.classList.toggle('is-done', j < i); });

    activer(0); await wait(450);
    const model = computeModel(lat, lon); // calcul réel
    steps[0].classList.add('is-done');
    activer(1); await wait(450);
    activer(2); await wait(450);
    steps.forEach((s) => { s.classList.remove('is-active'); s.classList.add('is-done'); });
    await wait(200);

    if (!model) { afficherAucun(selection?.label || input.value); return; }
    lastModel = model;
    // Motion : séquence cinématographique épinglée. Sinon : repli empilé lisible.
    if (reduced) {
      construireStack(model);
      const head = scene.querySelector<HTMLElement>('.vr-head');
      if (head) head.scrollIntoView({ block: 'start' });
    } else {
      construireCine(model);
    }
  }

  // ——— Autocomplétion ———
  let debounce = 0, activeIdx = -1, currentSugs: any[] = [];
  const fermerSug = () => { sugList.hidden = true; input.setAttribute('aria-expanded', 'false'); activeIdx = -1; };
  function rendreSug(feats: any[]) {
    currentSugs = feats;
    if (!feats.length) { fermerSug(); return; }
    sugList.innerHTML = feats.map((f, i) => { const pr = f.properties || {}; const sub = [pr.postcode, pr.city].filter(Boolean).join(' '); return `<li role="option" id="vr-sug-${i}" aria-selected="false" data-idx="${i}">${esc(pr.label || pr.name || '')}<span class="vr-sug-sub">${esc(sub)}</span></li>`; }).join('');
    sugList.hidden = false; input.setAttribute('aria-expanded', 'true'); activeIdx = -1;
  }
  function choisir(i: number) {
    const f = currentSugs[i]; if (!f) return;
    const [lon, lat] = f.geometry.coordinates;
    selection = { lon, lat, label: f.properties?.label || input.value };
    input.value = selection.label; fermerSug(); lancer();
  }
  input.addEventListener('input', () => {
    selection = null; geoErreur.classList.add('hidden');
    const q = input.value.trim(); window.clearTimeout(debounce);
    if (q.length < 3) { fermerSug(); return; }
    debounce = window.setTimeout(async () => { try { rendreSug(await geocoder(q, true, 6)); } catch { fermerSug(); } }, 260);
  });
  input.addEventListener('keydown', (e) => {
    if (sugList.hidden) return;
    const items = Array.from(sugList.querySelectorAll('li'));
    if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, items.length - 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); }
    else if (e.key === 'Enter' && activeIdx >= 0) { e.preventDefault(); choisir(activeIdx); return; }
    else if (e.key === 'Escape') { fermerSug(); return; } else return;
    items.forEach((el, i) => el.setAttribute('aria-selected', i === activeIdx ? 'true' : 'false'));
    if (items[activeIdx]) items[activeIdx].scrollIntoView({ block: 'nearest' });
  });
  sugList.addEventListener('click', (e) => { const li = (e.target as HTMLElement).closest('li'); if (li) choisir(Number((li as HTMLElement).dataset.idx)); });
  document.addEventListener('click', (e) => { if (!form.contains(e.target as Node)) fermerSug(); });

  // ——— Lancement ———
  async function lancer() {
    if (cineCleanup) { cineCleanup(); cineCleanup = null; } // détacher un moteur précédent
    scene.hidden = false;
    scene.innerHTML = `<div class="vr-analyse"><div class="vr-analyse-step is-active"><span class="vr-analyse-dot"></span><span>Recherche des ventes autour de chez vous…</span></div></div>`;
    try { await chargerDonnees(); } catch {
      geoErreur.textContent = 'Impossible de charger les données pour le moment. Réessayez dans un instant.';
      geoErreur.classList.remove('hidden'); scene.hidden = true; return;
    }
    if (!meta || meta.status !== 'ready' || !dataset || !dataset.length) { afficherDonneesEnAttente(); return; }

    let coords = selection;
    if (!coords) {
      const q = input.value.trim();
      if (q.length < 3) { scene.hidden = true; geoErreur.textContent = "Indiquez d'abord votre rue ou votre adresse."; geoErreur.classList.remove('hidden'); return; }
      try { const feats = await geocoder(q, false, 1); if (!feats.length) { afficherAucun(q); return; } const [lon, lat] = feats[0].geometry.coordinates; coords = { lon, lat, label: feats[0].properties?.label || q }; selection = coords; }
      catch { geoErreur.textContent = 'Adresse non reconnue. Précisez la rue et la commune.'; geoErreur.classList.remove('hidden'); scene.hidden = true; return; }
    }
    await jouerAnalyseEtRendre(coords.lat, coords.lon);
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); fermerSug(); lancer(); });
</script>
