  // ————————————————————————————————————————————————————————————————
  //  TUNNEL PERSONNALISÉ — le vrai parcours « SITUER MON BIEN »
  //  Enchaîne 4 étapes filtrantes DVF (compteur qui diminue réellement),
  //  une rupture visuelle, 2 questions déclaratives (compteur figé), et
  //  une lecture finale honnête (fourchette centrale + repère + limite).
  //  Aucun prix estimé du bien n'est jamais produit.
  // ————————————————————————————————————————————————————————————————
  type Etat = {
    type: 'Maison' | 'Appartement' | null;
    sb: number | null;
    p: number | null;
    st: number | null;
    stConnu: boolean; // false si l'utilisateur a répondu « je ne sais pas »
    exterieur: string | null;
    etatDeclare: string | null;
    step: number; // index de l'étape courante
    poolInitial: number; // compteur de départ (transactions non composites)
    progression: Array<{ cle: string; libelle: string; n: number; elargi?: boolean }>;
    lecture: any | null;
    retenues: any[];
  };

  function ouvrirTunnel(panneau: HTMLElement, model: any) {
    if (!dataset) return;
    if (!selection?.lat || !selection?.lon) return; // sécurité — devrait être toujours vrai
    const propre = CMP.retirerComposites(dataset);
    const etat: Etat = {
      type: null, sb: null, p: null, st: null, stConnu: true,
      exterieur: null, etatDeclare: null,
      step: 0, poolInitial: propre.length,
      progression: [], lecture: null, retenues: [],
    };
    rendreTunnel(panneau, etat, model);
  }

  // Recalcule complètement la progression à partir des réponses.
  // Cela garantit que revenir en arrière et modifier une réponse produit
  // toujours le bon compteur (pas de cache invalide).
  function recalculerProgression(etat: Etat) {
if (!etat.type) { etat.progression = []; etat.retenues = []; etat.lecture = null; return; }
    const cible: any = {
      type: etat.type, sb: etat.sb || 0, p: etat.p || 0,
      lat: selection?.lat, lon: selection?.lon,
      st: (etat.type === 'Maison' && etat.stConnu && etat.st ? etat.st : undefined),
    };
    const prog: Etat['progression'] = [];
    const propre = CMP.retirerComposites(dataset);
    prog.push({ cle: 'depart', libelle: 'transactions autour de cette adresse', n: propre.length });

    const parType = CMP.filtrerType(propre, etat.type);
    prog.push({ cle: 'type', libelle: etat.type === 'Maison' ? 'maisons' : 'appartements', n: parType.length });

    if (etat.sb == null) { etat.progression = prog; etat.retenues = parType; etat.lecture = null; return; }
    const parSurf = CMP.filtrerSurface(parType, cible);
    prog.push({
      cle: 'surface',
      libelle: `entre ${parSurf.plage[0]} et ${parSurf.plage[1]} m²`,
      n: parSurf.pool.length,
      elargi: parSurf.elargi,
    });

    if (etat.p == null) { etat.progression = prog; etat.retenues = parSurf.pool; etat.lecture = null; return; }
    const parP = CMP.filtrerPieces(parSurf.pool, cible);
    prog.push({
      cle: 'pieces',
      libelle: parP.plage[0] === parP.plage[1] ? `${parP.plage[0]} pièces` : `${parP.plage[0]} à ${parP.plage[1]} pièces`,
      n: parP.pool.length,
      elargi: parP.elargi,
    });

    let poolT = parP.pool;
    if (etat.type === 'Maison' && etat.stConnu && etat.st && etat.st > 0) {
      const pt = CMP.filtrerTerrain(parP.pool, cible);
      if (pt.applique) {
        prog.push({
          cle: 'terrain',
          libelle: `terrain de ${pt.plage[0]} à ${pt.plage[1]} m²`,
          n: pt.pool.length,
          elargi: pt.elargi,
        });
        poolT = pt.pool;
      }
    }

    // Sélection finale par score — seulement après que TOUS les critères DVF
    // ont été renseignés.
    const dvfComplet = etat.type != null && etat.sb != null && etat.p != null &&
      (etat.type === 'Appartement' || (etat.type === 'Maison' && etat.stConnu !== undefined));
    if (dvfComplet) {
      const sel = CMP.selectionParScore(poolT, cible);
      prog.push({
        cle: 'score',
        libelle: 'suffisamment ressemblantes',
        n: sel.retenues.length,
        elargi: sel.elargi,
      });
      etat.retenues = sel.retenues;
      etat.lecture = CMP.calculerLecture(sel.retenues);
    } else {
      etat.retenues = poolT;
      etat.lecture = null;
    }
    etat.progression = prog;
  }

  function rendreProgression(etat: Etat, rupture: boolean): string {
    if (!etat.progression.length) return '';
    return `<div class="vr-tun-prog${rupture ? ' vr-tun-prog--gele' : ''}">
      ${etat.progression.map((e, i) => `
        <div class="vr-tun-step" data-cle="${e.cle}">
          <span class="vr-tun-n">${e.n}</span>
          <span class="vr-tun-lbl">${esc(e.libelle)}${e.elargi ? ' <em class="vr-tun-el">· élargi</em>' : ''}</span>
        </div>
      `).join('<div class="vr-tun-fleche" aria-hidden="true">↓</div>')}
    </div>`;
  }

  // Étapes du tunnel — l'ordre définit le parcours. Terrain est conditionnel (maison).
  function etapesActives(etat: Etat): string[] {
    const base = ['type', 'surface', 'pieces'];
    if (etat.type === 'Maison') base.push('terrain');
    base.push('rupture', 'exterieur', 'etat', 'lecture', 'action');
    return base;
  }

  function rendreTunnel(panneau: HTMLElement, etat: Etat, model: any) {
    recalculerProgression(etat);
    const etapes = etapesActives(etat);
    const cle = etapes[etat.step];
    const totalDvf = etapes.indexOf('rupture'); // nb d'étapes DVF avant rupture
    const rupture = etat.step >= totalDvf; // après la rupture, plus de filtres DVF

    // Barre de dots — sur toutes les étapes sauf action (redondant avec le résumé)
    const totalDots = etapes.length - (etapes.includes('action') ? 1 : 0);
    const dots = Array.from({ length: totalDots }, (_, i) =>
      `<span class="vr-tun-dot ${i <= etat.step ? 'is-on' : ''}"></span>`,
    ).join('');

    // Corps de l'étape
    let corps = '';
    if (cle === 'type') corps = ecranType(etat);
    else if (cle === 'surface') corps = ecranSurface(etat);
    else if (cle === 'pieces') corps = ecranPieces(etat);
    else if (cle === 'terrain') corps = ecranTerrain(etat);
    else if (cle === 'rupture') corps = ecranRupture(etat);
    else if (cle === 'exterieur') corps = ecranExterieur(etat);
    else if (cle === 'etat') corps = ecranEtat(etat);
    else if (cle === 'lecture') corps = ecranLecture(etat);
    else if (cle === 'action') corps = ecranAction(etat);

    // Bouton retour, sauf sur la première étape et sur les 2 dernières
    const canBack = etat.step > 0 && cle !== 'lecture' && cle !== 'action';

    panneau.innerHTML = `
      <div class="vr-tun ${rupture ? 'vr-tun--declaratif' : 'vr-tun--dvf'}" id="vr-tun">
        <div class="vr-tun-head">
          <p class="vr-tun-titre">${rupture ? 'CE QUE LES DONNÉES PUBLIQUES NE SAVENT PAS' : 'CE QUE LES VENTES PUBLIQUES PERMETTENT DE COMPARER'}</p>
          <div class="vr-tun-dots">${dots}</div>
        </div>
        ${rendreProgression(etat, rupture)}
        <div class="vr-tun-corps">${corps}</div>
        ${canBack ? '<button type="button" class="vr-tun-back">← Revenir</button>' : ''}
      </div>`;

    // Brancher les interactions selon l'étape
    if (cle === 'type') brancherType(panneau, etat, model);
    else if (cle === 'surface') brancherSurface(panneau, etat, model);
    else if (cle === 'pieces') brancherPieces(panneau, etat, model);
    else if (cle === 'terrain') brancherTerrain(panneau, etat, model);
    else if (cle === 'rupture') brancherRupture(panneau, etat, model);
    else if (cle === 'exterieur') brancherOpts(panneau, etat, model, 'exterieur');
    else if (cle === 'etat') brancherOpts(panneau, etat, model, 'etatDeclare');
    else if (cle === 'lecture') brancherLecture(panneau, etat, model);
    else if (cle === 'action') brancherAction(panneau, etat, model);

    if (canBack) {
      panneau.querySelector<HTMLButtonElement>('.vr-tun-back')!.addEventListener('click', () => {
        etat.step -= 1;
        rendreTunnel(panneau, etat, model);
      });
    }
  }

  // — Étape TYPE ——————————————————————————————————————————————
  function ecranType(etat: Etat): string {
    const isM = etat.type === 'Maison', isA = etat.type === 'Appartement';
    return `
      <p class="vr-tun-q">Quel type de bien décrivez-vous ?</p>
      <div class="vr-tun-opts vr-tun-opts--pair">
        <button type="button" class="vr-tun-opt vr-tun-opt--big${isM ? ' is-chosen' : ''}" data-v="Maison">
          <span class="vr-tun-opt-ico">🏠</span>
          <span class="vr-tun-opt-lbl">Maison</span>
        </button>
        <button type="button" class="vr-tun-opt vr-tun-opt--big${isA ? ' is-chosen' : ''}" data-v="Appartement">
          <span class="vr-tun-opt-ico">🏢</span>
          <span class="vr-tun-opt-lbl">Appartement</span>
        </button>
      </div>`;
  }
  function brancherType(panneau: HTMLElement, etat: Etat, model: any) {
    panneau.querySelectorAll<HTMLButtonElement>('.vr-tun-opt').forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.v as 'Maison' | 'Appartement';
      if (etat.type !== v) {
        // Changement de type → invalide les réponses en aval qui n'ont plus de sens
        etat.type = v;
        // On garde surface/pièces (portables) mais on retire le terrain si on part sur appt
        if (v === 'Appartement') { etat.st = null; etat.stConnu = true; }
      }
      etat.step += 1;
      rendreTunnel(panneau, etat, model);
    }));
  }

  // — Étape SURFACE ——————————————————————————————————————————————
  function ecranSurface(etat: Etat): string {
    return `
      <p class="vr-tun-q">Quelle surface habitable ?</p>
      <p class="vr-tun-sub">La surface loi Carrez pour un appartement, la surface habitable pour une maison.</p>
      <div class="vr-tun-champ vr-tun-champ--num">
        <input type="number" inputmode="numeric" min="8" max="600" step="1" id="vr-tun-sb" class="vr-tun-input" placeholder="ex. 92" value="${etat.sb ?? ''}" />
        <span class="vr-tun-unite">m²</span>
      </div>
      <p class="vr-tun-err" id="vr-tun-err" hidden></p>
      <button type="button" class="vr-tun-next" id="vr-tun-next">Continuer →</button>`;
  }
  function brancherSurface(panneau: HTMLElement, etat: Etat, model: any) {
    const input = panneau.querySelector<HTMLInputElement>('#vr-tun-sb')!;
    const err = panneau.querySelector<HTMLElement>('#vr-tun-err')!;
    const next = panneau.querySelector<HTMLButtonElement>('#vr-tun-next')!;
    const valider = () => {
      const v = Number(input.value);
      if (!Number.isFinite(v) || v < 8 || v > 600) {
        err.textContent = 'Une surface entre 8 et 600 m².'; err.hidden = false; return;
      }
      err.hidden = true;
      etat.sb = Math.round(v);
      etat.step += 1;
      rendreTunnel(panneau, etat, model);
    };
    next.addEventListener('click', valider);
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); valider(); } });
    input.focus();
  }

  // — Étape PIÈCES ——————————————————————————————————————————————
  function ecranPieces(etat: Etat): string {
    const opts = [1, 2, 3, 4, 5, 6, 7];
    const isChosen = (n: number) => (etat.p === n || (n === 7 && etat.p && etat.p >= 7)) ? ' is-chosen' : '';
    return `
      <p class="vr-tun-q">Combien de pièces principales ?</p>
      <p class="vr-tun-sub">Chambres et pièces à vivre — cuisine, salle de bain et WC ne comptent pas.</p>
      <div class="vr-tun-opts vr-tun-opts--grille">
        ${opts.map((n) => `<button type="button" class="vr-tun-opt vr-tun-opt--num${isChosen(n)}" data-v="${n}">${n === 7 ? '7+' : n}</button>`).join('')}
      </div>`;
  }
  function brancherPieces(panneau: HTMLElement, etat: Etat, model: any) {
    panneau.querySelectorAll<HTMLButtonElement>('.vr-tun-opt').forEach((b) => b.addEventListener('click', () => {
      etat.p = Number(b.dataset.v);
      etat.step += 1;
      rendreTunnel(panneau, etat, model);
    }));
  }

  // — Étape TERRAIN (maison seulement) ——————————————————————————
  function ecranTerrain(etat: Etat): string {
    return `
      <p class="vr-tun-q">Surface de terrain ?</p>
      <p class="vr-tun-sub">Si vous ne connaissez pas cette valeur, dites-le simplement — nous n'inventerons rien à sa place.</p>
      <div class="vr-tun-champ vr-tun-champ--num">
        <input type="number" inputmode="numeric" min="10" max="20000" step="10" id="vr-tun-st" class="vr-tun-input" placeholder="ex. 400" value="${etat.stConnu && etat.st ? etat.st : ''}" />
        <span class="vr-tun-unite">m²</span>
      </div>
      <p class="vr-tun-err" id="vr-tun-err" hidden></p>
      <div class="vr-tun-actions">
        <button type="button" class="vr-tun-next" id="vr-tun-next">Continuer →</button>
        <button type="button" class="vr-tun-skip" id="vr-tun-skip">Je ne sais pas — passer</button>
      </div>`;
  }
  function brancherTerrain(panneau: HTMLElement, etat: Etat, model: any) {
    const input = panneau.querySelector<HTMLInputElement>('#vr-tun-st')!;
    const err = panneau.querySelector<HTMLElement>('#vr-tun-err')!;
    const next = panneau.querySelector<HTMLButtonElement>('#vr-tun-next')!;
    const skip = panneau.querySelector<HTMLButtonElement>('#vr-tun-skip')!;
    next.addEventListener('click', () => {
      const v = Number(input.value);
      if (!Number.isFinite(v) || v < 10 || v > 20000) {
        err.textContent = 'Une surface de terrain entre 10 et 20 000 m² — ou choisissez « je ne sais pas ».';
        err.hidden = false; return;
      }
      err.hidden = true;
      etat.st = Math.round(v); etat.stConnu = true;
      etat.step += 1; rendreTunnel(panneau, etat, model);
    });
    skip.addEventListener('click', () => {
      etat.st = null; etat.stConnu = false;
      etat.step += 1; rendreTunnel(panneau, etat, model);
    });
    input.focus();
  }

  // — Rupture (écran de transition explicative) —————————————————
  function ecranRupture(etat: Etat): string {
    const n = etat.lecture?.n ?? etat.retenues.length;
