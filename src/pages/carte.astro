---
/**
 * /carte — landing dédiée au QR code de la carte de visite de Mouaad.
 *
 * URL protégée (imprimée sur support physique) : ne jamais supprimer, renommer
 * ni rediriger sans validation explicite.
 *
 * Rôle : prolonger la rencontre amorcée par la carte de visite. Page courte,
 * personnelle, pensée mobile d'abord (trafic quasi exclusivement QR). Elle ne
 * reproduit pas la homepage : retrouver Mouaad → comprendre sa manière de
 * travailler → aller plus loin (diagnostic ou contact).
 *
 * Les paramètres d'URL (?src=carte…) passent naturellement : page statique,
 * ils n'altèrent pas le rendu.
 */
import Layout from '../layouts/Layout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { site } from '../config/site';

const points = [
  {
    titre: 'Lire votre marché local',
    texte: 'Les ventes réelles autour de chez vous, pas une moyenne abstraite.',
  },
  {
    titre: 'Comprendre avant de décider',
    texte: 'On distingue les signaux observés des suppositions. Toujours dans cet ordre.',
  },
  {
    titre: 'Un regard humain sur votre situation',
    texte: 'Votre bien n’est pas un cas générique. Il mérite une lecture, pas une recette.',
  },
];
---

<Layout
  title="À Lèves, je commence par écouter"
  description="Mouaad Boullourou, conseiller immobilier SAFTI à Lèves et alentours. Une lecture du marché local avant toute proposition."
  headerTransparent={false}
>
  <!-- Accueil : reconnaissance immédiate -->
  <section class="carte-hero">
    <div class="max-w-page mx-auto px-edge md:px-edge-md grid md:grid-cols-12 gap-8 md:gap-12 items-center">
      <div class="md:col-span-6 order-2 md:order-1 fade-up">
        <p class="eyebrow mb-4">À Lèves</p>
        <h1 class="carte-titre text-encre">À&nbsp;Lèves, je commence par écouter.</h1>
        <p class="font-sans text-body-lg text-brun mt-5 max-w-md">
          Habitant du quartier, j’accompagne vos projets immobiliers
          avec une connaissance fine du terrain.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="/situer-ma-vente?src=carte" class="btn-primaire">Situer ma vente</a>
          <a href="/contact" class="btn-secondaire">Me contacter</a>
        </div>
      </div>
      <div class="md:col-span-6 order-1 md:order-2 fade-up">
        <div class="carte-portrait">
          <ResponsiveImage
            slot="mouaad-terrain"
            ratio="4/5"
            priority={true}
            loading="eager"
            sizes="(min-width:768px) 46vw, 92vw"
            class="w-full h-full"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Qui est Mouaad -->
  <section class="max-w-editorial mx-auto px-edge md:px-edge-md py-section md:py-section-md">
    <div class="fade-up">
      <p class="eyebrow mb-4">La continuité humaine</p>
      <h2 class="text-h2 text-encre mb-5">{site.mouaad.nom}</h2>
      <div class="space-y-4 font-sans text-body-lg text-encre/85 leading-relaxed">
        <p>
          Je suis Mouaad Boullourou, conseiller immobilier SAFTI à Lèves et alentours.
          Ma manière de travailler tient en quatre verbes :
          écouter, reformuler, comprendre — puis seulement décider.
        </p>
        <p>
          La lecture précède toujours la proposition. C’est le principe de LEVOIS,
          ma méthode de lecture du marché et d’accompagnement.
        </p>
      </div>
      <p class="font-sans text-sm text-brun border-l-2 border-argile/60 pl-4 mt-6">
        {site.mouaad.signature}
      </p>
      <a href="/mouaad" class="inline-flex items-center gap-1.5 font-sans text-argile font-medium mt-6 hover:text-encre transition-colors">
        Faire connaissance
        <svg width="15" height="15" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>

  <!-- Ce qu'apporte LEVOIS -->
  <section class="carte-apports">
    <div class="max-w-page mx-auto px-edge md:px-edge-md">
      <div class="grid md:grid-cols-3 gap-5 md:gap-6">
        {points.map((p, i) => (
          <div class="carte-apport fade-up" style={`transition-delay:${i * 80}ms`}>
            <span class="carte-apport-n" aria-hidden="true">0{i + 1}</span>
            <h3 class="font-display text-xl text-papier mb-2">{p.titre}</h3>
            <p class="font-sans text-[15px] leading-relaxed text-papier/70">{p.texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- La méthode en une phrase -->
  <section class="max-w-editorial mx-auto px-edge md:px-edge-md py-section md:py-section-md text-center">
    <blockquote class="fade-up">
      <p class="font-display text-2xl md:text-3xl text-encre leading-snug" style="font-variation-settings:'opsz' 40;">
        « Un bien ne se compare pas à un marché abstrait.
        Il se compare aux alternatives visibles, ici, maintenant. »
      </p>
    </blockquote>
    <a href="/methode" class="inline-flex items-center gap-1.5 font-sans text-argile font-medium mt-6 hover:text-encre transition-colors fade-up">
      Le Système des Écarts
      <svg width="15" height="15" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </section>

  <!-- Double CTA final -->
  <section class="max-w-page mx-auto px-edge md:px-edge-md pb-section md:pb-section-md">
    <div class="carte bg-argile-pale/40 p-7 md:p-10 text-center fade-up">
      <h2 class="font-display text-2xl md:text-3xl text-encre mb-3">Par où commencer ?</h2>
      <p class="font-sans text-body-lg text-brun max-w-lg mx-auto mb-7">
        Le diagnostic « Situer ma vente » me transmet tout votre contexte en trois minutes,
        sans coordonnées. Ou écrivez-moi directement.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/situer-ma-vente?src=carte" class="btn-primaire">Situer ma vente</a>
        <a href={`tel:${site.phone}`} class="btn-secondaire">{site.phoneDisplay}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .carte-hero { padding-top: 2.5rem; }
  @media (min-width: 768px) { .carte-hero { padding-top: 4rem; } }

  .carte-titre {
    font-family: 'Public Sans', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(2.3rem, 6.5vw, 4rem);
    line-height: 1.05; letter-spacing: -0.02em;
  }
  .carte-portrait {
    border-radius: 0; overflow: hidden;
    border: 1px solid #C9CEC8;
    max-width: 420px; margin-inline: auto;
  }
  @media (min-width: 768px) { .carte-portrait { margin-inline: 0 0 0 auto; } }

  .carte-apports {
    background: #111522;
    padding: 3.5rem 0;
  }
  @media (min-width: 768px) { .carte-apports { padding: 5rem 0; } }
  .carte-apport {
    border-top: 1px solid rgba(242, 245, 239, 0.22);
    padding-top: 1.25rem;
  }
  .carte-apport-n {
    display: block;
    font-family: 'Public Sans', system-ui, sans-serif;
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.14em;
    color: #D7FF42; margin-bottom: 1rem;
  }
</style>
