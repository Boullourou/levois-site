---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Mouaad Boullourou — Conseiller immobilier à Lèves"
  description="Les vrais chiffres de l'immobilier à Lèves, données notaires, et une réponse à chaque question. Mouaad Boullourou, conseiller SAFTI."
>

  <article class="max-w-xl mx-auto px-edge md:px-edge-md pt-section md:pt-section-md pb-section-md">

    <!-- 1. ACCROCHE -->
    <header class="mb-8 fade-up">
      <h1 class="text-hero text-sapin leading-[0.95] mb-5">
        Bonjour,<br/>
        <em class="font-normal italic text-sapin-deep">c'est Mouaad.</em>
      </h1>
      <span class="rule-ocre"></span>
      <p class="text-body-lg text-muted mt-6">
        Conseiller immobilier à Lèves. Les vrais chiffres du secteur —
        et une réponse à chaque question, même la plus simple.
      </p>
    </header>

    <!-- 2. LE DON UNIVERSEL — STATS VISIBLES DIRECT -->
    <section class="mb-6 fade-up">
      <div class="bg-sapin text-cream rounded-md p-6 md:p-8">
        <div class="text-eyebrow uppercase tracking-widest text-ocre-soft mb-4">
          Ventes réelles · données notaires · 2024-2025
        </div>

        <!-- Grille de chiffres -->
        <div class="grid grid-cols-3 gap-4 mb-5">
          <div>
            <div class="text-h2 leading-none">121</div>
            <div class="text-[12px] opacity-70 mt-1 leading-tight">ventes enregistrées</div>
          </div>
          <div>
            <!-- À COMPLÉTER : prix médian maison depuis /votre-rue -->
            <div class="text-h2 leading-none">[XXX k€]</div>
            <div class="text-[12px] opacity-70 mt-1 leading-tight">maison médiane (75 ventes)</div>
          </div>
          <div>
            <!-- À COMPLÉTER : prix médian appartement depuis /votre-rue -->
            <div class="text-h2 leading-none">[X XXX €/m²]</div>
            <div class="text-[12px] opacity-70 mt-1 leading-tight">appartement (46 ventes)</div>
          </div>
        </div>

        <a
          href="/votre-rue"
          class="inline-flex items-center gap-2 bg-cream text-sapin px-6 py-3 rounded-full hover:bg-cream-soft transition-colors text-[15px] font-medium"
        >
          Voir les prix de votre rue
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
        </a>
        <p class="text-[12px] opacity-70 mt-3">Gratuit, sans inscription. Secteur par secteur.</p>
      </div>
    </section>

    <!-- 3. INVITE À ALLER PLUS LOIN -->
    <section class="mb-6 fade-up">
      <p class="text-[15px] text-muted leading-relaxed">
        Ces chiffres ne suffisent pas&nbsp;? Dites-moi votre cas —
        je réponds à chaque demande, même si c'est juste une question.
      </p>
    </section>

    <!-- 4. SÉLECTION DE PROFIL -->
    <section class="mb-8 fade-up">
      <div class="grid grid-cols-2 gap-3" id="profil-buttons">
        <button
          data-profil="vendre"
          class="profil-btn text-left border border-beige rounded-md px-4 py-4 bg-cream hover:bg-cream-soft transition-colors"
        >
          <span class="block text-xl mb-1">🏠</span>
          <span class="profil-label block text-[14px] font-medium text-sapin leading-snug">Je veux vendre</span>
        </button>
        <button
          data-profil="acheter"
          class="profil-btn text-left border border-beige rounded-md px-4 py-4 bg-cream hover:bg-cream-soft transition-colors"
        >
          <span class="block text-xl mb-1">🔍</span>
          <span class="profil-label block text-[14px] font-medium text-sapin leading-snug">Je cherche à acheter</span>
        </button>
        <button
          data-profil="recommander"
          class="profil-btn text-left border border-beige rounded-md px-4 py-4 bg-cream hover:bg-cream-soft transition-colors"
        >
          <span class="block text-xl mb-1">👥</span>
          <span class="profil-label block text-[14px] font-medium text-sapin leading-snug">Je connais quelqu'un</span>
        </button>
        <button
          data-profil="metier"
          class="profil-btn text-left border border-beige rounded-md px-4 py-4 bg-cream hover:bg-cream-soft transition-colors"
        >
          <span class="block text-xl mb-1">✨</span>
          <span class="profil-label block text-[14px] font-medium text-sapin leading-snug">Le métier m'intéresse</span>
        </button>
      </div>
    </section>

    <!-- 5. BLOCS PROFIL -->

    <!-- PROFIL A — VENDRE -->
    <section id="bloc-vendre" class="profil-bloc hidden mb-10 fade-up">
      <p class="text-[15px] text-sapin leading-relaxed mb-5">
        Avant de mettre en vente&nbsp;: ce qui part vraiment dans votre rue,
        à quel prix, en combien de temps. Je vous le dis sans détour,
        même si ce n'est pas ce que vous espériez.
      </p>
      <div class="border border-beige rounded-md p-6 bg-cream-soft">
        <form action="https://formspree.io/f/xnjynroj" method="POST" class="space-y-4">
          <input type="hidden" name="_subject" value="Contact carte — Vendeur" />
          <input type="hidden" name="_next" value="https://levois.fr/merci" />
          <input type="hidden" name="profil" value="Je veux vendre" />
          <div class="grid sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="text-eyebrow uppercase text-muted">Prénom *</span>
              <input type="text" name="prenom" required class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin text-[16px]" />
            </label>
            <label class="block">
              <span class="text-eyebrow uppercase text-muted">Email ou téléphone *</span>
              <input type="text" name="contact" required class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin text-[16px]" />
            </label>
          </div>
          <label class="block">
            <span class="text-eyebrow uppercase text-muted">Votre rue, ou votre question (facultatif)</span>
            <input type="text" name="message" placeholder="ex : combien vaut une maison rue du Moulin ?" class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin text-[16px]" />
          </label>
          <button type="submit" class="inline-flex items-center gap-3 bg-sapin text-cream px-7 py-3.5 rounded-full hover:bg-sapin-deep transition-colors text-[15px]">
            Envoyer
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
          </button>
          <p class="text-[12px] text-muted leading-relaxed">C'est moi qui réponds, sous 24h. Un échange, rien de plus.</p>
        </form>
      </div>
    </section>

    <!-- PROFIL B — ACHETER -->
    <section id="bloc-acheter" class="profil-bloc hidden mb-10 fade-up">
      <p class="text-[15px] text-sapin leading-relaxed mb-5">
        Je vois passer des biens avant leur mise en ligne. Dites-moi ce que
        vous cherchez&nbsp;: je vous fais signe quand ça colle, et seulement
        à ce moment-là.
      </p>
      <div class="border border-beige rounded-md p-6 bg-cream-soft">
        <form action="https://formspree.io/f/xnjynroj" method="POST" class="space-y-4">
          <input type="hidden" name="_subject" value="Contact carte — Acheteur" />
          <input type="hidden" name="_next" value="https://levois.fr/merci" />
          <input type="hidden" name="profil" value="Je cherche à acheter" />
          <div class="grid sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="text-eyebrow uppercase text-muted">Prénom *</span>
              <input type="text" name="prenom" required class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin text-[16px]" />
            </label>
            <label class="block">
              <span class="text-eyebrow uppercase text-muted">Email ou téléphone *</span>
              <input type="text" name="contact" required class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin text-[16px]" />
            </label>
          </div>
          <label class="block">
            <span class="text-eyebrow uppercase text-muted">Ce que vous cherchez, ou votre question (facultatif)</span>
            <input type="text" name="message" placeholder="ex : maison avec jardin, Lèves ou Champhol…" class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin text-[16px]" />
          </label>
          <button type="submit" class="inline-flex items-center gap-3 bg-sapin text-cream px-7 py-3.5 rounded-full hover:bg-sapin-deep transition-colors text-[15px]">
            Envoyer
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
          </button>
          <p class="text-[12px] text-muted leading-relaxed">C'est moi qui réponds, sous 24h. Un échange, rien de plus.</p>
        </form>
      </div>
    </section>

    <!-- PROFIL C — RECOMMANDER -->
    <section id="bloc-recommander" class="profil-bloc hidden mb-10 fade-up">
      <p class="text-[15px] text-sapin leading-relaxed mb-5">
        Un proche vend, achète, ou hésite&nbsp;? Présentez-le-moi.
        Je m'en occupe avec soin, et je vous tiens au courant.
      </p>
      <div class="border border-beige rounded-md p-6 bg-cream-soft">
        <form action="https://formspree.io/f/xnjynroj" method="POST" class="space-y-4">
          <input type="hidden" name="_subject" value="Contact carte — Recommandation" />
          <input type="hidden" name="_next" value="https://levois.fr/merci" />
          <input type="hidden" name="profil" value="Je connais quelqu'un" />
          <label class="block">
            <span class="text-eyebrow uppercase text-muted">Votre prénom *</span>
            <input type="text" name="prenom" required placeholder="Pour que je puisse mentionner qui vous envoie" class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin text-[16px]" />
          </label>
          <label class="block">
            <span class="text-eyebrow uppercase text-muted">Prénom du proche *</span>
            <input type="text" name="proche_prenom" required class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin text-[16px]" />
          </label>
          <label class="block">
            <span class="text-eyebrow uppercase text-muted">Numéro ou email du proche *</span>
            <input type="text" name="proche_contact" required class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin text-[16px]" />
          </label>
          <label class="block">
            <span class="text-eyebrow uppercase text-muted">Sa situation en quelques mots (facultatif)</span>
            <input type="text" name="message" placeholder="vente, achat, autre…" class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin text-[16px]" />
          </label>
          <button type="submit" class="inline-flex items-center gap-3 bg-sapin text-cream px-7 py-3.5 rounded-full hover:bg-sapin-deep transition-colors text-[15px]">
            Envoyer
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
          </button>
          <p class="text-[12px] text-muted leading-relaxed">Je le contacte sous 24h en mentionnant votre prénom. Un échange, rien de plus.</p>
          <p class="text-[11px] text-muted leading-relaxed border-t border-beige pt-3">En soumettant ce formulaire, vous confirmez avoir l'accord de votre proche pour transmettre ses coordonnées.</p>
        </form>
      </div>
    </section>

    <!-- PROFIL D — MÉTIER -->
    <section id="bloc-metier" class="profil-bloc hidden mb-10 fade-up">
      <p class="text-[15px] text-sapin leading-relaxed mb-5">
        Vous vous demandez à quoi ressemble ce métier, fait proprement&nbsp;?
        Je vous montre comment je travaille. On en parle, juste pour voir.
      </p>
      <div class="border border-beige rounded-md p-6 bg-cream-soft">
        <form action="https://formspree.io/f/xnjynroj" method="POST" class="space-y-4">
          <input type="hidden" name="_subject" value="Contact carte — Métier" />
          <input type="hidden" name="_next" value="https://levois.fr/merci" />
          <input type="hidden" name="profil" value="Le métier m'intéresse" />
          <div class="grid sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="text-eyebrow uppercase text-muted">Prénom *</span>
              <input type="text" name="prenom" required class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin text-[16px]" />
            </label>
            <label class="block">
              <span class="text-eyebrow uppercase text-muted">Email ou téléphone *</span>
              <input type="text" name="contact" required class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin text-[16px]" />
            </label>
          </div>
          <label class="block">
            <span class="text-eyebrow uppercase text-muted">Votre situation actuelle, ou votre question (facultatif)</span>
            <input type="text" name="message" placeholder="ex : en reconversion, curieux, déjà dans l'immo…" class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin text-[16px]" />
          </label>
          <button type="submit" class="inline-flex items-center gap-3 bg-sapin text-cream px-7 py-3.5 rounded-full hover:bg-sapin-deep transition-colors text-[15px]">
            Envoyer
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
          </button>
          <p class="text-[12px] text-muted leading-relaxed">C'est moi qui réponds, sous 24h. Un échange, rien de plus.</p>
        </form>
      </div>
    </section>

    <!-- 6. ANCRE FINALE + CONTACT DIRECT -->
    <section class="fade-up pt-8 border-t border-beige">
      <p class="text-[15px] text-sapin leading-relaxed mb-6">
        Que vous me contactiez ou non, vous repartez avec les vrais chiffres.
        C'est déjà ça.
      </p>
      <p class="text-[15px] text-muted mb-4">Pour me joindre directement&nbsp;:</p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href="tel:+33781380121"
          class="inline-flex items-center gap-2 text-sapin hover:text-sapin-deep transition-colors text-[15px]"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.68A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          07 81 38 01 21
        </a>
        <span class="hidden sm:block text-muted">·</span>
        <a
          href="mailto:mouaad@levois.fr"
          class="inline-flex items-center gap-2 text-sapin hover:text-sapin-deep transition-colors text-[15px]"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          mouaad@levois.fr
        </a>
      </div>
    </section>

  </article>

  <script>
    const buttons = document.querySelectorAll('.profil-btn');
    const blocs = document.querySelectorAll('.profil-bloc');

    const BTN_ACTIVE = ['bg-sapin', 'border-sapin'];
    const BTN_INACTIVE = ['bg-cream', 'border-beige'];

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const profil = btn.getAttribute('data-profil');

        buttons.forEach((b) => {
          BTN_ACTIVE.forEach((c) => b.classList.remove(c));
          BTN_INACTIVE.forEach((c) => b.classList.add(c));
          const label = b.querySelector('.profil-label');
          label.classList.remove('text-cream');
          label.classList.add('text-sapin');
        });

        BTN_INACTIVE.forEach((c) => btn.classList.remove(c));
        BTN_ACTIVE.forEach((c) => btn.classList.add(c));
        const activeLabel = btn.querySelector('.profil-label');
        activeLabel.classList.remove('text-sapin');
        activeLabel.classList.add('text-cream');

        blocs.forEach((b) => b.classList.add('hidden'));

        const target = document.getElementById(`bloc-${profil}`);
        if (target) {
          target.classList.remove('hidden');
          setTimeout(() => {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 50);
        }

        if (typeof window.gtag === 'function') {
          window.gtag('event', 'profil_select', { profil_type: profil });
        }
      });
    });

    const params = new URLSearchParams(window.location.search);
    const src = params.get('src');
    if (src) {
      document.querySelectorAll('input[name="_subject"]').forEach((input) => {
        input.value += ` [src:${src}]`;
      });
    }
  </script>

</Layout>
