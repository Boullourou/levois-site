const { commune } = Astro.props;
const pageTitle = `Prix m² & Ventes Notariées DVF à ${commune.name} (${commune.postalCode})`;
const pageDesc = `Consultez les prix réels au m² signés chez les notaires (DVF) à ${commune.name} (${commune.postalCode}). Historique complet 2021-2025, médianes maisons et appartements, analyse de marché et diagnostics avec Mouaad Boullourou.`;
---

<Layout title={pageTitle} description={pageDesc}>
  <div class="w" style="padding-top:110px;padding-bottom:80px;">
    <!-- BREADCRUMB -->
    <nav aria-label="Fil d'Ariane" style="font-size:13px;color:rgba(19,42,34,0.7);margin-bottom:24px;">
      <a href="/" style="text-decoration:underline;">Accueil</a>
      <span style="margin:0 8px;">›</span>
      <a href="/votre-rue/" style="text-decoration:underline;">Observatoire Notarié</a>
      <span style="margin:0 8px;">›</span>
      <span style="font-weight:700;color:var(--ink);">{commune.name}</span>
    </nav>

    <!-- HEADER DE PAGE -->
    <header style="max-width:820px;margin-bottom:44px;">
      <span class="ey" style="color:var(--or);display:inline-block;margin-bottom:12px;">Données Notariales Officielles (DVF)</span>
      <h1 style="font-size:clamp(34px,4.5vw,56px);line-height:1.1;margin-bottom:18px;">
        Prix immobilier au m² à {commune.name} <span style="color:var(--or);">({commune.postalCode})</span>
      </h1>
      <p style="font-size:18px;line-height:1.6;color:var(--ink-light);">
        {commune.description}
      </p>
    </header>

    <!-- BLOC SYNTHÈSE CHIFFRÉE EN DUR -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;margin-bottom:48px;">
      <!-- CARTE MAISONS -->
      <div style="background:#fff;border:1px solid rgba(19,42,34,0.12);border-radius:18px;padding:32px;box-shadow:0 10px 30px rgba(19,42,34,0.04);">
        <span style="font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:0.8px;color:var(--or);display:block;margin-bottom:8px;">Maisons · Année 2025</span>
        <div style="font-size:42px;font-weight:800;color:var(--ink);line-height:1;margin-bottom:10px;">
          {commune.maison.median2025} <span style="font-size:20px;font-weight:600;">€/m²</span>
        </div>
        <p style="font-size:14px;color:var(--ink-light);margin-bottom:16px;">
          Prix médian constaté sur <b>{commune.maison.count2025} ventes</b> notariées en 2025 ({commune.maison.totalCount} ventes enregistrées sur 5 ans).
        </p>
        <div style="background:var(--pa);padding:12px 16px;border-radius:10px;font-size:13px;color:var(--ink);">
          <b>Fourchette 50 % des ventes :</b><br/>
          {commune.maison.q1} €/m² à {commune.maison.q3} €/m²
        </div>
      </div>

      <!-- CARTE APPARTEMENTS -->
      {commune.appartement && (
        <div style="background:#fff;border:1px solid rgba(19,42,34,0.12);border-radius:18px;padding:32px;box-shadow:0 10px 30px rgba(19,42,34,0.04);">
          <span style="font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:0.8px;color:var(--ink);display:block;margin-bottom:8px;">Appartements · Année 2025</span>
          <div style="font-size:42px;font-weight:800;color:var(--ink);line-height:1;margin-bottom:10px;">
            {commune.appartement.median2025} <span style="font-size:20px;font-weight:600;">€/m²</span>
          </div>
          <p style="font-size:14px;color:var(--ink-light);margin-bottom:16px;">
            Prix médian constaté sur <b>{commune.appartement.count2025} ventes</b> notariées en 2025 ({commune.appartement.totalCount} ventes enregistrées sur 5 ans).
          </p>
          <div style="background:var(--pa);padding:12px 16px;border-radius:10px;font-size:13px;color:var(--ink);">
            <b>Fourchette 50 % des ventes :</b><br/>
            {commune.appartement.q1} €/m² à {commune.appartement.q3} €/m²
          </div>
        </div>
      )}
    </div>

    <!-- TABLEAU HISTORIQUE 5 ANS MAISONS -->
    <section style="background:#fff;border:1px solid rgba(19,42,34,0.12);border-radius:20px;padding:36px;margin-bottom:48px;">
      <h2 style="font-size:24px;margin-bottom:12px;">Historique des ventes notariées de maisons à {commune.name} (2021-2025)</h2>
      <p style="font-size:15px;color:var(--ink-light);margin-bottom:24px;">Données brutes issues de la base officielle DVF (DGFiP / Etalab).</p>
      
      <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:14px;text-align:left;">
          <thead>
            <tr style="border-bottom:2px solid var(--ink);color:var(--ink);">
              <th style="padding:12px;">Année</th>
              <th style="padding:12px;">Nombre de ventes</th>
              <th style="padding:12px;">Prix médian au m²</th>
              <th style="padding:12px;">1er quartile (25%)</th>
              <th style="padding:12px;">3e quartile (75%)</th>
            </tr>
          </thead>
          <tbody>
            {commune.maison.history.map(row => (
              <tr style="border-bottom:1px solid rgba(19,42,34,0.08);">
                <td style="padding:12px;font-weight:700;">{row.year}</td>
                <td style="padding:12px;">{row.count}</td>
                <td style="padding:12px;font-weight:700;color:var(--or);">{row.median} €/m²</td>
                <td style="padding:12px;">{row.q1} €/m²</td>
                <td style="padding:12px;">{row.q3} €/m²</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- TABLEAU HISTORIQUE 5 ANS APPARTEMENTS -->
    {commune.appartement && (
      <section style="background:#fff;border:1px solid rgba(19,42,34,0.12);border-radius:20px;padding:36px;margin-bottom:48px;">
        <h2 style="font-size:24px;margin-bottom:12px;">Historique des ventes notariées d'appartements à {commune.name} (2021-2025)</h2>
        <p style="font-size:15px;color:var(--ink-light);margin-bottom:24px;">Données brutes issues de la base officielle DVF (DGFiP / Etalab).</p>
        
        <div style="overflow-x:auto;">
          <table style="width:100%;border-collapse:collapse;font-size:14px;text-align:left;">
            <thead>
              <tr style="border-bottom:2px solid var(--ink);color:var(--ink);">
                <th style="padding:12px;">Année</th>
                <th style="padding:12px;">Nombre de ventes</th>
                <th style="padding:12px;">Prix médian au m²</th>
                <th style="padding:12px;">1er quartile (25%)</th>
                <th style="padding:12px;">3e quartile (75%)</th>
              </tr>
            </thead>
            <tbody>
              {commune.appartement.history.map(row => (
                <tr style="border-bottom:1px solid rgba(19,42,34,0.08);">
                  <td style="padding:12px;font-weight:700;">{row.year}</td>
                  <td style="padding:12px;">{row.count}</td>
                  <td style="padding:12px;font-weight:700;color:var(--ink);">{row.median} €/m²</td>
                  <td style="padding:12px;">{row.q1} €/m²</td>
                  <td style="padding:12px;">{row.q3} €/m²</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <!-- ANALYSE ÉDITORIALE DÉTAILLÉE : COMPRENDRE LES ÉCARTS DE PRIX À LA COMMUNE -->
    <article style="background:#fff;border:1px solid rgba(19,42,34,0.12);border-radius:20px;padding:44px;margin-bottom:48px;line-height:1.7;color:var(--ink);">
      <h2 style="font-size:26px;margin-bottom:18px;">Comment analyser les prix de l'immobilier à {commune.name} ?</h2>
      <p style="margin-bottom:16px;">
        À {commune.name} ({commune.postalCode}), le prix médian au m² ne constitue pas un tarif figé, mais un repère statistique central. La dispersion entre le premier quartile (les 25 % des biens les plus abordables) et le troisième quartile (les 25 % les plus onéreux) s'explique par des critères tangibles et vérifiables sur le terrain.
      </p>
      
      <h3 style="font-size:20px;margin-top:28px;margin-bottom:12px;color:var(--or);">1. L'état du bâti et le diagnostic de performance énergétique (DPE)</h3>
      <p style="margin-bottom:16px;">
        La performance énergétique est devenue un facteur de négociation majeur sur le bassin chartrain. Une maison classée F ou G subit une décote directe liée au coût estimé des travaux d'isolation et de chauffage, tandis qu'un bien classé C ou D sans travaux se positionne naturellement dans le quartile supérieur du marché local.
      </p>

      <h3 style="font-size:20px;margin-top:28px;margin-bottom:12px;color:var(--or);">2. L'emplacement micro-local, le calme et les accès</h3>
      <p style="margin-bottom:16px;">
        Au sein même de {commune.name}, deux biens identiques peuvent afficher un écart de valeur substantiel selon leur rue, la proximité immédiate des écoles, des commerces de quartier ou des arrêts de bus de la métropole. L'absence de nuisances sonores et la qualité du voisinage immédiat pèsent lourdement sur la décision finale des acquéreurs.
      </p>

      <h3 style="font-size:20px;margin-top:28px;margin-bottom:12px;color:var(--or);">3. La distinction entre une vente DVF passée et votre projet actuel</h3>
      <p style="margin-bottom:0;">
        Les chiffres présentés ci-dessus reflètent des actes notariés signés. Ils ne capturent ni les négociations en cours, ni les finitions intérieures de votre bien, ni les conditions d'emprunt bancaire actuelles des acheteurs. Pour fixer un prix de vente juste sans risquer de brader ni de bloquer son bien pendant des mois, un diagnostic méthodique de votre situation est indispensable.
      </p>
    </article>

    <!-- SECTION DIAGNOSTIC ET PRISE DE DÉCISION -->
    <section style="background:var(--pa);border:1px solid rgba(19,42,34,0.12);border-radius:20px;padding:44px;margin-bottom:48px;">
      <span class="ey" style="color:var(--or);margin-bottom:8px;display:inline-block;">Aide à la décision locale</span>
      <h2 style="font-size:clamp(28px,3.5vw,42px);margin-bottom:16px;">Vous avez un projet immobilier à {commune.name} ?</h2>
      <p style="font-size:16px;line-height:1.6;color:var(--ink-light);max-width:680px;margin-bottom:32px;">
        Les médianes notariales donnent un repère de marché, mais elles ne mesurent ni les travaux intérieurs, ni l'exposition, ni la négociation en cours. Utilisez nos diagnostics gratuits pour clarifier votre situation :
      </p>

      <div style="display:flex;gap:16px;flex-wrap:wrap;">
        <a class="pill" href="/situer-ma-vente/">
          <span>Faire le diagnostic de ma vente à {commune.name}</span>
          <i>→</i>
        </a>
        <a class="pill pill-dark" href="/ma-recherche/">
          <span>Clarifier ma recherche d'achat</span>
          <i>→</i>
        </a>
        <a class="pill pill-outline" href="/vendre-et-acheter/">
          <span>Vente et achat simultanés</span>
          <i>→</i>
        </a>
      </div>
    </section>

    <!-- CARTE CONTACT MOUAAD -->
    <section style="background:#fff;border:1px solid rgba(19,42,34,0.12);border-radius:20px;padding:36px;display:flex;align-items:center;gap:32px;flex-wrap:wrap;">
      <div style="width:90px;height:90px;border-radius:50%;overflow:hidden;flex-shrink:0;background:var(--ink);">
        <img src="/v7/asset-07.webp" alt="Mouaad Boullourou" style="width:100%;height:100%;object-fit:cover;">
      </div>
      <div style="flex:1;min-width:260px;">
        <h3 style="font-size:20px;margin-bottom:4px;">Mouaad Boullourou</h3>
        <p style="font-size:14px;color:var(--or);font-weight:700;margin-bottom:6px;">Conseiller immobilier indépendant SAFTI · Basé à Lèves (28300)</p>
        <p style="font-size:14px;color:var(--ink-light);margin:0;">
          Un doute sur les prix réels ou sur la faisabilité de votre projet à {commune.name} ? Échangeons librement sans engagement.
        </p>
      </div>
      <div style="display:flex;gap:12px;align-items:center;flex-shrink:0;">
        <a class="pill" href="/contact/">Écrire à Mouaad <i>→</i></a>
        <a class="ph" href="tel:+33781380121">07 81 38 01 21</a>
      </div>
    </section>
  </div>
</Layout>
