---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';


const designContract = "Identité LEVOIS validée : Satoshi, quartier, cobalt. Résultat avant contact.";

const faq = [
  {
    q: 'Que se passe-t-il si le portail bloque la lecture ?',
    a: 'Ce n’est pas une erreur de votre lien. Certains sites refusent qu’un autre service lise leurs pages. Le même questionnaire de trois réponses prend alors le relais et vous dirige vers la ressource la plus utile.',
  },
  {
    q: 'L’outil juge-t-il le prix de mon bien ?',
    a: 'Non. Il analyse la façon dont l’annonce présente le bien. Le prix exige des biens comparables, la concurrence active, l’état réel, la rue et votre situation.',
  },
  {
    q: 'Dois-je donner mes coordonnées ?',
    a: 'Non. Les deux conseils apparaissent avant toute demande de contact. Vous choisissez ensuite librement de transmettre le résultat à Mouaad pour aller plus loin.',
  },
  {
    q: 'Le lien de mon annonce est-il conservé ?',
    a: 'Le lien est utilisé pour cette lecture et n’est pas enregistré par l’outil. Il n’est transmis à Mouaad que si vous remplissez ensuite le formulaire et donnez votre accord.',
  },
];
---

<Layout
  title="Audit gratuit d’annonce immobilière à Chartres"
  description="Collez le lien de votre annonce immobilière et recevez deux améliorations concrètes avant toute demande de coordonnées. Audit gratuit à Lèves, Chartres et dans le bassin chartrain."
  designContract={designContract}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebApplication',
        name: 'Audit d’annonce LEVOIS',
        url: `${site.url}/audit-annonce`,
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Navigateur web',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
        description: 'Outil gratuit qui croise le lien d’une annonce immobilière avec trois réponses courtes pour proposer deux actions concrètes avant toute demande de coordonnées.',
        areaServed: ['Lèves', 'Chartres', 'Bassin chartrain'],
      },
      {
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      },
    ],
  })} />

<div class="levois-audit">
    <section class="url-hero" aria-labelledby="audit-title">
      <div class="url-hero__copy">
        <h1 id="audit-title">Collez votre annonce.<br /><span>3 réponses. 2 actions.</span></h1>
        <p>Le lien apporte le contexte. Vos réponses montrent ce qui se passe réellement entre les vues, les contacts, les visites et les offres.</p>
        <ul aria-label="Engagements de l’audit">
          <li>Gratuit</li>
          <li>Sans coordonnées</li>
          <li>Conseils avant contact</li>
        </ul>
      </div>

      <div class="url-entry" id="outil">
        <div class="url-steps" aria-label="Parcours de l’audit">
          <span data-active>Votre lien</span>
          <span>3 réponses</span>
          <span>2 actions</span>
        </div>
        <form data-url-form novalidate>
          <label for="listing-url">Lien public de l’annonce</label>
          <input id="listing-url" name="url" type="url" inputmode="url" autocomplete="url" required placeholder="https://www…" />
          <button type="submit">Analyser mon annonce</button>
          <p class="url-entry__privacy">Lecture ponctuelle. Aucun suivi automatique de l’annonce.</p>
          <p class="form-status" data-url-status role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <section class="url-output" data-output hidden aria-live="polite"></section>

    <section class="url-method" aria-labelledby="method-title">
      <div>
        <h2 id="method-title">L’annonce parle avant vous.</h2>
        <p>Un acheteur découvre d’abord une image, un titre et un prix. Il cherche ensuite les informations qui lui permettent de se projeter — ou une raison de passer à l’annonce suivante.</p>
      </div>
      <ol>
        <li><b>Comprendre</b><span>L’avantage principal est-il évident en quelques secondes&nbsp;?</span></li>
        <li><b>Se projeter</b><span>Le texte et les photos répondent-ils aux questions concrètes&nbsp;?</span></li>
        <li><b>Agir</b><span>L’annonce donne-t-elle une raison claire de demander une visite&nbsp;?</span></li>
      </ol>
    </section>

    <section class="url-boundary" aria-labelledby="boundary-title">
      <h2 id="boundary-title">Deux conseils automatiques.<br />Une situation qui reste humaine.</h2>
      <div>
        <p>L’outil peut relire la présentation. Il ne peut pas visiter le bien, entendre les objections, mesurer la qualité des contacts ni connaître votre calendrier.</p>
        <p>C’est précisément là que l’analyse de Mouaad devient utile&nbsp;: confronter l’annonce, le marché et votre projet sans vous imposer une décision.</p>
      </div>
    </section>

    <section class="url-faq" aria-labelledby="faq-title">
      <h2 id="faq-title">Questions simples.<br />Réponses nettes.</h2>
      <div>
        {faq.map((item) => (
          <details>
            <summary>{item.q}<span aria-hidden="true"></span></summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>

  <script>
import {requestJson} from '../lib/request-json';
    import { type ListingAnalysis, type ListingSnapshot } from '../lib/audit-url';
    import { analyseHybridListing, getContextQuestion, type BlockedAuditResult, type ContextOption, type ListingDuration, type ListingSignal } from '../lib/audit-blocked';

    const urlForm = document.querySelector<HTMLFormElement>('[data-url-form]');
    const urlInput = document.querySelector<HTMLInputElement>('#listing-url');
    const urlStatus = document.querySelector<HTMLElement>('[data-url-status]');
    const output = document.querySelector<HTMLElement>('[data-output]');
    let currentUrl = '';

    const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (char) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;',
    }[char] || char));

    function trackAudit(event: string, detail: Record<string, unknown> = {}) {
      window.dispatchEvent(new CustomEvent('levois:audit', { detail: { event, ...detail } }));
      const dataLayer = (window as Window & { dataLayer?: Record<string, unknown>[] }).dataLayer;
      if (Array.isArray(dataLayer)) dataLayer.push({ event, ...detail });
    }

    function setLoading(loading: boolean) {
      const button = urlForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!button) return;
      button.disabled = loading;
      button.textContent = loading ? 'Lecture de la page…' : 'Analyser mon annonce';
    }

    function choices(name: string, options: ContextOption[]) {
      return options.map((option) => `<label><input type="radio" name="${escapeHtml(name)}" value="${escapeHtml(option.value)}"><span>${escapeHtml(option.label)}</span></label>`).join('');
    }

    function startQuestionnaire(snapshot: ListingSnapshot, readable: boolean, message: string) {
      if (!output) return;
      let duration: ListingDuration | null = null;
      let signal: ListingSignal | null = null;
      output.hidden = false;
      output.innerHTML = `<div class="fallback-shell guided-shell" tabindex="-1">
        <div class="fallback-copy">
          <h2>${readable ? 'Le lien apporte le contexte.' : 'Votre lien n’est pas en cause.'}<br><span>Vos réponses donnent le sens.</span></h2>
          <p>${escapeHtml(message)}</p>
          <p>Trois sélections suffisent. Aucune coordonnée n’est demandée pour voir les deux actions.</p>
          <p class="fallback-url">Lien conservé&nbsp;: ${escapeHtml(currentUrl)}</p>
        </div>
        <div class="fallback-form" data-guided-screen>
        </div>
      </div>`;
      trackAudit(readable ? 'audit_url_readable' : 'audit_url_blocked', { source: snapshot.source });
      output.querySelector<HTMLElement>('.fallback-shell')?.focus();
      output.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });

      const screen = output.querySelector<HTMLElement>('[data-guided-screen]');
      const durations: ContextOption[] = [
        { value: 'moins-7', label: 'Moins de 7 jours' }, { value: '7-30', label: 'De 7 à 30 jours' }, { value: 'plus-30', label: 'Plus d’un mois' },
      ];
      const signals: ContextOption[] = [
        { value: 'peu-vues', label: 'Très peu de vues' }, { value: 'vues-sans-contact', label: 'Des vues, mais aucun contact' },
        { value: 'contacts-sans-visite', label: 'Des contacts, mais aucune visite' }, { value: 'visites-sans-offre', label: 'Des visites, mais aucune offre' },
        { value: 'offre-recue', label: 'Une proposition ou une offre reçue' },
      ];

      function renderStep(step: 1 | 2 | 3) {
        if (!screen) return;
        const question = step === 1
          ? { question: 'Depuis combien de temps l’annonce est-elle publiée ?', options: durations, name: 'duration' }
          : step === 2
            ? { question: 'Que se passe-t-il aujourd’hui ?', options: signals, name: 'signal' }
            : { ...getContextQuestion(signal!), name: 'context' };
        screen.innerHTML = `<form data-guided-form>
          <p>Question ${step} sur 3</p>
          <div class="guided-progress" aria-hidden="true"><i style="transform:scaleX(${step / 3})"></i></div>
          <fieldset><legend tabindex="-1">${escapeHtml(question.question)}</legend>${choices(question.name, question.options)}</fieldset>
          ${step > 1 ? '<button class="guided-back" type="button">Modifier la réponse précédente</button>' : ''}
        </form>`;
        screen.querySelector<HTMLElement>('legend')?.focus();
        screen.querySelector<HTMLButtonElement>('.guided-back')?.addEventListener('click', () => renderStep((step - 1) as 1 | 2));
        screen.querySelector<HTMLFormElement>('[data-guided-form]')?.addEventListener('change', (event) => {
          const input = (event.target as HTMLElement).closest<HTMLInputElement>('input[type="radio"]');
          if (!input) return;
          if (step === 1) { duration = input.value as ListingDuration; renderStep(2); return; }
          if (step === 2) { signal = input.value as ListingSignal; trackAudit('audit_stage_identified', { signal }); renderStep(3); return; }
          if (!duration || !signal) return;
          const result = analyseHybridListing(snapshot, duration, signal, input.value);
          showResult(snapshot, result.analysis, result.resource, { duration, signal, context: input.value, urlReadable: readable });
        });
      }
      renderStep(1);
    }

    function resultMarkup(snapshot: ListingSnapshot, analysis: ListingAnalysis, resource?: BlockedAuditResult['resource']) {
      const tips = analysis.tips.map((tip, index) => `<article class="advice-row">
        <span>${index + 1}</span>
        <div><h3>${escapeHtml(tip.title)}</h3><p class="advice-observation">${escapeHtml(tip.observation)}</p><p><b>À faire&nbsp;:</b> ${escapeHtml(tip.action)}</p></div>
      </article>`).join('');
      const facts = analysis.facts.map((fact) => `<li>${escapeHtml(fact)}</li>`).join('');
      return `<div class="result-shell" tabindex="-1">
        <header class="result-head">
          <div><p>Première lecture terminée</p><h2>${escapeHtml(analysis.title)}</h2></div>
          <button type="button" data-restart>Auditer un autre lien</button>
        </header>
        <div class="advice-list">${tips}</div>
        <div class="result-evidence">
          <details><summary>Ce résultat s’appuie sur<span aria-hidden="true"></span></summary><ul>${facts}</ul></details>
          <div><b>Ici s’arrête l’automatisation.</b><p>${escapeHtml(analysis.limit)}</p></div>
        </div>
        ${resource ? `<a class="resource-next" href="${escapeHtml(resource.href)}"><span>La ressource adaptée à cette étape</span><b>${escapeHtml(resource.label)}</b><p>${escapeHtml(resource.description)}</p></a>` : ''}
        <section class="human-next">
          <div><h2>Vous voulez savoir ce que cela change dans votre cas&nbsp;?</h2><p>Transmettez cette première lecture à Mouaad. Il reprendra à partir de l’annonce, de votre situation et du marché — sans engagement et sans vous demander de modifier votre prix à l’aveugle.</p></div>
          <form data-lead-form novalidate>
            <div class="lead-grid">
              <label>Prénom<input name="prenom" autocomplete="given-name" required maxlength="80"></label>
              <label>Nom<input name="nom" autocomplete="family-name" required maxlength="80"></label>
              <label>Email<input name="email" type="email" autocomplete="email" required maxlength="200"></label>
              <label>Téléphone <small>facultatif</small><input name="telephone" type="tel" autocomplete="tel" maxlength="40"></label>
            </div>
            <label class="lead-note">Ce que vous voulez préciser <small>facultatif</small><textarea name="detail" rows="3" maxlength="2000" placeholder="Depuis quand l’annonce est en ligne, retours reçus, difficulté principale…"></textarea></label>
            <label class="lead-consent"><input id="audit-consent" type="checkbox" required><span>J’accepte que ces informations et le lien de l’annonce soient transmis à Mouaad pour qu’il puisse me répondre.</span></label>
            <label class="honeypot" aria-hidden="true">Site web<input name="site_web" tabindex="-1" autocomplete="off"></label>
            <button type="submit">Demander la lecture de Mouaad</button>
            <p class="form-status" data-lead-status role="status" aria-live="polite"></p>
          </form>
        </section>
      </div>`;
    }

    function showResult(snapshot: ListingSnapshot, analysis: ListingAnalysis, resource?: BlockedAuditResult['resource'], answers: Record<string, unknown> = {}) {
      if (!output) return;
      output.hidden = false;
      output.innerHTML = resultMarkup(snapshot, analysis, resource);
      trackAudit('audit_result_viewed', { result: analysis.title });
      output.querySelector<HTMLElement>('.result-shell')?.focus();
      output.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      output.querySelector<HTMLButtonElement>('[data-restart]')?.addEventListener('click', () => {
        output.hidden = true;
        output.innerHTML = '';
        urlInput?.focus();
        window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });
      output.querySelector<HTMLAnchorElement>('.resource-next')?.addEventListener('click', () => trackAudit('audit_resource_clicked', { href: resource?.href }));
      bindLead(snapshot, analysis, answers);
    }

    function bindLead(snapshot: ListingSnapshot, analysis: ListingAnalysis, answers: Record<string, unknown>) {
      const form = output?.querySelector<HTMLFormElement>('[data-lead-form]');
      const status = output?.querySelector<HTMLElement>('[data-lead-status]');
      let sending=false;
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (sending || !form.reportValidity()) return;
        sending=true;
        const data = new FormData(form);
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (button) { button.disabled = true; button.textContent = 'Transmission…'; }
        if (status) status.textContent = '';
        try {
          const {response,data:payload} = await requestJson<any>('/api/lead', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              type: 'audit-annonce', consentement: true,
              prenom: data.get('prenom'), nom: data.get('nom'), email: data.get('email'), telephone: data.get('telephone'),
              annonce: snapshot.url, detail: data.get('detail'), site_web: data.get('site_web'),
              audit: {
                code: 'hybrid', titre: analysis.title, resume: analysis.summary,
                faits: analysis.facts, actions: analysis.tips.map((tip) => `${tip.title} — ${tip.action}`),
                reponses: { ...answers, source: snapshot.source, titre: snapshot.title, prix: snapshot.price || 'non lu', photos: snapshot.photoCount ?? 'non lu' },
              },
            }),
          });
          if (!response.ok || payload?.ok !== true) throw new Error(payload.message || 'La transmission n’a pas abouti.');
          form.innerHTML = `<div class="lead-success" tabindex="-1" role="status"><b>Votre demande est transmise.</b><p>Mouaad dispose du lien, des deux premiers conseils et de votre précision. Il pourra reprendre exactement là où l’automatisation s’arrête.</p></div>`;
          trackAudit('audit_human_requested', { result: analysis.title });
          form.querySelector<HTMLElement>('.lead-success')?.focus();
        } catch (error) {
          if (status) status.textContent = error instanceof Error ? error.message : 'La transmission n’a pas abouti.';
          sending=false;
          if (button) { button.disabled = false; button.textContent = 'Réessayer la transmission'; }
        }
      });
    }

    urlForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!urlForm.reportValidity() || !urlInput) return;
      currentUrl = urlInput.value.trim();
      trackAudit('audit_started');
      if (urlStatus) urlStatus.textContent = '';
      setLoading(true);
      try {
        const {response,data:payload} = await requestJson<any>('/api/audit-url/', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ url: currentUrl }),
        });
        if (response.ok && payload.snapshot && payload.analysis) {
          startQuestionnaire(payload.snapshot as ListingSnapshot, true, 'La page a fourni quelques éléments de présentation. Ils seront croisés avec les réactions que vous avez réellement reçues.');
        } else if (payload.fallback || response.status >= 500) {
          startQuestionnaire({ url: currentUrl, source: 'Portail non lisible', title: '', description: '' }, false, payload.message || 'La page ne peut pas être lue automatiquement.');
        } else {
          if (urlStatus) urlStatus.textContent = payload.message || 'Ce lien ne peut pas être analysé. Indiquez le lien public complet d’une annonce.';
        }
      } catch (error) {
        startQuestionnaire({ url: currentUrl, source: 'Lecture indisponible', title: '', description: '' }, false, 'La lecture du lien est indisponible. Vous pouvez continuer avec vos réponses ; aucune donnée de l’annonce n’a été confirmée.');
      } finally {
        setLoading(false);
      }
    });
  </script>

  <style is:global>
    .url-hero { min-height: calc(100svh - var(--site-header-h)); display: grid; grid-template-columns: 1.08fr .92fr; background: var(--levois-paper); color: var(--levois-ink); }
    .url-hero > * { min-width: 0; }
    .url-hero__copy { padding: clamp(62px, 8vw, 118px) clamp(24px, 6vw, 92px); display: flex; flex-direction: column; justify-content: center; }
    .url-hero h1 { max-width: 980px; margin: 0; font-family: Satoshi, sans-serif; font-size: clamp(56px, 7vw, 96px); font-weight: 400; line-height: .9; letter-spacing: -.035em; }
    .url-hero h1 span { color: var(--levois-accent); }
    .url-hero__copy > p { max-width: 680px; margin: 34px 0 0; font-size: clamp(18px, 1.45vw, 22px); line-height: 1.5; }
    .url-hero__copy ul { margin: 28px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 24px; list-style: none; color: var(--levois-muted); font-size: 12px; }
    .url-hero__copy li + li::before { margin-right: 24px; content: '·'; }
    .url-entry { padding: clamp(34px, 5vw, 74px); background: var(--levois-accent); color: #fff; display: flex; flex-direction: column; justify-content: center; }
    .url-steps { margin-bottom: clamp(42px, 7vw, 90px); display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(255,255,255,.55); }
    .url-steps span { padding: 14px 4px 0; color: var(--levois-on-dark); font-size: 12px; position: relative; }
    .url-steps span[data-active] { color: #fff; font-weight: 750; }
    .url-steps span[data-active]::before { content: ''; position: absolute; width: 100%; height: 5px; top: -3px; left: 0; background: var(--levois-selected); }
    .url-entry form { display: grid; }
    .url-entry label { margin-bottom: 12px; color: #fff; font-size: clamp(24px, 3vw, 42px); font-weight: 800; line-height: 1.05; }
    .url-entry input { min-height: 72px; width: 100%; padding: 0 20px; border: 2px solid #fff; border-radius: 0; background: #fff; color: var(--levois-ink); font: 600 18px/1.2 Satoshi, sans-serif; }
    .url-entry button, .human-next button { min-height: 64px; padding: 0 26px; border: 0; border-radius: 999px; background: var(--levois-selected); color: var(--levois-ink); font: 800 17px/1.2 Satoshi, sans-serif; cursor: pointer; }
    .url-entry button { margin-top: 2px; }
    .url-entry button:hover { background: var(--levois-ink); color: var(--levois-selected); }
    button:disabled { cursor: wait; opacity: .68; }
    .url-entry__privacy { margin: 18px 0 0; color: var(--levois-on-dark); font-size: 12px; }
    .form-status { min-height: 24px; margin: 10px 0 0; color: #fff; font-weight: 700; }
    .url-output { scroll-margin-top: var(--site-header-h); }
    .fallback-shell { display: grid; grid-template-columns: .9fr 1.1fr; background: var(--levois-ink); color: var(--levois-paper); outline: none; }
    .fallback-copy, .fallback-form { padding: clamp(52px, 7vw, 100px) clamp(24px, 6vw, 92px); }
    .fallback-copy h2 { margin: 0; font-size: clamp(42px, 5.5vw, 76px); line-height: .96; letter-spacing: -.03em; }
    .fallback-copy h2 span { color: var(--levois-selected); }
    .fallback-copy > p { max-width: 60ch; margin: 28px 0 0; color: var(--levois-on-dark); font-size: 18px; line-height: 1.55; }
    .fallback-copy .fallback-url { padding-top: 18px; border-top: 1px solid #596158; color: var(--levois-on-dark); font-size: 12px; overflow-wrap: anywhere; }
    .fallback-form { background: var(--levois-paper); color: var(--levois-ink); display: grid; align-content: center; gap: 34px; }
    .fallback-form form { display: grid; gap: 16px; }
    .fallback-form form + form { padding-top: 30px; border-top: 1px solid var(--levois-line); }
    .fallback-form form > p { margin: 0; color: var(--levois-accent); font-size: 12px; font-weight: 800; }
    .guided-progress { height: 4px; margin-bottom: 18px; background: var(--levois-line); }
    .guided-progress i { width: 100%; height: 100%; display: block; background: var(--levois-accent); transform-origin: left center; transition: transform .25s ease-out; }
    .fallback-form fieldset { margin: 0; padding: 0; border: 0; display: grid; gap: 2px; background: var(--levois-ink); }
    .fallback-form legend { width: 100%; margin-bottom: 18px; background: var(--levois-paper); font-size: clamp(28px, 3vw, 42px); font-weight: 800; line-height: 1.05; }
    .fallback-form label { position: relative; cursor: pointer; }
    .fallback-form input { position: absolute; opacity: 0; pointer-events: none; }
    .fallback-form label span { min-height: 58px; padding: 14px 18px; display: flex; align-items: center; border-radius: 16px; background: #fff; color: var(--levois-ink); font-weight: 750; }
    .fallback-form label:hover span, .fallback-form input:checked + span { background: var(--levois-selected); }
    .fallback-form input:focus-visible + span { outline: 3px solid var(--levois-accent); outline-offset: -3px; }
    .fallback-form [hidden] { display: none; }
    .guided-back { width: max-content; min-height: 42px; margin-top: 6px; padding: 0; border: 0; border-bottom: 1px solid currentColor; background: transparent; color: var(--levois-ink); font: 750 14px/1.2 Satoshi, sans-serif; cursor: pointer; }
    .human-next label { display: grid; gap: 8px; font-weight: 750; }
    .human-next input, .human-next textarea { width: 100%; padding: 15px 16px; border: 1px solid var(--levois-ink); border-radius: 0; background: #fff; color: var(--levois-ink); font: 400 16px/1.45 Satoshi, sans-serif; }
    .human-next textarea { resize: vertical; }
    .lead-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
