---
import Layout from '../layouts/Layout.astro';

const categories = [
  { eyebrow: "À table", title: "Restaurants & cafés", desc: "Les adresses qui font qu'on reste dîner à Lèves plutôt qu'à Chartres." },
  { eyebrow: "Au pain", title: "Boulangeries & pâtisseries", desc: "Là où va vraiment le quartier, pas juste celle qui est la plus visible." },
  { eyebrow: "Du quotidien", title: "Alimentation & marchés", desc: "Les commerces de bouche, les marchés réguliers, les producteurs locaux." },
  { eyebrow: "Au service", title: "Artisans & métiers manuels", desc: "Plombiers, électriciens, menuisiers, maçons : ceux qu'on rappelle et qu'on recommande." },
  { eyebrow: "Pour le corps", title: "Coiffeurs, esthétique, bien-être", desc: "Les enseignes locales, les indépendants, les habitués." },
  { eyebrow: "Pour le reste", title: "Autres commerces & services", desc: "Tout ce qui ne rentre pas dans les cases précédentes mais mérite d'être mentionné." },
];
---

<Layout
  title="Commerces & artisans de Lèves"
  description="Les bonnes adresses de Lèves au fil des rencontres. Annuaire en construction."
>

  <article class="max-w-page mx-auto px-edge md:px-edge-md pt-section md:pt-section-md pb-section-md">

    <!-- HERO -->
    <header class="mb-section md:mb-section-md max-w-editorial fade-up">
      <div class="eyebrow mb-6">Au quotidien</div>
      <h1 class="text-hero text-sapin leading-[0.95] mb-8">
        Commerces<br/>
        <em class="font-normal italic text-sapin-deep">&amp; artisans.</em>
      </h1>
      <span class="rule-ocre"></span>
      <p class="text-body-lg text-muted max-w-prose">
        Pas un annuaire exhaustif comme on en trouve sur Pages Jaunes —
        une sélection au fil des rencontres, des bonnes adresses qui me
        sont recommandées par d'autres habitants ou que je découvre moi-même
        en m'installant.
      </p>
    </header>

    <!-- EN CONSTRUCTION badge -->
    <div class="mb-16 md:mb-20 fade-up">
      <div class="inline-flex items-center gap-3 border border-beige rounded-full px-5 py-2.5 bg-cream-soft">
        <span class="block w-1.5 h-1.5 rounded-full bg-ocre"></span>
        <span class="text-eyebrow uppercase text-muted">En construction · premières adresses à venir</span>
      </div>
    </div>

    <!-- TEASER : catégories -->
    <section class="mb-section md:mb-section-md fade-up">
      <h2 class="text-h2 text-sapin mb-3">Les catégories qui seront couvertes :</h2>
      <span class="rule-ocre"></span>

      <div class="grid sm:grid-cols-2 gap-px bg-beige border border-beige mt-12">
        {categories.map((cat) => (
          <div class="bg-cream p-6 md:p-8">
            <div class="eyebrow-muted mb-3">{cat.eyebrow}</div>
            <h3 class="text-h3 text-sapin mb-2">{cat.title}</h3>
            <p class="text-[15px] text-muted leading-relaxed">{cat.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA double : recommander OU être référencé -->
    <section class="grid md:grid-cols-2 gap-5 fade-up">

      <!-- CTA recommander -->
      <div class="bg-cream-soft border border-beige rounded-md p-8 md:p-10">
        <div class="eyebrow mb-4">Vous avez une bonne adresse ?</div>
        <h3 class="text-h3 text-sapin mb-3">Recommandez-la</h3>
        <p class="text-[15px] text-muted leading-relaxed mb-6">
          Un commerce, un artisan, un café que vous adorez à Lèves ?
          Mentionnez-le-moi. Aucun contact commercial implicite —
          juste l'envie de faire connaître ce qui le mérite.
        </p>
        <a
          href="/contribuer"
          class="inline-flex items-center gap-2 text-eyebrow uppercase text-sapin hover:text-ocre transition-colors border-b border-sapin pb-1"
        >
          Recommander
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
        </a>
      </div>

      <!-- CTA commerçant -->
      <div class="bg-sapin text-cream rounded-md p-8 md:p-10">
        <div class="text-eyebrow uppercase tracking-widest text-ocre-soft mb-4">Vous tenez un commerce ?</div>
        <h3 class="text-h3 mb-3">Un site web sobre &amp; rapide</h3>
        <p class="text-[15px] opacity-80 leading-relaxed mb-6">
          Si vous tenez un commerce ou un atelier à Lèves ou autour
          et que votre visibilité en ligne mériterait mieux, j'ai peut-être
          quelque chose à vous proposer.
        </p>
        <a
          href="/pour-les-commerces"
          class="inline-flex items-center gap-2 text-eyebrow uppercase text-ocre-soft hover:text-cream transition-colors border-b border-ocre-soft pb-1"
        >
          Voir mon offre site
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
        </a>
      </div>

    </section>

  </article>
</Layout>
