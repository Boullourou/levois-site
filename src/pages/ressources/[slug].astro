---
import Layout from '../../layouts/Layout.astro';
import { getPublishedEditorialArticles } from '../../lib/editorial/catalog';
import { RESOURCE_CATEGORY_LABELS, RESOURCE_CTA_LABELS, createResourceCatalog, resourceActionUrl, resourceDate } from '../../lib/editorial/shared-catalog';
export function getStaticPaths() {
  const catalog = createResourceCatalog(getPublishedEditorialArticles());
  return catalog.map((resource) => ({ params: { slug: resource.slug }, props: { resource, catalog } }));
}
const { resource, catalog } = Astro.props;
const legacy = resource.legacyContent;
const otherResources = catalog.filter((entry) => entry.id !== resource.id).sort((a, b) => Number(b.category === resource.category) - Number(a.category === resource.category)).slice(0, 3);
const primaryUrl = resourceActionUrl(resource.primaryDestination, resource.id);
const contactUrl = resourceActionUrl('/contact/', resource.id);
---
<Layout
  title={`${resource.title} · LEVOIS`}
  description={resource.summary}
  image={resource.image?.src}
  imageAlt={resource.image?.alt}
  article={{ headline: resource.title, author: resource.author, category: RESOURCE_CATEGORY_LABELS[resource.category], createdAt: resource.createdAt, updatedAt: resource.updatedAt }}
>
  <div class="res-article-page" data-article-id={resource.id}>
    <div class="w">
      <nav class="res-breadcrumb" aria-label="Fil d’Ariane">
        <a href="/ressources/">← Ressources</a><span class="sep" aria-hidden="true">/</span><span class="curr" aria-current="page">{resource.title}</span>
      </nav>
      <header class="res-art-header">
        <span class="res-art-tag">{RESOURCE_CATEGORY_LABELS[resource.category]}</span>
        <h1>{resource.title}</h1>
        <p class="res-art-lead">{resource.summary}</p>
        <div class="res-art-meta">
          <span>Par <strong>{resource.author.name}</strong> · {resource.author.role}</span>
          {resource.createdAt && <time datetime={resource.createdAt}>Rédigé le {resourceDate(resource.createdAt)}</time>}
          {resource.updatedAt && <time datetime={resource.updatedAt}>Modifié le {resourceDate(resource.updatedAt)}</time>}
        </div>
      </header>
      <div class="res-art-layout">
        <article class="res-art-content">
          <div class="res-box-reponse">
            <span class="res-box-ey">L’essentiel</span>
            <h2>La réponse courte</h2>
            <p>{resource.answer}</p>
          </div>
          {resource.image && <img class="res-article-image" src={resource.image.src} alt={resource.image.alt} width={resource.image.width} height={resource.image.height} loading="lazy" decoding="async" />}
          <div class="res-prose">
            {legacy ? <>
              {legacy.explication.map((paragraph) => <p>{paragraph}</p>)}
              <h2>Exemple illustratif : {legacy.exemple.titre}</h2>
              <p>{legacy.exemple.texte}</p>
              <h2>Les raccourcis et erreurs à éviter</h2>
              <ul class="res-list-warn">{legacy.erreurs.map((item) => <li>{item}</li>)}</ul>
              <h2>{legacy.checklist.titre}</h2>
              <ol class="res-list-check">{legacy.checklist.items.map((item) => <li>{item}</li>)}</ol>
            </> : resource.sections.map((section) => <section><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>)}
            <div class="res-box-limit">
              <h2>Les limites à garder en tête</h2>
              {resource.limits.map((limit) => <p>{limit}</p>)}
            </div>
            {legacy && <><h2>Votre prochaine action utile</h2><p>{legacy.action}</p></>}
            <section class="res-sources" aria-labelledby="article-sources">
              <h2 id="article-sources">Périmètre et sources</h2>
              <p>{resource.scope}</p>
              {resource.sources.length ? <ul>{resource.sources.map((source) => <li><a href={source.url}>{source.label}</a>{source.accessedAt && <span> — consulté le {resourceDate(source.accessedAt)}</span>}</li>)}</ul> : <p>Cette ressource propose une méthode de réflexion. Elle ne présente pas de statistique locale ni de résultat commercial mesuré.</p>}
            </section>
          </div>
          <div class="res-author-card">
            <img src="/v7/asset-07.webp" alt="Mouaad Boullourou" class="res-author-img" width="80" height="80" loading="lazy" decoding="async" />
            <div class="res-author-info">
              <h2>Et pour votre situation ?</h2>
              <p class="res-author-sub">Mouaad Boullourou · Conseiller indépendant SAFTI · Lèves et Chartres Métropole</p>
              <p class="res-author-bio">Vous pouvez poursuivre avec les repères utiles à votre projet ou m’écrire directement. Le sujet de cet article sera déjà indiqué.</p>
              <div class="res-author-actions">
                <a class="res-primary-action" href={primaryUrl}>{RESOURCE_CTA_LABELS[resource.primaryDestination]} →</a>
                {resource.primaryDestination !== '/contact/' && <a class="res-secondary-action" href={contactUrl}>Écrire à Mouaad →</a>}
                <a class="phone-btn phone-nowrap" href="tel:+33781380121">Appeler le 07 81 38 01 21</a>
              </div>
            </div>
          </div>
        </article>
        <aside class="res-art-sidebar" aria-label="Lectures associées">
          <div class="res-sidebar-box">
            <h2>Poursuivre votre lecture</h2>
            <div class="res-sidebar-links">
              {otherResources.map((other) => <a class="res-sidebar-item" href={`/ressources/${other.slug}/`}><span class="res-sidebar-tag">{RESOURCE_CATEGORY_LABELS[other.category]}</span><strong>{other.title}</strong></a>)}
            </div>
            <div class="res-sidebar-cta"><a class="btn-outline" href="/ressources/">Toutes les ressources →</a></div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</Layout>
<style>
.res-article-page {
  background: var(--v7-paper);
  padding: clamp(64px, 8vw, 96px) 0 100px;
  color: var(--v7-ink);
}

.res-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  margin-bottom: 32px;
}

.res-breadcrumb a {
  color: var(--v7-muted);
  text-decoration: none;
  font-weight: 600;
  transition: color 0.2s;
}

.res-breadcrumb a:hover {
  color: var(--v7-orange);
}

.res-breadcrumb .sep {
  color: rgba(19, 42, 34, 0.2);
}

.res-breadcrumb .curr {
  color: var(--v7-ink);
  font-weight: 500;
  max-width: 320px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.res-art-header {
  max-width: 820px;
  margin-bottom: 48px;
  border-bottom: 1px solid rgba(19, 42, 34, 0.08);
  padding-bottom: 36px;
}

.res-art-tag {
  display: inline-block;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--v7-orange);
  background: rgba(194, 94, 26, 0.08);
  padding: 4px 12px;
  border-radius: 999px;
  margin-bottom: 16px;
}

.res-art-header h1 {
  font-family: 'Satoshi', sans-serif !important;
  font-size: clamp(32px, 4.4vw, 50px);
  font-weight: 700;
  line-height: 1.18;
  letter-spacing: -0.02em;
  margin-bottom: 18px;
}

.res-art-lead {
  font-size: clamp(18px, 2vw, 22px);
  line-height: 1.5;
  color: var(--v7-muted);
  margin-bottom: 20px;
}

.res-art-meta {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  color: var(--v7-muted);
}

.res-art-meta .dot {
  opacity: 0.4;
}

.res-art-layout {
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 56px;
  align-items: flex-start;
}

@media (max-width: 960px) {
  .res-art-layout {
    grid-template-columns: 1fr;
    gap: 40px;
  }
}

.res-box-reponse {
  background: rgba(19, 42, 34, 0.04);
  border-left: 4px solid var(--v7-ink);
  border-radius: 0 16px 16px 0;
  padding: 24px 28px;
  margin-bottom: 40px;
}

.res-box-ey {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--v7-muted);
  display: block;
  margin-bottom: 6px;
}

.res-box-reponse h2 {
  font-family: 'Satoshi', sans-serif !important;
  font-size: 20px;
  font-weight: 700;
  margin: 0 0 10px;
  color: var(--v7-ink);
}

.res-box-reponse p {
  font-size: 16px;
  line-height: 1.6;
  color: var(--v7-ink);
  margin: 0;
}

.res-prose {
  font-size: 17px;
  line-height: 1.7;
  color: rgba(19, 42, 34, 0.9);
}

.res-prose h2 {
  font-family: 'Satoshi', sans-serif !important;
  font-size: 26px;
  font-weight: 700;
  line-height: 1.3;
  margin: 44px 0 16px;
  color: var(--v7-ink);
}

.res-prose p {
  margin: 0 0 20px;
}

.res-list-warn,
.res-list-check {
  margin: 0 0 28px 24px;
  padding: 0;
}

.res-list-warn li,
.res-list-check li {
  margin-bottom: 12px;
  line-height: 1.6;
}

.res-box-limit {
  background: #FFFFFF;
  border: 1px solid rgba(19, 42, 34, 0.1);
  border-radius: 16px;
  padding: 24px;
  margin: 36px 0;
}

.res-box-limit h2 {
  font-family: 'Satoshi', sans-serif !important;
  font-size: 18px;
  font-weight: 700;
  margin: 0 0 10px;
  color: var(--v7-ink);
}

.res-box-limit p {
  margin: 0;
  font-size: 15px;
  line-height: 1.6;
  color: var(--v7-muted);
}

/* CARTE AUTEUR MOUAAD */
.res-author-card {
  margin-top: 56px;
  background: #FFFFFF;
  border: 1px solid rgba(19, 42, 34, 0.12);
  border-radius: 20px;
  padding: 32px 28px;
  display: flex;
  gap: 24px;
  align-items: flex-start;
  box-shadow: 0 8px 24px rgba(19, 42, 34, 0.04);
}

@media (max-width: 640px) {
  .res-author-card {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
}

.res-author-img {
  width: 80px;
  height: 80px;
  border-radius: 999px;
  object-fit: cover;
  flex-shrink: 0;
  border: 2px solid var(--v7-orange);
}

.res-author-info h2 {
  font-family: 'Satoshi', sans-serif !important;
  font-size: 20px;
  font-weight: 700;
  margin: 0 0 4px;
}

.res-author-sub {
  font-size: 13px;
  font-weight: 600;
  color: var(--v7-orange);
  margin-bottom: 12px;
}

.res-author-bio {
  font-size: 14px;
  line-height: 1.6;
  color: var(--v7-muted);
  margin-bottom: 20px;
}

.res-author-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
}

@media (max-width: 640px) {
  .res-author-actions {
    justify-content: center;
  }
}

.phone-nowrap {
  white-space: nowrap !important;
}

/* SIDEBAR */
.res-sidebar-box {
  background: #FFFFFF;
  border: 1px solid rgba(19, 42, 34, 0.1);
  border-radius: 20px;
  padding: 28px 24px;
  position: sticky;
  top: 100px;
}

.res-sidebar-box h2 {
  font-family: 'Satoshi', sans-serif !important;
  font-size: 18px;
  font-weight: 700;
  margin: 0 0 20px;
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(19, 42, 34, 0.08);
}

.res-sidebar-links {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 24px;
}

.res-sidebar-item {
  display: block;
  text-decoration: none;
  color: var(--v7-ink);
  transition: transform 0.2s;
}

.res-sidebar-item:hover {
  transform: translateX(4px);
}

.res-sidebar-item:hover strong {
  color: var(--v7-orange);
}

.res-sidebar-tag {
  display: block;
  font-size: 11px;
  color: var(--v7-muted);
  margin-bottom: 4px;
  font-weight: 600;
}

.res-sidebar-item strong {
  font-size: 14px;
  line-height: 1.4;
  display: block;
  transition: color 0.2s;
}

.res-sidebar-cta {
  border-top: 1px solid rgba(19, 42, 34, 0.08);
  padding-top: 16px;
}

.res-sidebar-cta .btn-outline {
  display: block;
  text-align: center;
  font-size: 13px;
  font-weight: 600;
  padding: 10px 16px;
  border: 1px solid rgba(19, 42, 34, 0.2);
  border-radius: 999px;
  text-decoration: none;
  color: var(--v7-ink);
  transition: all 0.2s;
}

.res-sidebar-cta .btn-outline:hover {
  border-color: var(--v7-ink);
  background: rgba(19, 42, 34, 0.04);
}
.res-art-layout { grid-template-columns:minmax(0,1fr) 300px;gap:40px }
.res-art-content,.res-art-sidebar { min-width:0 }
.res-art-header h1,.res-prose,.res-author-info { overflow-wrap:anywhere }
.res-art-meta { flex-wrap:wrap }
.res-art-meta time { display:block;width:100% }
.res-breadcrumb { flex-wrap:wrap }
.res-breadcrumb .curr { max-width:100%;white-space:normal;overflow-wrap:anywhere }
.res-article-image { display:block;width:100%;height:auto;border-radius:12px;margin:0 0 32px }
.res-box-limit p + p { margin-top:12px }
.res-sources { font-size:15px;border-top:1px solid rgba(20,20,20,.12);margin-top:40px;padding-top:12px }
.res-sources a { color:var(--v7-ink);text-underline-offset:3px;overflow-wrap:anywhere }
.res-primary-action,.res-secondary-action,.phone-btn { display:inline-flex;align-items:center;min-height:44px;padding:12px 18px;border-radius:24px;text-decoration:none;font-size:15px }
.res-primary-action { background:var(--v7-ink);color:#fff }
.res-secondary-action { background:#fff;color:var(--v7-ink);border:1px solid rgba(20,20,20,.15) }
.res-primary-action:hover { background:#353530 }
.phone-btn { color:var(--v7-ink);text-decoration:underline;text-underline-offset:4px;padding-inline:0 }
a:focus-visible { outline:3px solid #a34510;outline-offset:4px }
@media(max-width:960px) { .res-art-layout { grid-template-columns:minmax(0,1fr) } }
@media(max-width:640px) { .res-box-reponse { padding:20px }.res-author-card { padding:24px 18px }.res-author-actions { flex-direction:column }.res-primary-action,.res-secondary-action { width:100%;justify-content:center }.res-author-actions .phone-nowrap { white-space:normal!important } }
@media(prefers-reduced-motion:reduce) { .res-sidebar-item { transition:none }.res-sidebar-item:hover { transform:none } }
</style>
