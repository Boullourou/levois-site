---
import Layout from '../../layouts/Layout.astro';
import ResourceLibrary from '../../components/ResourceLibrary.astro';
import { getPublishedEditorialArticles } from '../../lib/editorial/catalog';
import { createResourceCatalog, paginateResources } from '../../lib/editorial/shared-catalog';
const catalog = createResourceCatalog(getPublishedEditorialArticles());
const pages = paginateResources(catalog);
---
<Layout title="Ressources immobilières · Lèves et Chartres · LEVOIS" description="Des réponses utiles pour vendre, acheter ou comprendre les ventes locales à Lèves et Chartres Métropole. Explications, sources, limites et prochaine action.">
  <ResourceLibrary entries={pages[0]} catalog={catalog} page={1} totalPages={pages.length} />
</Layout>