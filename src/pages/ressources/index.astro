---
import Layout from '../../layouts/Layout.astro';
import { resources } from '../../data/resources';

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Ressources immobilières LEVOIS',
  itemListElement: resources.map((resource, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: resource.titre,
    url: `https://levois.fr/ressources/${resource.slug}`,
  })),
};
---

<Layout
  title="Ressources"
  description="Six ressources gratuites pour comprendre les signaux de votre vente avant d'ajuster quoi que ce soit. Sans inscription."
>
  <script type="application/ld+json" set:html={JSON.stringify(listSchema)} />
  <div class="max-w-page mx-auto px-edge md:px-edge-md pt-12 md:pt-20">

    <header class="max-w-2xl mb-12 md:mb-16">
      <p class="eyebrow mb-4">Ressources gratuites</p>
      <h1 class="text-display text-encre mb-4">Comprendre avant d'ajuster.</h1>
      <p class="font-sans text-body-lg text-brun">
        Chaque ressource répond à une seule question — celle que se posent réellement
        les propriétaires. Sans inscription, sans contrepartie : la valeur d'abord.
      </p>
    </header>

    <div class="resource-grid mb-16">
      {resources.map((r, index) => (
        <a
          href={`/ressources/${r.slug}`}
          class="resource-entry group"
        >
          <span class="resource-index">{String(index + 1).padStart(2, '0')}</span>
          <p class="resource-question">{r.question}</p>
          <h2>{r.titre}</h2>
          <p class="resource-benefit">{r.benefice}</p>
          <p class="resource-meta"><span>{r.duree}</span><strong>{r.cta} →</strong></p>
        </a>
      ))}
    </div>

    <div class="resource-chooser md:flex items-center justify-between gap-8">
      <div class="max-w-xl">
        <h2 class="font-display text-2xl text-encre mb-2">Vous ne savez pas par laquelle commencer ?</h2>
        <p class="font-sans text-[15px] text-brun leading-relaxed">
          Le parcours « Situer ma vente » identifie la ressource la plus utile
          pour votre situation précise — en trois minutes, sans coordonnées.
        </p>
      </div>
      <a href="/situer-ma-vente" class="btn-primaire mt-5 md:mt-0 shrink-0">Situer ma vente</a>
    </div>

    <p class="font-sans text-sm text-brun/80 mt-10 max-w-prose">
      Mouaad conçoit ces contenus à partir des questions rencontrées sur le terrain et des données disponibles sur le bassin chartrain.
      L’objectif : vous être utile bien avant qu’une décision immobilière devienne urgente.
    </p>
  </div>
</Layout>

<style>
  .resource-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid #111522; }
  .resource-entry { position: relative; min-height: 320px; display: flex; flex-direction: column; padding: clamp(24px, 3vw, 42px); border-right: 1px solid #111522; border-bottom: 1px solid #111522; color: #111522; text-decoration: none; transition: background-color .2s ease-out, color .2s ease-out; }
  .resource-entry:nth-child(even) { border-right: 0; }
  .resource-entry:hover { background: #243cff; color: #f2f5ef; }
  .resource-index { color: #243cff; font: 700 13px/1 'Public Sans', system-ui, sans-serif; letter-spacing: .08em; }
  .resource-entry:hover .resource-index { color: #d7ff42; }
  .resource-question { max-width: 46ch; margin: 28px 0 0; font-size: 14px; line-height: 1.45; }
  .resource-entry h2 { max-width: 18ch; margin: 14px 0 0; font: 700 clamp(24px, 2.7vw, 38px)/1.03 'Public Sans', system-ui, sans-serif; letter-spacing: -.03em; }
  .resource-benefit { max-width: 54ch; margin: 18px 0 30px; color: currentColor; font-size: 15px; line-height: 1.55; opacity: .76; }
  .resource-meta { display: flex; justify-content: space-between; gap: 20px; margin: auto 0 0; font-size: 13px; }
  .resource-meta strong { color: #243cff; }
  .resource-entry:hover .resource-meta strong { color: #d7ff42; }
  .resource-chooser { padding: clamp(28px, 4vw, 50px); background: #111522; color: #f2f5ef; }
  .resource-chooser h2 { color: #f2f5ef; }
  .resource-chooser p { color: rgba(242,245,239,.72); }
  @media (max-width: 720px) {
    .resource-grid { grid-template-columns: 1fr; }
    .resource-entry { min-height: 280px; border-right: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .resource-entry { transition: none; }
  }
</style>
