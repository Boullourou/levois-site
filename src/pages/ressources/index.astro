---
import Layout from '../../layouts/Layout.astro';
import { resources } from '../../data/resources';

const categories = [
  'Préparer la vente',
  'Impact de l’annonce',
  'Analyse des contacts',
  'Psychologie des acheteurs',
  'Stratégie de prix',
  'Relance & Repositionnement'
];
---

<Layout 
  title="Ressources & Guides Immobiliers · Chartres & Lèves · LEVOIS" 
  description="Guides d'analyse, décryptages des prix réels et conseils méthodologiques indépendants pour réussir votre projet immobilier à Chartres et son agglomération."
>
  <main class="res-page">
    <div class="w">

      <!-- HERO ÉDITORIAL STATUTAIRE -->
      <header class="res-hero">
        <p class="res-ey">Analyses &amp; Recherches Immobilières · Chartres Métropole &amp; Lèves</p>
        <h1>Comprendre le marché avant de décider.</h1>
        <p class="res-sub">
          Guides pratiques, analyses sans complaisance des prix notariés et méthodes de terrain pour aborder votre vente ou votre achat en toute lucidité. La référence d'information indépendante sur le bassin chartrain.
        </p>
      </header>

      <!-- GRILLE DES RESSOURCES & ANALYSES -->
      <section class="res-grid-sec">
        <div class="res-cards-grid">
          {resources.map((r, i) => (
            <article class="res-card">
              <div class="res-card-top">
                <span class="res-category">{categories[i] || 'Guide Pratique'}</span>
                <span class="res-duration">{r.duree}</span>
              </div>

              <h2 class="res-card-title">
                <a href={`/ressources/${r.slug}/`}>{r.titre}</a>
              </h2>

              <p class="res-card-question">
                <strong>La question clé :</strong> {r.question}
              </p>

              <p class="res-card-desc">
                {r.benefice}
              </p>

              <div class="res-card-footer">
                <a class="res-read-btn" href={`/ressources/${r.slug}/`}>
                  Lire l'analyse complète <i>→</i>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- PASSERELLES VERS LES OUTILS DE DÉCISION -->
      <section class="res-tools-sec">
        <div class="res-tools-box">
          <div class="res-tools-content">
            <span class="res-ey" style="color:var(--v7-orange);">Outils d'aide à la décision</span>
            <h2>Vous préférez faire le point sur votre situation exacte ?</h2>
            <p>
              Nos 3 outils d'analyse sont à votre disposition en libre accès. Obtenez une vision claire de votre projet en 3 minutes.
            </p>
            <div class="res-tools-btns">
              <a class="btn-primary" href="/situer-ma-vente/">Situer ma vente →</a>
              <a class="btn-secondary" href="/ma-recherche/">Clarifier mon achat →</a>
              <a class="btn-secondary" href="/vendre-et-acheter/">Vente &amp; Achat simultanés →</a>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>

<style>
.res-page {
  background: var(--v7-paper);
  padding: clamp(64px, 8vw, 96px) 0 100px;
  color: var(--v7-ink);
}

.res-hero {
  max-width: 840px;
  margin-bottom: 64px;
}

.res-ey {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--v7-orange);
  margin-bottom: 14px;
}

.res-hero h1 {
  font-family: 'Satoshi', sans-serif !important;
  font-size: clamp(34px, 4.8vw, 56px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.03em;
  margin-bottom: 20px;
}

.res-sub {
  font-size: clamp(17px, 1.8vw, 20px);
  line-height: 1.6;
  color: var(--v7-muted);
}

.res-grid-sec {
  margin-bottom: 80px;
}

.res-cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

@media (max-width: 1040px) {
  .res-cards-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .res-cards-grid {
    grid-template-columns: 1fr;
  }
}

.res-card {
  background: #FFFFFF;
  border: 1px solid rgba(19, 42, 34, 0.1);
  border-radius: 20px;
  padding: 32px 26px;
  display: flex;
  flex-direction: column;
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s, border-color 0.25s;
  box-shadow: 0 4px 16px rgba(19, 42, 34, 0.03);
}

.res-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 36px rgba(19, 42, 34, 0.08);
  border-color: rgba(19, 42, 34, 0.25);
}

.res-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.res-category {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--v7-orange);
  background: rgba(194, 94, 26, 0.08);
  padding: 4px 10px;
  border-radius: 999px;
}

.res-duration {
  font-size: 12px;
  font-weight: 600;
  color: var(--v7-muted);
}

.res-card-title {
  font-family: 'Satoshi', sans-serif !important;
  font-size: 21px;
  font-weight: 700;
  line-height: 1.25;
  margin: 0 0 14px;
}

.res-card-title a {
  color: var(--v7-ink);
  text-decoration: none;
  transition: color 0.2s;
}

.res-card-title a:hover {
  color: var(--v7-orange);
}

.res-card-question {
  font-size: 14px;
  line-height: 1.55;
  color: var(--v7-ink);
  margin-bottom: 12px;
}

.res-card-desc {
  font-size: 14px;
  line-height: 1.6;
  color: var(--v7-muted);
  margin-bottom: 24px;
  flex-grow: 1;
}

.res-card-footer {
  border-top: 1px solid rgba(19, 42, 34, 0.08);
  padding-top: 18px;
}

.res-read-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 15px;
  font-weight: 700;
  color: var(--v7-ink);
  text-decoration: none;
  transition: color 0.2s, transform 0.2s;
}

.res-card:hover .res-read-btn {
  color: var(--v7-orange);
  transform: translateX(3px);
}

.res-tools-sec {
  border-top: 1px solid rgba(19, 42, 34, 0.08);
  padding-top: 64px;
}

.res-tools-box {
  background: var(--v7-ink);
  color: #FAF9F6;
  border-radius: 24px;
  padding: 48px 36px;
}

.res-tools-box h2 {
  font-family: 'Satoshi', sans-serif !important;
  color: #FAF9F6;
  font-size: clamp(24px, 3.2vw, 36px);
  font-weight: 700;
  margin: 10px 0 14px;
}

.res-tools-box p {
  color: rgba(250, 249, 246, 0.85);
  font-size: 16px;
  line-height: 1.6;
  max-width: 680px;
  margin-bottom: 28px;
}

.res-tools-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

.res-tools-btns .btn-primary {
  background: var(--v7-orange);
  color: #FFFFFF;
  padding: 12px 24px;
  border-radius: 999px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s;
}

.res-tools-btns .btn-primary:hover {
  background: #FFFFFF;
  color: var(--v7-ink);
}

.res-tools-btns .btn-secondary {
  background: rgba(250, 249, 246, 0.1);
  color: #FAF9F6;
  border: 1px solid rgba(250, 249, 246, 0.2);
  padding: 12px 22px;
  border-radius: 999px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s;
}

.res-tools-btns .btn-secondary:hover {
  background: #FAF9F6;
  color: var(--v7-ink);
}
</style>
