---
import Layout from '../layouts/Layout.astro';

const designContract = `LEVOIS_DA_B_RECHERCHE
THESIS: Le questionnaire devient un champ de relations où chaque réponse déplace des repères nommés ; refuser le wizard en cartes et le score final.
OWN-WORLD: Craie, aubergine, fuchsia et acide ; rails de progression, lignes de dépendance, contrôles rectangulaires et quatre blocs bord à bord.
STORY: La personne comprend la portée, répond, voit la traduction immédiate, choisit une vérification puis lit une synthèse corrigeable.
FIRST VIEWPORT: Sept fonctions métier sur un rail, ouverture concise au centre et aperçu des quatre sorties en lisière.
FORM: Territoire B épinglé — démonstration multi-états de Lignes vives.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md`;

const states = [
  { id: 'opening', label: 'Ouverture' },
  { id: 'question', label: 'Question' },
  { id: 'translator', label: 'Traduction' },
  { id: 'tradeoff', label: 'Arbitrage' },
  { id: 'reading', label: 'Première lecture' },
];
---

<Layout
  title="Mettre ma recherche au clair"
  description="Clarifiez les usages, contraintes et arbitrages de votre projet de résidence principale avant de laisser vos coordonnées."
  designContract={designContract}
>
  <div class="lv-page research-demo" data-research-demo data-current-state="opening">
    <header class="demo-header">
      <div>
        <p>Résidence principale · première lecture sans coordonnées</p>
        <h1>Mettre ma recherche au clair</h1>
      </div>
      <nav class="state-switcher" aria-label="États du démonstrateur" role="tablist">
        {states.map((state, index) => (
          <button
            type="button"
            role="tab"
            id={`tab-${state.id}`}
            aria-controls={`panel-${state.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            data-state-button={state.id}
          >{state.label}</button>
        ))}
      </nav>
    </header>

    <div class="research-shell">
      <aside class="step-rail" aria-label="Les sept fonctions du parcours">
        <ol>
          <li data-rail-step="1" class="is-current"><span>Niveau d’avancement</span><i></i></li>
          <li data-rail-step="2"><span>Situation actuelle</span><i></i></li>
          <li data-rail-step="3"><span>Amélioration attendue</span><i></i></li>
          <li data-rail-step="4"><span>Usage avant typologie</span><i></i></li>
          <li data-rail-step="5"><span>Cadre de réalité</span><i></i></li>
          <li data-rail-step="6"><span>Arbitrage utile</span><i></i></li>
          <li data-rail-step="7"><span>Première lecture</span><i></i></li>
        </ol>
        <p><strong data-progress-label>Ouverture</strong><br /><span data-progress-detail>Comprendre le cadre</span></p>
      </aside>

      <div class="state-stage">
        <section
          class="demo-panel opening-panel"
          id="panel-opening"
          role="tabpanel"
          aria-labelledby="tab-opening"
          data-state-panel="opening"
        >
          <div class="opening-copy">
            <h2 class="lv-headline">Votre situation d’abord. La forme du logement ensuite.</h2>
            <p class="lv-lead">En 11 questions essentielles, vous reliez ce qui doit changer, ce que vous voulez préserver et ce qu’il reste à vérifier. Vous voyez la première lecture avant toute demande de coordonnées.</p>
            <ul>
              <li>Résidence principale uniquement</li>
              <li>Aucun montant ni validation bancaire</li>
              <li>Chaque réponse reste modifiable</li>
            </ul>
            <button class="lv-button lv-button--acid" type="button" data-go-state="question">Commencer ma première lecture</button>
          </div>
          <div class="opening-map" aria-label="Les quatre blocs produits à la fin">
            <span>Ce que l’achat doit changer</span>
            <span>Ce que vous voulez préserver</span>
            <span>Ce que vous pourriez assouplir</span>
            <span>Ce qu’il reste à vérifier</span>
          </div>
        </section>

        <section
          class="demo-panel question-panel"
          id="panel-question"
          role="tabpanel"
          aria-labelledby="tab-question"
          data-state-panel="question"
          hidden
        >
          <form data-usage-form>
            <div class="question-context">
              <span>Usage avant typologie</span>
              <span>Question de démonstration · 5 sur 11</span>
            </div>
            <fieldset>
              <legend>Quel usage doit principalement mieux fonctionner dans votre prochain logement&nbsp;?</legend>
              <div class="option-axis">
                <label><input type="radio" name="usage" value="Dormir et préserver l’intimité" /><span>Dormir et préserver l’intimité</span></label>
                <label><input type="radio" name="usage" value="Travailler ou étudier" /><span>Travailler ou étudier</span></label>
                <label><input type="radio" name="usage" value="Accueillir ou partager le quotidien" /><span>Accueillir ou partager le quotidien</span></label>
                <label><input type="radio" name="usage" value="Cuisiner et prendre les repas" /><span>Cuisiner et prendre les repas</span></label>
                <label><input type="radio" name="usage" value="Profiter réellement d’un extérieur" /><span>Profiter réellement d’un extérieur</span></label>
                <label><input type="radio" name="usage" value="Je ne sais pas encore" /><span>Je ne sais pas encore</span></label>
              </div>
            </fieldset>
            <div class="inline-translator" role="status" aria-live="polite" data-inline-translator>
              <span>Traducteur en direct</span>
              <p>Choisissez un usage : la traduction apparaîtra ici sans déduire une pièce, une surface ou une typologie.</p>
            </div>
            <button class="lv-button" type="button" data-go-state="translator" data-needs-usage disabled>Continuer avec cette réponse</button>
          </form>
        </section>

        <section
          class="demo-panel translator-panel"
          id="panel-translator"
          role="tabpanel"
          aria-labelledby="tab-translator"
          data-state-panel="translator"
          hidden
        >
          <div class="translator-source">
            <span>Réponse déclarée</span>
            <strong data-usage-output>Travailler ou étudier</strong>
          </div>
          <div class="translator-line" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="translator-reading" role="status">
            <span>Ce que cette réponse change</span>
            <p>Vous avez relié le projet à un usage concret : <strong data-usage-output>travailler ou étudier</strong>. Nous pouvons maintenant examiner la forme de logement comme une hypothèse de solution, pas comme une conclusion.</p>
            <dl>
              <div><dt>Niveau</dt><dd>Conséquence directement établie</dd></div>
              <div><dt>Ne permet pas de conclure</dt><dd>Une pièce, une surface ou une typologie</dd></div>
            </dl>
            <div class="translator-actions">
              <button type="button" class="lv-button lv-button--paper" data-go-state="question">Modifier ma réponse</button>
              <button type="button" class="lv-button lv-button--acid" data-go-state="tradeoff">Voir un arbitrage</button>
            </div>
          </div>
        </section>

        <section
          class="demo-panel tradeoff-panel"
          id="panel-tradeoff"
          role="tabpanel"
          aria-labelledby="tab-tradeoff"
          data-state-panel="tradeoff"
          hidden
        >
          <form data-tradeoff-form>
            <div class="question-context">
              <span>Arbitrage utile</span>
              <span>Question de démonstration · 11 sur 11</span>
            </div>
            <fieldset>
              <legend>Lequel de ces deux scénarios mérite d’être vérifié en premier&nbsp;?</legend>
              <p class="tradeoff-help">Les deux enjeux peuvent rester compatibles. Vous choisissez seulement la première vérification.</p>
              <div class="tradeoff-axis">
                <label>
                  <input type="radio" name="tradeoff" value="preserve" />
                  <span><b>Préserver d’abord les trajets actuels</b><small>Comparer plusieurs organisations de l’espace dans ce même repère.</small></span>
                </label>
                <div class="axis-junction" aria-hidden="true"><i></i></div>
                <label>
                  <input type="radio" name="tradeoff" value="change" />
                  <span><b>Prioriser l’espace de travail</b><small>Tester comment conserver des trajets praticables avec un repère différent.</small></span>
                </label>
              </div>
              <label class="neutral-option"><input type="radio" name="tradeoff" value="missing" /><span>Impossible de choisir sans une information supplémentaire</span></label>
            </fieldset>
            <button class="lv-button lv-button--acid" type="button" data-go-state="reading" data-needs-tradeoff disabled>Voir ma première lecture</button>
          </form>
        </section>

        <section
          class="demo-panel reading-panel"
          id="panel-reading"
          role="tabpanel"
          aria-labelledby="tab-reading"
          data-state-panel="reading"
          hidden
        >
          <header class="reading-header">
            <div>
              <span>Première lecture · scénario de démonstration</span>
              <h2 class="lv-headline">Ce qui devient plus clair</h2>
            </div>
            <p>Cette lecture organise ce que vous avez déclaré. Elle ne valide ni un budget, ni un financement, ni un bien et ne remplace pas les vérifications propres à votre situation.</p>
          </header>
          <div class="reading-grid">
            <article class="reading-block reading-block--change">
              <span>Ce que votre achat doit changer</span>
              <h3>Mieux organiser l’espace autour de <em data-usage-lower>votre usage principal</em>.</h3>
              <p>Vous avez indiqué que l’achat doit principalement améliorer l’espace et son organisation. Dans le quotidien, cela se traduit d’abord par <strong data-usage-output>travailler ou étudier</strong>.</p>
              <button type="button" data-go-state="question">Modifier cette réponse</button>
            </article>
            <article class="reading-block reading-block--preserve">
              <span>Ce que vous voulez préserver</span>
              <h3>Des trajets déjà pratiques.</h3>
              <p>Ce repère reste une condition à confronter aux solutions comparées. Il n’impose pas encore une commune précise.</p>
              <button type="button" data-go-state="question">Modifier cette réponse</button>
            </article>
            <article class="reading-block reading-block--flex">
              <span>Ce que vous pourriez assouplir</span>
              <h3 data-flex-title>Tester plusieurs organisations avant de déplacer le repère géographique.</h3>
              <p data-flex-copy>Ce compromis sert à apprendre. Il ne rend aucun critère définitivement flexible.</p>
              <button type="button" data-go-state="tradeoff">Modifier l’arbitrage</button>
            </article>
            <article class="reading-block reading-block--verify">
              <span>Ce qu’il reste à décider ou vérifier</span>
              <ul>
                <li><strong>Cadre financier.</strong> Le repère global reste à confirmer ; aucune faisabilité n’est déduite.</li>
                <li><strong>Géographie.</strong> Tester un trajet réel avant de figer le secteur.</li>
                <li><strong>Forme du logement.</strong> Maison et appartement restent des hypothèses ouvertes.</li>
              </ul>
              <button type="button" data-go-state="question">Revoir mes réponses</button>
            </article>
          </div>
          <div class="reading-actions">
            <button type="button" class="lv-button lv-button--paper">Affiner cette lecture</button>
            <button type="button" class="lv-button lv-button--acid">Recevoir ma synthèse</button>
            <button type="button" class="lv-button">Demander un échange</button>
          </div>
          <p class="reading-boundary">Recevoir la synthèse reste séparé d’une demande d’échange. Aucune information n’est transmise à Mouaad sans action explicite.</p>
        </section>
      </div>
    </div>
  </div>
</Layout>

<style>
  .research-demo { min-height: calc(100svh - var(--lv-header)); background: var(--lv-paper); }
  .demo-header { min-height: 116px; display: grid; grid-template-columns: 1fr auto; align-items: stretch; border-bottom: 1px solid var(--lv-aubergine); background: var(--lv-chalk); }
  .demo-header > div { display: flex; align-items: baseline; gap: 22px; padding: 24px var(--lv-edge); }
  .demo-header p { margin: 0; color: var(--lv-muted); font-size: 11px; font-weight: 700; }
  .demo-header h1 { margin: 0; font-family: var(--lv-display); font-size: clamp(25px, 3vw, 46px); font-weight: 400; line-height: .95; letter-spacing: -.035em; }
  .state-switcher { display: grid; grid-template-columns: repeat(5, minmax(92px, 1fr)); border-left: 1px solid var(--lv-aubergine); }
  .state-switcher button { min-height: 52px; padding: 12px; border: 0; border-right: 1px solid rgba(50,16,63,.35); border-radius: 0; background: transparent; color: var(--lv-aubergine); font: 700 11px/1.25 var(--lv-sans); cursor: pointer; }
  .state-switcher button:last-child { border-right: 0; }
  .state-switcher button[aria-selected='true'] { background: var(--lv-aubergine); color: var(--lv-acid); }

  .research-shell { min-height: 720px; display: grid; grid-template-columns: minmax(190px, 18vw) 1fr; }
  .step-rail { display: flex; flex-direction: column; justify-content: space-between; padding: 32px 0 28px var(--lv-edge); border-right: 1px solid var(--lv-aubergine); background: var(--lv-chalk); }
  .step-rail ol { margin: 0; padding: 0; list-style: none; }
  .step-rail li { position: relative; min-height: 66px; display: grid; grid-template-columns: 1fr 36px; align-items: start; gap: 14px; padding-right: 0; color: var(--lv-muted); font-size: 11px; line-height: 1.3; }
  .step-rail li i { position: relative; height: 1px; margin-top: 7px; background: var(--lv-line); }
  .step-rail li i::after { position: absolute; top: -4px; right: 0; width: 9px; height: 9px; border: 1px solid var(--lv-line); background: var(--lv-chalk); content: ''; }
  .step-rail li.is-current { color: var(--lv-aubergine); font-weight: 800; }
  .step-rail li.is-current i { background: var(--lv-fuchsia); }
  .step-rail li.is-current i::after { border-color: var(--lv-fuchsia); background: var(--lv-acid); }
  .step-rail > p { margin: 0; font-size: 11px; line-height: 1.4; }
  .step-rail > p strong { color: var(--lv-fuchsia); }

  .state-stage { min-width: 0; position: relative; }
  .demo-panel { min-height: 720px; }
  .demo-panel[hidden] { display: none; }

  .opening-panel { display: grid; grid-template-columns: 1.15fr .85fr; }
  .opening-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(48px, 7vw, 110px) var(--lv-edge); border-right: 1px solid var(--lv-aubergine); }
  .opening-copy .lv-headline { max-width: 13ch; }
  .opening-copy .lv-lead { margin-top: 30px; }
  .opening-copy ul { margin: 30px 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--lv-aubergine); list-style: none; }
  .opening-copy li { min-height: 82px; display: flex; align-items: center; padding: 15px; border-right: 1px solid var(--lv-aubergine); font-size: 11px; line-height: 1.4; }
  .opening-copy li:last-child { border-right: 0; }
  .opening-copy .lv-button { width: min(430px, 100%); }
  .opening-map { display: grid; grid-template-rows: repeat(4, 1fr); background: var(--lv-aubergine); color: var(--lv-paper); }
  .opening-map span { position: relative; display: flex; align-items: flex-end; padding: 28px; border-bottom: 1px solid rgba(245,242,232,.35); font-size: clamp(18px, 2vw, 29px); font-weight: 800; line-height: 1.05; }
  .opening-map span::before { position: absolute; top: 0; left: 20%; width: 1px; height: 58%; background: var(--lv-acid); content: ''; }
  .opening-map span:nth-child(2)::before { left: 42%; background: var(--lv-fuchsia); }
  .opening-map span:nth-child(3)::before { left: 63%; }
  .opening-map span:nth-child(4) { border-bottom: 0; background: var(--lv-acid); color: var(--lv-aubergine); }
  .opening-map span:nth-child(4)::before { left: 80%; background: var(--lv-fuchsia); }

  .question-panel form, .tradeoff-panel form { min-height: 720px; display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(260px, .65fr); grid-template-rows: auto 1fr auto; }
  .question-context { grid-column: 1 / -1; min-height: 58px; display: flex; align-items: center; justify-content: space-between; padding: 12px var(--lv-edge); border-bottom: 1px solid var(--lv-aubergine); color: var(--lv-muted); font-size: 11px; font-weight: 700; }
  fieldset { min-width: 0; margin: 0; padding: clamp(40px, 5vw, 74px) var(--lv-edge); border: 0; border-right: 1px solid var(--lv-aubergine); }
  legend { max-width: 18ch; padding: 0; font-size: clamp(31px, 4vw, 58px); font-weight: 850; line-height: 1; letter-spacing: -.035em; text-wrap: balance; }
  .option-axis { margin-top: 42px; border-top: 1px solid var(--lv-aubergine); }
  .option-axis label { position: relative; min-height: 60px; display: grid; grid-template-columns: 44px 1fr; align-items: center; border-bottom: 1px solid var(--lv-aubergine); cursor: pointer; }
  .option-axis input { width: 18px; height: 18px; margin: 0 13px; accent-color: var(--lv-fuchsia); }
  .option-axis span { padding: 14px; border-left: 1px solid var(--lv-line); font-size: 14px; font-weight: 650; }
  .option-axis label:has(input:checked) { background: var(--lv-acid); }
  .inline-translator { padding: clamp(40px, 5vw, 74px) clamp(22px, 3vw, 44px); background: var(--lv-aubergine); color: var(--lv-paper); }
  .inline-translator > span { color: var(--lv-acid); font-size: 11px; font-weight: 800; }
  .inline-translator p { margin: 42px 0 0; font-size: clamp(20px, 2.4vw, 34px); font-weight: 750; line-height: 1.15; letter-spacing: -.02em; }
  .question-panel .lv-button, .tradeoff-panel .lv-button { grid-column: 1 / -1; margin: 22px var(--lv-edge) 28px auto; }
  .lv-button:disabled { background: var(--lv-line); border-color: var(--lv-line); color: var(--lv-paper); cursor: not-allowed; }

  .translator-panel { display: grid; grid-template-columns: .7fr .2fr 1.1fr; background: var(--lv-aubergine); color: var(--lv-paper); }
  .translator-source, .translator-reading { display: flex; flex-direction: column; justify-content: center; padding: var(--lv-edge); }
  .translator-source span, .translator-reading > span { color: var(--lv-acid); font-size: 11px; font-weight: 800; }
  .translator-source strong { margin-top: 28px; font-family: var(--lv-display); font-size: clamp(42px, 6vw, 86px); font-weight: 400; line-height: .9; letter-spacing: -.04em; }
  .translator-line { position: relative; border-inline: 1px solid rgba(245,242,232,.34); }
  .translator-line::before { position: absolute; top: 20%; bottom: 20%; left: 50%; width: 1px; background: var(--lv-acid); content: ''; }
  .translator-line i { position: absolute; left: calc(50% - 6px); width: 13px; height: 13px; border: 1px solid var(--lv-acid); background: var(--lv-aubergine); }
  .translator-line i:nth-child(1) { top: 20%; } .translator-line i:nth-child(2) { top: 49%; background: var(--lv-fuchsia); } .translator-line i:nth-child(3) { bottom: 20%; background: var(--lv-acid); }
  .translator-reading p { max-width: 31ch; margin: 30px 0; font-size: clamp(22px, 2.8vw, 40px); font-weight: 750; line-height: 1.16; letter-spacing: -.02em; }
  .translator-reading dl { margin: 0; border-block: 1px solid rgba(245,242,232,.36); }
  .translator-reading dl > div { display: grid; grid-template-columns: 170px 1fr; gap: 18px; padding: 13px 0; border-bottom: 1px solid rgba(245,242,232,.25); font-size: 12px; }
  .translator-reading dl > div:last-child { border-bottom: 0; }
  .translator-reading dt { color: var(--lv-lilac); } .translator-reading dd { margin: 0; }
  .translator-actions { margin-top: 30px; display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--lv-paper); }
  .translator-actions .lv-button { border: 0; }

  .tradeoff-help { max-width: 55ch; margin: 22px 0 0; color: var(--lv-muted); font-size: 13px; line-height: 1.5; }
  .tradeoff-axis { margin-top: 40px; display: grid; grid-template-columns: 1fr 90px 1fr; align-items: stretch; }
  .tradeoff-axis label { min-height: 220px; display: flex; padding: 22px; border: 1px solid var(--lv-aubergine); cursor: pointer; }
  .tradeoff-axis label:has(input:checked) { background: var(--lv-acid); }
  .tradeoff-axis input, .neutral-option input { width: 18px; height: 18px; margin: 2px 18px 0 0; flex: 0 0 auto; accent-color: var(--lv-fuchsia); }
  .tradeoff-axis span { display: flex; flex-direction: column; justify-content: space-between; gap: 40px; }
  .tradeoff-axis b { font-size: clamp(21px, 2.3vw, 32px); line-height: 1.08; }
  .tradeoff-axis small { font-size: 13px; line-height: 1.5; }
  .axis-junction { position: relative; }
  .axis-junction::before { position: absolute; top: 50%; left: 0; right: 0; height: 1px; background: var(--lv-fuchsia); content: ''; }
  .axis-junction i { position: absolute; top: calc(50% - 8px); left: calc(50% - 8px); width: 17px; height: 17px; background: var(--lv-fuchsia); }
  .neutral-option { min-height: 58px; display: flex; align-items: center; padding: 13px; border: 1px solid var(--lv-aubergine); border-top: 0; cursor: pointer; }
  .neutral-option:has(input:checked) { background: var(--lv-lilac); }
  .tradeoff-panel fieldset { grid-column: 1 / -1; border-right: 0; }

  .reading-header { display: grid; grid-template-columns: 1.1fr .9fr; align-items: end; gap: 50px; padding: 48px var(--lv-edge); border-bottom: 1px solid var(--lv-aubergine); }
  .reading-header span { color: var(--lv-fuchsia); font-size: 11px; font-weight: 800; }
  .reading-header h2 { margin-top: 18px; }
  .reading-header > p { max-width: 55ch; margin: 0; color: var(--lv-muted); font-size: 13px; line-height: 1.55; }
  .reading-grid { display: grid; grid-template-columns: repeat(2, 1fr); }
  .reading-block { min-height: 330px; display: flex; flex-direction: column; padding: 30px var(--lv-edge); border-right: 1px solid var(--lv-aubergine); border-bottom: 1px solid var(--lv-aubergine); }
  .reading-block:nth-child(2n) { border-right: 0; }
  .reading-block > span { font-size: 11px; font-weight: 800; }
  .reading-block h3 { max-width: 20ch; margin: 30px 0 0; font-size: clamp(25px, 3vw, 44px); font-weight: 850; line-height: 1; letter-spacing: -.03em; }
  .reading-block h3 em { color: var(--lv-fuchsia); font-style: normal; }
  .reading-block p, .reading-block ul { max-width: 64ch; margin: 24px 0; font-size: 13px; line-height: 1.55; }
  .reading-block ul { padding-left: 20px; }
  .reading-block li + li { margin-top: 10px; }
  .reading-block button { width: max-content; min-height: 44px; margin-top: auto; padding: 8px 0; border: 0; border-bottom: 1px solid currentColor; border-radius: 0; background: transparent; color: inherit; font: 700 12px/1.2 var(--lv-sans); cursor: pointer; }
  .reading-block--change { background: var(--lv-acid); }
  .reading-block--preserve { background: var(--lv-paper); }
  .reading-block--flex { background: var(--lv-fuchsia); color: var(--lv-paper); }
  .reading-block--verify { background: var(--lv-aubergine); color: var(--lv-paper); }
  .reading-actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; padding: 28px var(--lv-edge); background: var(--lv-aubergine); }
  .reading-actions .lv-button { border: 0; }
  .reading-boundary { margin: 0; padding: 0 var(--lv-edge) 32px; background: var(--lv-aubergine); color: var(--lv-lilac); font-size: 11px; }

  @media (max-width: 1040px) {
    .demo-header { grid-template-columns: 1fr; }
    .state-switcher { border-top: 1px solid var(--lv-aubergine); border-left: 0; overflow-x: auto; }
    .research-shell { grid-template-columns: 1fr; }
    .step-rail { min-height: auto; padding: 16px var(--lv-edge); border-right: 0; border-bottom: 1px solid var(--lv-aubergine); }
    .step-rail ol { display: grid; grid-template-columns: repeat(7, minmax(90px, 1fr)); overflow-x: auto; }
    .step-rail li { min-height: 48px; display: block; padding-right: 14px; }
    .step-rail li i { display: block; margin-top: 9px; }
    .step-rail > p { display: none; }
  }
  @media (max-width: 760px) {
    .demo-header > div { display: block; padding-block: 18px; }
    .demo-header p { margin-bottom: 8px; }
    .state-switcher { grid-template-columns: repeat(5, minmax(118px, 1fr)); }
    .opening-panel, .question-panel form, .translator-panel, .tradeoff-panel form, .reading-header { grid-template-columns: 1fr; }
    .opening-copy, fieldset { border-right: 0; border-bottom: 1px solid var(--lv-aubergine); }
    .opening-copy ul { grid-template-columns: 1fr; }
    .opening-copy li { min-height: 54px; border-right: 0; border-bottom: 1px solid var(--lv-aubergine); }
    .opening-copy li:last-child { border-bottom: 0; }
    .opening-map span { min-height: 120px; }
    .question-context { align-items: flex-start; gap: 10px; }
    .question-context span:last-child { text-align: right; }
    .question-panel .inline-translator { min-height: 280px; }
    .question-panel .lv-button, .tradeoff-panel .lv-button { margin-inline: var(--lv-edge); }
    .translator-source, .translator-reading { min-height: 310px; }
    .translator-line { min-height: 90px; border-block: 1px solid rgba(245,242,232,.34); border-inline: 0; }
    .translator-line::before { inset: 50% 15% auto; width: auto; height: 1px; }
    .translator-line i { top: calc(50% - 6px) !important; bottom: auto !important; left: auto; }
    .translator-line i:nth-child(1) { left: 15%; } .translator-line i:nth-child(2) { left: 49%; } .translator-line i:nth-child(3) { right: 15%; }
    .translator-actions { grid-template-columns: 1fr; }
    .tradeoff-axis { grid-template-columns: 1fr; }
    .tradeoff-axis label { min-height: 170px; }
    .axis-junction { min-height: 70px; }
    .axis-junction::before { top: 0; bottom: 0; left: 50%; right: auto; width: 1px; height: auto; }
    .reading-grid, .reading-actions { grid-template-columns: 1fr; }
    .reading-block { min-height: 290px; border-right: 0; }
    .reading-header { align-items: start; }
  }
</style>

<script>
  const demo = document.querySelector<HTMLElement>('[data-research-demo]');
  const stateButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-state-button]')];
  const statePanels = [...document.querySelectorAll<HTMLElement>('[data-state-panel]')];
  const progressLabel = document.querySelector<HTMLElement>('[data-progress-label]');
  const progressDetail = document.querySelector<HTMLElement>('[data-progress-detail]');
  const railSteps = [...document.querySelectorAll<HTMLElement>('[data-rail-step]')];
  const stateMeta: Record<string, { label: string; detail: string; step: number }> = {
    opening: { label: 'Ouverture', detail: 'Comprendre le cadre', step: 1 },
    question: { label: 'Question ordinaire', detail: 'Usage avant typologie', step: 4 },
    translator: { label: 'Traducteur en direct', detail: 'Ce que la réponse change', step: 4 },
    tradeoff: { label: 'Arbitrage utile', detail: 'Choisir une vérification', step: 6 },
    reading: { label: 'Première lecture', detail: 'Quatre blocs corrigeables', step: 7 },
  };

  function activateState(state: string, focusPanel = true) {
    const meta = stateMeta[state] ?? stateMeta.opening;
    if (demo) demo.dataset.currentState = state;
    stateButtons.forEach((button) => {
      const active = button.dataset.stateButton === state;
      button.setAttribute('aria-selected', String(active));
      button.tabIndex = active ? 0 : -1;
    });
    statePanels.forEach((panel) => { panel.hidden = panel.dataset.statePanel !== state; });
    railSteps.forEach((step) => step.classList.toggle('is-current', Number(step.dataset.railStep) === meta.step));
    if (progressLabel) progressLabel.textContent = meta.label;
    if (progressDetail) progressDetail.textContent = meta.detail;
    if (focusPanel) document.querySelector<HTMLElement>(`[data-state-panel="${state}"]`)?.focus({ preventScroll: true });
  }

  stateButtons.forEach((button, index) => {
    button.addEventListener('click', () => activateState(button.dataset.stateButton ?? 'opening', false));
    button.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      let next = index;
      if (event.key === 'ArrowRight') next = (index + 1) % stateButtons.length;
      if (event.key === 'ArrowLeft') next = (index - 1 + stateButtons.length) % stateButtons.length;
      if (event.key === 'Home') next = 0;
      if (event.key === 'End') next = stateButtons.length - 1;
      stateButtons[next]?.focus();
      activateState(stateButtons[next]?.dataset.stateButton ?? 'opening', false);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-go-state]').forEach((button) => {
    button.addEventListener('click', () => activateState(button.dataset.goState ?? 'opening', false));
  });

  const usageForm = document.querySelector<HTMLFormElement>('[data-usage-form]');
  const usageContinue = document.querySelector<HTMLButtonElement>('[data-needs-usage]');
  const inlineTranslator = document.querySelector<HTMLElement>('[data-inline-translator] p');
  let selectedUsage = 'Travailler ou étudier';

  function renderUsage(value: string) {
    selectedUsage = value;
    document.querySelectorAll<HTMLElement>('[data-usage-output]').forEach((element) => { element.textContent = value; });
    document.querySelectorAll<HTMLElement>('[data-usage-lower]').forEach((element) => { element.textContent = value.toLocaleLowerCase('fr-FR'); });
    if (inlineTranslator) inlineTranslator.innerHTML = `Vous avez relié le projet à un usage concret : <strong>${value}</strong>. Cela n’impose ni pièce, ni surface, ni typologie.`;
    if (usageContinue) usageContinue.disabled = false;
  }
  usageForm?.addEventListener('change', () => {
    const value = new FormData(usageForm).get('usage');
    if (typeof value === 'string') renderUsage(value);
  });

  const tradeoffForm = document.querySelector<HTMLFormElement>('[data-tradeoff-form]');
  const tradeoffContinue = document.querySelector<HTMLButtonElement>('[data-needs-tradeoff]');
  const flexTitle = document.querySelector<HTMLElement>('[data-flex-title]');
  const flexCopy = document.querySelector<HTMLElement>('[data-flex-copy]');
  tradeoffForm?.addEventListener('change', () => {
    const choice = new FormData(tradeoffForm).get('tradeoff');
    if (tradeoffContinue) tradeoffContinue.disabled = false;
    if (choice === 'preserve') {
      if (flexTitle) flexTitle.textContent = 'Tester plusieurs organisations avant de déplacer le repère géographique.';
      if (flexCopy) flexCopy.textContent = 'Vous préservez d’abord les trajets actuels. Ce compromis reste à tester, pas à adopter.';
    } else if (choice === 'change') {
      if (flexTitle) flexTitle.textContent = `Tester un autre repère géographique pour mieux faire fonctionner : ${selectedUsage.toLocaleLowerCase('fr-FR')}.`;
      if (flexCopy) flexCopy.textContent = 'Vous priorisez l’usage tout en vérifiant que les trajets restent praticables.';
    } else {
      if (flexTitle) flexTitle.textContent = 'Aucun assouplissement n’est conclu pour l’instant.';
      if (flexCopy) flexCopy.textContent = 'L’information manquante rejoint les vérifications, sans rendre un critère flexible.';
    }
  });
</script>
