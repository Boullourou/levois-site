---
import Layout from '../layouts/Layout.astro';
import { montageAsset, montageContract } from '../data/territoryC';
---

<Layout
  title="Mettre ma recherche au clair"
  description="Clarifiez ce que l’achat de votre résidence principale doit changer, ce que vous voulez préserver et ce qu’il reste à vérifier."
  territoryC={true}
  designContract={montageContract}
>
  <section class="mh-mr-shell mh-frame mh-frame--night" aria-labelledby="mh-mr-title">
    <div class="mh-mr-intro">
      <div>
        <h1 class="mh-title" id="mh-mr-title">Mettre ma recherche au clair</h1>
        <p class="mh-lead">Une première lecture utile de votre projet de résidence principale, avant toute coordonnée.</p>
      </div>
      <p class="mh-caption">Démonstrateur de cinq moments clés · aucun envoi · aucune donnée enregistrée</p>
    </div>

    <nav class="mh-mr-state-nav" aria-label="États du démonstrateur">
      <button class="mh-state-tab" type="button" data-mh-state="opening" aria-pressed="true">Ouverture</button>
      <button class="mh-state-tab" type="button" data-mh-state="question" aria-pressed="false">Question</button>
      <button class="mh-state-tab" type="button" data-mh-state="translator" aria-pressed="false">Traducteur</button>
      <button class="mh-state-tab" type="button" data-mh-state="arbitrage" aria-pressed="false">Arbitrage</button>
      <button class="mh-state-tab" type="button" data-mh-state="reading" aria-pressed="false">Première lecture</button>
    </nav>

    <div class="mh-mr-stage" aria-live="polite">
      <section class="mh-mr-panel mh-mr-opening" data-mh-panel="opening" data-active aria-labelledby="mh-opening-title">
        <div class="mh-mr-opening-copy">
          <h2 class="mh-display" id="mh-opening-title" tabindex="-1">Votre projet n’a pas besoin d’être déjà résolu.</h2>
          <p class="mh-lead">Vous nous dites ce que vous vivez. LEVOIS vous aide à comprendre ce que cela change pour votre projet immobilier, ce qui reste incertain et ce qu’il faut vérifier avant de décider.</p>
          <ul>
            <li>11 questions dans le parcours standard</li>
            <li>Première lecture avant toute coordonnée</li>
            <li>Réponses modifiables, aucun diagnostic certain</li>
          </ul>
          <button class="mh-button" type="button" data-mh-next="question">Commencer la démonstration</button>
        </div>
        <figure class="mh-mr-opening-image" aria-label={montageAsset.role}>
          <div aria-hidden="true"></div>
          <img src={montageAsset.src} alt={montageAsset.alt} width="1584" height="1056" loading="lazy" />
          <figcaption>Le flou reste visible jusqu’à ce qu’une réponse permette réellement de le lever.</figcaption>
        </figure>
      </section>

      <section class="mh-mr-panel mh-mr-question" data-mh-panel="question" aria-labelledby="mh-question-title">
        <div class="mh-mr-progress" aria-label="Étape 4 sur 7"><span style="--progress:57%"></span><b>Usage avant typologie</b><i>4 / 7</i></div>
        <form data-mh-question-form>
          <fieldset>
            <legend id="mh-question-title" tabindex="-1">Quel usage doit principalement mieux fonctionner dans votre prochain logement&nbsp;?</legend>
            <p>Une seule réponse. Elle précise un usage ; elle ne déduit ni pièce, ni surface, ni type de bien.</p>
            <div class="mh-mr-choices">
              <label class="mh-choice"><input type="radio" name="usage" value="Dormir et préserver l’intimité" /><span>Dormir et préserver l’intimité</span></label>
              <label class="mh-choice"><input type="radio" name="usage" value="Travailler ou étudier" checked /><span>Travailler ou étudier</span></label>
              <label class="mh-choice"><input type="radio" name="usage" value="Accueillir ou partager le quotidien" /><span>Accueillir ou partager le quotidien</span></label>
              <label class="mh-choice"><input type="radio" name="usage" value="Cuisiner et prendre les repas" /><span>Cuisiner et prendre les repas</span></label>
              <label class="mh-choice"><input type="radio" name="usage" value="Profiter réellement d’un extérieur" /><span>Profiter réellement d’un extérieur</span></label>
              <label class="mh-choice"><input type="radio" name="usage" value="Je ne sais pas encore" /><span>Je ne sais pas encore</span></label>
            </div>
            <button class="mh-button" type="button" data-mh-next="translator">Voir ce que cette réponse change</button>
          </fieldset>
        </form>
      </section>

      <section class="mh-mr-panel mh-mr-translator" data-mh-panel="translator" aria-labelledby="mh-translator-title">
        <div class="mh-mr-progress" aria-label="Étape 4 sur 7"><span style="--progress:57%"></span><b>Traduction en direct</b><i>4 / 7</i></div>
        <div class="mh-mr-translator-grid">
          <div>
            <p class="mh-mr-caption-line">Votre réponse</p>
            <h2 class="mh-subtitle" id="mh-translator-title" data-mh-usage-display tabindex="-1">Travailler ou étudier</h2>
          </div>
          <div class="mh-mr-translation">
            <p class="mh-mr-certainty"><span>C</span> Conséquence directe</p>
            <p>Vous avez relié le projet à un usage concret : <strong data-mh-usage-inline>travailler ou étudier</strong>. Nous pouvons maintenant examiner la forme de logement comme une hypothèse de solution, pas comme une conclusion.</p>
          </div>
        </div>
        <div class="mh-mr-panel-actions">
          <button class="mh-button mh-button--ghost" type="button" data-mh-next="question">Modifier cette réponse</button>
          <button class="mh-button" type="button" data-mh-next="arbitrage">Voir un arbitrage</button>
        </div>
      </section>

      <section class="mh-mr-panel mh-mr-arbitrage" data-mh-panel="arbitrage" aria-labelledby="mh-arbitrage-title">
        <div class="mh-mr-progress" aria-label="Étape 6 sur 7"><span style="--progress:86%"></span><b>Arbitrage utile</b><i>6 / 7</i></div>
        <div class="mh-mr-arbitrage-intro">
          <h2 class="mh-title" id="mh-arbitrage-title" tabindex="-1">Lequel de ces deux scénarios mérite d’être vérifié en premier&nbsp;?</h2>
          <p>Les deux enjeux ne sont pas déclarés incompatibles. Vous choisissez seulement la première vérification.</p>
        </div>
        <form data-mh-arbitrage-form>
          <fieldset class="mh-mr-arbitrage-options">
            <legend class="sr-only">Choisir une première vérification</legend>
            <label class="mh-mr-scenario">
              <input type="radio" name="arbitrage" value="preserve" checked />
              <span><b>Préserver d’abord les trajets actuels</b>Tester une organisation permettant de mieux travailler sans changer le repère géographique.</span>
            </label>
            <label class="mh-mr-scenario">
              <input type="radio" name="arbitrage" value="change" />
              <span><b>Prioriser l’usage du logement</b>Tester un autre repère géographique tout en mesurant l’effet sur les trajets.</span>
            </label>
            <label class="mh-mr-scenario mh-mr-scenario--quiet">
              <input type="radio" name="arbitrage" value="none" />
              <span><b>Aucun des deux</b>Ne rendre aucun critère flexible et conserver les deux vérifications ouvertes.</span>
            </label>
            <label class="mh-mr-scenario mh-mr-scenario--quiet">
              <input type="radio" name="arbitrage" value="missing" />
              <span><b>Impossible de choisir</b>Nommer l’information supplémentaire nécessaire avant d’arbitrer.</span>
            </label>
          </fieldset>
          <button class="mh-button" type="button" data-mh-next="reading">Voir ma première lecture</button>
        </form>
      </section>

      <section class="mh-mr-panel mh-mr-reading" data-mh-panel="reading" aria-labelledby="mh-reading-title">
        <div class="mh-mr-reading-head">
          <div>
            <h2 class="mh-title" id="mh-reading-title" tabindex="-1">Votre première lecture</h2>
            <p>Cette lecture reprend uniquement les réponses affichées dans ce démonstrateur. Elle ne valide ni un budget, ni un financement, ni un bien.</p>
          </div>
          <p class="mh-mr-certainty"><span>D→C</span> Déclaré puis traduit</p>
        </div>

        <div class="mh-mr-reading-blocks">
          <article>
            <span>Ce que votre achat doit changer</span>
            <h3>Faire mieux fonctionner votre quotidien.</h3>
            <p>Vous avez indiqué que l’achat doit améliorer l’espace et son organisation. Dans le quotidien, cela se traduit d’abord par <strong data-mh-reading-usage>travailler ou étudier</strong>.</p>
          </article>
          <article>
            <span>Ce que vous voulez préserver</span>
            <h3>Des trajets déjà pratiques.</h3>
            <p>Ce point reste une contrainte déclarée. La lecture n’en déduit pas qu’un autre secteur serait impossible.</p>
          </article>
          <article class="mh-mr-reading-accent">
            <span>Ce que vous pourriez assouplir</span>
            <h3 data-mh-compromise-title>La réponse à l’usage, pas le repère de trajet.</h3>
            <p data-mh-compromise-copy>Premier test : garder le repère géographique et comparer plusieurs organisations permettant de mieux travailler.</p>
          </article>
          <article>
            <span>Ce qu’il reste à décider ou vérifier</span>
            <h3>Une prochaine observation, pas un verdict.</h3>
            <p><strong>À vérifier :</strong> quelle organisation permet réellement l’usage prioritaire ? Votre réponse ne permet pas encore de conclure sur une typologie. Prochaine vérification : comparer deux plans pendant une visite.</p>
          </article>
        </div>

        <div class="mh-mr-reading-limits">
          <p>Aucune lecture DVF personnalisée · aucun montant demandé · aucune recommandation automatique de bien · aucun diagnostic certain.</p>
          <div>
            <button class="mh-button mh-button--ghost" type="button" data-mh-next="question">Modifier une réponse</button>
            <a class="mh-button" href="/contact?objet=achat">En parler avec Mouaad</a>
          </div>
        </div>
      </section>
    </div>
  </section>
</Layout>

<style>
  .mh-mr-shell { min-height: calc(100svh - 72px); }
  .mh-mr-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 40px;
    padding: clamp(52px, 6vw, 84px) var(--mh-edge) 42px;
    border-bottom: 1px solid var(--mh-line-light);
  }
  .mh-mr-intro .mh-lead { margin-top: 24px; color: var(--mh-cream-soft); }
  .mh-mr-intro .mh-caption { max-width: 28ch; text-align: right; color: var(--mh-cream-soft); }

  .mh-mr-state-nav {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    padding-inline: var(--mh-edge);
    border-bottom: 1px solid var(--mh-line-light);
  }
  .mh-state-tab {
    min-height: 58px;
    padding: 10px 12px;
    border: 0;
    border-right: 1px solid var(--mh-line-light);
    color: var(--mh-cream-soft);
    background: transparent;
    font: 600 12px/1.25 var(--mh-sans);
    text-align: left;
    cursor: pointer;
  }
  .mh-state-tab:first-child { border-left: 1px solid var(--mh-line-light); }
  .mh-state-tab[aria-pressed='true'] { color: var(--mh-night); background: var(--mh-cyan); }

  .mh-mr-stage { min-height: 660px; }
  :global(.js) .mh-mr-panel:not([data-active]) { display: none; }
  .mh-mr-panel { min-height: 660px; padding: clamp(48px, 7vw, 104px) var(--mh-edge); }
  .mh-mr-panel[data-active] { animation: mh-cut-in 420ms cubic-bezier(.2,.8,.2,1) both; }
  @keyframes mh-cut-in { from { opacity: .72; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  .mh-mr-opening { display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(50px, 8vw, 120px); align-items: center; }
  .mh-mr-opening-copy .mh-lead { margin-top: 36px; color: var(--mh-cream-soft); }
  .mh-mr-opening-copy ul { margin: 36px 0; padding: 0; list-style: none; border-top: 1px solid var(--mh-line-light); }
  .mh-mr-opening-copy li { padding: 14px 0; border-bottom: 1px solid var(--mh-line-light); font-size: 13px; }
  .mh-mr-opening-image { position: relative; min-height: 480px; margin: 0; overflow: hidden; border: 1px solid var(--mh-line-light); background: var(--mh-plum); }
  .mh-mr-opening-image > div { position: absolute; inset: 0; background: var(--mh-plum); }
  .mh-mr-opening-image img { width: 100%; height: 100%; position: absolute; inset: 0; object-fit: cover; object-position: 60% center; }
  .mh-mr-opening-image figcaption { position: absolute; right: 0; bottom: 0; left: 0; padding: 20px; color: var(--mh-night); background: var(--mh-coral); font-size: 13px; line-height: 1.5; }

  .mh-mr-progress { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 18px; padding-top: 20px; border-top: 1px solid var(--mh-line-light); }
  .mh-mr-progress span { position: absolute; top: -1px; left: 0; width: var(--progress); height: 3px; background: var(--mh-coral); }
  .mh-mr-progress b { font-size: 12px; }
  .mh-mr-progress i { color: var(--mh-cream-soft); font-size: 12px; font-style: normal; }

  .mh-mr-question form { width: min(100%, 980px); margin: 62px auto 0; }
  .mh-mr-question fieldset { margin: 0; padding: 0; border: 0; }
  .mh-mr-question legend { max-width: 18ch; padding: 0; font-family: var(--mh-serif); font-size: clamp(42px, 5vw, 72px); line-height: .96; letter-spacing: -.03em; }
  .mh-mr-question fieldset > p { max-width: 66ch; margin: 24px 0 34px; color: var(--mh-cream-soft); line-height: 1.6; }
  .mh-mr-choices { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--mh-line-light); }
  .mh-choice { position: relative; min-height: 70px; display: flex; align-items: center; border-right: 1px solid var(--mh-line-light); border-bottom: 1px solid var(--mh-line-light); cursor: pointer; }
  .mh-choice:nth-child(even) { border-right: 0; }
  .mh-choice:nth-last-child(-n + 2) { border-bottom: 0; }
  .mh-choice input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .mh-choice span { width: 100%; min-height: 70px; display: flex; align-items: center; padding: 16px 18px 16px 48px; font-size: 14px; line-height: 1.35; }
  .mh-choice span::before { position: absolute; left: 18px; width: 13px; height: 13px; border: 1px solid var(--mh-cream-soft); content: ''; }
  .mh-choice input:checked + span { color: var(--mh-night); background: var(--mh-cyan); }
  .mh-choice input:checked + span::before { border-color: var(--mh-night); background: var(--mh-night); box-shadow: inset 0 0 0 3px var(--mh-cyan); }
  .mh-mr-question .mh-button { margin-top: 28px; }

  .mh-mr-translator-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(50px, 9vw, 140px); align-items: start; margin-top: clamp(70px, 9vw, 120px); }
  .mh-mr-caption-line { margin: 0 0 18px; color: var(--mh-coral); font-size: 12px; }
  .mh-mr-translation { position: relative; padding: clamp(34px, 5vw, 64px); color: var(--mh-night); background: var(--mh-cream); }
  .mh-mr-translation::before { position: absolute; top: 0; bottom: 0; left: -22px; width: 22px; background: var(--mh-coral); content: ''; }
  .mh-mr-certainty { display: flex; align-items: center; gap: 12px; margin: 0 0 30px; font-size: 12px; font-weight: 700; }
  .mh-mr-certainty span { min-width: 34px; min-height: 34px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid currentColor; }
  .mh-mr-translation > p:last-child { margin: 0; font-family: var(--mh-serif); font-size: clamp(28px, 3vw, 44px); line-height: 1.05; }
  .mh-mr-panel-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 46px; }

  .mh-mr-arbitrage-intro { display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(40px, 8vw, 120px); align-items: end; margin: 62px 0 48px; }
  .mh-mr-arbitrage-intro > p { max-width: 52ch; margin: 0; color: var(--mh-cream-soft); line-height: 1.6; }
  .mh-mr-arbitrage-options { display: grid; grid-template-columns: 1fr 1fr; margin: 0 0 30px; padding: 0; border: 1px solid var(--mh-line-light); }
  .mh-mr-scenario { position: relative; min-height: 174px; border-right: 1px solid var(--mh-line-light); border-bottom: 1px solid var(--mh-line-light); cursor: pointer; }
  .mh-mr-scenario:nth-child(even) { border-right: 0; }
  .mh-mr-scenario:nth-last-child(-n + 2) { border-bottom: 0; }
  .mh-mr-scenario input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .mh-mr-scenario span { min-height: 174px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; padding: 24px; color: var(--mh-cream-soft); font-size: 14px; line-height: 1.55; }
  .mh-mr-scenario b { color: var(--mh-cream); font-family: var(--mh-serif); font-size: clamp(27px, 2.8vw, 39px); font-weight: 400; line-height: 1; }
  .mh-mr-scenario input:checked + span { color: var(--mh-night); background: var(--mh-coral); }
  .mh-mr-scenario input:checked + span b { color: var(--mh-night); }
  .mh-mr-scenario--quiet b { font-family: var(--mh-sans); font-size: 16px; font-weight: 700; }

  .mh-mr-reading-head { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: end; padding-bottom: 44px; border-bottom: 1px solid var(--mh-line-light); }
  .mh-mr-reading-head > div > p { max-width: 70ch; margin: 28px 0 0; color: var(--mh-cream-soft); line-height: 1.6; }
  .mh-mr-reading-head .mh-mr-certainty { margin: 0; }
  .mh-mr-reading-blocks { display: grid; grid-template-columns: 1fr 1fr; }
  .mh-mr-reading-blocks article { min-height: 310px; display: flex; flex-direction: column; justify-content: space-between; gap: 26px; padding: clamp(28px, 4vw, 52px); border-right: 1px solid var(--mh-line-light); border-bottom: 1px solid var(--mh-line-light); }
  .mh-mr-reading-blocks article:nth-child(even) { border-right: 0; }
  .mh-mr-reading-blocks article span { color: var(--mh-coral); font-size: 12px; font-weight: 700; }
  .mh-mr-reading-blocks h3 { max-width: 18ch; margin: 0; font-family: var(--mh-serif); font-size: clamp(30px, 3.2vw, 46px); font-weight: 400; line-height: 1; }
  .mh-mr-reading-blocks p { max-width: 58ch; margin: 0; color: var(--mh-cream-soft); font-size: 14px; line-height: 1.6; }
  .mh-mr-reading-accent { color: var(--mh-night); background: var(--mh-cyan); }
  .mh-mr-reading-accent span,
  .mh-mr-reading-accent p { color: var(--mh-night) !important; }
  .mh-mr-reading-limits { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center; padding-top: 38px; }
  .mh-mr-reading-limits > p { max-width: 74ch; margin: 0; color: var(--mh-cream-soft); font-size: 12px; line-height: 1.6; }
  .mh-mr-reading-limits > div { display: flex; flex-wrap: wrap; gap: 12px; }

  @media (max-width: 900px) {
    .mh-mr-intro,
    .mh-mr-opening,
    .mh-mr-translator-grid,
    .mh-mr-arbitrage-intro,
    .mh-mr-reading-head,
    .mh-mr-reading-limits { grid-template-columns: 1fr; }
    .mh-mr-intro .mh-caption { text-align: left; }
    .mh-mr-opening-image { min-height: 360px; }
    .mh-mr-translation::before { top: -16px; right: 0; bottom: auto; left: 0; width: auto; height: 16px; }
  }

  @media (max-width: 640px) {
    .mh-mr-intro,
    .mh-mr-panel { padding-inline: 20px; }
    .mh-mr-state-nav { display: flex; overflow-x: auto; padding-inline: 20px; scrollbar-width: thin; }
    .mh-state-tab { min-width: 126px; flex: 0 0 auto; }
    .mh-mr-panel { min-height: auto; }
    .mh-mr-opening-image { min-height: 300px; }
    .mh-mr-choices,
    .mh-mr-arbitrage-options,
    .mh-mr-reading-blocks { grid-template-columns: 1fr; }
    .mh-choice,
    .mh-mr-scenario,
    .mh-mr-reading-blocks article { border-right: 0; }
    .mh-choice:nth-last-child(2),
    .mh-mr-scenario:nth-last-child(2) { border-bottom: 1px solid var(--mh-line-light); }
    .mh-mr-reading-blocks article { min-height: 250px; padding: 30px 22px; }
    .mh-mr-reading-blocks article:nth-child(3) { order: 4; }
    .mh-mr-reading-blocks article:nth-child(4) { order: 3; }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-mh-state]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-mh-panel]'));
  const usageInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="usage"]'));
  const arbitrageInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="arbitrage"]'));

  const showState = (state: string, moveFocus = true) => {
    tabs.forEach((tab) => tab.setAttribute('aria-pressed', String(tab.dataset.mhState === state)));
    panels.forEach((panel) => {
      if (panel.dataset.mhPanel === state) panel.setAttribute('data-active', '');
      else panel.removeAttribute('data-active');
    });
    const active = panels.find((panel) => panel.dataset.mhPanel === state);
    if (moveFocus) active?.querySelector<HTMLElement>('h2, legend, h1')?.focus({ preventScroll: true });
    active?.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  };

  const usage = () => usageInputs.find((input) => input.checked)?.value ?? 'Je ne sais pas encore';
  const updateUsage = () => {
    const value = usage();
    document.querySelectorAll<HTMLElement>('[data-mh-usage-display]').forEach((node) => (node.textContent = value));
    document.querySelectorAll<HTMLElement>('[data-mh-usage-inline], [data-mh-reading-usage]').forEach((node) => {
      node.textContent = value.charAt(0).toLocaleLowerCase('fr-FR') + value.slice(1);
    });
  };

  const updateCompromise = () => {
    const value = arbitrageInputs.find((input) => input.checked)?.value ?? 'preserve';
    const title = document.querySelector<HTMLElement>('[data-mh-compromise-title]');
    const copy = document.querySelector<HTMLElement>('[data-mh-compromise-copy]');
    const states: Record<string, [string, string]> = {
      preserve: ['La réponse à l’usage, pas le repère de trajet.', 'Premier test : garder le repère géographique et comparer plusieurs organisations permettant de mieux travailler.'],
      change: ['Le repère géographique, sous condition.', 'Premier test : garder l’usage prioritaire et mesurer l’effet d’un autre repère géographique sur les trajets.'],
      none: ['Rien n’est déclaré flexible.', 'Les deux enjeux restent à vérifier. Aucun compromis n’est déduit de cette réponse.'],
      missing: ['Impossible à conclure pour l’instant.', 'L’information qui permettrait de comparer les deux scénarios doit d’abord être identifiée.'],
    };
    const state = states[value] ?? states.preserve;
    if (title) title.textContent = state[0];
    if (copy) copy.textContent = state[1];
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => showState(tab.dataset.mhState ?? 'opening'));
    tab.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      let target = index;
      if (event.key === 'ArrowRight') target = (index + 1) % tabs.length;
      if (event.key === 'ArrowLeft') target = (index - 1 + tabs.length) % tabs.length;
      if (event.key === 'Home') target = 0;
      if (event.key === 'End') target = tabs.length - 1;
      tabs[target]?.focus();
      showState(tabs[target]?.dataset.mhState ?? 'opening', false);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-mh-next]').forEach((button) => {
    button.addEventListener('click', () => {
      updateUsage();
      updateCompromise();
      showState(button.dataset.mhNext ?? 'opening');
    });
  });
  usageInputs.forEach((input) => input.addEventListener('change', updateUsage));
  arbitrageInputs.forEach((input) => input.addEventListener('change', updateCompromise));
  updateUsage();
  updateCompromise();
</script>
