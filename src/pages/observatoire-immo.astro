---
import Layout from '../layouts/Layout.astro';

const indicateurs = [
  {
    eyebrow: "Prix médians",
    title: "Combien ça vaut, vraiment",
    desc: "Médiane des prix demandés et des prix de transaction par typologie. Évolution trimestre après trimestre, sans extrapolation hasardeuse.",
  },
  {
    eyebrow: "Durée de marché",
    title: "Combien de temps avant vente",
    desc: "Temps moyen qu'un bien passe en annonce avant retrait, baisse, ou conclusion. Un signal puissant sur l'état réel du marché.",
  },
  {
    eyebrow: "Stock actif",
    title: "Le marché en temps réel",
    desc: "Nombre de biens en vente à Lèves, ventilation par typologie (appartements T2/T3/T4, maisons, terrains). Comparaison avec le trimestre précédent.",
  },
];

const garanties = [
  { title: "Sources transparentes", desc: "Toutes les données sont sourcées : DVF (données publiques de l'État), annonces actives, observation terrain." },
  { title: "Anonymisation", desc: "Aucun bien spécifique n'est jamais nommé sans accord explicite du propriétaire. Les données sont systématiquement agrégées." },
  { title: "Trimestriel, jamais inventé", desc: "Publication chaque trimestre, quand les données notaires sont fraîches. Si le trimestre est creux en données, je l'écris au lieu d'inventer." },
  { title: "Toujours gratuit", desc: "L'observatoire est et restera gratuit. Pas de version premium, pas de paywall, pas de publicité." },
];
---

<Layout
  title="Observatoire immobilier de Lèves"
  description="Données du marché immobilier à Lèves : prix médians, durée moyenne avant vente, stock actif. Trimestriel et gratuit, premier numéro été 2026. Inscrivez-vous pour le recevoir."
>

  <article class="max-w-page mx-auto px-edge md:px-edge-md pt-section md:pt-section-md pb-section-md">

    <!-- HERO -->
    <header class="mb-section md:mb-section-md max-w-editorial fade-up">
      <div class="eyebrow mb-6">À venir · trimestriel · gratuit</div>
      <h1 class="text-hero text-sapin leading-[0.95] mb-8">
        Observatoire<br/>
        <em class="font-normal italic text-sapin-deep">immobilier de Lèves.</em>
      </h1>
      <span class="rule-ocre"></span>
      <p class="text-body-lg text-muted max-w-prose">
        Chaque trimestre, des données concrètes sur le marché immobilier à
        Lèves et dans le bassin chartrain : annonces actives, prix médians,
        durée moyenne avant vente, tendances par secteur. Pas d'estimations
        à la louche, pas d'enthousiasme commercial — uniquement des chiffres
        vérifiés, présentés simplement.
      </p>
    </header>

    <!-- BADGE EN CONSTRUCTION -->
    <div class="mb-16 md:mb-20 fade-up">
      <div class="inline-flex items-center gap-3 border border-beige rounded-full px-5 py-2.5 bg-cream-soft">
        <span class="block w-1.5 h-1.5 rounded-full bg-ocre"></span>
        <span class="text-eyebrow uppercase text-muted">Premier numéro · été 2026</span>
      </div>
    </div>

    <!-- POURQUOI cet observatoire -->
    <section class="mb-section md:mb-section-md max-w-editorial fade-up">
      <div class="eyebrow mb-4">Pourquoi je le construis</div>
      <h2 class="text-h2 text-sapin mb-6">
        Parce qu'il n'existe pas,<br/>
        <em class="italic font-normal">et qu'il manque cruellement.</em>
      </h2>
      <span class="rule-ocre"></span>
      <div class="space-y-5 text-body-lg text-ink/85 leading-relaxed mt-6">
        <p>
          Pour décider de vendre, d'acheter, ou simplement de s'installer à Lèves,
          il faut des données fiables. Pour le moment, on trouve principalement
          des estimations approximatives, des moyennes nationales transposées,
          ou des chiffres construits par des sites commerciaux qui ont intérêt
          à les arrondir dans un sens ou dans l'autre.
        </p>
        <p>
          L'observatoire vise à combler ce manque pour Lèves et le bassin chartrain.
          Il n'apportera pas la vérité absolue — aucun observatoire ne le peut —
          mais il donnera des points de repère vérifiés, trimestre après trimestre, gratuitement.
        </p>
      </div>
    </section>

    <!-- CE QUI SERA DEDANS -->
    <section class="mb-section md:mb-section-md fade-up">
      <div class="eyebrow mb-4">Ce qu'on y trouvera</div>
      <h2 class="text-h2 text-sapin mb-3">
        Les trois indicateurs<br/>
        <em class="italic font-normal">de chaque édition.</em>
      </h2>
      <span class="rule-ocre"></span>

      <div class="space-y-0 mt-12">
        {indicateurs.map((ind, idx) => (
          <article class={`grid md:grid-cols-12 gap-4 md:gap-12 py-8 md:py-10 ${idx === 0 ? 'border-t' : ''} border-b border-beige fade-up`}>
            <div class="md:col-span-3">
              <div class="text-h3 italic text-ocre">0{idx + 1}.</div>
              <div class="eyebrow-muted mt-3">{ind.eyebrow}</div>
            </div>
            <div class="md:col-span-8">
              <h3 class="text-h3 text-sapin mb-3">{ind.title}</h3>
              <p class="text-body-lg text-muted leading-relaxed max-w-prose">{ind.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- GARANTIES ÉDITORIALES -->
    <section class="bg-cream-soft border-y border-beige py-section md:py-section-md -mx-edge md:-mx-edge-md px-edge md:px-edge-md mb-section md:mb-section-md grain">
      <div class="max-w-page mx-auto relative z-10">
        <div class="mb-12 md:mb-14 fade-up max-w-editorial">
          <div class="eyebrow mb-4">Mes engagements</div>
          <h2 class="text-display text-sapin">
            Ce sur quoi vous pouvez<br/>
            <em class="italic font-normal">vraiment compter.</em>
          </h2>
          <span class="rule-ocre"></span>
        </div>

        <div class="grid sm:grid-cols-2 gap-px bg-beige border border-beige fade-up">
          {garanties.map((g) => (
            <div class="bg-cream p-6 md:p-9">
              <h4 class="text-h3 text-sapin mb-3">{g.title}</h4>
              <p class="text-[15px] text-muted leading-relaxed">{g.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CAPTURE OPT-IN -->
    <section class="bg-sapin text-cream rounded-md p-8 md:p-12 fade-up" id="abonnement">
      <div class="max-w-editorial">

        <div class="text-eyebrow uppercase tracking-widest text-ocre-soft mb-4">M'inscrire</div>
        <h2 class="text-h2 mb-4">
          Recevoir l'observatoire<br/>
          <em class="italic font-normal">dès le premier numéro.</em>
        </h2>
        <p class="text-[15px] opacity-80 leading-relaxed mb-10 max-w-prose">
          Un email à chaque parution trimestrielle. Vous pouvez vous désinscrire
          en un clic à tout moment.
        </p>

        <form
          action="https://formspree.io/f/xnjynroj"
          method="POST"
          class="space-y-5"
        >
          <input type="hidden" name="_subject" value="[Observatoire] Nouvelle inscription" />
          <input type="hidden" name="_next" value="https://levois.fr/merci" />
          <div class="grid sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="text-eyebrow uppercase text-ocre-soft">Prénom</span>
              <input type="text" name="prenom" class="mt-1 w-full bg-sapin-deep border border-ocre/30 text-cream rounded-md px-4 py-2.5 focus:outline-none focus:border-ocre placeholder-cream/40" />
            </label>
            <label class="block">
              <span class="text-eyebrow uppercase text-ocre-soft">Email *</span>
              <input type="email" name="email" required class="mt-1 w-full bg-sapin-deep border border-ocre/30 text-cream rounded-md px-4 py-2.5 focus:outline-none focus:border-ocre placeholder-cream/40" />
            </label>
          </div>

          <fieldset class="space-y-2.5">
            <legend class="text-eyebrow uppercase text-ocre-soft mb-2">Votre profil (facultatif)</legend>
            <label class="flex items-start gap-3 text-[15px]">
              <input type="radio" name="profil" value="proprietaire" class="mt-1 accent-ocre" />
              <span>Je suis propriétaire à Lèves ou alentours</span>
            </label>
            <label class="flex items-start gap-3 text-[15px]">
              <input type="radio" name="profil" value="recherche" class="mt-1 accent-ocre" />
              <span>Je cherche à acheter dans le secteur</span>
            </label>
            <label class="flex items-start gap-3 text-[15px]">
              <input type="radio" name="profil" value="curieux" class="mt-1 accent-ocre" />
              <span>Je suis simplement curieux du marché local</span>
            </label>
            <label class="flex items-start gap-3 text-[15px]">
              <input type="radio" name="profil" value="pro" class="mt-1 accent-ocre" />
              <span>Pro de l'immo / notaire / autre</span>
            </label>
          </fieldset>

          <label class="flex items-start gap-3 text-xs opacity-80">
            <input type="checkbox" name="consentement" value="oui" required class="mt-0.5 accent-ocre" />
            <span>
              J'accepte de recevoir l'observatoire trimestriel par email. Je peux
              me désabonner à tout moment via le lien en bas de chaque email.
            </span>
          </label>

          <button type="submit" class="bg-ocre text-sapin-deep px-7 py-3.5 rounded-full hover:bg-ocre-soft transition-colors text-[15px] font-medium inline-flex items-center gap-3">
            M'inscrire
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
          </button>
        </form>
      </div>
    </section>

    <!-- ENGAGEMENT FINAL -->
    <section class="mt-section anti-vente max-w-prose fade-up">
      Si vous êtes professionnel de l'immobilier (notaire, agent, expert),
      je serai ravi d'échanger sur vos retours ou de partager mes données brutes
      sur demande. L'observatoire est aussi un outil de dialogue local.
    </section>

  </article>
</Layout>
