---
import Layout from '../layouts/Layout.astro';
import marketSummary from '../data/dvf-market-summary.json';
import { montageAsset, montageContract } from '../data/territoryC';

const levesHouses = marketSummary.series.find(
  (item) => item.commune === 'Lèves' && item.propertyType === 'Maison',
);
const local = levesHouses?.fullPeriod;
const number = new Intl.NumberFormat('fr-FR');
---

<Layout
  title="Accueil"
  description="LEVOIS aide les acheteurs et les vendeurs à comprendre leur situation immobilière, à comparer leurs options et à savoir quoi vérifier avant de décider."
  territoryC={true}
  designContract={montageContract}
>
  <section class="mh-home-hero mh-frame mh-frame--night" aria-labelledby="mh-home-title">
    <div class="mh-home-copy">
      <p class="mh-home-identity">Mouaad Boullourou · Conseiller immobilier SAFTI à Lèves, à Chartres et aux alentours</p>
      <h1 class="mh-display" id="mh-home-title">Mettre votre projet immobilier au clair avant de décider</h1>
      <p class="mh-lead mh-home-lead">
        Acheter, vendre ou comprendre les ventes locales : LEVOIS vous aide à comparer vos options et à savoir quoi vérifier avant de décider.
      </p>

      <div class="mh-home-actions" aria-label="Choisir une entrée">
        <a class="mh-home-action mh-home-action--primary" href="/ma-recherche">
          <span>Mettre ma recherche au clair</span><i aria-hidden="true">→</i>
        </a>
        <a class="mh-home-action" href="/situer-ma-vente"><span>Faire le point sur ma vente</span><i aria-hidden="true">→</i></a>
        <a class="mh-home-action" href="/votre-rue"><span>Voir les ventes autour de moi</span><i aria-hidden="true">→</i></a>
        <a class="mh-home-action" href="/contact"><span>Contacter Mouaad</span><i aria-hidden="true">→</i></a>
      </div>
      <p class="mh-caption mh-home-contract">
        Vous consultez votre première lecture avant de laisser vos coordonnées et pouvez corriger vos réponses. Aucun appel automatique.
      </p>
    </div>

    <figure class="mh-home-light" aria-label={montageAsset.role}>
      <div class="mh-home-light-fallback" aria-hidden="true"></div>
      <img src={montageAsset.src} alt={montageAsset.alt} width="1584" height="1056" loading="eager" fetchpriority="high" />
      <figcaption>
        <span>Une situation floue</span>
        <b>devient une décision habitable.</b>
      </figcaption>
    </figure>
  </section>

  <section class="mh-frame mh-frame--cream mh-home-sequence" aria-labelledby="sequence-title">
    <div class="mh-stage mh-section-pad">
      <div class="mh-home-section-head">
        <h2 class="mh-title" id="sequence-title">Une décision se monte plan après plan.</h2>
        <p class="mh-lead">LEVOIS ne remplace pas votre jugement. Il sépare ce qui est établi, ce qui semble probable et ce qu’il reste à vérifier.</p>
      </div>

      <ol class="mh-home-planes">
        <li>
          <span>Situation</span>
          <strong>Partir de ce que vous vivez.</strong>
          <p>Le contexte déclaré reste un fait. Il n’est pas transformé en diagnostic.</p>
        </li>
        <li>
          <span>Options</span>
          <strong>Voir ce que chaque réponse change.</strong>
          <p>Les conséquences directes sont distinguées des interprétations.</p>
        </li>
        <li>
          <span>Arbitrage</span>
          <strong>Comparer sans conclure à votre place.</strong>
          <p>Un compromis utile apparaît seulement s’il est soutenu par vos réponses.</p>
        </li>
        <li>
          <span>Vérification</span>
          <strong>Savoir quoi regarder ensuite.</strong>
          <p>La lecture se termine par une prochaine action rationnelle, pas par un score.</p>
        </li>
      </ol>
      <a class="mh-button mh-button--dark" href="/methode">Voir la méthode LEVOIS</a>
    </div>
  </section>

  <section class="mh-frame mh-frame--plum mh-home-local" aria-labelledby="local-title">
    <div class="mh-stage mh-section-pad">
      <div class="mh-home-local-heading">
        <h2 class="mh-title" id="local-title">Les ventes observées donnent un repère. Pas une estimation.</h2>
        <p class="mh-lead">Un aperçu des maisons enregistrées à Lèves dans les données DVF 2021–2025. La dispersion compte autant que la médiane.</p>
      </div>

      {local && (
        <dl class="mh-proof-strip mh-home-market-proof">
          <div><dt>Période observée</dt><dd>{local.years[0]}—{local.years.at(-1)}</dd></div>
          <div><dt>Ventes retenues</dt><dd>{number.format(local.count)}</dd></div>
          <div><dt>Quartile bas</dt><dd>{number.format(local.pricePerSqm.q1)} €<small>/m²</small></dd></div>
          <div><dt>Médiane</dt><dd>{number.format(local.pricePerSqm.median)} €<small>/m²</small></dd></div>
        </dl>
      )}

      <div class="mh-home-local-limit">
        <p>Ces données décrivent des transactions historiques de maisons à Lèves. Elles ne connaissent ni l’état de votre bien, ni ses travaux, ni la demande actuelle.</p>
        <a class="mh-button" href="/votre-rue">Voir un résultat local prudent</a>
      </div>
    </div>
  </section>

  <section class="mh-frame mh-frame--night mh-home-pilot" aria-labelledby="pilot-title">
    <div class="mh-stage mh-section-pad">
      <div class="mh-home-pilot-copy">
        <h2 class="mh-title" id="pilot-title">Une annonce vue, mais peu de contacts : où le mouvement s’arrête-t-il ?</h2>
        <p class="mh-lead">Le silence ne prouve pas à lui seul que le prix est trop élevé. Il faut d’abord distinguer diffusion, ouverture et contact.</p>
        <a class="mh-button" href="/ressources/annonce-vue-peu-de-contacts">Faire la lecture de l’entonnoir</a>
      </div>
      <div class="mh-home-contact-sheet" aria-label="Quatre étapes de lecture d’une annonce">
        <div><span>Diffusion</span><i></i></div>
        <div><span>Vue</span><i></i></div>
        <div><span>Ouverture</span><i></i></div>
        <div><span>Contact</span><i></i></div>
      </div>
    </div>
  </section>

  <section class="mh-frame mh-frame--coral mh-home-human" aria-labelledby="human-title">
    <div class="mh-stage mh-section-pad">
      <h2 class="mh-title" id="human-title">Quand le numérique ne suffit plus, Mouaad reprend le montage avec vous.</h2>
      <div>
        <p class="mh-lead">Aucun outil n’est obligatoire pour poser une question. Mouaad accompagne les acheteurs et les vendeurs ; les modalités d’un premier échange sont convenues selon la situation.</p>
        <a class="mh-button mh-button--dark" href="/contact">Contacter Mouaad</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .mh-home-hero {
    min-height: calc(100svh - 72px);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(360px, .65fr);
  }

  .mh-home-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(52px, 7vw, 100px) var(--mh-edge) clamp(48px, 6vw, 84px);
  }

  .mh-home-identity {
    max-width: 58ch;
    margin: 0 0 clamp(34px, 5vw, 70px);
    color: var(--mh-cream-soft);
    font-size: 12px;
    line-height: 1.55;
  }

  .mh-home-copy .mh-display {
    max-width: 14ch;
    font-size: clamp(58px, 6.4vw, 88px);
  }

  .mh-home-lead { margin-top: clamp(28px, 4vw, 48px); }

  .mh-home-actions {
    max-width: 760px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: clamp(38px, 5vw, 64px);
    border: 1px solid var(--mh-line-light);
  }

  .mh-home-action {
    min-height: 66px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 18px;
    border-right: 1px solid var(--mh-line-light);
    border-bottom: 1px solid var(--mh-line-light);
    color: var(--mh-cream);
    background: transparent;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
    transition: background 220ms ease-out, color 220ms ease-out;
  }
  .mh-home-action:nth-child(even) { border-right: 0; }
  .mh-home-action:nth-last-child(-n + 2) { border-bottom: 0; }
  .mh-home-action i { color: var(--mh-coral); font-style: normal; font-size: 20px; }
  .mh-home-action:hover { color: var(--mh-night); background: var(--mh-cyan); }
  .mh-home-action:hover i { color: inherit; }
  .mh-home-action--primary { color: var(--mh-night); background: var(--mh-coral); }
  .mh-home-action--primary i { color: inherit; }
  .mh-home-action:focus-visible { outline: 3px solid var(--mh-cyan); outline-offset: -5px; }

  .mh-home-contract { max-width: 73ch; margin-top: 22px; color: var(--mh-cream-soft); }

  .mh-home-light {
    position: relative;
    min-height: 620px;
    margin: 0;
    overflow: hidden;
    border-left: 1px solid var(--mh-line-light);
    background: var(--mh-plum);
  }

  .mh-home-light-fallback {
    position: absolute;
    inset: 0;
    background: var(--mh-plum);
  }
  .mh-home-light-fallback::before,
  .mh-home-light-fallback::after {
    position: absolute;
    width: 78%;
    height: 45%;
    background: rgba(244, 236, 220, .24);
    content: '';
    transform: rotate(-18deg);
  }
  .mh-home-light-fallback::before { right: -18%; bottom: 20%; }
  .mh-home-light-fallback::after { right: -6%; bottom: 3%; background: rgba(128, 235, 227, .28); }
  .mh-home-light img { width: 100%; height: 100%; position: absolute; inset: 0; object-fit: cover; object-position: 58% center; }
  .mh-home-light::after {
    position: absolute;
    inset: 0;
    background: rgba(18, 11, 19, .12);
    content: '';
    pointer-events: none;
  }
  .mh-home-light figcaption {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: 5px;
    padding: 24px;
    color: var(--mh-night);
    background: var(--mh-cyan);
    font-size: 12px;
  }
  .mh-home-light figcaption b { font-family: var(--mh-serif); font-size: 28px; font-weight: 400; line-height: 1; }

  .mh-home-section-head,
  .mh-home-local-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, .85fr);
    align-items: end;
    gap: clamp(42px, 8vw, 130px);
    margin-bottom: clamp(64px, 9vw, 118px);
  }

  .mh-home-planes { margin: 0 0 48px; padding: 0; list-style: none; border-top: 1px solid var(--mh-line-dark); }
  .mh-home-planes li {
    min-height: 126px;
    display: grid;
    grid-template-columns: .5fr 1.4fr 1fr;
    align-items: start;
    gap: 28px;
    padding: 26px 0;
    border-bottom: 1px solid var(--mh-line-dark);
  }
  .mh-home-planes span { padding-top: 5px; color: var(--mh-coral-dark); font-size: 12px; font-weight: 700; }
  .mh-home-planes strong { font-family: var(--mh-serif); font-size: clamp(28px, 3vw, 42px); font-weight: 400; line-height: 1; }
  .mh-home-planes p { max-width: 42ch; margin: 4px 0 0; font-size: 15px; line-height: 1.6; }

  .mh-home-market-proof { margin-bottom: 46px; }
  .mh-home-market-proof small { font: 500 12px/1 var(--mh-sans); }
  .mh-home-local-limit { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 36px; }
  .mh-home-local-limit p { max-width: 66ch; margin: 0; color: var(--mh-cream-soft); line-height: 1.65; }

  .mh-home-pilot .mh-stage { display: grid; grid-template-columns: 1fr .9fr; align-items: center; gap: clamp(60px, 10vw, 150px); }
  .mh-home-pilot-copy .mh-lead { margin-top: 32px; color: var(--mh-cream-soft); }
  .mh-home-pilot-copy .mh-button { margin-top: 38px; }
  .mh-home-contact-sheet { display: grid; border: 1px solid var(--mh-line-light); }
  .mh-home-contact-sheet div { min-height: 104px; display: grid; grid-template-columns: 100px 1fr; align-items: center; gap: 24px; padding: 18px; border-bottom: 1px solid var(--mh-line-light); }
  .mh-home-contact-sheet div:last-child { border-bottom: 0; }
  .mh-home-contact-sheet span { font-size: 12px; }
  .mh-home-contact-sheet i { height: 1px; display: block; background: var(--mh-cream); opacity: .8; }
  .mh-home-contact-sheet div:nth-child(2) i { width: 78%; background: var(--mh-cyan); }
  .mh-home-contact-sheet div:nth-child(3) i { width: 49%; background: var(--mh-coral); }
  .mh-home-contact-sheet div:nth-child(4) i { width: 28%; background: var(--mh-violet); }

  .mh-home-human .mh-stage { display: grid; grid-template-columns: 1.25fr .75fr; align-items: end; gap: clamp(50px, 9vw, 140px); }
  .mh-home-human .mh-lead { margin-bottom: 32px; }

  @media (max-width: 1020px) {
    .mh-home-hero { min-height: auto; grid-template-columns: 1fr; }
    .mh-home-light { min-height: 440px; border-top: 1px solid var(--mh-line-light); border-left: 0; }
    .mh-home-light img { object-position: center 56%; }
  }

  @media (max-width: 760px) {
    .mh-home-copy { padding-inline: 20px; }
    .mh-home-identity { margin-bottom: 38px; }
    .mh-home-actions { grid-template-columns: 1fr; }
    .mh-home-action { border-right: 0; }
    .mh-home-action:nth-last-child(2) { border-bottom: 1px solid var(--mh-line-light); }
    .mh-home-section-head,
    .mh-home-local-heading,
    .mh-home-pilot .mh-stage,
    .mh-home-human .mh-stage,
    .mh-home-local-limit { grid-template-columns: 1fr; }
    .mh-home-planes li { grid-template-columns: 1fr; gap: 11px; }
    .mh-home-planes span { padding-top: 0; }
    .mh-home-local-limit { align-items: start; }
    .mh-home-light { min-height: 340px; }
    .mh-home-light figcaption { padding: 18px 20px; }
  }
</style>
