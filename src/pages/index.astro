---
import Layout from '../layouts/Layout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import WorldGateway from '../components/home/WorldGateway.astro';
import marketSummary from '../data/dvf-market-summary.json';

const levesHouses = marketSummary.series.find(
  (series) => series.commune === 'Lèves' && series.propertyType === 'Maison',
);
if (!levesHouses) throw new Error('Série DVF absente : Lèves · Maison');

const latestMarket = levesHouses.latest;
const number = new Intl.NumberFormat('fr-FR');

const designContract = `LEVOIS_HOME_BUYER_FIRST
THESIS: Faire entrer par la recherche acheteur, puis maintenir deux portes vendeurs utiles sans les diminuer.
OWN-WORLD: Blanc de jour, bleu calme, cobalt-lime et corail; grandes figures photographiques, séparations courbes et signes en mouvement.
STORY: Clarifier un achat avant de courir les annonces; aider le vendeur à lire les signaux; rencontrer Mouaad quand les données ne suffisent plus.
FIRST VIEWPORT: La recherche acheteur est visible et active en premier; les deux parcours vendeurs restent lisibles, actionnables et proches.
FORM: Fusion approuvée C+A — passage cinématographique et trois portails vivants; seed f5d676a7.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md`;

const marketDatasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': 'https://levois.fr/#dvf-market-dataset',
  name: 'Repères DVF de Lèves et Chartres — maisons et appartements',
  description:
    'Synthèse locale des ventes immobilières passées à Lèves et Chartres : médiane du prix observé au m², quartiles, évolution annuelle et taille des échantillons.',
  url: 'https://levois.fr/#repere-local',
  inLanguage: 'fr-FR',
  license: 'https://www.etalab.gouv.fr/licence-ouverte-open-licence/',
  isAccessibleForFree: true,
  temporalCoverage: '2021/2025',
  spatialCoverage: [
    { '@type': 'Place', name: 'Lèves, Eure-et-Loir, France' },
    { '@type': 'Place', name: 'Chartres, Eure-et-Loir, France' },
  ],
  creator: { '@id': 'https://levois.fr/#organization' },
  isBasedOn: 'https://www.data.gouv.fr/fr/datasets/demandes-de-valeurs-foncieres-geolocalisees/',
  distribution: {
    '@type': 'DataDownload',
    encodingFormat: 'application/json',
    contentUrl: 'https://levois.fr/data/dvf-market-summary.json',
  },
};
---

<Layout
  title="Accueil"
  description="À Lèves, Chartres et dans le bassin chartrain, LEVOIS aide propriétaires, vendeurs et acheteurs à voir plus clair avant de décider."
  image="/images/hero-chartres-evidence-1536.webp"
  homeV2={true}
  designContract={designContract}
>
  <script type="application/ld+json" set:html={JSON.stringify(marketDatasetSchema)} />

  <div class="home-experience">
    <WorldGateway />

    <section class="local-scene" id="repere-local" aria-labelledby="local-title">
      <div class="local-map" aria-hidden="true">
        <span class="local-ring local-ring--one"></span>
        <span class="local-ring local-ring--two"></span>
        <span class="local-street local-street--one"></span>
        <span class="local-street local-street--two"></span>
        <b>LÈVES</b>
      </div>
      <div class="local-message">
        <h2 id="local-title">Un repère pour Lèves.<br /><em>Pas une estimation.</em></h2>
        <div class="local-number">
          <strong>{number.format(latestMarket.pricePerSqm.median)} <span>€/m²</span></strong>
          <p>Prix médian signé pour une maison à Lèves en {latestMarket.year}.</p>
        </div>
        <p class="local-limit">
          {latestMarket.count} ventes de maisons observées. Ce chiffre situe le marché local ; votre rue, votre bien et votre situation donnent le reste du sens.
        </p>
      </div>
      <p class="local-source">Données DVF · DGFiP · ventes passées, ni estimation ni prévision</p>
    </section>

    <section class="three-gestures" aria-label="La promesse LEVOIS">
      <p class="gesture gesture--see">Voir clair.</p>
      <p class="gesture gesture--understand">Comprendre ce qui change.</p>
      <p class="gesture gesture--choose">Choisir sans subir.</p>
      <span>Le site vous donne le premier repère. Vous gardez toujours la décision.</span>
    </section>

    <section class="human-scene" id="mouaad" aria-labelledby="human-title">
      <figure class="human-picture">
        <ResponsiveImage
          slot="mouaad-rdv"
          ratio="none"
          sizes="(min-width: 900px) 56vw, 100vw"
          class="human-image"
        />
      </figure>
      <div class="human-message">
        <h2 id="human-title">Puis il y a ce qu’aucun écran ne peut décider à votre place.</h2>
        <p>
          Je prends le relais quand votre situation mérite mieux qu’une réponse automatique. On regarde les options ensemble. Je vous explique ce que chacune change. Vous choisissez.
        </p>
        <a href="/mouaad">Faire connaissance <i aria-hidden="true"></i></a>
        <small>Mouaad Boullourou · Conseiller immobilier indépendant SAFTI · Lèves et bassin chartrain</small>
      </div>
    </section>

    <section class="side-doors" aria-labelledby="side-title">
      <header>
        <h2 id="side-title">Vous n’avez peut-être pas de projet.<br />Mais quelqu’un autour de vous, oui.</h2>
      </header>
      <div class="side-worlds">
        <a class="side-world side-world--connect" href="/recommander" data-journey="prescriber">
          <span class="side-kicker">Aider un proche</span>
          <strong>Je connais quelqu’un qui veut acheter ou vendre.</strong>
          <span class="side-action">Découvrir SAFTI Connect <i aria-hidden="true"></i></span>
        </a>
        <a class="side-world side-world--team" href="/rejoindre" data-journey="team_candidate">
          <span class="side-kicker">Ouvrir une possibilité</span>
          <strong>Et si l’immobilier devenait mon métier&nbsp;?</strong>
          <span class="side-action">En parler sans m’engager <i aria-hidden="true"></i></span>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .home-experience {
    --ink: #0b1730;
    --paper: #f7f9f5;
    --blue: #2a6ff5;
    --cobalt: #243cff;
    --lime: #d7ff42;
    --coral: #f56a5a;
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Public Sans', system-ui, sans-serif;
  }
  .home-experience *, .home-experience *::before, .home-experience *::after { box-sizing: border-box; }
  .home-experience h2, .home-experience p, .home-experience figure { margin: 0; }

  .local-scene {
    position: relative;
    min-height: 110svh;
    display: grid;
    align-items: end;
    isolation: isolate;
    overflow: hidden;
    background: #09182a;
    color: #fff;
  }
  .local-map { position: absolute; inset: 0; pointer-events: none; opacity: .95; }
  .local-map::before { content: ''; position: absolute; inset: 9% -8% -14% 43%; background: #243cff; clip-path: polygon(12% 5%,100% 0,92% 78%,47% 100%,0 75%); }
  .local-map::after { content: ''; position: absolute; width: 44vw; height: 44vw; right: -7vw; top: 8%; border: 1px solid rgba(215,255,66,.55); border-radius: 50%; }
  .local-map b { position: absolute; right: 7vw; bottom: 8vh; color: rgba(255,255,255,.1); font-family: 'Bricolage Grotesque', sans-serif; font-size: clamp(110px,20vw,330px); line-height: .8; letter-spacing: -.04em; }
  .local-ring { position: absolute; z-index: 2; border: 2px solid var(--lime); border-radius: 50%; animation: local-pulse 4s ease-out infinite; }
  .local-ring--one { width: 18px; height: 18px; right: 30%; top: 30%; }
  .local-ring--two { width: 14px; height: 14px; right: 17%; top: 54%; animation-delay: 1.4s; }
  .local-street { position: absolute; z-index: 1; right: 4%; width: 47%; height: 2px; background: rgba(255,255,255,.52); transform-origin: right center; }
  .local-street--one { top: 42%; transform: rotate(-17deg); }
  .local-street--two { top: 61%; transform: rotate(9deg); }
  .local-message {
    width: min(100%, 1500px);
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, .8fr);
    gap: clamp(42px, 7vw, 120px);
    align-items: end;
    padding: clamp(100px, 14vh, 180px) clamp(22px, 5vw, 76px) clamp(88px, 11vh, 140px);
  }
  .local-message h2 {
    max-width: 920px;
    font-family: 'Bricolage Grotesque', 'Public Sans', sans-serif;
    font-size: clamp(70px, 9vw, 140px);
    font-weight: 630;
    line-height: .96;
    letter-spacing: -.035em;
    text-wrap: balance;
  }
  .local-message h2 em { color: var(--lime); font-style: normal; }
  .local-number { align-self: center; }
  .local-number strong { display: block; font-family: 'Bricolage Grotesque', sans-serif; font-size: clamp(68px, 8vw, 124px); font-weight: 760; line-height: .95; letter-spacing: -.035em; }
  .local-number strong span { font-size: .34em; }
  .local-number p { max-width: 390px; margin-top: 18px; font-size: clamp(17px, 1.5vw, 21px); line-height: 1.45; }
  .local-limit { grid-column: 2; max-width: 520px; color: rgba(255,255,255,.78); font-size: 15px; line-height: 1.6; }
  .local-source { position: absolute; left: clamp(22px,5vw,76px); bottom: 24px; color: rgba(255,255,255,.58); font-size: 12px; }

  .three-gestures {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(100px, 14vh, 180px) clamp(22px, 5vw, 76px);
    background: #f7f9f5;
  }
  .gesture {
    width: max-content;
    max-width: 100%;
    font-family: 'Bricolage Grotesque', 'Public Sans', sans-serif;
    font-size: clamp(72px, 11.6vw, 180px);
    font-weight: 650;
    line-height: .98;
    letter-spacing: -.03em;
    animation: gesture-arrive linear both;
    animation-timeline: view();
    animation-range: entry 5% cover 45%;
  }
  .gesture--see { color: var(--blue); }
  .gesture--understand { align-self: flex-end; color: var(--cobalt); text-align: right; }
  .gesture--choose { color: var(--coral); }
  .three-gestures > span { max-width: 440px; margin: clamp(48px, 7vh, 82px) 0 0 auto; color: #526077; font-size: 16px; line-height: 1.55; }

  .human-scene { min-height: 100svh; display: grid; grid-template-columns: 1.04fr .96fr; background: #e9f3ff; }
  .human-picture { min-height: 760px; overflow: hidden; clip-path: ellipse(88% 82% at 12% 50%); }
  :global(.human-image) { width: 100%; height: 100%; }
  :global(.human-image img) { width: 100%; height: 100%; object-fit: cover; object-position: center 22%; }
  .human-message { display: flex; flex-direction: column; justify-content: center; padding: clamp(90px, 10vw, 150px) clamp(22px, 6vw, 94px) clamp(80px, 10vw, 140px) clamp(30px, 4vw, 70px); }
  .human-message h2 { max-width: 760px; font-family: 'Bricolage Grotesque', 'Public Sans', sans-serif; font-size: clamp(54px, 6vw, 96px); font-weight: 720; line-height: .98; letter-spacing: -.035em; text-wrap: balance; }
  .human-message p { max-width: 650px; margin-top: 34px; font-size: clamp(18px, 1.7vw, 23px); line-height: 1.55; }
  .human-message a { width: max-content; display: inline-flex; align-items: center; gap: 18px; margin-top: 34px; color: var(--cobalt); font-weight: 800; text-decoration: none; }
  .human-message a:hover { color: var(--ink); }
  .human-message i, .side-action i { position: relative; width: 35px; height: 12px; }
  .human-message i::before, .side-action i::before { content: ''; position: absolute; left: 0; top: 5px; width: 33px; height: 2px; background: currentColor; }
  .human-message i::after, .side-action i::after { content: ''; position: absolute; right: 0; top: 1px; width: 9px; height: 9px; border: solid currentColor; border-width: 2px 2px 0 0; transform: rotate(45deg); }
  .human-message small { max-width: 500px; margin-top: 44px; color: #526077; font-size: 12px; line-height: 1.5; }

  .side-doors { padding: clamp(100px, 12vw, 170px) 0 0; background: #fff; }
  .side-doors > header { padding: 0 clamp(22px, 5vw, 76px) clamp(64px, 8vw, 120px); }
  .side-doors h2 { max-width: 1180px; font-family: 'Bricolage Grotesque', 'Public Sans', sans-serif; font-size: clamp(58px, 7.5vw, 116px); font-weight: 720; line-height: .98; letter-spacing: -.035em; text-wrap: balance; }
  .side-worlds { min-height: 600px; display: grid; grid-template-columns: 1fr 1fr; overflow: hidden; }
  .side-world { position: relative; display: flex; flex-direction: column; justify-content: flex-end; gap: 20px; padding: clamp(50px, 7vw, 110px); color: var(--ink); text-decoration: none; transition: flex .7s cubic-bezier(.16, 1, .3, 1), background .45s ease; }
  .side-world--connect { background: #ff6a35; clip-path: ellipse(92% 112% at 8% 100%); }
  .side-world--team { margin-left: -7vw; padding-left: clamp(100px, 12vw, 190px); background: var(--lime); clip-path: ellipse(92% 112% at 92% 100%); }
  .side-world:hover { filter: saturate(1.08); }
  .side-kicker { font-size: 14px; font-weight: 780; }
  .side-world strong { max-width: 650px; font-family: 'Bricolage Grotesque', 'Public Sans', sans-serif; font-size: clamp(42px, 4.4vw, 70px); font-weight: 720; line-height: 1; letter-spacing: -.03em; }
  .side-action { width: max-content; max-width: 100%; display: inline-flex; align-items: center; gap: 18px; margin-top: 10px; font-weight: 800; }

  .home-experience :focus-visible { outline: 4px solid var(--lime); outline-offset: 5px; }
  @keyframes local-pulse { 0% { box-shadow: 0 0 0 0 rgba(215,255,66,.7); } 70% { box-shadow: 0 0 0 34px rgba(215,255,66,0); } 100% { box-shadow: 0 0 0 0 rgba(215,255,66,0); } }
  @keyframes gesture-arrive { from { opacity: .25; transform: translateX(-9vw); } to { opacity: 1; transform: none; } }

  @media (max-width: 980px) {
    .local-message { grid-template-columns: 1fr; }
    .local-limit { grid-column: auto; }
    .human-scene { grid-template-columns: 1fr; }
    .human-picture { min-height: 680px; clip-path: ellipse(84% 92% at 50% 8%); }
    .human-message { padding-top: 50px; }
  }
  @media (max-width: 720px) {
    .local-scene { min-height: 900px; }
    .local-map::before { inset: 34% -30% -4% 8%; }
    .local-map b { right: -4vw; bottom: 12vh; font-size: 34vw; }
    .local-street { width: 72%; }
    .local-message { align-self: end; gap: 34px; padding: 100px 20px 90px; }
    .local-message h2 { font-size: clamp(66px, 20vw, 96px); }
    .local-limit { font-size: 14px; }
    .three-gestures { min-height: 760px; padding-right: 20px; padding-left: 20px; }
    .gesture { font-size: clamp(66px, 21vw, 104px); }
    .gesture--understand { max-width: 95%; }
    .human-picture { min-height: 560px; }
    .human-message { padding: 44px 20px 92px; }
    .side-doors > header { padding-right: 20px; padding-left: 20px; }
    .side-worlds { min-height: 900px; grid-template-columns: 1fr; }
    .side-world { min-height: 470px; padding: 64px 24px; clip-path: ellipse(116% 100% at 50% 100%); }
    .side-world--team { margin: -60px 0 0; padding-left: 24px; clip-path: ellipse(116% 100% at 50% 100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .local-ring, .gesture { animation: none; transform: none; opacity: 1; }
  }
</style>
