---
import { site } from '../config/site';
import Analytics from '../components/Analytics.astro';
import '../styles/home-luxury.css';

const title = 'LEVOIS · Aide à la décision immobilière · Chartres Métropole';
const description = "Mettez votre projet immobilier au clair avant de vous engager. Outils d'aide à la décision et accompagnement local indépendant à Chartres, Lèves et son agglomération. Sans pression commerciale.";
const navigation = [
  { href: '/ma-recherche/', label: 'Acheter', journey: 'buyer' },
  { href: '/situer-ma-vente/', label: 'Vendre', journey: 'seller' },
  { href: '/vendre-et-acheter/', label: 'Les deux', journey: 'transition' },
  { href: '/votre-rue/', label: 'Ventes dans ma rue', journey: 'local' },
  { href: '/ressources/', label: 'Ressources' },
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#1E3A2F" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site.url + '/'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={site.url + '/assets/levois-partage.jpg'} />
    <meta property="og:url" content={site.url + '/'} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content="website" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'RealEstateAgent', name: site.name,
      url: site.url, email: site.email, telephone: site.phone,
      founder: { '@type': 'Person', name: site.mouaad.nom },
      areaServed: site.communes.map(name => ({ '@type': 'City', name })),
    })} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <!--
      THESIS: clarity before commitment, following the user-provided homepage.
      OWN-WORLD: forest green, linen, SAFTI orange and Plus Jakarta Sans.
      STORY: three projects, useful tools, then Mouaad's personal guidance.
      FIRST VIEWPORT: a calm promise and immediately usable project cards.
      FORM: thumb-friendly links, native navigation and restrained depth.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
    -->
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-name">LEVOIS<span class="brand-dot" aria-hidden="true"></span></span>
          <span class="brand-sub">Chartres & Agglomération</span>
        </a>
        <nav class="nav-links" aria-label="Navigation principale">
          {navigation.map(link => <a href={link.href} data-journey={link.journey}>{link.label}</a>)}
        </nav>
        <a href="/contact/" class="btn-header">Échanger avec Mouaad</a>
        <details class="mobile-menu">
          <summary>Menu <span aria-hidden="true">+</span></summary>
          <nav aria-label="Navigation mobile">
            {navigation.map(link => <a href={link.href} data-journey={link.journey}>{link.label}</a>)}
            <a href="/reprendre/">Reprendre ma lecture</a>
            <a href="/contact/">Échanger avec Mouaad</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="contenu" tabindex="-1">
      <section class="hero container" aria-labelledby="hero-title">
        <div class="hero-badge"><span aria-hidden="true">✦</span> Sans engagement · Sans coordonnées obligatoires</div>
        <h1 id="hero-title">Mettez votre projet immobilier au clair <span>avant de décider.</span></h1>
        <p class="hero-sub">Des outils concrets et un regard local indépendant sur Chartres, Lèves et les communes voisines pour avancer sereinement, sans pression commerciale.</p>
        <div class="portes-grid">
          <a href="/ma-recherche/" class="porte-card" data-journey="buyer">
            <div>
              <span class="porte-tag">Acquéreurs</span>
              <h2>Clarifier ma recherche d'achat</h2>
              <p>Partez de votre vie quotidienne avant les filtres techniques pour éviter le piège de la maison idéale au mauvais endroit.</p>
            </div>
            <span class="porte-btn">Lancer l'outil d'analyse <span aria-hidden="true">→</span></span>
          </a>
          <a href="/situer-ma-vente/" class="porte-card" data-journey="seller">
            <div>
              <span class="porte-tag">Propriétaires</span>
              <h2>Faire le point sur ma vente</h2>
              <p>Visites sans offre, annonce qui stagne ou préparation du prix : identifiez ce qui bloque avant de brader votre bien.</p>
            </div>
            <span class="porte-btn">Diagnostiquer ma situation <span aria-hidden="true">→</span></span>
          </a>
          <a href="/vendre-et-acheter/" class="porte-card" data-journey="transition">
            <div>
              <span class="porte-tag">Double projet</span>
              <h2>Vendre pour acheter</h2>
              <p>Sécurisez le calendrier, l'apport réel et le maillon financier sensible pour anticiper les points de blocage entre deux signatures.</p>
            </div>
            <span class="porte-btn">Organiser les deux projets <span aria-hidden="true">→</span></span>
          </a>
        </div>
      </section>

      <div class="territory-strip">
        <div class="container">
          <ul class="territory-items" aria-label="Communes couvertes">
            <li>Lèves</li><li>Chartres</li><li>Mainvilliers</li><li>Lucé</li>
            <li>Champhol</li><li>Luisant</li><li>Le Coudray</li>
          </ul>
        </div>
      </div>

      <section class="container" aria-labelledby="tools-title">
        <div class="section-title">
          <h2 id="tools-title">Des outils pensés pour éclairer, pas pour piéger.</h2>
          <p>Nos diagnostics sont en accès libre et utilisables immédiatement. Vous obtenez une lecture concrète avant même de décider si vous souhaitez en parler.</p>
        </div>
        <div class="tools-grid">
          <a href="/ressources/verifier-avant-baisse-prix/" class="tool-box">
            <span class="tool-num">01 · Vendeur</span>
            <h3>La grille anti-baisse de prix</h3>
            <p>Les vérifications indispensables sur votre annonce et vos retours de visite avant de modifier votre prix.</p>
          </a>
          <a href="/votre-rue/" class="tool-box" data-journey="local">
            <span class="tool-num">02 · Données</span>
            <h3>Les ventes réelles dans votre rue</h3>
            <p>Consultez l'historique DVF des vrais prix signés autour de chez vous, avec leurs limites méthodologiques expliquées.</p>
          </a>
          <a href="/ma-recherche/" class="tool-box" data-journey="buyer">
            <span class="tool-num">03 · Achat</span>
            <h3>Clarifier mes priorités d’achat</h3>
            <p>Partez de votre vie quotidienne pour préciser vos usages, vos priorités et les conditions de votre recherche.</p>
          </a>
        </div>
      </section>

      <section class="container" aria-labelledby="mouaad-title">
        <div class="bio-section">
          <div class="bio-photo-wrapper">
            <img src="/v7/asset-07.webp" alt="Mouaad Boullourou, conseiller immobilier SAFTI à Chartres et Lèves" class="bio-photo" width="800" height="1202" loading="lazy" decoding="async" />
          </div>
          <div class="bio-content">
            <h2 id="mouaad-title">Mouaad Boullourou</h2>
            <p class="bio-subtitle">Votre conseiller immobilier SAFTI · Chartres & Agglomération</p>
            <p>Installé avec ma famille à Lèves, j'ai créé <strong>LEVOIS</strong> pour répondre à une réalité simple : les décisions immobilières sont trop souvent prises sous pression, avec des informations partielles.</p>
            <p>Mon crédo est de vous apporter un maximum de clarté et de valeur gratuitement. Pas de démarchage forcé, pas d'estimation au doigt mouillé. Quand une démarche est comprise et utile, se faire accompagner devient une évidence.</p>
            <div class="bio-guarantee"><span aria-hidden="true">✦</span> Zéro appel automatique. Barème d'honoraires SAFTI transparent et visible avant tout engagement.</div>
            <div class="bio-actions">
              <a href="/contact/" class="btn-primary">Poser une question directe</a>
              <a href={'tel:' + site.phone} class="btn-secondary">{site.phoneDisplay}</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <p class="footer-wordmark">LEVOIS<span aria-hidden="true">.</span></p>
            <p>Démarche et outils d'aide à la décision immobilière portés par Mouaad Boullourou, conseiller indépendant SAFTI.</p>
            <p class="footer-area">Secteur : Lèves, Chartres, Mainvilliers, Lucé, Champhol, Luisant, Le Coudray et première couronne.</p>
          </div>
          <nav class="footer-col" aria-labelledby="footer-journeys">
            <h2 id="footer-journeys">Parcours</h2>
            <ul>
              <li><a href="/ma-recherche/" data-journey="buyer">Acheter un bien</a></li>
              <li><a href="/situer-ma-vente/" data-journey="seller">Faire le point sur ma vente</a></li>
              <li><a href="/vendre-et-acheter/" data-journey="transition">Vente et achat simultanés</a></li>
              <li><a href="/votre-rue/" data-journey="local">Données des ventes locales</a></li>
              <li><a href="/reprendre/">Reprendre ma lecture</a></li>
            </ul>
          </nav>
          <nav class="footer-col" aria-labelledby="footer-transparency">
            <h2 id="footer-transparency">Transparence</h2>
            <ul>
              <li><a href="/methode/">Notre méthode</a></li>
              <li><a href="https://www.safti.fr/bareme" target="_blank" rel="noopener noreferrer">Barème d'honoraires<span class="sr-only"> (nouvel onglet)</span></a></li>
              <li><a href="/mentions-legales/">Mentions légales</a></li>
              <li><a href="/confidentialite/">Confidentialité</a></li>
              <li><button type="button" data-analytics-settings>Choix de confidentialité</button></li>
            </ul>
          </nav>
        </div>
        <div class="footer-bottom">
          <p>© 2026 LEVOIS · Mouaad Boullourou · Conseiller indépendant SAFTI (RSAC Chartres). Tous droits réservés.</p>
          <p>Aucun appel automatique · Vos données restent sous votre contrôle.</p>
        </div>
      </div>
    </footer>
    <Analytics />
    <script>
      import '../scripts/experience-entry';
    </script>
  </body>
</html>
