---
import Layout from '../layouts/Layout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import dvfMeta from '../../public/data/dvf-meta.json';

const mutationCount = new Intl.NumberFormat('fr-FR').format(dvfMeta.count);
const communeCount = dvfMeta.communes.length;

const designContract = `LEVOIS_HOME_V2
THESIS: Rendre l’écart entre le bien, sa perception et la décision immédiatement visible ; refuser le hero immobilier centré sur le conseiller ou la maison idéale.
OWN-WORLD: Papier minéral, encre, cobalt et citron structurent des aplats de calibration ; la terre cuite n’apparaît qu’en contrepoint humain et local.
STORY: Le visiteur comprend les trois lectures, voit acheteurs et vendeurs former une même boucle, vérifie la preuve locale puis choisit son parcours.
FIRST VIEWPORT: Promesse typographique à gauche, mécanisme en trois états sticky à droite, deux actions de même poids sous le texte.
FORM: Mise au point, direction approuvée après le prototype A + C et son audit typographique ; seed key assigned.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md`;
---

<Layout
  title="Accueil"
  description="LEVOIS rend la valeur immobilière plus lisible pour les acheteurs comme pour les vendeurs de Lèves, Chartres et du bassin chartrain."
  image="/images/mouaad-rdv-1022.webp"
  homeV2={true}
  designContract={designContract}
>
  <div class="home-v2" data-home-v2>
    <section class="hero-scroll" id="top" data-scroll-story aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">Rendre<br />la valeur<br />lisible.</h1>
        <p>
          Que vous achetiez ou vendiez, LEVOIS remet dans le bon ordre
          <strong>les faits disponibles, la perception du marché et la décision à prendre.</strong>
        </p>
        <div class="route-pair" aria-label="Choisir votre parcours">
          <a class="route" href="/ma-recherche">
            <span class="route-copy"><small>Acheteur</small><strong>Situer ma recherche</strong></span>
            <span class="direction-mark" aria-hidden="true"></span>
          </a>
          <a class="route route-dark" href="/votre-rue">
            <span class="route-copy"><small>Vendeur</small><strong>Situer mon bien</strong></span>
            <span class="direction-mark" aria-hidden="true"></span>
          </a>
        </div>
      </div>

      <div class="story-panel" aria-label="Du bien réel à une décision plus claire">
        <div class="story-progress" aria-hidden="true"><span></span></div>
        <div class="story-intro">
          <p>Un bien. Trois lectures. Une décision plus claire.</p>
          <span class="story-status" data-story-status>Le bien</span>
        </div>
        <div class="story-steps">
          <article class="story-step is-active" data-story-step="0" data-kind="facts">
            <span class="step-mark" aria-hidden="true"></span>
            <div class="step-copy">
              <strong>Ce que le bien est.</strong>
              <p>Son emplacement, ses caractéristiques et les usages qu’il rend possibles.</p>
            </div>
          </article>
          <article class="story-step" data-story-step="1" data-kind="market">
            <span class="step-mark" aria-hidden="true"></span>
            <div class="step-copy">
              <strong>Ce que le marché perçoit.</strong>
              <p>Sa présentation, les alternatives visibles et le contexte dans lequel il apparaît.</p>
            </div>
          </article>
          <article class="story-step" data-story-step="2" data-kind="decision">
            <span class="step-mark" aria-hidden="true"></span>
            <div class="step-copy">
              <strong>Ce que vous décidez.</strong>
              <p>Acheter, vendre, attendre ou approfondir — avec les limites rendues visibles.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <div class="principles" aria-label="Principes de LEVOIS">
      <span>Une lecture locale et expliquée</span>
      <span>Des limites rendues visibles</span>
      <span>Acheteurs et vendeurs au même niveau</span>
    </div>

    <section class="market" id="marche" aria-labelledby="market-title">
      <h2 id="market-title">Deux côtés.<br /><span>Un même marché.</span></h2>
      <div class="market-flow">
        <div class="market-side">
          <strong>Une recherche mieux définie.</strong>
          <p>Critères, budget, compromis et niveau de préparation deviennent une recherche que l’on peut réellement défendre.</p>
        </div>
        <div class="market-core" aria-hidden="true">LEVOIS</div>
        <div class="market-side">
          <strong>Une vente mieux positionnée.</strong>
          <p>Les besoins des acheteurs éclairent la perception du bien, sa présentation et sa stratégie de commercialisation.</p>
        </div>
      </div>
    </section>

    <section class="method" id="methode" aria-labelledby="method-title">
      <div class="method-copy">
        <h2 id="method-title">Pas de verdict magique.</h2>
        <p>Vous voyez ce qui soutient, brouille ou fragilise une décision. L’analyse montre également ce qu’elle ne peut pas conclure.</p>
      </div>
      <div class="method-list" aria-label="Les trois gestes de la méthode">
        <div class="method-row"><strong>Constater</strong><span>Les faits disponibles.</span></div>
        <div class="method-row"><strong>Interpréter</strong><span>La perception du marché.</span></div>
        <div class="method-row"><strong>Décider</strong><span>Ce qui mérite une action.</span></div>
      </div>
    </section>

    <section class="local-proof" id="territoire" aria-labelledby="territory-title">
      <div class="local-copy">
        <h2 id="territory-title">Le bassin chartrain, documenté.</h2>
        <p class="local-lead">
          Les données publiques racontent ce qui s’est vendu. Elles ne disent ni la demande actuelle,
          ni la valeur exacte de votre bien. LEVOIS montre les repères et leurs limites dans la même lecture.
        </p>

        <dl class="proof-line" aria-label="Couverture des données locales">
          <div><dt>Mutations intégrées</dt><dd>{mutationCount}</dd></div>
          <div><dt>Période observée</dt><dd>{dvfMeta.anneesIncluses[0]}–{dvfMeta.anneesIncluses.at(-1)}</dd></div>
          <div><dt>Communes couvertes</dt><dd>{communeCount}</dd></div>
        </dl>

        <p class="proof-note">
          Source : Demandes de valeurs foncières, DGFiP — données géolocalisées par Etalab.
          Une vente voisine est un repère, pas une estimation. La base DVF n’est pas exhaustive.
        </p>
        <div class="local-actions">
          <a class="text-link" href="/votre-rue">Voir les ventes autour de mon adresse <span class="direction-mark" aria-hidden="true"></span></a>
          <a class="text-link" href="/situer-ma-vente">Situer ma vente <span class="direction-mark" aria-hidden="true"></span></a>
        </div>
      </div>

      <figure class="territory-media">
        <ResponsiveImage
          slot="territoire-carte"
          ratio="none"
          sizes="(min-width: 900px) 50vw, 100vw"
          class="home-territory-image"
        />
        <figcaption><strong>Lèves · Chartres</strong><span>Lecture locale, contexte explicite.</span></figcaption>
      </figure>
    </section>

    <section class="human" id="mouaad" aria-labelledby="human-title">
      <figure class="human-media">
        <ResponsiveImage
          slot="mouaad-rdv"
          ratio="none"
          sizes="(min-width: 900px) 44vw, 100vw"
          class="home-human-image"
        />
      </figure>
      <div class="human-copy">
        <h2 id="human-title">L’analyse éclaire.<br />La relation décide.</h2>
        <p class="statement">
          Une fois les signaux clarifiés, je vous aide à arbitrer les compromis, négocier et choisir la suite — que vous achetiez ou vendiez.
        </p>
        <p class="privacy-promise">Vos informations ne me sont transmises que si vous le demandez.</p>
        <div class="route-pair" aria-label="Choisir votre parcours avec Mouaad">
          <a class="route" href="/ma-recherche">
            <span class="route-copy"><small>Acheteur</small><strong>Situer ma recherche</strong></span>
            <span class="direction-mark" aria-hidden="true"></span>
          </a>
          <a class="route route-dark" href="/votre-rue">
            <span class="route-copy"><small>Vendeur</small><strong>Situer mon bien</strong></span>
            <span class="direction-mark" aria-hidden="true"></span>
          </a>
        </div>
        <p class="role">
          Mouaad Boullourou<br />
          Conseiller immobilier indépendant · Réseau SAFTI<br />
          Lèves, Chartres et bassin chartrain
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .home-v2 {
    --paper: #f2f5ef;
    --white: #ffffff;
    --ink: #111522;
    --ink-soft: #202635;
    --blue: #243cff;
    --lime: #d7ff42;
    --terra: #a84531;
    --line: #c9cec8;
    --muted: #58615b;
    --display: 'Archivo Black', sans-serif;
    --sans: 'Public Sans', system-ui, sans-serif;
    --header-h: 78px;
    --page-pad: clamp(22px, 5vw, 76px);
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
  }

  .home-v2 *, .home-v2 *::before, .home-v2 *::after { box-sizing: border-box; }
  .home-v2 a { color: inherit; }
  .home-v2 h1, .home-v2 h2, .home-v2 p, .home-v2 figure, .home-v2 dl, .home-v2 dd { margin: 0; }

  .hero-scroll {
    --story-progress: 0;
    min-height: 168vh;
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(480px, .94fr);
    align-items: start;
    background: var(--paper);
  }

  .hero-copy,
  .story-panel {
    position: sticky;
    top: var(--header-h);
    min-height: calc(100svh - var(--header-h));
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(58px, 7vw, 104px) var(--page-pad) 58px;
  }

  .hero-copy h1 {
    max-width: 760px;
    font-family: var(--display);
    font-size: clamp(56px, 7vw, 96px);
    line-height: .9;
    letter-spacing: -.035em;
    text-wrap: balance;
  }

  .hero-copy > p {
    max-width: 620px;
    margin-top: 34px;
    font-size: clamp(18px, 1.55vw, 22px);
    line-height: 1.55;
  }
  .hero-copy > p strong { font-weight: 650; }

  .route-pair {
    width: 100%;
    max-width: 680px;
    margin-top: 38px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
    border: 2px solid var(--ink);
    background: var(--ink);
  }

  .route {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 15px 20px;
    background: var(--paper);
    text-decoration: none;
    transition: background-color .2s ease-out, color .2s ease-out;
  }
  .route:hover { background: var(--lime); }
  .route-dark { background: var(--ink); color: var(--paper) !important; }
  .route-dark:hover { background: var(--blue); }
  .route-copy { display: grid; gap: 4px; }
  .route-copy small { color: currentColor; font-size: 12px; line-height: 1; opacity: .66; }
  .route-copy strong { font-size: 15px; line-height: 1.25; font-weight: 650; }

  .direction-mark {
    position: relative;
    width: 29px;
    height: 12px;
    flex: 0 0 29px;
  }
  .direction-mark::before {
    content: '';
    position: absolute;
    left: 0;
    right: 2px;
    top: 5px;
    height: 2px;
    background: currentColor;
  }
  .direction-mark::after {
    content: '';
    position: absolute;
    right: 1px;
    top: 1px;
    width: 8px;
    height: 8px;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    transform: rotate(45deg);
  }

  .story-panel {
    position: sticky;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
  }

  .story-progress {
    position: absolute;
    z-index: 8;
    left: 0;
    right: 0;
    top: 0;
    height: 5px;
    background: rgba(242, 245, 239, .14);
  }
  .story-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--lime);
    transform: scaleX(var(--story-progress));
    transform-origin: left center;
  }

  .story-intro {
    min-height: 98px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 26px clamp(26px, 3vw, 44px) 22px;
    border-bottom: 1px solid rgba(242, 245, 239, .28);
  }
  .story-intro p { max-width: 430px; font-size: 16px; line-height: 1.45; }
  .story-status { color: #d5dad4; font-size: 13px; white-space: nowrap; }
  .story-steps { display: grid; grid-template-rows: repeat(3, minmax(0, 1fr)); }

  .story-step {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    align-items: center;
    gap: clamp(18px, 2.4vw, 34px);
    padding: clamp(24px, 3vw, 42px);
    border-bottom: 1px solid rgba(242, 245, 239, .24);
    overflow: hidden;
  }
  .story-step:last-child { border-bottom: 0; }
  .story-step[data-kind='facts'] { background: var(--blue); }
  .story-step[data-kind='market'] { background: var(--ink-soft); }
  .story-step[data-kind='decision'] { background: var(--lime); color: var(--ink); }

  .story-ready .story-step { background: transparent; color: var(--paper); }
  .story-ready .story-step::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    clip-path: inset(0 100% 0 0);
    transition: clip-path .7s cubic-bezier(.16, 1, .3, 1);
  }
  .story-ready .story-step[data-kind='facts']::before { background: var(--blue); }
  .story-ready .story-step[data-kind='market']::before { background: var(--ink-soft); }
  .story-ready .story-step[data-kind='decision']::before { background: var(--lime); }
  .story-ready .story-step.is-active::before { clip-path: inset(0); }
  .story-ready .story-step[data-kind='decision'].is-active { color: var(--ink); }

  .step-mark {
    width: 28px;
    height: 2px;
    background: currentColor;
    opacity: .58;
    transform-origin: left center;
  }
  .story-ready .step-mark { opacity: .44; transform: scaleX(.78); transition: transform .4s cubic-bezier(.16, 1, .3, 1), opacity .2s ease-out; }
  .story-ready .story-step.is-active .step-mark { opacity: 1; transform: scaleX(1); }
  .step-copy strong {
    display: block;
    max-width: 520px;
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -.025em;
    text-wrap: balance;
  }
  .step-copy p { max-width: 520px; margin-top: 12px; font-size: clamp(15px, 1.2vw, 18px); line-height: 1.45; }
  .story-ready .step-copy { opacity: .58; transform: translateX(-5px); transition: opacity .28s ease-out, transform .5s cubic-bezier(.16, 1, .3, 1); }
  .story-ready .story-step.is-active .step-copy { opacity: 1; transform: none; }

  .principles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .principles span {
    min-height: 66px;
    display: flex;
    align-items: center;
    padding: 15px var(--page-pad);
    border-right: 1px solid var(--ink);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }
  .principles span:nth-child(2) { color: var(--terra); }
  .principles span:last-child { border-right: 0; }

  .market {
    padding: clamp(80px, 9vw, 138px) var(--page-pad);
    background: var(--ink);
    color: var(--paper);
  }
  .market,
  .method,
  .local-proof,
  .human { scroll-margin-top: calc(var(--header-h) + 1px); }
  .market h2,
  .method h2,
  .local-copy h2,
  .human-copy h2 {
    max-width: 920px;
    font-family: var(--sans);
    font-size: clamp(42px, 5.5vw, 76px);
    font-weight: 800;
    line-height: .98;
    letter-spacing: -.03em;
    text-wrap: balance;
  }
  .market h2 span { color: var(--lime); }

  .market-flow {
    display: grid;
    grid-template-columns: 1fr 176px 1fr;
    align-items: stretch;
    margin-top: clamp(50px, 6vw, 82px);
  }
  .market-side { padding: 30px 0; border-top: 1px solid rgba(242, 245, 239, .5); border-bottom: 1px solid rgba(242, 245, 239, .5); }
  .market-side:last-child { text-align: right; }
  .market-side strong { display: block; margin-bottom: 14px; font-size: clamp(24px, 2.8vw, 38px); font-weight: 650; letter-spacing: -.02em; }
  .market-side p { max-width: 470px; color: #d5dad4; font-size: 17px; line-height: 1.55; }
  .market-side:last-child p { margin-left: auto; }
  .market-core { display: grid; place-items: center; background: var(--blue); color: var(--paper); font-family: var(--display); font-size: 22px; letter-spacing: -.03em; }

  .method { min-height: 560px; display: grid; grid-template-columns: .86fr 1.14fr; background: var(--blue); color: var(--paper); }
  .method-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(64px, 8vw, 112px) var(--page-pad); }
  .method-copy p { max-width: 580px; margin-top: 30px; font-size: 19px; line-height: 1.58; }
  .method-list { display: grid; grid-template-rows: repeat(3, 1fr); background: var(--paper); color: var(--ink); }
  .method-row { display: grid; grid-template-columns: minmax(120px, .45fr) 1fr; align-items: center; gap: 28px; padding: 30px clamp(28px, 5vw, 68px); border-bottom: 1px solid var(--ink); }
  .method-row:last-child { border-bottom: 0; background: var(--lime); }
  .method-row strong { font-size: 16px; font-weight: 700; }
  .method-row span { font-size: clamp(19px, 2vw, 28px); font-weight: 600; line-height: 1.25; }

  .local-proof { min-height: 700px; display: grid; grid-template-columns: 1fr 1fr; background: var(--paper); }
  .local-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(76px, 8vw, 122px) var(--page-pad); }
  .local-lead { max-width: 680px; margin-top: 32px; font-size: clamp(18px, 1.65vw, 22px); line-height: 1.58; }
  .proof-line { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 48px; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .proof-line div { padding: 19px 18px 19px 0; border-right: 1px solid var(--ink); }
  .proof-line div + div { padding-left: 18px; }
  .proof-line div:last-child { border-right: 0; }
  .proof-line dt { color: var(--muted); font-size: 12px; line-height: 1.35; }
  .proof-line dd { margin-top: 8px; font-size: clamp(24px, 2.2vw, 34px); font-weight: 700; line-height: 1; letter-spacing: -.025em; }
  .proof-note { max-width: 660px; margin-top: 26px; padding-left: 16px; border-left: 1px solid var(--terra); color: var(--muted); font-size: 13px; line-height: 1.6; }
  .local-actions { display: flex; flex-wrap: wrap; gap: 18px 30px; margin-top: 30px; }
  .text-link { min-height: 44px; display: inline-flex; align-items: center; gap: 16px; font-size: 14px; font-weight: 650; text-underline-offset: 5px; }
  .text-link:hover { color: var(--blue); }
  .text-link .direction-mark { width: 24px; flex-basis: 24px; }

  .territory-media { position: relative; min-height: 700px; overflow: hidden; background: var(--ink); }
  :global(.home-territory-image) { width: 100%; height: 100%; }
  :global(.home-territory-image img) { filter: saturate(.78) contrast(1.06); }
  .territory-media figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px clamp(22px, 4vw, 48px);
    background: var(--terra);
    color: #fff;
    font-size: 13px;
  }
  .territory-media figcaption strong { font-size: 16px; font-weight: 700; }

  .human { min-height: 700px; display: grid; grid-template-columns: minmax(360px, .88fr) 1.12fr; background: var(--white); }
  .human-media { min-height: 700px; overflow: hidden; background: var(--ink); }
  :global(.home-human-image) { width: 100%; height: 100%; }
  :global(.home-human-image img) { filter: saturate(.9) contrast(1.03); }
  .human-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(70px, 8vw, 120px) var(--page-pad); }
  .human-copy .statement { max-width: 710px; margin-top: 34px; font-size: clamp(20px, 2vw, 28px); line-height: 1.45; }
  .privacy-promise { max-width: 600px; margin-top: 22px; padding-left: 16px; border-left: 1px solid var(--terra); color: var(--muted); font-size: 14px; line-height: 1.55; }
  .human-copy .route-pair { margin-top: 38px; }
  .human-copy .role { margin-top: 28px; color: var(--muted); font-size: 13px; line-height: 1.55; }

  .home-v2 :focus-visible { outline: 3px solid var(--blue); outline-offset: 4px; }
  .home-v2 .route-dark:focus-visible { outline-color: var(--lime); }

  @media (max-width: 1100px) {
    .proof-line { grid-template-columns: 1fr; }
    .proof-line div,
    .proof-line div + div { padding: 14px 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .proof-line div:last-child { border-bottom: 0; }
  }

  @media (max-width: 980px) {
    .home-v2 { --header-h: 104px; }
    .hero-scroll { min-height: auto; grid-template-columns: 1fr; }
    .hero-copy,
    .story-panel { position: static; min-height: auto; }
    .hero-copy { padding-top: 76px; padding-bottom: 68px; }
    .story-panel { min-height: 670px; }
    .principles { grid-template-columns: 1fr; }
    .principles span { border-right: 0; border-bottom: 1px solid var(--ink); }
    .principles span:last-child { border-bottom: 0; }
    .market-flow { grid-template-columns: 1fr; }
    .market-core { min-height: 94px; }
    .market-side:last-child { text-align: left; }
    .market-side:last-child p { margin-left: 0; }
    .method,
    .local-proof,
    .human { grid-template-columns: 1fr; }
    .method-list { min-height: 440px; }
    .territory-media { min-height: 580px; order: -1; }
    .human-media { min-height: 600px; max-height: 760px; }
  }

  @media (max-width: 620px) {
    .home-v2 { --page-pad: 20px; }
    .hero-copy h1 { font-size: clamp(52px, 16vw, 72px); }
    .hero-copy > p { margin-top: 28px; font-size: 17px; }
    .route-pair { grid-template-columns: 1fr; }
    .route { min-height: 70px; }
    .story-panel { min-height: 720px; }
    .story-intro { min-height: 112px; align-items: flex-start; flex-direction: column; gap: 8px; padding: 26px 20px 20px; }
    .story-status { white-space: normal; }
    .story-step { grid-template-columns: 18px minmax(0, 1fr); gap: 15px; padding: 26px 20px; }
    .step-mark { width: 18px; }
    .step-copy strong { font-size: clamp(26px, 8.5vw, 34px); }
    .step-copy p { font-size: 15px; }
    .market,
    .method-copy,
    .local-copy,
    .human-copy { padding-left: 20px; padding-right: 20px; }
    .market h2,
    .method h2,
    .local-copy h2,
    .human-copy h2 { font-size: clamp(40px, 12vw, 56px); }
    .method-row { grid-template-columns: 1fr; align-content: center; gap: 8px; padding: 26px 20px; }
    .territory-media { min-height: 460px; }
    .territory-media figcaption { align-items: flex-start; flex-direction: column; gap: 5px; }
    .human-media { min-height: 520px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll { min-height: auto; }
    .hero-copy,
    .story-panel { position: static; min-height: auto; }
    .story-ready .story-step::before { clip-path: inset(0); transition: none; }
    .story-ready .step-copy { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-home-v2]');
  const story = root?.querySelector<HTMLElement>('[data-scroll-story]');
  const storySteps = Array.from(root?.querySelectorAll<HTMLElement>('[data-story-step]') ?? []);
  const storyStatus = root?.querySelector<HTMLElement>('[data-story-status]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const stageLabels = ['Le bien', 'Le marché', 'La décision'];
  let framePending = false;

  function setStaticStory() {
    if (!root || !story || !storyStatus) return;
    root.classList.remove('story-ready');
    story.style.setProperty('--story-progress', '1');
    storySteps.forEach((step) => step.classList.add('is-active'));
    storyStatus.textContent = 'Le bien · Le marché · La décision';
  }

  function updateStory() {
    framePending = false;
    if (!root || !story || !storyStatus || !storySteps.length) return;
    if (reduceMotion.matches || window.innerWidth <= 980) {
      setStaticStory();
      return;
    }

    root.classList.add('story-ready');
    const rect = story.getBoundingClientRect();
    const headerHeight = 78;
    const travel = Math.max(1, rect.height - (window.innerHeight - headerHeight));
    const progress = Math.min(1, Math.max(0, (headerHeight - rect.top) / travel));
    const activeIndex = Math.min(2, Math.floor(Math.min(progress, .9999) * 3));

    story.style.setProperty('--story-progress', progress.toFixed(4));
    storySteps.forEach((step, index) => step.classList.toggle('is-active', index === activeIndex));
    storyStatus.textContent = stageLabels[activeIndex];
  }

  function requestStoryUpdate() {
    if (framePending) return;
    framePending = true;
    requestAnimationFrame(updateStory);
  }

  window.addEventListener('scroll', requestStoryUpdate, { passive: true });
  window.addEventListener('resize', requestStoryUpdate);
  reduceMotion.addEventListener?.('change', requestStoryUpdate);
  updateStory();
</script>
