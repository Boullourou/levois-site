---
import Layout from '../layouts/Layout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import EvidenceHero from '../components/home/EvidenceHero.astro';
import marketSummary from '../data/dvf-market-summary.json';

const designContract = `LEVOIS_HOME_V2
THESIS: Rendre l’écart entre le bien, sa perception et la décision immédiatement visible ; refuser le hero immobilier centré sur le conseiller ou la maison idéale.
OWN-WORLD: Papier minéral, encre, cobalt et citron structurent des aplats de calibration ; la terre cuite n’apparaît qu’en contrepoint humain et local.
STORY: Le visiteur comprend les trois lectures, voit acheteurs et vendeurs former une même boucle, vérifie la preuve locale puis choisit son parcours.
FIRST VIEWPORT: Manifeste typographique, photographie réelle de Chartres, rail de preuves DVF et deux actions de même poids — acheteur en encre/citron, vendeur en cobalt/minéral.
FORM: Composition 2 approuvée ; la photographie passe de la couleur au monochrome pendant que les preuves locales deviennent lisibles.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md`;

const marketDatasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': 'https://levois.fr/#dvf-market-dataset',
  name: 'Repères DVF de Lèves et Chartres — maisons et appartements',
  description:
    'Synthèse locale des ventes immobilières passées à Lèves et Chartres : médiane du prix observé au m², quartiles, évolution annuelle et taille des échantillons.',
  url: 'https://levois.fr/#territoire',
  inLanguage: 'fr-FR',
  temporalCoverage: '2021/2025',
  spatialCoverage: [
    { '@type': 'Place', name: 'Lèves, Eure-et-Loir, France' },
    { '@type': 'Place', name: 'Chartres, Eure-et-Loir, France' },
  ],
  creator: { '@id': 'https://levois.fr/#organization' },
  isBasedOn: 'https://www.data.gouv.fr/fr/datasets/demandes-de-valeurs-foncieres-geolocalisees/',
  distribution: {
    '@type': 'DataDownload',
    encodingFormat: 'application/json',
    contentUrl: 'https://levois.fr/data/dvf-market-summary.json',
  },
};

const coveredYears = marketSummary.period.toYear - marketSummary.period.fromYear + 1;
const annualLocalMutations = Math.round(marketSummary.source.datasetMutationCount / coveredYears);
const localMutationCount = marketSummary.source.datasetMutationCount;
---

<Layout
  title="Accueil"
  description="LEVOIS rend la valeur immobilière plus lisible pour les acheteurs comme pour les vendeurs de Lèves, Chartres et du bassin chartrain."
  image="/images/hero-chartres-evidence-1536.webp"
  homeV2={true}
  designContract={designContract}
>
  <script type="application/ld+json" set:html={JSON.stringify(marketDatasetSchema)} />
  <div class="home-v2" data-home-v2>
    <EvidenceHero summary={marketSummary} />

    <div class="principles" aria-label="Ce que permet LEVOIS">
      <span>Voir ce que le marché a réellement signé</span>
      <span>Clarifier le besoin avant de chercher</span>
      <span>Préparer une vente avant l’urgence</span>
    </div>

    <section class="checkpoints" id="marche" aria-labelledby="checkpoints-title">
      <header class="checkpoints-intro">
        <h2 id="checkpoints-title">Faire le point avant que le calendrier décide pour vous.</h2>
        <p>
          Un checkpoint ne vous engage à rien. Il transforme une intuition en repères concrets — avant une visite,
          avant une annonce ou simplement avant qu’un changement de vie impose son rythme.
        </p>
      </header>

      <div class="checkpoint-grid">
        <article class="checkpoint checkpoint-buyer">
          <div class="checkpoint-heading">
            <span>Acheteur</span>
            <strong>Checkpoint recherche</strong>
          </div>
          <h3>Une recherche claire ouvre plus de portes.</h3>
          <p>
            Budget, surface, secteur et priorités sont confrontés aux ventes réellement enregistrées.
            Vous obtenez une première lecture avant de transmettre la moindre coordonnée.
          </p>
          <div class="checkpoint-proof">
            <strong>+ 6 000</strong>
            <span>
              conseillers SAFTI en France. Si vous choisissez de transmettre votre recherche, Mouaad peut la faire
              circuler dans son réseau et vous signaler certains biens avant leur diffusion lorsqu’ils y sont partagés.
            </span>
          </div>
          <a class="checkpoint-action" href="/ma-recherche">
            <span><strong>Faire mon checkpoint</strong><small>Gratuit · sans engagement</small></span>
            <span class="direction-mark" aria-hidden="true"></span>
          </a>
          <p class="checkpoint-source">
            Taille du réseau : <a href="https://www.safti.fr/qui-sommes-nous" rel="noopener noreferrer">SAFTI, chiffres officiels 2026</a>.
          </p>
        </article>

        <article class="checkpoint checkpoint-seller">
          <div class="checkpoint-heading">
            <span>Propriétaire</span>
            <strong>Checkpoint de sécurité</strong>
          </div>
          <h3>Le meilleur moment pour préparer une vente, c’est avant d’avoir à vendre.</h3>
          <p>
            Un imprévu n’est jamais un argument commercial. C’est une raison de disposer, dès maintenant, d’un repère
            sur votre bien et d’un interlocuteur local qui connaît déjà votre situation — sans lancer de vente.
          </p>
          <div class="checkpoint-proof">
            <strong>{annualLocalMutations.toLocaleString('fr-FR')}</strong>
            <span>
              mutations par an en moyenne dans les sept communes suivies, soit {localMutationCount.toLocaleString('fr-FR')}
              ventes recensées par DVF entre {marketSummary.period.fromYear} et {marketSummary.period.toYear}.
            </span>
          </div>
          <a class="checkpoint-action" href="/situer-ma-vente">
            <span><strong>Créer mon repère propriétaire</strong><small>Utile aujourd’hui ou plus tard</small></span>
            <span class="direction-mark" aria-hidden="true"></span>
          </a>
          <p class="checkpoint-source">Un repère de marché n’est ni une estimation automatique ni une obligation de vendre.</p>
        </article>
      </div>

      <p class="checkpoint-bridge">
        Les recherches qualifiées renforcent les ventes. Les biens bien préparés renforcent les recherches.
        <strong>Deux côtés, un même marché.</strong>
      </p>
    </section>

    <section class="method" id="methode" aria-labelledby="method-title">
      <div class="method-copy">
        <h2 id="method-title">Une décision solide tient en trois gestes.</h2>
        <p>Chaque couleur a désormais un rôle : le fait observé, sa lecture par le marché, puis l’action qui mérite d’être prise.</p>
      </div>
      <div class="method-list" aria-label="Les trois gestes de la méthode">
        <div class="method-row"><strong>Constater</strong><span>Les faits disponibles.</span></div>
        <div class="method-row"><strong>Interpréter</strong><span>La perception du marché.</span></div>
        <div class="method-row"><strong>Décider</strong><span>Ce qui mérite une action.</span></div>
      </div>
    </section>

    <section class="local-proof" id="territoire" aria-labelledby="territory-title">
      <div class="local-copy">
        <h2 id="territory-title">Les ventes passées mesurent un contexte. Pas votre bien.</h2>
        <p class="local-lead">
          Les ventes passées donnent un contexte. Elles ne connaissent ni l’état de votre bien,
          ni sa présentation, ni la demande qui le découvrira demain.
        </p>

        <dl class="proof-line" aria-label="Méthode de lecture des données locales">
          <div><dt>01 · Comparer</dt><dd>Même commune.<br />Même type de bien.</dd></div>
          <div><dt>02 · Écarter</dt><dd>Les mutations<br />multi-lots.</dd></div>
          <div><dt>03 · Situer</dt><dd>Médiane, quartiles<br />et échantillon.</dd></div>
        </dl>

        <p class="proof-note">
          Source : Demandes de valeurs foncières, DGFiP — données géolocalisées par Etalab.
          Années civiles 2021–2025. Une vente voisine est un repère, jamais une estimation individuelle.
        </p>
        <div class="local-actions">
          <a class="text-link" href="/votre-rue">Voir les ventes autour de mon adresse <span class="direction-mark" aria-hidden="true"></span></a>
          <a class="text-link" href="/situer-ma-vente">Situer ma vente <span class="direction-mark" aria-hidden="true"></span></a>
        </div>
      </div>

      <aside class="data-boundary" aria-labelledby="boundary-title">
        <h3 id="boundary-title">Ce que les prix passés ne peuvent pas décider.</h3>
        <p class="boundary-intro">Quatre informations absentes de DVF peuvent pourtant changer toute la stratégie.</p>
        <dl>
          <div><dt>La demande active aujourd’hui</dt><dd>Non mesuré</dd></div>
          <div><dt>L’état et les travaux du bien</dt><dd>Non mesuré</dd></div>
          <div><dt>La première impression de l’annonce</dt><dd>Non mesuré</dd></div>
          <div><dt>Le compromis acceptable pour un acheteur</dt><dd>Non mesuré</dd></div>
        </dl>
        <p class="boundary-conclusion">
          C’est dans cet écart entre les données et la perception que se joue la décision.
        </p>
      </aside>
    </section>

    <section class="human" id="mouaad" aria-labelledby="human-title">
      <figure class="human-media">
        <ResponsiveImage
          slot="mouaad-rdv"
          ratio="none"
          sizes="(min-width: 900px) 44vw, 100vw"
          class="home-human-image"
        />
      </figure>
      <div class="human-copy">
        <h2 id="human-title">L’analyse éclaire.<br />La relation décide.</h2>
        <p class="statement">
          Une fois les signaux clarifiés, je vous aide à arbitrer les compromis, négocier et choisir la suite — que vous achetiez ou vendiez.
        </p>
        <p class="privacy-promise">Vos informations ne me sont transmises que si vous le demandez.</p>
        <div class="route-pair" aria-label="Choisir votre parcours avec Mouaad">
          <a class="route route-buyer" href="/ma-recherche">
            <span class="route-copy"><small>Acheteur</small><strong>Faire mon checkpoint</strong></span>
            <span class="direction-mark" aria-hidden="true"></span>
          </a>
          <a class="route route-seller" href="/situer-ma-vente">
            <span class="route-copy"><small>Propriétaire</small><strong>Créer mon repère</strong></span>
            <span class="direction-mark" aria-hidden="true"></span>
          </a>
        </div>
        <p class="role">
          Mouaad Boullourou<br />
          Conseiller immobilier indépendant · Réseau SAFTI<br />
          Lèves, Chartres et bassin chartrain
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .home-v2 {
    --paper: #f2f5ef;
    --white: #ffffff;
    --ink: #111522;
    --ink-soft: #202635;
    --blue: #243cff;
    --lime: #d7ff42;
    --terra: #a84531;
    --line: #c9cec8;
    --muted: #58615b;
    --display: 'Archivo Black', sans-serif;
    --sans: 'Public Sans', system-ui, sans-serif;
    --header-h: 78px;
    --page-pad: clamp(22px, 5vw, 76px);
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
  }

  .home-v2 *, .home-v2 *::before, .home-v2 *::after { box-sizing: border-box; }
  .home-v2 a { color: inherit; }
  .home-v2 h1, .home-v2 h2, .home-v2 p, .home-v2 figure, .home-v2 dl, .home-v2 dd { margin: 0; }

  .route-pair {
    width: 100%;
    max-width: 680px;
    margin-top: 38px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
    border: 2px solid var(--ink);
    background: var(--ink);
  }

  .route {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 15px 20px;
    background: var(--paper);
    text-decoration: none;
    transition: background-color .2s ease-out, color .2s ease-out;
  }
  .route-buyer { background: var(--ink); color: var(--lime) !important; }
  .route-buyer:hover { background: var(--lime); color: var(--ink) !important; }
  .route-seller { background: var(--blue); color: var(--paper) !important; }
  .route-seller:hover { background: var(--ink); color: var(--lime) !important; }
  .route-copy { display: grid; gap: 4px; }
  .route-copy small { color: currentColor; font-size: 12px; line-height: 1; opacity: .66; }
  .route-copy strong { font-size: 15px; line-height: 1.25; font-weight: 650; }
  .route .direction-mark,
  .checkpoint-action .direction-mark { animation: cta-cue 2.8s cubic-bezier(.16,1,.3,1) infinite; }

  .direction-mark {
    position: relative;
    width: 29px;
    height: 12px;
    flex: 0 0 29px;
  }
  .direction-mark::before {
    content: '';
    position: absolute;
    left: 0;
    right: 2px;
    top: 5px;
    height: 2px;
    background: currentColor;
  }
  .direction-mark::after {
    content: '';
    position: absolute;
    right: 1px;
    top: 1px;
    width: 8px;
    height: 8px;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    transform: rotate(45deg);
  }

  @keyframes cta-cue {
    0%, 68%, 100% { transform: translateX(0); }
    76% { transform: translateX(7px); }
    84% { transform: translateX(2px); }
    90% { transform: translateX(7px); }
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .principles span {
    min-height: 66px;
    display: flex;
    align-items: center;
    padding: 15px var(--page-pad);
    border-right: 1px solid var(--ink);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }
  .principles span:nth-child(2) { color: var(--terra); }
  .principles span:last-child { border-right: 0; }

  .checkpoints {
    background: var(--ink);
    color: var(--paper);
  }
  .checkpoints,
  .method,
  .local-proof,
  .human { scroll-margin-top: calc(var(--header-h) + 1px); }
  .checkpoints h2,
  .method h2,
  .local-copy h2,
  .human-copy h2 {
    max-width: 920px;
    font-family: var(--sans);
    font-size: clamp(42px, 5.5vw, 76px);
    font-weight: 800;
    line-height: .98;
    letter-spacing: -.03em;
    text-wrap: balance;
  }
  .checkpoints-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr);
    align-items: end;
    gap: clamp(48px, 8vw, 130px);
    padding: clamp(78px, 8vw, 124px) var(--page-pad);
    border-bottom: 1px solid rgba(242,245,239,.38);
  }
  .checkpoints-intro p {
    max-width: 560px;
    color: #d5dad4;
    font-size: clamp(18px, 1.7vw, 23px);
    line-height: 1.55;
  }
  .checkpoint-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .checkpoint {
    min-height: 650px;
    display: flex;
    flex-direction: column;
    padding: clamp(50px, 5vw, 78px) var(--page-pad);
  }
  .checkpoint-buyer { background: var(--ink-soft); color: var(--paper); }
  .checkpoint-seller { background: var(--blue); color: var(--paper); }
  .checkpoint-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 18px;
    border-bottom: 1px solid currentColor;
    font-size: 12px;
    line-height: 1.25;
  }
  .checkpoint-heading span { font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .checkpoint-heading strong { font-weight: 500; opacity: .72; }
  .checkpoint h3 {
    max-width: 720px;
    margin: clamp(34px, 4.3vw, 62px) 0 0;
    font-size: clamp(35px, 3.8vw, 58px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.03em;
    text-wrap: balance;
  }
  .checkpoint > p:not(.checkpoint-source) {
    max-width: 680px;
    margin-top: 28px;
    color: rgba(242,245,239,.82);
    font-size: clamp(17px, 1.45vw, 21px);
    line-height: 1.55;
  }
  .checkpoint-proof {
    display: grid;
    grid-template-columns: minmax(120px, .38fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(20px, 3vw, 44px);
    margin-top: auto;
    padding: 28px 0;
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
  }
  .checkpoint-proof > strong {
    color: var(--lime);
    font-family: var(--display);
    font-size: clamp(42px, 4.5vw, 68px);
    font-weight: 400;
    line-height: .9;
    letter-spacing: -.04em;
    white-space: nowrap;
  }
  .checkpoint-proof span { font-size: 14px; line-height: 1.5; }
  .checkpoint-action {
    min-height: 92px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 26px;
    padding: 18px 22px;
    background: var(--lime);
    color: var(--ink) !important;
    text-decoration: none;
    transition: background-color .2s ease-out, color .2s ease-out;
  }
  .checkpoint-seller .checkpoint-action { background: var(--paper); color: var(--blue) !important; }
  .checkpoint-action:hover,
  .checkpoint-seller .checkpoint-action:hover { background: var(--ink); color: var(--lime) !important; }
  .checkpoint-action > span:first-child { display: grid; gap: 4px; }
  .checkpoint-action strong { font-size: clamp(18px, 1.65vw, 24px); line-height: 1.1; }
  .checkpoint-action small { font-size: 12px; opacity: .72; }
  .checkpoint-source {
    margin-top: 14px !important;
    color: rgba(242,245,239,.67);
    font-size: 10px;
    line-height: 1.5;
  }
  .checkpoint-source a { text-underline-offset: 3px; }
  .checkpoint-bridge {
    padding: 30px var(--page-pad);
    background: var(--lime);
    color: var(--ink);
    font-size: clamp(18px, 1.75vw, 25px);
    line-height: 1.4;
    text-align: center;
  }

  .method { min-height: 560px; display: grid; grid-template-columns: .86fr 1.14fr; background: var(--paper); color: var(--ink); }
  .method-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(64px, 8vw, 112px) var(--page-pad); }
  .method-copy p { max-width: 580px; margin-top: 30px; color: var(--muted); font-size: 19px; line-height: 1.58; }
  .method-list { display: grid; grid-template-rows: repeat(3, 1fr); }
  .method-row { display: grid; grid-template-columns: minmax(120px, .45fr) 1fr; align-items: center; gap: 28px; padding: 30px clamp(28px, 5vw, 68px); border-bottom: 1px solid var(--ink); }
  .method-row:nth-child(1) { background: var(--blue); color: var(--paper); }
  .method-row:nth-child(2) { background: var(--ink-soft); color: var(--paper); }
  .method-row:last-child { border-bottom: 0; background: var(--lime); color: var(--ink); }
  .method-row strong { font-size: 16px; font-weight: 700; }
  .method-row span { font-size: clamp(19px, 2vw, 28px); font-weight: 600; line-height: 1.25; }

  .local-proof { min-height: 700px; display: grid; grid-template-columns: 1fr 1fr; background: var(--paper); }
  .local-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(76px, 8vw, 122px) var(--page-pad); }
  .local-lead { max-width: 680px; margin-top: 32px; font-size: clamp(18px, 1.65vw, 22px); line-height: 1.58; }
  .proof-line { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 48px; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .proof-line div { padding: 19px 18px 19px 0; border-right: 1px solid var(--ink); }
  .proof-line div + div { padding-left: 18px; }
  .proof-line div:last-child { border-right: 0; }
  .proof-line dt { color: var(--muted); font-size: 12px; line-height: 1.35; }
  .proof-line dd { margin-top: 8px; font-size: clamp(17px, 1.55vw, 23px); font-weight: 700; line-height: 1.18; letter-spacing: -.02em; }
  .proof-note { max-width: 660px; margin-top: 26px; padding-left: 16px; border-left: 1px solid var(--terra); color: var(--muted); font-size: 13px; line-height: 1.6; }
  .local-actions { display: flex; flex-wrap: wrap; gap: 18px 30px; margin-top: 30px; }
  .text-link { min-height: 44px; display: inline-flex; align-items: center; gap: 16px; font-size: 14px; font-weight: 650; text-underline-offset: 5px; }
  .text-link:hover { color: var(--blue); }
  .text-link .direction-mark { width: 24px; flex-basis: 24px; }

  .data-boundary {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(70px, 8vw, 120px) var(--page-pad);
    background: var(--ink);
    color: var(--paper);
  }
  .data-boundary h3 {
    max-width: 680px;
    margin: 0;
    font-size: clamp(34px, 4vw, 58px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.03em;
    text-wrap: balance;
  }
  .boundary-intro { max-width: 620px; margin-top: 22px !important; color: #d5dad4; font-size: 16px; line-height: 1.5; }
  .data-boundary dl { margin: 36px 0 0; border-top: 1px solid rgba(242,245,239,.5); }
  .data-boundary dl div {
    min-height: 74px;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 24px;
    border-bottom: 1px solid rgba(242,245,239,.35);
  }
  .data-boundary dt { font-size: clamp(16px, 1.55vw, 22px); line-height: 1.25; }
  .data-boundary dd { color: var(--lime); font-size: 13px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .boundary-conclusion {
    max-width: 590px;
    margin-top: 42px !important;
    padding: 24px;
    background: var(--blue);
    font-size: clamp(20px, 2.1vw, 30px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -.02em;
  }

  .human { min-height: 700px; display: grid; grid-template-columns: minmax(360px, .88fr) 1.12fr; background: var(--white); }
  .human-media { min-height: 700px; overflow: hidden; background: var(--ink); }
  :global(.home-human-image) { width: 100%; height: 100%; }
  :global(.home-human-image img) { filter: saturate(.9) contrast(1.03); }
  .human-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(70px, 8vw, 120px) var(--page-pad); }
