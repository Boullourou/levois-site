---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SituationRail from '../components/SituationRail.astro';
import MethodPanels from '../components/MethodPanels.astro';
import ResourcesMosaic from '../components/ResourcesMosaic.astro';
import ProfilesGallery from '../components/ProfilesGallery.astro';
import TerritoryScene from '../components/TerritoryScene.astro';
import TeamScene from '../components/TeamScene.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
---

<Layout title="Accueil" headerTransparent={false}>

  <!-- 1 · Hero — narration en trois temps -->
  <Hero />

  <!-- 2 · Signature — respiration éditoriale (structure unique, papier) -->
  <section class="py-16 md:py-24" aria-labelledby="signature-titre">
    <div class="max-w-editorial mx-auto px-edge md:px-edge-md text-center fade-up">
      <span class="ligne-ecart mx-auto mb-8"></span>
      <h2 id="signature-titre" class="text-h2 text-encre">
        Une seule réalité.<br class="md:hidden"/> Deux lectures. <em class="text-argile">Un écart.</em>
      </h2>
      <p class="font-sans text-body-lg text-brun mt-6 max-w-prose mx-auto">
        Cet écart ne signifie pas que votre bien a un problème. Il indique qu’une information
        mérite d’être comprise — avant toute demande de coordonnées.
      </p>
    </div>
  </section>

  <!-- 3 · Bifurcation — rail éditorial des cinq situations -->
  <SituationRail />

  <!-- 4 · Méthode — cinq panneaux distincts, progression chromatique -->
  <MethodPanels />

  <!-- 5 · Quatre profils illustratifs (galerie asymétrique honnête) -->
  <ProfilesGallery />

  <!-- 6 · Ressources — mosaïque -->
  <ResourcesMosaic />

  <!-- 7 · Engagements — liste manifeste sur encre (structure unique) -->
  <section class="py-section md:py-section-md bg-encre text-papier" aria-labelledby="engagements-titre">
    <div class="max-w-page mx-auto px-edge md:px-edge-md grid md:grid-cols-12 gap-10">
      <div class="md:col-span-5 fade-up">
        <p class="eyebrow !text-argile-lum mb-4">Engagements</p>
        <h2 id="engagements-titre" class="text-display text-papier">Ce que LEVOIS<br/>ne fera jamais.</h2>
        <p class="font-sans text-body-lg text-papier/70 mt-4 max-w-md">
          La crédibilité ne se décrète pas. Elle se construit par la précision —
          et par ce qu’on refuse de faire.
        </p>
      </div>
      <ul class="md:col-span-7 grid sm:grid-cols-2 gap-x-8 gap-y-6 font-sans text-[15px] text-papier/85 fade-up">
        {[
          'Aucune estimation automatique : un prix sérieux se construit, il ne se génère pas.',
          'Aucune donnée inventée : pas de compteurs, pas de faux pourcentages, pas de faux avis.',
          'Vos coordonnées ne sont demandées qu’après la première valeur délivrée.',
          'Le site dit aussi ce qu’il ne peut pas conclure — chaque lecture affiche ses limites.',
          'Aucune urgence artificielle : vous décidez à votre rythme, ou pas du tout.',
          'Votre situation n’est transmise à Mouaad que si vous le demandez explicitement.',
        ].map((t) => (
          <li class="flex gap-3">
            <span class="ligne-ecart !bg-argile-lum !w-5 mt-3 shrink-0"></span>
            <span class="leading-relaxed">{t}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8 · Territoire — scène panoramique -->
  <TerritoryScene />

  <!-- 9 · Les visages de LEVOIS -->
  <TeamScene />

  <!-- 10 · CTA final — scène photographique -->
  <section class="pb-4" aria-labelledby="final-titre">
    <div class="max-w-page mx-auto px-edge md:px-edge-md">
      <div class="rounded-panel overflow-hidden grid md:grid-cols-2 bg-papier-vif border border-beige">
        <div class="p-8 md:p-14 flex flex-col justify-center fade-up">
          <span class="ligne-ecart mb-7"></span>
          <h2 id="final-titre" class="text-display text-encre">
            Vous n’avez pas besoin de tout changer.
            <em class="text-argile block mt-2">Vous avez besoin de savoir quoi regarder en premier.</em>
          </h2>
          <div class="flex flex-wrap gap-3 mt-8">
            <a href="/situer-ma-vente" class="btn-primaire">Situer ma vente</a>
            <a href="/contact" class="btn-secondaire">Échanger avec Mouaad</a>
          </div>
        </div>
        <div class="min-h-[280px] md:min-h-0">
          <ResponsiveImage slot="hero-dialogue" ratio="none" sizes="(min-width:768px) 50vw, 100vw" class="w-full h-full" />
        </div>
      </div>
    </div>
  </section>

</Layout>
