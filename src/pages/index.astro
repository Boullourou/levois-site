---
import { site } from '../config/site';
import Analytics from '../components/Analytics.astro';
import homeStyles from '../styles/home-luxury.css?inline';

const title = 'LEVOIS · Aide à la décision immobilière · Chartres Métropole';
const description = "Mettez votre projet immobilier au clair avant de vous engager. Outils d'aide à la décision et accompagnement local indépendant à Chartres, Lèves et son agglomération. Sans pression commerciale.";
const navigation = [
  { href: '/ma-recherche/', label: 'Acheter', journey: 'buyer' },
  { href: '/situer-ma-vente/', label: 'Vendre', journey: 'seller' },
  { href: '/vendre-et-acheter/', label: 'Les deux', journey: 'transition' },
  { href: '/votre-rue/', label: 'Ventes dans ma rue', journey: 'local' },
  { href: '/ressources/', label: 'Ressources' },
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#16382C" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site.url + '/'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={homeStyles}></style>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={site.url + '/assets/levois-partage.jpg'} />
    <meta property="og:url" content={site.url + '/'} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content="website" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'RealEstateAgent',
      name: site.name,
      url: site.url,
      email: site.email,
      telephone: site.phone,
      founder: { '@type': 'Person', name: site.mouaad.nom },
      areaServed: site.communes.map(name => ({ '@type': 'City', name })),
    })} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    
    <!-- HEADER -->
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="LEVOIS, retour à l'accueil">
          <span class="brand-name">LEVOIS<span class="brand-dot" aria-hidden="true"></span></span>
          <span class="brand-sub">Aide à la décision · Chartres & Agglomération</span>
        </a>
        <nav class="nav-links" aria-label="Navigation principale">
          {navigation.map(link => <a href={link.href} data-journey={link.journey}>{link.label}</a>)}
        </nav>
        <a href="/contact/" class="btn-header">Échanger avec Mouaad</a>
        <details class="mobile-menu">
          <summary>Menu <span aria-hidden="true">+</span></summary>
          <nav aria-label="Navigation mobile">
            {navigation.map(link => <a href={link.href} data-journey={link.journey}>{link.label}</a>)}
            <a href="/reprendre/">Reprendre ma lecture</a>
            <a href="/contact/">Échanger avec Mouaad</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="contenu" tabindex="-1">
      <!-- HERO SECTION -->
      <section class="hero container" aria-labelledby="hero-title">
        <div class="hero-intro">
          <div class="hero-badge">
            <span class="hero-badge-dot" aria-hidden="true"></span>
            Aide à la décision immobilière · Chartres & Agglomération
          </div>
          <h1 id="hero-title">
            Mettez votre projet immobilier au clair <span class="serif-accent">avant de vous engager.</span>
          </h1>
          <p class="hero-sub">
            Des outils d'analyse gratuits en accès libre et le regard indépendant d'un conseiller de quartier. Zéro pression commerciale, 100 % de clarté pour décider sereinement.
          </p>
          <div class="hero-reassurance">
            <span class="reassurance-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              100 % gratuit & sans coordonnées obligatoires
            </span>
            <span class="reassurance-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Données réelles notariées (DVF)
            </span>
            <span class="reassurance-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Zéro démarchage téléphonique
            </span>
          </div>
        </div>

        <!-- HERO PANORAMA -->
        <div class="hero-panorama-wrap">
          <picture>
            <source srcset="/images/hero-chartres-evidence-1152.avif" type="image/avif" />
            <img 
              src="/images/hero-chartres-evidence-1152.webp" 
              alt="Vue panoramique et toits du bassin chartrain et de Lèves sous une lumière naturelle" 
              class="hero-panorama-img"
              width="1152" 
              height="540" 
              loading="eager" 
              decoding="async" 
            />
          </picture>
          <div class="hero-panorama-overlay">
            <div class="hero-panorama-card">
              <div class="hero-panorama-location">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                Ancrage local : Lèves · Chartres Métropole
              </div>
              <p>
                <strong>La bonne décision commence par la bonne lecture du marché.</strong> Explorez les dynamiques réelles de votre quartier en toute indépendance.
              </p>
            </div>
          </div>
        </div>

        <!-- 3 ACTION DOORS (CARDS) -->
        <div class="section-header">
          <span class="section-tag">Parcours personnalisés</span>
          <h2>Par quoi souhaitez-vous commencer ?</h2>
          <p>Trois diagnostics interactifs conçus pour vous apporter une lecture limpide avant même de parler mandat.</p>
        </div>

        <div class="portes-grid">
          <!-- CARD 1: BUYER -->
          <a href="/ma-recherche/" class="porte-card" data-journey="buyer">
            <div class="porte-img-wrap">
              <picture>
                <source srcset="/images/levois-quartier-1000.avif" type="image/avif" />
                <img src="/images/levois-quartier-1000.webp" alt="Ruelle de quartier résidentiel à Chartres et Lèves" class="porte-img" width="400" height="250" loading="lazy" decoding="async" />
              </picture>
              <span class="porte-badge-overlay">Acquéreurs</span>
            </div>
            <div class="porte-body">
              <span class="porte-tag">01 · Recherche d'achat</span>
              <h3>Clarifier mes critères d'achat</h3>
              <p>Partez de votre vie quotidienne avant les filtres techniques pour éviter le piège de la maison idéale au mauvais endroit.</p>
              <div class="porte-btn">
                <span>Lancer l'outil d'analyse</span>
                <span class="arrow" aria-hidden="true">→</span>
              </div>
            </div>
          </a>

          <!-- CARD 2: SELLER -->
          <a href="/situer-ma-vente/" class="porte-card" data-journey="seller">
            <div class="porte-img-wrap">
              <picture>
                <source srcset="/images/hero-proprietaires-1152.avif" type="image/avif" />
                <img src="/images/hero-proprietaires-1152.webp" alt="Maison de caractère et son jardin sur le secteur de Chartres" class="porte-img" width="400" height="250" loading="lazy" decoding="async" />
              </picture>
              <span class="porte-badge-overlay">Propriétaires</span>
            </div>
            <div class="porte-body">
              <span class="porte-tag">02 · Vente de bien</span>
              <h3>Faire le point sur ma vente</h3>
              <p>Visites sans offre, annonce qui stagne ou préparation du prix : identifiez ce qui bloque avant de brader votre bien.</p>
              <div class="porte-btn">
                <span>Diagnostiquer ma situation</span>
                <span class="arrow" aria-hidden="true">→</span>
              </div>
            </div>
          </a>

          <!-- CARD 3: TRANSITION -->
          <a href="/vendre-et-acheter/" class="porte-card" data-journey="transition">
            <div class="porte-img-wrap">
              <picture>
                <source srcset="/images/hero-dialogue-1152.avif" type="image/avif" />
                <img src="/images/hero-dialogue-1152.webp" alt="Échange et plans autour d'un projet immobilier à Chartres" class="porte-img" width="400" height="250" loading="lazy" decoding="async" />
              </picture>
              <span class="porte-badge-overlay">Double projet</span>
            </div>
            <div class="porte-body">
              <span class="porte-tag">03 · Vente & Achat</span>
              <h3>Vendre pour acheter</h3>
              <p>Sécurisez le calendrier, l'apport réel et le maillon financier sensible pour anticiper tout blocage entre deux signatures.</p>
              <div class="porte-btn">
                <span>Organiser les deux projets</span>
                <span class="arrow" aria-hidden="true">→</span>
              </div>
            </div>
          </a>
        </div>
      </section>

      <!-- TERRITORY RIBBON -->
      <div class="territory-strip">
        <div class="container">
          <p class="territory-title">Territoire d'intervention direct</p>
          <ul class="territory-items" aria-label="Communes couvertes">
            <li>Lèves <span class="territory-tag-pilot">Commune pilote</span></li>
            <li>Chartres</li>
            <li>Mainvilliers</li>
            <li>Lucé</li>
            <li>Champhol</li>
            <li>Luisant</li>
            <li>Le Coudray</li>
          </ul>
        </div>
      </div>

      <!-- FREE TOOLS SECTION (HVCO) -->
      <section class="tools-section container" aria-labelledby="tools-title">
        <div class="section-header">
          <span class="section-tag">Ressources & Données</span>
          <h2 id="tools-title">Des outils concrets pour éclairer, pas pour piéger.</h2>
          <p>Nos diagnostics sont en accès libre et utilisables immédiatement. Vous obtenez une lecture concrète avant même de décider si vous souhaitez en parler.</p>
        </div>
        <div class="tools-grid">
          <a href="/ressources/verifier-avant-baisse-prix/" class="tool-box">
            <div class="tool-header-row">
              <span class="tool-num">01 · Vendeur</span>
              <span class="tool-pill-free">Accès libre</span>
            </div>
            <h3>La grille anti-baisse de prix</h3>
            <p>Les vérifications indispensables sur votre annonce et vos retours de visite avant de modifier votre prix à la baisse.</p>
            <span class="tool-link-text">Consulter la grille <span aria-hidden="true">→</span></span>
          </a>
          <a href="/votre-rue/" class="tool-box" data-journey="local">
            <div class="tool-header-row">
              <span class="tool-num">02 · Données</span>
              <span class="tool-pill-free">Accès libre</span>
            </div>
            <h3>Les ventes réelles dans votre rue</h3>
            <p>Consultez l'historique DVF des vrais prix signés autour de chez vous, avec leurs limites méthodologiques expliquées sans fard.</p>
            <span class="tool-link-text">Explorer les prix signés <span aria-hidden="true">→</span></span>
          </a>
          <a href="/ma-recherche/" class="tool-box" data-journey="buyer">
            <div class="tool-header-row">
              <span class="tool-num">03 · Achat</span>
              <span class="tool-pill-free">Accès libre</span>
            </div>
            <h3>Clarifier mes priorités d'achat</h3>
            <p>Partez de votre vie quotidienne pour préciser vos usages, vos priorités et les conditions réelles de votre recherche.</p>
            <span class="tool-link-text">Faire le test des usages <span aria-hidden="true">→</span></span>
          </a>
        </div>
      </section>

      <!-- METHODOLOGY BANNER -->
      <section class="container" aria-labelledby="method-title">
        <div class="method-banner">
          <span class="method-badge">La démarche LEVOIS</span>
          <h2 id="method-title">Une méthode en 5 étapes pour des décisions comprises et assumées.</h2>
          <p class="method-lead">
            L'immobilier n'est pas une question de chance ou de bagout commercial. C'est une succession de faits vérifiables et d'arbitrages clairs.
          </p>
          <div class="method-steps-grid">
            <div class="method-step-item">
              <span class="method-step-idx">ÉTAPE 1</span>
              <strong>Comprendre</strong>
              <span>Isoler la réalité de votre situation et vos contraintes de vie.</span>
            </div>
            <div class="method-step-item">
              <span class="method-step-idx">ÉTAPE 2</span>
              <strong>Aligner</strong>
              <span>Mettre en cohérence le calendrier, le budget et le marché.</span>
            </div>
            <div class="method-step-item">
              <span class="method-step-idx">ÉTAPE 3</span>
              <strong>Positionner</strong>
              <span>Définir une stratégie de prix juste et documentée par les faits.</span>
            </div>
            <div class="method-step-item">
              <span class="method-step-idx">ÉTAPE 4</span>
              <strong>Piloter</strong>
              <span>Mesurer les retours réels et ajuster sans panique ni précipitation.</span>
            </div>
            <div class="method-step-item">
              <span class="method-step-idx">ÉTAPE 5</span>
              <strong>Apprendre</strong>
              <span>Capitaliser sur chaque étape pour sécuriser la signature finale.</span>
            </div>
          </div>
        </div>
      </section>

      <!-- BIO SECTION (MOUAAD BOULLOUROU) -->
      <section class="container" aria-labelledby="mouaad-title">
        <div class="bio-section">
          <div class="bio-photo-card">
            <picture>
              <source srcset="/images/mouaad-rdv-1022.avif" type="image/avif" />
              <img 
                src="/images/mouaad-rdv-1022.webp" 
                alt="Mouaad Boullourou, conseiller immobilier SAFTI en échange avec des clients" 
                class="bio-photo" 
                width="680" 
                height="850" 
                loading="lazy" 
                decoding="async" 
              />
            </picture>
            <div class="bio-photo-caption">
              Mouaad Boullourou · Conseiller indépendant SAFTI (RSAC Chartres)
            </div>
          </div>
          <div class="bio-content">
            <span class="bio-tag">Votre interlocuteur de confiance</span>
            <h2 id="mouaad-title">Mouaad Boullourou</h2>
            <p class="bio-subtitle">Conseiller immobilier indépendant SAFTI · Chartres & Agglomération</p>
            
            <p>
              Installé avec ma famille à Lèves, j'ai créé <strong>LEVOIS</strong> pour répondre à une réalité que je constate tous les jours : les décisions immobilières sont trop souvent prises sous pression, avec des informations partielles ou enjolivées.
            </p>
            
            <div class="bio-quote">
              « Donner un maximum de valeur et de clarté gratuitement pour établir une confiance durable et partagée. »
            </div>

            <p>
              Mon engagement est simple : pas de démarchage téléphonique agressif, pas d'estimation flatteuse pour décrocher un mandat à tout prix. Je vous partage les données réelles et mon analyse de terrain. Quand une démarche est comprise et utile, avancer ensemble devient une évidence.
            </p>

            <div class="bio-guarantee-box">
              <div class="bio-guarantee-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Zéro appel automatique ni relance commerciale non sollicitée
              </div>
              <div class="bio-guarantee-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Barème d'honoraires SAFTI transparent et public avant tout engagement
              </div>
              <div class="bio-guarantee-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Disponibilité directe et réactivité humaine à Chartres et Lèves
              </div>
            </div>

            <div class="bio-actions">
              <a href="/contact/" class="btn-primary">Poser une question directe</a>
              <a href={'tel:' + site.phone} class="btn-secondary">{site.phoneDisplay}</a>
              <a href="/methode/" class="btn-secondary">Découvrir la méthode</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <p class="footer-wordmark">LEVOIS<span aria-hidden="true">.</span></p>
            <p>
              Démarche et outils d'aide à la décision immobilière portés par Mouaad Boullourou, conseiller indépendant SAFTI.
            </p>
            <p class="footer-area">
              Secteur d'intervention : Lèves, Chartres, Mainvilliers, Lucé, Champhol, Luisant, Le Coudray et première couronne.
            </p>
          </div>
          <nav class="footer-col" aria-labelledby="footer-journeys">
            <h2 id="footer-journeys">Parcours</h2>
            <ul>
              <li><a href="/ma-recherche/" data-journey="buyer">Acheter un bien</a></li>
              <li><a href="/situer-ma-vente/" data-journey="seller">Faire le point sur ma vente</a></li>
              <li><a href="/vendre-et-acheter/" data-journey="transition">Vente et achat simultanés</a></li>
              <li><a href="/votre-rue/" data-journey="local">Données des ventes locales</a></li>
              <li><a href="/reprendre/">Reprendre ma lecture</a></li>
            </ul>
          </nav>
          <nav class="footer-col" aria-labelledby="footer-transparency">
            <h2 id="footer-transparency">Transparence</h2>
            <ul>
              <li><a href="/methode/">Notre méthode</a></li>
              <li><a href="https://www.safti.fr/bareme" target="_blank" rel="noopener noreferrer">Barème d'honoraires<span class="sr-only"> (nouvel onglet)</span></a></li>
              <li><a href="/mentions-legales/">Mentions légales</a></li>
              <li><a href="/confidentialite/">Confidentialité</a></li>
              <li><button type="button" data-analytics-settings>Choix de confidentialité</button></li>
            </ul>
          </nav>
        </div>
        <div class="footer-bottom">
          <p>© 2026 LEVOIS · Mouaad Boullourou · Conseiller indépendant SAFTI (RSAC Chartres). Tous droits réservés.</p>
          <p>Aucun appel automatique · Vos données restent sous votre contrôle strict.</p>
        </div>
      </div>
    </footer>

    <Analytics />
    <script>
      import '../scripts/experience-entry';
    </script>
  </body>
</html>