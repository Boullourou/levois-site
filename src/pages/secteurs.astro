---
import Layout from '../layouts/Layout.astro';

const principes = [
  { eyebrow: "Cartographier", title: "Identifier les vrais sous-ensembles", desc: "Lèves n'est pas un bloc uniforme. Centre-bourg, lotissements récents, hameaux périphériques — chacun a son rythme." },
  { eyebrow: "Comparer", title: "Donner les atouts ET les inconvénients", desc: "Pas de discours promotionnel. Chaque secteur a ses qualités, et chaque secteur a ses limites. Les deux comptent." },
  { eyebrow: "Écouter", title: "Restituer les retours d'habitants", desc: "Ce que disent les gens qui vivent dans chaque secteur, leurs satisfactions, leurs frustrations, leurs surprises." },
  { eyebrow: "Élargir", title: "Étendre aux communes voisines", desc: "Une section sur les secteurs limitrophes : Chartres, Mainvilliers, Champhol, Lucé. Pour comparer en connaissance de cause." },
];
---

<Layout
  title="Les secteurs de Lèves"
  description="À découvrir les différents secteurs de Lèves avec les habitants. Page en construction."
>

  <article class="max-w-page mx-auto px-edge md:px-edge-md pt-section md:pt-section-md pb-section-md">

    <!-- HERO -->
    <header class="mb-section md:mb-section-md max-w-editorial fade-up">
      <div class="eyebrow mb-6">Sur la carte · les quartiers</div>
      <h1 class="text-hero text-sapin leading-[0.95] mb-8">
        Les secteurs<br/>
        <em class="font-normal italic text-sapin-deep">de Lèves.</em>
      </h1>
      <span class="rule-ocre"></span>
      <p class="text-body-lg text-muted max-w-prose">
        Une page à découvrir avec les habitants, pas une vision figée par
        l'agent qui veut vendre quelque chose. Les sous-quartiers, ce qu'on
        y vit vraiment, et ce qui les distingue.
      </p>
    </header>

    <!-- EN CONSTRUCTION badge -->
    <div class="mb-16 md:mb-20 fade-up">
      <div class="inline-flex items-center gap-3 border border-beige rounded-full px-5 py-2.5 bg-cream-soft">
        <span class="block w-1.5 h-1.5 rounded-full bg-ocre"></span>
        <span class="text-eyebrow uppercase text-muted">En construction · cartographie en cours</span>
      </div>
    </div>

    <!-- TEASER : ce qui vient -->
    <section class="mb-section md:mb-section-md fade-up">
      <h2 class="text-h2 text-sapin mb-3">Comment je vais construire cette page :</h2>
      <span class="rule-ocre"></span>

      <div class="space-y-0 mt-12">
        {principes.map((axe, idx) => (
          <article class={`grid md:grid-cols-[auto_1fr] gap-4 md:gap-12 py-7 md:py-9 ${idx === 0 ? 'border-t' : ''} border-b border-beige fade-up`}>
            <div class="md:w-48">
              <div class="eyebrow-muted">{axe.eyebrow}</div>
            </div>
            <div>
              <h3 class="text-h3 text-sapin mb-2">{axe.title}</h3>
              <p class="text-body-lg text-muted leading-relaxed max-w-prose">{axe.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- CTA contribute -->
    <section class="bg-cream-soft border border-beige rounded-md p-8 md:p-12 fade-up">
      <div class="max-w-editorial">
        <div class="eyebrow mb-4">Vous connaissez bien un secteur ?</div>
        <h2 class="text-h2 text-sapin mb-4">
          Racontez-moi votre quartier<br/>
          <em class="italic font-normal">de l'intérieur.</em>
        </h2>
        <p class="text-body-lg text-muted leading-relaxed mb-8 max-w-prose">
          Ce qui vous y plaît, ce qui vous y agace, les détails qu'on ne voit
          qu'en y vivant. Ce sont ces témoignages qui rendront cette page
          utile pour quelqu'un qui envisage de s'installer.
        </p>
        <a
          href="/contribuer"
          class="inline-flex items-center gap-3 bg-sapin text-cream px-7 py-3.5 rounded-full hover:bg-sapin-deep transition-colors text-[15px]"
        >
          Partager mon secteur
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
        </a>
      </div>
    </section>

  </article>
</Layout>
