---
import Layout from '../layouts/Layout.astro';

const axes = [
  { eyebrow: "Le quartier", title: "Le rapport au voisinage", desc: "Comment on s'installe, comment on s'intègre, ce que les gens racontent de leur arrivée." },
  { eyebrow: "Les transports", title: "L'accès à Chartres et à Paris", desc: "Le quotidien depuis Lèves : voiture, train, bus, vélo. Les vraies durées vécues, pas les promesses agences." },
  { eyebrow: "Le rythme", title: "La vie au quotidien", desc: "Marchés, commerces, services, associations. Ce qui fait le tissu d'une journée ordinaire à Lèves." },
  { eyebrow: "Les familles", title: "Écoles et environnement enfants", desc: "Le maillage scolaire, les activités péri, ce qu'en disent les parents installés depuis quelques années." },
  { eyebrow: "Les surprises", title: "Ce qui surprend en bien", desc: "Les détails qu'on ne voit pas en visite mais qui font qu'on reste. Les coins méconnus, les rituels locaux." },
];
---

<Layout
  title="Pourquoi vivre à Lèves"
  description="Pourquoi s'installer à Lèves ? Page en construction, enrichie au fil des rencontres avec les habitants."
>

  <article class="max-w-page mx-auto px-edge md:px-edge-md pt-section md:pt-section-md pb-section-md">

    <!-- HERO -->
    <header class="mb-section md:mb-section-md max-w-editorial fade-up">
      <div class="eyebrow mb-6">À découvrir · pour qui s'installe</div>
      <h1 class="text-hero text-sapin leading-[0.95] mb-8">
        Pourquoi y vivre<br/>
        <em class="font-normal italic text-sapin-deep">à Lèves ?</em>
      </h1>
      <span class="rule-ocre"></span>
      <p class="text-body-lg text-muted max-w-prose">
        Une des pages les plus importantes du carnet — et l'une des plus longues
        à construire honnêtement. Elle ne sera pas faite d'arguments marketing,
        mais de ce qu'en disent vraiment les gens qui vivent ici, secteur par secteur,
        année après année.
      </p>
    </header>

    <!-- EN CONSTRUCTION badge -->
    <div class="mb-16 md:mb-20 fade-up">
      <div class="inline-flex items-center gap-3 border border-beige rounded-full px-5 py-2.5 bg-cream-soft">
        <span class="block w-1.5 h-1.5 rounded-full bg-ocre"></span>
        <span class="text-eyebrow uppercase text-muted">En construction · premières rencontres en cours</span>
      </div>
    </div>

    <!-- TEASER : ce qui vient -->
    <section class="mb-section md:mb-section-md fade-up">
      <h2 class="text-h2 text-sapin mb-3">Ce qui viendra ici, au fil des rencontres :</h2>
      <span class="rule-ocre"></span>

      <div class="space-y-0 mt-12">
        {axes.map((axe, idx) => (
          <article class={`grid md:grid-cols-[auto_1fr] gap-4 md:gap-12 py-7 md:py-9 ${idx === 0 ? 'border-t' : ''} border-b border-beige fade-up`}>
            <div class="md:w-48">
              <div class="eyebrow-muted">{axe.eyebrow}</div>
            </div>
            <div>
              <h3 class="text-h3 text-sapin mb-2">{axe.title}</h3>
              <p class="text-body-lg text-muted leading-relaxed max-w-prose">{axe.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- CTA contribute -->
    <section class="bg-cream-soft border border-beige rounded-md p-8 md:p-12 fade-up">
      <div class="max-w-editorial">
        <div class="eyebrow mb-4">Vous vivez à Lèves ?</div>
        <h2 class="text-h2 text-sapin mb-4">
          Votre regard d'habitant<br/>
          <em class="italic font-normal">m'intéresse vraiment.</em>
        </h2>
        <p class="text-body-lg text-muted leading-relaxed mb-8 max-w-prose">
          Que vous viviez ici depuis 30 ans ou 6 mois, votre vision compte
          plus que la mienne pour cette page. Une anecdote, un détail,
          un coup de cœur ou un coup de gueule — tout est utile.
        </p>
        <a
          href="/contribuer"
          class="inline-flex items-center gap-3 bg-sapin text-cream px-7 py-3.5 rounded-full hover:bg-sapin-deep transition-colors text-[15px]"
        >
          Partager mon regard
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
        </a>
      </div>
    </section>

  </article>
</Layout>
