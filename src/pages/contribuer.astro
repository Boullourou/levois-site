---
import Layout from '../layouts/Layout.astro';

const facons = [
  {
    eyebrow: "Une histoire",
    title: "Une rencontre, un témoignage",
    desc: "Vous vivez à Lèves et avez envie de partager votre histoire d'installation, un parcours, un quartier que vous connaissez bien. Le format peut être un témoignage écrit ou une rencontre en personne."
  },
  {
    eyebrow: "Une adresse",
    title: "Un commerce, un artisan à recommander",
    desc: "Une bonne adresse à Lèves ou autour, un artisan compétent, un restaurant qu'on n'oublie pas. Tout ce que vous voudriez voir mentionné dans le carnet pour que d'autres le découvrent."
  },
  {
    eyebrow: "Un retour",
    title: "Une correction, un désaccord, une précision",
    desc: "Si quelque chose vous semble inexact, mal formulé, ou simplement à compléter, dites-le-moi. Les retours critiques sont les plus utiles."
  },
];
---

<Layout
  title="Contribuer au carnet"
  description="Comment enrichir le carnet de Lèves avec votre regard d'habitant ou votre expertise locale."
>

  <article class="max-w-page mx-auto px-edge md:px-edge-md pt-section md:pt-section-md pb-section-md">

    <!-- HERO -->
    <header class="mb-section md:mb-section-md max-w-editorial fade-up">
      <div class="eyebrow mb-6">Aidez-moi</div>
      <h1 class="text-hero text-sapin leading-[0.95] mb-8">
        Contribuer<br/>
        <em class="font-normal italic text-sapin-deep">au carnet.</em>
      </h1>
      <span class="rule-ocre"></span>
      <p class="text-body-lg text-muted max-w-prose">
        Le carnet ne peut pas exister sans la parole de ceux qui vivent à Lèves.
        Voici trois façons de l'enrichir — vous pouvez en choisir une, ou plusieurs,
        ou simplement m'écrire librement.
      </p>
    </header>

    <!-- 3 FAÇONS DE CONTRIBUER -->
    <section class="mb-section md:mb-section-md">

      <div class="space-y-0">
        {facons.map((facon, idx) => (
          <article class={`grid md:grid-cols-12 gap-4 md:gap-12 py-9 md:py-12 ${idx === 0 ? 'border-t' : ''} border-b border-beige fade-up`}>
            <div class="md:col-span-3">
              <div class="text-h2 italic text-ocre">0{idx + 1}.</div>
              <div class="eyebrow-muted mt-3">{facon.eyebrow}</div>
            </div>
            <div class="md:col-span-8">
              <h3 class="text-h2 text-sapin mb-4">{facon.title}</h3>
              <p class="text-body-lg text-muted leading-relaxed max-w-prose">{facon.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- FORMULAIRE -->
    <section class="bg-cream-soft border border-beige rounded-md p-8 md:p-12 fade-up" id="formulaire">
      <div class="max-w-editorial">

        <div class="eyebrow mb-4">M'écrire</div>
        <h2 class="text-h2 text-sapin mb-4">
          Le formulaire<br/>
          <em class="italic font-normal">pour partager.</em>
        </h2>
        <p class="text-body-lg text-muted leading-relaxed mb-10 max-w-prose">
          Vous n'êtes pas obligé de tout remplir. Tout ce qui m'aidera à vous
          recontacter et à comprendre votre apport est bienvenu.
        </p>

        <form
          action="https://formspree.io/f/xnjynroj"
          method="POST"
          class="space-y-5"
        >
          <input type="hidden" name="_subject" value="[Carnet] Nouvelle contribution" />
          <input type="hidden" name="_next" value="https://levois.fr/merci" />
          <div class="grid sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="text-eyebrow uppercase text-muted">Prénom</span>
              <input type="text" name="prenom" class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin" />
            </label>
            <label class="block">
              <span class="text-eyebrow uppercase text-muted">Nom (facultatif)</span>
              <input type="text" name="nom" class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin" />
            </label>
          </div>

          <label class="block">
            <span class="text-eyebrow uppercase text-muted">Email *</span>
            <input type="email" name="email" required class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin" />
          </label>

          <label class="block">
            <span class="text-eyebrow uppercase text-muted">Téléphone (facultatif)</span>
            <input type="tel" name="telephone" class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-2.5 focus:outline-none focus:border-sapin" />
          </label>

          <fieldset class="space-y-3">
            <legend class="text-eyebrow uppercase text-muted mb-2">Ce qui m'amène (plusieurs choix possibles)</legend>
            <label class="flex items-start gap-3 text-[15px]">
              <input type="checkbox" name="motif_histoire" value="oui" class="mt-1 accent-sapin" />
              <span>Je veux partager une histoire ou un témoignage</span>
            </label>
            <label class="flex items-start gap-3 text-[15px]">
              <input type="checkbox" name="motif_adresse" value="oui" class="mt-1 accent-sapin" />
              <span>Je veux recommander un commerce ou un artisan</span>
            </label>
            <label class="flex items-start gap-3 text-[15px]">
              <input type="checkbox" name="motif_correction" value="oui" class="mt-1 accent-sapin" />
              <span>Je veux signaler une erreur, une imprécision, un désaccord</span>
            </label>
            <label class="flex items-start gap-3 text-[15px]">
              <input type="checkbox" name="motif_autre" value="oui" class="mt-1 accent-sapin" />
              <span>Autre chose (à préciser dans le message)</span>
            </label>
          </fieldset>

          <label class="block">
            <span class="text-eyebrow uppercase text-muted">Votre message</span>
            <textarea name="message" rows="6" placeholder="Racontez-moi ce que vous avez à partager — il n'y a pas de format imposé, écrivez comme ça vient." class="mt-1 w-full bg-cream border border-beige rounded-md px-4 py-3 focus:outline-none focus:border-sapin"></textarea>
          </label>

          <label class="flex items-start gap-3 text-xs text-muted">
            <input type="checkbox" name="consentement" value="oui" required class="mt-0.5 accent-sapin" />
            <span>
              J'accepte d'être recontacté par Mouaad Boullourou au sujet de ma contribution.
              Je peux retirer mon consentement à tout moment.
            </span>
          </label>

          <button type="submit" class="bg-sapin text-cream px-7 py-3.5 rounded-full hover:bg-sapin-deep transition-colors text-[15px] inline-flex items-center gap-3">
            Envoyer ma contribution
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
          </button>

          <p class="text-xs text-muted pt-3">
            Données utilisées uniquement pour cette demande. Voir
            <a href="/mentions-legales" class="text-sapin underline underline-offset-2">mentions légales</a>.
          </p>
        </form>
      </div>
    </section>

    <!-- Engagement éditorial -->
    <section class="mt-section anti-vente max-w-prose fade-up">
      Si je publie quelque chose à partir de votre contribution, je vous le soumets
      avant publication — vous pouvez corriger, demander à rester anonyme, ou demander
      à ce que ça ne soit pas publié du tout. Aucun usage sans votre accord.
    </section>

  </article>
</Layout>
