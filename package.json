{
  "name": "levois-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "predev": "node scripts/editorial-prepare.mjs",
    "dev": "astro dev",
    "prestart": "node scripts/editorial-prepare.mjs",
    "start": "astro dev",
    "prebuild": "node scripts/editorial-prepare.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "pretest": "node scripts/editorial-prepare.mjs",
    "test": "vitest run",
    "test:cockpit": "vitest run src/lib/cockpit functions/_lib/cockpit/security.test.ts tests/cockpit-api.test.ts",
    "test:cockpit:security": "vitest run functions/_lib/cockpit/security.test.ts tests/cockpit-api.test.ts",
    "dev:cockpit": "npm run build && wrangler pages dev dist --local --persist-to .wrangler/state/cockpit --ip 127.0.0.1 --port 8788 --compatibility-date 2026-03-02 --d1 COCKPIT_DB=00000000-0000-0000-0000-000000000000 --binding COCKPIT_LOCAL_BYPASS=1",
    "db:cockpit:migrate:local": "wrangler d1 migrations apply levois-cockpit-local --local --config wrangler.cockpit.toml --persist-to .wrangler/state/cockpit",
    "db:cockpit:seed:local": "wrangler d1 execute levois-cockpit-local --local --config wrangler.cockpit.toml --persist-to .wrangler/state/cockpit --file db/fixtures/cockpit-v1.sql",
    "data:dvf": "node scripts/build-dvf.mjs",
    "data:market": "node scripts/build-market-summary.mjs",
    "test:market": "node --test tests/market-summary.node.mjs",
    "data:verify": "node scripts/verify-dvf.mjs",
    "editorial:check": "node scripts/editorial-check.mjs",
    "editorial:prepare": "node scripts/editorial-prepare.mjs",
    "editorial:import": "node scripts/editorial-import.mjs",
    "editorial:convert": "node scripts/editorial-convert.mjs",
    "editorial:batch": "node scripts/editorial-batch.mjs",
    "test:public": "node scripts/verify-public.mjs",
    "test:delivery": "node scripts/qa-delivery.mjs",
    "dev:experience": "node scripts/dev-experience.mjs",
    "precheck": "node scripts/editorial-prepare.mjs",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "jose": "^6.1.3",
    "posthog-js": "^1.380.0",
    "satteri": "0.10.5",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
